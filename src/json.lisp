;;;; json.lisp -- a small dependency-free JSON reader/writer.
;;;;
;;;; Objects are (:OBJECT . alist) with string keys in source order, arrays are
;;;; vectors, and true/false/null are :TRUE / :FALSE / :NULL.  Key order is
;;;; kept so a laid-out graph reads back like the graph that went in.

(in-package #:diagram)

(defun json-object-p (x) (and (consp x) (eq (car x) :object)))

(defun jget (obj key &optional default)
  (if (json-object-p obj)
      (let ((cell (assoc key (cdr obj) :test #'string=)))
        (if cell (cdr cell) default))
      default))

(defun jset (obj key value)
  (let ((cell (assoc key (cdr obj) :test #'string=)))
    (if cell
        (setf (cdr cell) value)
        (setf (cdr (last obj)) (list (cons key value))))
    value))

(defun jobject (&rest keys-and-values)
  (cons :object (loop for (k v) on keys-and-values by #'cddr collect (cons k v))))

;;; Reading

(defun parse-json (string)
  (let ((pos 0) (len (length string)))
    (labels ((peek () (and (< pos len) (char string pos)))
             (fail (msg) (error "JSON parse error at offset ~D: ~A" pos msg))
             (ws () (loop while (and (< pos len)
                                     (member (char string pos)
                                             '(#\Space #\Tab #\Newline #\Return #\Page)))
                          do (incf pos)))
             (expect (c)
               (ws)
               (unless (eql (peek) c) (fail (format nil "expected ~C" c)))
               (incf pos))
             (value ()
               (ws)
               (case (peek)
                 ((nil) (fail "unexpected end of input"))
                 (#\{ (incf pos) (read-object))
                 (#\[ (incf pos) (read-array))
                 (#\" (incf pos) (read-string))
                 (#\t (literal "true" :true))
                 (#\f (literal "false" :false))
                 (#\n (literal "null" :null))
                 (t (read-number))))
             (literal (word val)
               (let ((end (+ pos (length word))))
                 (unless (and (<= end len) (string= word string :start2 pos :end2 end))
                   (fail "bad literal"))
                 (setf pos end)
                 val))
             (read-object ()
               (ws)
               (when (eql (peek) #\}) (incf pos) (return-from read-object (list :object)))
               (let ((acc '()))
                 (loop
                   (ws)
                   (unless (eql (peek) #\") (fail "expected a string key"))
                   (incf pos)
                   (let ((key (read-string)))
                     (expect #\:)
                     (push (cons key (value)) acc))
                   (ws)
                   (case (peek)
                     (#\, (incf pos))
                     (#\} (incf pos) (return (cons :object (nreverse acc))))
                     (t (fail "expected , or }"))))))
             (read-array ()
               (ws)
               (when (eql (peek) #\]) (incf pos) (return-from read-array (vector)))
               (let ((acc '()))
                 (loop
                   (push (value) acc)
                   (ws)
                   (case (peek)
                     (#\, (incf pos))
                     (#\] (incf pos) (return (coerce (nreverse acc) 'vector)))
                     (t (fail "expected , or ]"))))))
             (hex4 ()
               (when (> (+ pos 4) len) (fail "short \\u escape"))
               (prog1 (parse-integer string :start pos :end (+ pos 4) :radix 16)
                 (incf pos 4)))
             (read-string ()
               (with-output-to-string (out)
                 (loop
                   (when (>= pos len) (fail "unterminated string"))
                   (let ((c (char string pos)))
                     (incf pos)
                     (cond ((char= c #\") (return))
                           ((char= c #\\)
                            (when (>= pos len) (fail "unterminated escape"))
                            (let ((e (char string pos)))
                              (incf pos)
                              (case e
                                (#\n (write-char #\Newline out))
                                (#\t (write-char #\Tab out))
                                (#\r (write-char #\Return out))
                                (#\b (write-char #\Backspace out))
                                (#\f (write-char #\Page out))
                                (#\u (let ((code (hex4)))
                                       (when (and (<= #xD800 code #xDBFF)
                                                  (< (+ pos 1) len)
                                                  (char= (char string pos) #\\)
                                                  (char= (char string (1+ pos)) #\u))
                                         (incf pos 2)
                                         (let ((lo (hex4)))
                                           (setf code (+ #x10000 (ash (- code #xD800) 10)
                                                         (- lo #xDC00)))))
                                       (write-char (code-char code) out)))
                                (t (write-char e out)))))
                           (t (write-char c out)))))))
             (read-number ()
               (let ((start pos))
                 (loop while (and (< pos len) (find (char string pos) "+-0123456789.eE"))
                       do (incf pos))
                 (when (= start pos) (fail "unexpected character"))
                 (let ((text (subseq string start pos)))
                   (if (find-if (lambda (c) (find c ".eE")) text)
                       (let ((*read-default-float-format* 'double-float)
                             (*read-eval* nil))
                         (let ((v (read-from-string text)))
                           (unless (realp v) (fail "bad number"))
                           (float v 1d0)))
                       (parse-integer text))))))
      (prog1 (value)
        (ws)
        (when (< pos len) (fail "trailing characters"))))))

;;; Writing

(defun write-json-number (x out)
  (cond ((integerp x) (format out "~D" x))
        (t (let ((f (float x 1d0)))
             (if (and (= f (fround f)) (< (abs f) 1d15))
                 (format out "~D" (round f))
                 (let ((s (string-right-trim "0" (format nil "~,4F" f))))
                   (write-string (string-right-trim "." s) out)))))))

(defun write-json-string (s out)
  (write-char #\" out)
  (loop for c across s
        do (case c
             (#\" (write-string "\\\"" out))
             (#\\ (write-string "\\\\" out))
             (#\Newline (write-string "\\n" out))
             (#\Return (write-string "\\r" out))
             (#\Tab (write-string "\\t" out))
             (t (if (< (char-code c) 32)
                    (format out "\\u~4,'0X" (char-code c))
                    (write-char c out)))))
  (write-char #\" out))

(defun write-json (value &optional stream (indent 2))
  "Write VALUE as JSON to STREAM (NIL = return a string).  INDENT NIL = compact."
  (if (null stream)
      (with-output-to-string (s) (write-json value s indent))
      (labels ((nl (depth)
                 (when indent
                   (terpri stream)
                   (loop repeat (* depth indent) do (write-char #\Space stream))))
               (emit (v depth)
                 (cond ((eq v :true) (write-string "true" stream))
                       ((eq v :false) (write-string "false" stream))
                       ((or (eq v :null) (null v)) (write-string "null" stream))
                       ((eq v t) (write-string "true" stream))
                       ((stringp v) (write-json-string v stream))
                       ((realp v) (write-json-number v stream))
                       ((symbolp v) (write-json-string (string v) stream))
                       ((json-object-p v)
                        (if (null (cdr v))
                            (write-string "{}" stream)
                            (progn
                              (write-char #\{ stream)
                              (loop for (cell . more) on (cdr v)
                                    do (nl (1+ depth))
                                       (write-json-string (car cell) stream)
                                       (write-string (if indent ": " ":") stream)
                                       (emit (cdr cell) (1+ depth))
                                       (when more (write-char #\, stream)))
                              (nl depth)
                              (write-char #\} stream))))
                       ((vectorp v)
                        (if (zerop (length v))
                            (write-string "[]" stream)
                            (progn
                              (write-char #\[ stream)
                              (loop for i from 0 below (length v)
                                    do (nl (1+ depth))
                                       (emit (aref v i) (1+ depth))
                                       (when (< i (1- (length v))) (write-char #\, stream)))
                              (nl depth)
                              (write-char #\] stream))))
                       (t (error "Cannot write ~S as JSON" v)))))
        (emit value 0)
        value)))

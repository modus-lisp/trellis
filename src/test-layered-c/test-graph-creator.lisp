(defjmethod two-edges-into-same-port-from-east-with-fixed-port-order ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer)))
    (set-fixed-order-constraint this bottom-left)
    (set-fixed-order-constraint this top-right)
    (let* ((top-left-port (add-port-on-side this top-left port-side.east))
           (bottom-left-port (add-port-on-side this bottom-left port-side.east))
           (top-right-port (add-port-on-side this top-right port-side.west))
           (bottom-right-port (add-port-on-side this bottom-right port-side.west)))
      (add-edge-between-ports this bottom-left-port bottom-right-port)
      (add-edge-between-ports this bottom-left-port top-right-port)
      (add-edge-between-ports this top-left-port top-right-port)))
  (set-up-ids this)
  (.graph this))

(defjmethod get-current-order ((this layered-test-graph-creator))
  (let* ((layers (get-layers (.graph this)))
         (node-order (make-array (length layers))))
    (dotimes (i (length layers))
      (let ((nodes (get-nodes (jl-get layers i))))
        (setf (aref node-order i) (make-array (length nodes)))
        (dotimes (j (length nodes))
          (setf (aref (aref node-order i) j) (jl-get nodes j)))))
    node-order))

;;; ---- protected helpers

(defjmethod set-as-north-south-node ((this layered-test-graph-creator) node)
  (set-type node node-type.north-south-port))

(defjmethod add-north-south-edge ((this layered-test-graph-creator) side node-with-ns-ports
                                  north-south-dummy node-with-east-west-ports
                                  node-with-east-west-ports-is-origin)
  (let* ((normal-node-east-of-ns-port-node
           (< (get-index (get-layer node-with-east-west-ports))
              (get-index (get-layer node-with-ns-ports))))
         (direction (if normal-node-east-of-ns-port-node port-side.west port-side.east))
         (target-node-port-side (if (eq direction port-side.west) port-side.east port-side.west))
         (normal-node-port (add-port-on-side this node-with-east-west-ports target-node-port-side))
         (dummy-node-port (add-port-on-side this north-south-dummy direction)))
    (if node-with-east-west-ports-is-origin
        (add-edge-between-ports this normal-node-port dummy-node-port)
        (add-edge-between-ports this dummy-node-port normal-node-port))
    (set-property north-south-dummy layered-internal-properties.in-layer-layout-unit node-with-ns-ports)
    (set-property north-south-dummy layered-internal-properties.origin node-with-ns-ports)
    (set-as-north-south-node this north-south-dummy)
    (let ((origin-port (add-port-on-side this node-with-ns-ports side)))
      (set-property dummy-node-port layered-internal-properties.origin origin-port)
      (set-property origin-port layered-internal-properties.port-dummy north-south-dummy))
    (let* ((bary-assoc (jlist north-south-dummy))
           (other-bary-assocs (get-property node-with-ns-ports layered-internal-properties.barycenter-associates)))
      (if (null other-bary-assocs)
          (set-property node-with-ns-ports layered-internal-properties.barycenter-associates bary-assoc)
          (jl-add-all other-bary-assocs bary-assoc)))
    (if (eq side port-side.north)
        (jl-add (get-property north-south-dummy layered-internal-properties.in-layer-successor-constraints)
                node-with-ns-ports)
        (jl-add (get-property node-with-ns-ports layered-internal-properties.in-layer-successor-constraints)
                north-south-dummy))))

(defjmethod set-in-layer-order-constraint ((this layered-test-graph-creator) this-node before-this-node)
  (set-property this-node layered-internal-properties.in-layer-successor-constraints
                (jlist before-this-node)))

(defjmethod set-as-long-edge-dummy ((this layered-test-graph-creator) node)
  (set-type node node-type.long-edge))

(defjmethod set-port-order-fixed ((this layered-test-graph-creator) node)
  (set-property node layered-options.port-constraints port-constraints.fixed-order))

(defjmethod make-layers ((this layered-test-graph-creator) amount)
  (let ((layers (make-array amount)))
    (dotimes (i amount)
      (setf (aref layers i) (make-layer this)))
    layers))

(defjmethod set-fixed-order-constraint ((this layered-test-graph-creator) node)
  (set-property node layered-options.port-constraints port-constraints.fixed-order)
  node)

(defjmethod add-in-layer-edge ((this layered-test-graph-creator) node-one node-two port-side)
  (let ((port-one (add-port-on-side this node-one port-side))
        (port-two (add-port-on-side this node-two port-side)))
    (add-edge-between-ports this port-one port-two)))

(defjmethod add-nodes-to-layer ((this layered-test-graph-creator) amount-of-nodes left-layer)
  (let ((nodes (make-array amount-of-nodes)))
    (dotimes (j amount-of-nodes)
      (setf (aref nodes j) (add-node-to-layer this left-layer)))
    nodes))

(defjmethod make-layer ((this layered-test-graph-creator))
  (make-layer/1 this (.graph this)))

(defjmethod make-layer ((this layered-test-graph-creator) graph)
  (let* ((layers (get-layers graph))
         (layer (new-layer/1 graph)))
    (jl-add layers layer)
    layer))

(defjmethod add-node-to-layer ((this layered-test-graph-creator) layer)
  (let ((node (new-l-node/1 (.graph this))))
    (set-type node node-type.normal)
    (set-property node layered-internal-properties.in-layer-layout-unit node)
    (set-layer node layer)
    (setf (.id node) (.node-id this))
    (incf (.node-id this))
    node))

(defjmethod east-west-edge-from-to ((this layered-test-graph-creator) left right)
  (if (typep left 'l-port)
      (let ((right-port (add-port-on-side this right port-side.west)))
        (add-edge-between-ports this left right-port))
      (let ((left-port (add-port-on-side this left port-side.east))
            (right-port (add-port-on-side this right port-side.west)))
        (add-edge-between-ports this left-port right-port))))

(defjmethod add-edge-between-ports ((this layered-test-graph-creator) from to)
  (let ((edge (new-l-edge/0)))
    (set-source edge from)
    (set-target edge to)
    (setf (.id edge) (.edge-id this))
    (incf (.edge-id this))
    edge))

(defjmethod add-port-on-side ((this layered-test-graph-creator) node port-side)
  (let ((port (add-port-to this node)))
    (set-side port port-side)
    port))

(defjmethod add-port-to ((this layered-test-graph-creator) node)
  (let ((port (new-l-port/0)))
    (set-node port node)
    (setf (.id port) (.port-id this))
    (incf (.port-id this))
    port))

(defjmethod multiple-edges-into-one-port-and-free-port-order ((this layered-test-graph-creator))
  (let ((nodes (add-nodes-to-layer this 3 (make-layer this))))
    (add-in-layer-edge this (aref nodes 0) (aref nodes 2) port-side.west)
    (let ((port-upper-node (add-port-on-side this (aref nodes 0) port-side.west)))
      (add-edge-between-ports this port-upper-node (add-port-on-side this (aref nodes 2) port-side.west))
      (add-edge-between-ports this port-upper-node (add-port-on-side this (aref nodes 1) port-side.west))))
  (set-up-ids this)
  (.graph this))

(defjmethod get-only-correctly-improved-by-best-of-forward-and-backward-sweeps-in-single-layer
    ((this layered-test-graph-creator))
  (let* ((left-node (add-node-to-layer this (make-layer this))))
    (set-fixed-order-constraint this left-node)
    (let ((right-nodes (add-nodes-to-layer this 3 (make-layer this))))
      (east-west-edge-from-to this left-node (aref right-nodes 2))
      (east-west-edge-from-to this left-node (aref right-nodes 2))
      (east-west-edge-from-to this left-node (aref right-nodes 1))
      (add-in-layer-edge this (aref right-nodes 0) (aref right-nodes 2) port-side.west)))
  (set-up-ids this)
  (.graph this))

;;; ---- generic list/array helpers.  Java varargs `int... is` is one parameter
;;; here: pass a list of indices.

(defjmethod get-list-in-index-order ((this layered-test-graph-creator) li is)
  (let ((list (new-jlist)))
    (dolist (i is)
      (jl-add list (jl-get li i)))
    list))

(defjmethod get-array-in-index-order ((this layered-test-graph-creator) arr is)
  (let ((copy (copy-seq arr))
        (j 0))
    (dolist (i is)
      (setf (aref copy j) (aref arr i))
      (incf j))
    copy))

(defjmethod switch-order-in-list ((this layered-test-graph-creator) i j list)
  (let* ((list-copy (jl-copy list))
         (first (jl-get list-copy i))
         (second (jl-get list-copy j)))
    (jl-set list-copy i second)
    (jl-set list-copy j first)
    list-copy))

(defjmethod switch-order-in-array ((this layered-test-graph-creator) i j arr)
  (let* ((copy (copy-seq arr))
         (first (aref arr i))
         (snd (aref arr j)))
    (setf (aref copy j) first
          (aref copy i) snd)
    copy))

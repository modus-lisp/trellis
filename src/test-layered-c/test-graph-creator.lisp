(defjmethod get-nodes-in-different-layout-units-prevent-switch ((this layered-test-graph-creator))
  (let* ((layers (make-layers this 2))
         (left-nodes (add-nodes-to-layer this 2 (aref layers 0)))
         (right-nodes (add-nodes-to-layer this 3 (aref layers 1))))
    (east-west-edge-from-to this (aref left-nodes 0) (aref right-nodes 1))
    (east-west-edge-from-to this (aref left-nodes 1) (aref right-nodes 0))
    (let ((south-port (add-port-on-side this (aref right-nodes 1) port-side.south))
          (north-port (add-port-on-side this (aref right-nodes 2) port-side.north)))
      (add-edge-between-ports this south-port north-port))
    (set-property (aref right-nodes 1) layered-internal-properties.in-layer-layout-unit (aref right-nodes 2))
    (set-property (aref right-nodes 2) layered-internal-properties.in-layer-layout-unit (aref right-nodes 2)))
  (set-up-ids this)
  (.graph this))


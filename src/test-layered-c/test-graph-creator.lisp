;;;; test-graph-creator.lisp -- port of org.eclipse.elk.alg.layered.TestGraphCreator.
;;;;
;;;; Use to create test graphs.  Caution: the layout algorithm assumes the ports
;;;; to be ordered in a clockwise manner.  Java's `protected` and `private`
;;;; members keep their names; instance state lives in slots of the creator.

(in-package #:elk)

(defjclass layered-test-graph-creator ()
  ((port-id 0)
   (node-id 0)
   (edge-id 0)
   ;; the graph (protected final LGraph graph)
   (graph nil)
   (random nil)))

(defjctor layered-test-graph-creator ()
  (setf (.graph this) (new-l-graph/0))
  (set-property (.graph this) layered-options.edge-routing edge-routing.orthogonal)
  (setf (.random this) (new-mock-random))
  (set-property (.graph this) layered-internal-properties.random (.random this)))

(defjmethod get-graph ((this layered-test-graph-creator))
  (set-up-ids this)
  (set-property (.graph this) layered-options.edge-routing edge-routing.orthogonal)
  (.graph this))

(defjmethod get-empty-graph ((this layered-test-graph-creator))
  (set-up-ids this)
  (set-property (.graph this) layered-options.edge-routing edge-routing.orthogonal)
  (.graph this))

(defjmethod get-two-nodes-no-connection-graph ((this layered-test-graph-creator))
  (let ((layer (make-layer this)))
    (add-node-to-layer this layer)
    (add-node-to-layer this layer))
  (set-up-ids this)
  (.graph this))

(defjmethod set-up-ids ((this layered-test-graph-creator))
  (let ((l-id 0))
    (jdo (l (.graph this))
      (setf (.id l) l-id)
      (incf l-id)
      (let ((i 0))
        (jdo (n l)
          (setf (.id n) i)
          (incf i))))))

(defjmethod get-cross-formed-graph ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer)))
    (east-west-edge-from-to this top-left bottom-right)
    (east-west-edge-from-to this bottom-left top-right)
    (set-up-ids this)
    (.graph this)))

(defjmethod multiple-edges-and-single-edge ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (bottom-right (add-node-to-layer this right-layer)))
    (east-west-edge-from-to this top-left bottom-right)
    (east-west-edge-from-to this top-left bottom-right)
    (east-west-edge-from-to this bottom-left bottom-right)
    (set-up-ids this)
    (.graph this)))

(defjmethod get-cross-formed-graph-with-constraints-in-second-layer ((this layered-test-graph-creator))
  (get-cross-formed-graph this)
  (let* ((layer-one (jl-get (get-layers (.graph this)) 1))
         (top-node (jl-get (get-nodes layer-one) 0))
         (second-node (jl-get (get-nodes layer-one) 1)))
    (set-in-layer-order-constraint this top-node second-node))
  (set-up-ids this)
  (.graph this))

(defjmethod get-cross-formed-graph-constraints-prevent-any-switch ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer)))
    (east-west-edge-from-to this top-left bottom-right)
    (east-west-edge-from-to this bottom-left top-right)
    (set-in-layer-order-constraint this top-right bottom-right)
    (set-in-layer-order-constraint this top-left bottom-left)
    (set-up-ids this)
    (.graph this)))

(defjmethod get-one-node-graph ((this layered-test-graph-creator))
  (let ((layer (make-layer this)))
    (add-node-to-layer this layer))
  (set-up-ids this)
  (.graph this))

(defjmethod get-in-layer-edges-graph ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (middle-layer (make-layer this))
         (right-layer (make-layer this))
         (left-node (add-node-to-layer this left-layer))
         (middle-nodes (add-nodes-to-layer this 3 middle-layer))
         (right-node (add-node-to-layer this right-layer)))
    ;; add east side ports first to get expected port ordering
    (east-west-edge-from-to this (aref middle-nodes 1) right-node)
    (east-west-edge-from-to this left-node (aref middle-nodes 1))
    (add-in-layer-edge this (aref middle-nodes 0) (aref middle-nodes 2) port-side.west)
    (set-up-ids this)
    (.graph this)))

(defjmethod get-in-layer-edges-graph-which-results-in-crossings-when-switched ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (left-node (add-node-to-layer this left-layer))
         (right-nodes (add-nodes-to-layer this 3 right-layer)))
    (add-in-layer-edge this (aref right-nodes 0) (aref right-nodes 1) port-side.west)
    (east-west-edge-from-to this left-node (aref right-nodes 2))
    (set-up-ids this)
    (.graph this)))

(defjmethod get-multiple-edges-between-same-nodes-graph ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer)))
    (declare (ignorable bottom-right))
    (east-west-edge-from-to this top-left bottom-right)
    (east-west-edge-from-to this top-left bottom-right)
    (east-west-edge-from-to this bottom-left top-right)
    (east-west-edge-from-to this bottom-left top-right)
    (set-up-ids this)
    (.graph this)))

(defjmethod get-cross-with-extra-edge-in-between-graph ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (left-nodes (add-nodes-to-layer this 3 left-layer))
         (right-nodes (add-nodes-to-layer this 3 right-layer)))
    (east-west-edge-from-to this (aref left-nodes 0) (aref right-nodes 2))
    (east-west-edge-from-to this (aref left-nodes 1) (aref right-nodes 1))
    (east-west-edge-from-to this (aref left-nodes 2) (aref right-nodes 0))
    (set-up-ids this)
    (.graph this)))

(defjmethod get-cross-with-many-self-loops-graph ((this layered-test-graph-creator))
  (let ((self-loop-cross-graph (get-cross-formed-graph this)))
    (jdo (layer self-loop-cross-graph)
      (jdo (node layer)
        (self-loop-on this node port-side.east)
        (self-loop-on this node port-side.east)
        (self-loop-on this node port-side.east)
        (self-loop-on this node port-side.west)
        (self-loop-on this node port-side.west)
        (self-loop-on this node port-side.west)))
    self-loop-cross-graph))

(defjmethod self-loop-on ((this layered-test-graph-creator) node side)
  (add-edge-between-ports this
                          (add-port-on-side this node side)
                          (add-port-on-side this node side)))

(defjmethod get-more-complex-three-layer-graph ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (middle-layer (make-layer this))
         (right-layer (make-layer this))
         (left-nodes (add-nodes-to-layer this 3 left-layer))
         (middle-nodes (add-nodes-to-layer this 2 middle-layer))
         (right-nodes (add-nodes-to-layer this 3 right-layer)))
    (flet ((e (a b) (east-west-edge-from-to this a b)))
      (e (aref left-nodes 0) (aref middle-nodes 0))
      (e (aref left-nodes 1) (aref middle-nodes 0))
      (e (aref left-nodes 1) (aref middle-nodes 1))
      (e (aref left-nodes 2) (aref middle-nodes 0))
      (e (aref middle-nodes 0) (aref right-nodes 0))
      (e (aref middle-nodes 0) (aref right-nodes 1))
      (e (aref middle-nodes 0) (aref right-nodes 1))
      (e (aref middle-nodes 1) (aref right-nodes 0))
      (e (aref middle-nodes 1) (aref right-nodes 2)))
    (set-up-ids this)
    (.graph this)))

(defjmethod get-fixed-port-order-graph ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (left-node (add-node-to-layer this left-layer)))
    (set-property left-node layered-options.port-constraints port-constraints.fixed-order)
    (let* ((right-top-node (add-node-to-layer this right-layer))
           (right-bottom-node (add-node-to-layer this right-layer)))
      (east-west-edge-from-to this left-node right-bottom-node)
      (east-west-edge-from-to this left-node right-top-node)))
  (set-up-ids this)
  (.graph this))

(defjmethod get-graph-no-crossings-due-to-port-order-not-fixed ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (left-node (add-node-to-layer this left-layer))
         (right-top-node (add-node-to-layer this right-layer))
         (right-bottom-node (add-node-to-layer this right-layer)))
    (east-west-edge-from-to this left-node right-bottom-node)
    (east-west-edge-from-to this left-node right-top-node))
  (set-up-ids this)
  (.graph this))

(defjmethod get-switch-only-one-sided ((this layered-test-graph-creator))
  (let* ((layers (make-layers this 3))
         (left-nodes (add-nodes-to-layer this 2 (aref layers 0)))
         (middle-nodes (add-nodes-to-layer this 2 (aref layers 1)))
         (right-nodes (add-nodes-to-layer this 2 (aref layers 2))))
    (east-west-edge-from-to this (aref left-nodes 0) (aref middle-nodes 1))
    (east-west-edge-from-to this (aref left-nodes 1) (aref middle-nodes 0))
    (east-west-edge-from-to this (aref middle-nodes 0) (aref right-nodes 0))
    (east-west-edge-from-to this (aref middle-nodes 1) (aref right-nodes 1)))
  (set-up-ids this)
  (.graph this))

(defjmethod get-switch-only-east-one-sided ((this layered-test-graph-creator))
  (let* ((layers (make-layers this 3))
         (left-nodes (add-nodes-to-layer this 2 (aref layers 0)))
         (middle-nodes (add-nodes-to-layer this 2 (aref layers 1)))
         (right-nodes (add-nodes-to-layer this 2 (aref layers 2))))
    (east-west-edge-from-to this (aref left-nodes 0) (aref middle-nodes 0))
    (east-west-edge-from-to this (aref left-nodes 1) (aref middle-nodes 1))
    (east-west-edge-from-to this (aref middle-nodes 0) (aref right-nodes 1))
    (east-west-edge-from-to this (aref middle-nodes 1) (aref right-nodes 0)))
  (set-up-ids this)
  (.graph this))

(defjmethod get-fixed-port-order-in-layer-edges-dont-cross-each-other ((this layered-test-graph-creator))
  (let* ((layer (make-layer this))
         (nodes (add-nodes-to-layer this 2 layer)))
    (set-fixed-order-constraint this (aref nodes 0))
    (set-fixed-order-constraint this (aref nodes 1))
    ;; must add ports and edges manually, due to clockwise port ordering
    (let* ((upper-port-upper-node (add-port-on-side this (aref nodes 0) port-side.east))
           (lower-port-upper-node (add-port-on-side this (aref nodes 0) port-side.east))
           (upper-port-lower-node (add-port-on-side this (aref nodes 1) port-side.east))
           (lower-port-lower-node (add-port-on-side this (aref nodes 1) port-side.east)))
      (add-edge-between-ports this upper-port-upper-node lower-port-lower-node)
      (add-edge-between-ports this lower-port-upper-node upper-port-lower-node)))
  (set-up-ids this)
  (.graph this))

(defjmethod get-fixed-port-order-in-layer-edges-with-crossings ((this layered-test-graph-creator))
  (let* ((layer (make-layer this))
         (nodes (add-nodes-to-layer this 2 layer)))
    (set-fixed-order-constraint this (aref nodes 0))
    (set-fixed-order-constraint this (aref nodes 1))
    (add-in-layer-edge this (aref nodes 0) (aref nodes 1) port-side.east)
    (add-in-layer-edge this (aref nodes 0) (aref nodes 1) port-side.east))
  (set-up-ids this)
  (.graph this))

(defjmethod get-more-complex-in-layer-graph ((this layered-test-graph-creator))
  (let* ((layers (make-layers this 3))
         (left-nodes (add-nodes-to-layer this 4 (aref layers 0)))
         (middle-nodes (add-nodes-to-layer this 3 (aref layers 1)))
         (right-node (add-node-to-layer this (aref layers 2))))
    (set-fixed-order-constraint this (aref middle-nodes 0))
    (set-fixed-order-constraint this (aref middle-nodes 1))
    (east-west-edge-from-to this (aref left-nodes 1) (aref middle-nodes 0))
    (east-west-edge-from-to this (aref left-nodes 3) (aref middle-nodes 1))
    (east-west-edge-from-to this (aref left-nodes 2) (aref middle-nodes 1))
    (add-in-layer-edge this (aref middle-nodes 0) (aref middle-nodes 1) port-side.west)
    (east-west-edge-from-to this (aref left-nodes 0) (aref middle-nodes 0))
    (add-in-layer-edge this (aref middle-nodes 0) (aref middle-nodes 2) port-side.west)
    (add-in-layer-edge this (aref middle-nodes 0) (aref middle-nodes 1) port-side.east)
    (east-west-edge-from-to this (aref middle-nodes 0) right-node))
  (set-up-ids this)
  (.graph this))


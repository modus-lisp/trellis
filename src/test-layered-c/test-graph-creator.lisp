(defjmethod two-edges-into-same-port ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer)))
    (east-west-edge-from-to this top-left bottom-right)
    (let ((bottom-left-first-port (add-port-on-side this bottom-left port-side.east))
          (bottom-left-second-port (add-port-on-side this bottom-left port-side.east))
          (top-right-first-port (add-port-on-side this top-right port-side.west))
          (top-right-second-port (add-port-on-side this top-right port-side.west)))
      (add-edge-between-ports this bottom-left-first-port top-right-first-port)
      (add-edge-between-ports this bottom-left-second-port top-right-second-port)))
  (set-up-ids this)
  (.graph this))

(defjmethod two-edges-into-same-port-crosses-when-switched ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer))
         (top-right-port (add-port-on-side this top-right port-side.west))
         (bottom-left-port (add-port-on-side this bottom-left port-side.east)))
    (add-edge-between-ports this bottom-left-port top-right-port)
    (let ((top-left-port (add-port-on-side this top-left port-side.east)))
      (add-edge-between-ports this top-left-port top-right-port))
    (east-west-edge-from-to this bottom-left bottom-right))
  (set-up-ids this)
  (.graph this))

(defjmethod two-edges-into-same-port-resolves-crossing-when-switched ((this layered-test-graph-creator))
  (let* ((left-layer (make-layer this))
         (right-layer (make-layer this))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer))
         (top-left-port (add-port-on-side this top-left port-side.east))
         (bottom-left-port (add-port-on-side this bottom-left port-side.east))
         (bottom-right-port (add-port-on-side this bottom-right port-side.west)))
    (add-edge-between-ports this top-left-port bottom-right-port)
    (add-edge-between-ports this bottom-left-port bottom-right-port)
    (east-west-edge-from-to this bottom-left top-right))

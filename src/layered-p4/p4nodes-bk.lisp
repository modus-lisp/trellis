;;;; p4nodes-bk.lisp -- org.eclipse.elk.alg.layered.p4nodes.bk
;;;; Brandes & Koepf node placement.

(in-package #:elk)

(defvar *%p4-hierarchy-additions* nil)

(defun %p4-hierarchy-additions ()
  "The shared HIERARCHY_PROCESSING_ADDITIONS of every node placer (created once)."
  (or *%p4-hierarchy-additions*
      (setf *%p4-hierarchy-additions*
            (add-before (layout-processor-configuration.create)
                        layered-phases.p5-edge-routing
                        layered-intermediate-processor-strategy.hierarchical-port-position-processor))))

(defun %p4-layout-processor-configuration (graph)
  (if (contains (get-property graph layered-internal-properties.graph-properties)
                layered-graph-properties.external-ports)
      (%p4-hierarchy-additions)
      nil))

;;; ------------------------------------------------------------ BKAlignedLayout

(defjctor bk-aligned-layout (layered-graph node-count vdir hdir)
  (setf (.layered-graph this) layered-graph)
  (setf (.spacings this) (get-property layered-graph layered-internal-properties.spacings))
  (setf (.root this) (make-array node-count :initial-element nil)
        (.block-size this) (make-array node-count :initial-element nil)
        (.align this) (make-array node-count :initial-element nil)
        (.inner-shift this) (make-array node-count :initial-element nil)
        (.sink this) (make-array node-count :initial-element nil)
        (.shift this) (make-array node-count :initial-element nil)
        (.y this) (make-array node-count :initial-element nil)
        (.su this) (make-array node-count :initial-element nil)
        (.od this) (make-array node-count :initial-element t))
  (setf (.vdir this) vdir
        (.hdir this) hdir))

(defjmethod cleanup ((this bk-aligned-layout))
  (setf (.root this) nil (.block-size this) nil (.align this) nil (.inner-shift this) nil
        (.sink this) nil (.shift this) nil (.y this) nil))

(defjmethod layout-size ((this bk-aligned-layout))
  (let ((min double.positive-infinity)
        (max double.negative-infinity)
        (y (.y this)) (root (.root this)) (bs (.block-size this)))
    (jdo (layer (get-layers (.layered-graph this)))
      (jdo (n (get-nodes layer))
        (let* ((y-min (aref y (.id n)))
               (y-max (+ y-min (aref bs (.id (aref root (.id n)))))))
          (setf min (math.min min y-min)
                max (math.max max y-max)))))
    (- max min)))

(defjmethod calculate-delta ((this bk-aligned-layout) src tgt)
  (let* ((y (.y this)) (is (.inner-shift this))
         (src-pos (+ (aref y (.id (get-node src))) (aref is (.id (get-node src)))
                     (.y (get-position src)) (.y (get-anchor src))))
         (tgt-pos (+ (aref y (.id (get-node tgt))) (aref is (.id (get-node tgt)))
                     (.y (get-position tgt)) (.y (get-anchor tgt)))))
    (- tgt-pos src-pos)))

(defjmethod shift-block ((this bk-aligned-layout) root-node delta)
  (let ((current root-node))
    (loop
      (setf (aref (.y this) (.id current)) (+ (aref (.y this) (.id current)) delta))
      (setf current (aref (.align this) (.id current)))
      (when (eq current root-node) (return)))))

(defjmethod check-space-above ((this bk-aligned-layout) block-root delta ni)
  (let ((available-space delta)
        (root-node block-root)
        (current block-root))
    (loop
      (setf current (aref (.align this) (.id current)))
      (let ((min-y-current (get-min-y this current))
            (neighbor (%bk-upper-neighbor current ni)))
        (when neighbor
          (let ((max-y-neighbor (get-max-y this neighbor)))
            (setf available-space
                  (math.min available-space
                            (- min-y-current
                               (+ max-y-neighbor
                                  (get-vertical-spacing (.spacings this) current neighbor))))))))
      (when (eq root-node current) (return)))
    available-space))

(defjmethod check-space-below ((this bk-aligned-layout) block-root delta ni)
  (let ((available-space delta)
        (root-node block-root)
        (current block-root))
    (loop
      (setf current (aref (.align this) (.id current)))
      (let ((max-y-current (get-max-y this current))
            (neighbor (%bk-lower-neighbor current ni)))
        (when neighbor
          (let ((min-y-neighbor (get-min-y this neighbor)))
            (setf available-space
                  (math.min available-space
                            (- min-y-neighbor
                               (+ max-y-current
                                  (get-vertical-spacing (.spacings this) current neighbor))))))))
      (when (eq root-node current) (return)))
    available-space))

(defjmethod get-min-y ((this bk-aligned-layout) n)
  (let ((root-node (aref (.root this) (.id n))))
    (- (+ (aref (.y this) (.id root-node)) (aref (.inner-shift this) (.id n)))
       (.top (get-margin n)))))

(defjmethod get-max-y ((this bk-aligned-layout) n)
  (let ((root-node (aref (.root this) (.id n))))
    (+ (aref (.y this) (.id root-node)) (aref (.inner-shift this) (.id n))
       (.y (get-size n)) (.bottom (get-margin n)))))

(defun %bk-lower-neighbor (n ni)
  (let* ((nodes (get-nodes (get-layer n)))
         (layer-index (aref (.node-index ni) (.id n))))
    (if (< layer-index (1- (length nodes)))
        (jl-get nodes (1+ layer-index))
        nil)))

(defun %bk-upper-neighbor (n ni)
  (let* ((nodes (get-nodes (get-layer n)))
         (layer-index (aref (.node-index ni) (.id n))))
    (if (> layer-index 0)
        (jl-get nodes (1- layer-index))
        nil)))

(defjmethod to-string ((this bk-aligned-layout))
  (jstr (cond ((eq (.hdir this) h-direction.right) "RIGHT")
              ((eq (.hdir this) h-direction.left) "LEFT")
              (t ""))
        (cond ((eq (.vdir this) v-direction.down) "DOWN")
              ((eq (.vdir this) v-direction.up) "UP")
              (t "BALANCED"))))

;;; ------------------------------------------------------------ ICompactor

(defjgeneric horizontal-compaction 1)

;;; ------------------------------------------------------------ NeighborhoodInformation

(defjmethod cleanup ((this neighborhood-information))
  (setf (.layer-index this) nil (.node-index this) nil)
  (jl-clear (.left-neighbors this))
  (jl-clear (.right-neighbors this))
  (setf (.neighbor-comparator this) nil))

(defjstatic neighborhood-information.build-for (graph)
  (let ((ni (make-instance 'neighborhood-information)))
    (setf (.node-count ni) 0)
    (jdo (layer (get-layers graph))
      (incf (.node-count ni) (length (get-nodes layer))))
    ;; cache indexes of layers and of nodes
    (let ((l-id 0) (l-index 0) (n-id 0) (n-index 0))
      (setf (.layer-index ni) (make-array (length (get-layers graph)) :initial-element 0))
      (setf (.node-index ni) (make-array (.node-count ni) :initial-element 0))
      (jdo (l (get-layers graph))
        (setf (.id l) l-id) (incf l-id)
        (setf (aref (.layer-index ni) (.id l)) l-index) (incf l-index)
        (setf n-index 0)
        (jdo (n (get-nodes l))
          (setf (.id n) n-id) (incf n-id)
          (setf (aref (.node-index ni) (.id n)) n-index) (incf n-index))))
    (setf (.neighbor-comparator ni)
          (let ((node-index (.node-index ni)))
            (lambda (o1 o2)
              (to-int (math.signum (- (aref node-index (.id (get-first o1)))
                                      (aref node-index (.id (get-first o2)))))))))
    (setf (.left-neighbors ni) (new-jlist (max 1 (.node-count ni))))
    (%ni-determine-all-left-neighbors ni graph)
    (setf (.right-neighbors ni) (new-jlist (max 1 (.node-count ni))))
    (%ni-determine-all-right-neighbors ni graph)
    ni))

(defun %ni-determine-all-right-neighbors (ni graph)
  (jdo (l (get-layers graph))
    (jdo (n (get-nodes l))
      (let ((result (new-jlist)) (max-priority 0))
        (jdo (edge (get-outgoing-edges n))
          (unless (or (is-self-loop edge) (is-in-layer-edge edge))
            (let ((edge-prio (get-property edge layered-options.priority-straightness)))
              (when (> edge-prio max-priority)
                (setf max-priority edge-prio)
                (jl-clear result))
              (when (= edge-prio max-priority)
                (jl-add result (pair.of (get-node (get-target edge)) edge))))))
        (jl-sort result (.neighbor-comparator ni))
        (jl-add-at (.right-neighbors ni) (.id n) result)))))

(defun %ni-determine-all-left-neighbors (ni graph)
  (jdo (l (get-layers graph))
    (jdo (n (get-nodes l))
      (let ((result (new-jlist)) (max-priority 0))
        (jdo (edge (get-incoming-edges n))
          (unless (or (is-self-loop edge) (is-in-layer-edge edge))
            (let ((edge-prio (get-property edge layered-options.priority-straightness)))
              (when (> edge-prio max-priority)
                (setf max-priority edge-prio)
                (jl-clear result))
              (when (= edge-prio max-priority)
                (jl-add result (pair.of (get-node (get-source edge)) edge))))))
        (jl-sort result (.neighbor-comparator ni))
        (jl-add-at (.left-neighbors ni) (.id n) result)))))

;;; ------------------------------------------------------------ BKAligner

(defjctor bk-aligner (layered-graph ni)
  (setf (.layered-graph this) layered-graph
        (.ni this) ni))

(defjmethod vertical-alignment ((this bk-aligner) bal marked-edges)
  (let ((ni (.ni this))
        (root (.root bal)) (align (.align bal)) (od (.od bal)))
    (jdo (layer (get-layers (.layered-graph this)))
      (jdo (v (get-nodes layer))
        (setf (aref root (.id v)) v
              (aref align (.id v)) v
              (aref (.inner-shift bal) (.id v)) 0d0)))
    (let ((layers (get-layers (.layered-graph this))))
      (when (eq (.hdir bal) h-direction.left)
        (setf layers (reverse layers)))
      (jdo (layer layers)
        (let ((r -1)
              (nodes (get-nodes layer)))
          (when (eq (.vdir bal) v-direction.up)
            (setf r integer.max-value
                  nodes (reverse nodes)))
          (jdo (v-i-k nodes)
            (let ((neighbors (if (eq (.hdir bal) h-direction.left)
                                 (jl-get (.right-neighbors ni) (.id v-i-k))
                                 (jl-get (.left-neighbors ni) (.id v-i-k)))))
              (when (> (length neighbors) 0)
                (let* ((d (length neighbors))
                       (low (1- (to-int (math.floor (/ (+ d 1d0) 2d0)))))
                       (high (1- (to-int (math.ceil (/ (+ d 1d0) 2d0))))))
                  (flet ((try (m test)
                           (when (eq (aref align (.id v-i-k)) v-i-k)
                             (let* ((u-m-pair (jl-get neighbors m))
                                    (u-m (get-first u-m-pair)))
                               (when (and (not (contains marked-edges (get-second u-m-pair)))
                                          (funcall test r (aref (.node-index ni) (.id u-m))))
                                 (setf (aref align (.id u-m)) v-i-k)
                                 (setf (aref root (.id v-i-k)) (aref root (.id u-m)))
                                 (setf (aref align (.id v-i-k)) (aref root (.id v-i-k)))
                                 (let ((rid (.id (aref root (.id v-i-k)))))
                                   (setf (aref od rid)
                                         (and (aref od rid)
                                              (eq (get-type v-i-k) node-type.long-edge))))
                                 (setf r (aref (.node-index ni) (.id u-m))))))))
                    (if (eq (.vdir bal) v-direction.up)
                        (loop for m from high downto low do (try m #'>))
                        (loop for m from low to high do (try m #'<)))))))))))))

(defjmethod inside-block-shift ((this bk-aligner) bal)
  (let ((blocks (bk-node-placer.get-blocks bal))
        (is (.inner-shift bal)) (align (.align bal)))
    (jdo-map (root contents blocks)
      contents
      (let ((space-above (.top (get-margin root)))
            (space-below (+ (.y (get-size root)) (.bottom (get-margin root)))))
        (setf (aref is (.id root)) 0d0)
        (let ((current root) next)
          (loop
            (setf next (aref align (.id current)))
            (when (eq next root) (return))
            (let* ((edge (bk-node-placer.get-edge current next))
                   (port-pos-diff
                     (if (eq (.hdir bal) h-direction.left)
                         (- (+ (.y (get-position (get-target edge))) (.y (get-anchor (get-target edge))))
                            (.y (get-position (get-source edge))) (.y (get-anchor (get-source edge))))
                         (- (+ (.y (get-position (get-source edge))) (.y (get-anchor (get-source edge))))
                            (.y (get-position (get-target edge))) (.y (get-anchor (get-target edge))))))
                   (next-inner-shift (+ (aref is (.id current)) port-pos-diff)))
              (setf (aref is (.id next)) next-inner-shift)
              (setf space-above (math.max space-above (- (.top (get-margin next)) next-inner-shift)))
              (setf space-below (math.max space-below (+ next-inner-shift (.y (get-size next))
                                                         (.bottom (get-margin next)))))
              (setf current next)))
          (setf current root)
          (loop
            (setf (aref is (.id current)) (+ (aref is (.id current)) space-above))
            (setf current (aref align (.id current)))
            (when (eq current root) (return))))
        (setf (aref (.block-size bal) (.id root)) (+ space-above space-below))))))

;;; ------------------------------------------------------------ BKCompactor

(defjctor bk-compactor (layered-graph ni)
  (setf (.layered-graph this) layered-graph
        (.ni this) ni
        (.spacings this) (get-property layered-graph layered-internal-properties.spacings))
  (if (eq (get-property layered-graph layered-options.node-placement-bk-edge-straightening)
          edge-straightening-strategy.improve-straightness)
      (setf (.thresh-strategy this) (new-simple-threshold-strategy))
      (setf (.thresh-strategy this) (new-null-threshold-strategy))))

(defjmethod horizontal-compaction ((this bk-compactor) bal)
  (jdo (layer (get-layers (.layered-graph this)))
    (jdo (node (get-nodes layer))
      (setf (aref (.sink bal) (.id node)) node)
      (setf (aref (.shift bal) (.id node))
            (if (eq (.vdir bal) v-direction.up) double.negative-infinity double.positive-infinity))))
  (clrhash (.sink-nodes this))
  (let ((layers (get-layers (.layered-graph this))))
    (when (eq (.hdir bal) h-direction.left)
      (setf layers (reverse layers)))
    (init (.thresh-strategy this) bal (.ni this))
    (fill (.y bal) nil)
    (jdo (layer layers)
      (let ((nodes (get-nodes layer)))
        (when (eq (.vdir bal) v-direction.up)
          (setf nodes (reverse nodes)))
        (jdo (v nodes)
          (when (eq (aref (.root bal) (.id v)) v)
            (%bk-place-block this v bal)))))
    (%bk-place-classes this bal)
    (jdo (layer layers)
      (jdo (v (get-nodes layer))
        (setf (aref (.y bal) (.id v)) (aref (.y bal) (.id (aref (.root bal) (.id v)))))
        (when (eq v (aref (.root bal) (.id v)))
          (let ((sink-shift (aref (.shift bal) (.id (aref (.sink bal) (.id v))))))
            (when (or (and (eq (.vdir bal) v-direction.up) (> sink-shift double.negative-infinity))
                      (and (eq (.vdir bal) v-direction.down) (< sink-shift double.positive-infinity)))
              (setf (aref (.y bal) (.id v)) (+ (aref (.y bal) (.id v)) sink-shift)))))))
    (post-process (.thresh-strategy this))))

(defun %bk-place-block (this root bal)
  (let ((ni (.ni this)) (y (.y bal)) (is (.inner-shift bal)) (sink (.sink bal)))
    (when (aref y (.id root))
      (return-from %bk-place-block))
    (let ((is-initial-assignment t)
          (current-node root)
          (thresh (if (eq (.vdir bal) v-direction.down) double.negative-infinity double.positive-infinity)))
      (setf (aref y (.id root)) 0d0)
      (loop
        (let ((current-index-in-layer (aref (.node-index ni) (.id current-node)))
              (current-layer-size (length (get-nodes (get-layer current-node)))))
          (if (or (and (eq (.vdir bal) v-direction.down) (> current-index-in-layer 0))
                  (and (eq (.vdir bal) v-direction.up) (< current-index-in-layer (1- current-layer-size))))
              (let* ((neighbor (if (eq (.vdir bal) v-direction.up)
                                   (jl-get (get-nodes (get-layer current-node)) (1+ current-index-in-layer))
                                   (jl-get (get-nodes (get-layer current-node)) (1- current-index-in-layer))))
                     (neighbor-root (aref (.root bal) (.id neighbor))))
                (%bk-place-block this neighbor-root bal)
                (setf thresh (calculate-threshold (.thresh-strategy this) thresh root current-node))
                (when (eq (aref sink (.id root)) root)
                  (setf (aref sink (.id root)) (aref sink (.id neighbor-root))))
                (if (eq (aref sink (.id root)) (aref sink (.id neighbor-root)))
                    (let ((spacing (get-vertical-spacing (.spacings this) current-node neighbor)))
                      (if (eq (.vdir bal) v-direction.up)
                          (let ((current-block-position (aref y (.id root)))
                                (new-position (- (+ (aref y (.id neighbor-root)) (aref is (.id neighbor)))
                                                 (.top (get-margin neighbor))
                                                 spacing
                                                 (.bottom (get-margin current-node))
                                                 (.y (get-size current-node))
                                                 (aref is (.id current-node)))))
                            (if is-initial-assignment
                                (setf is-initial-assignment nil
                                      (aref y (.id root)) (math.min new-position thresh))
                                (setf (aref y (.id root))
                                      (math.min current-block-position (math.min new-position thresh)))))
                          (let ((current-block-position (aref y (.id root)))
                                (new-position (- (+ (aref y (.id neighbor-root)) (aref is (.id neighbor))
                                                    (.y (get-size neighbor))
                                                    (.bottom (get-margin neighbor))
                                                    spacing
                                                    (.top (get-margin current-node)))
                                                 (aref is (.id current-node)))))
                            (if is-initial-assignment
                                (setf is-initial-assignment nil
                                      (aref y (.id root)) (math.max new-position thresh))
                                (setf (aref y (.id root))
                                      (math.max current-block-position (math.max new-position thresh)))))))
                    ;; CLASSES
                    (let* ((spacing (jd (get-property (.layered-graph this) layered-options.spacing-node-node)))
                           (sink-node (%bk-get-or-create-class-node this (aref sink (.id root))))
                           (neighbor-sink (%bk-get-or-create-class-node this (aref sink (.id neighbor-root)))))
                      (if (eq (.vdir bal) v-direction.up)
                          (let ((required-space
                                  (- (+ (aref y (.id root)) (aref is (.id current-node))
                                        (.y (get-size current-node)) (.bottom (get-margin current-node))
                                        spacing)
                                     (- (+ (aref y (.id neighbor-root)) (aref is (.id neighbor)))
                                        (.top (get-margin neighbor))))))
                            (%class-node-add-edge sink-node neighbor-sink required-space))
                          (let ((required-space
                                  (- (+ (aref y (.id root)) (aref is (.id current-node)))
                                     (.top (get-margin current-node))
                                     (aref y (.id neighbor-root))
                                     (aref is (.id neighbor))
                                     (.y (get-size neighbor))
                                     (.bottom (get-margin neighbor))
                                     spacing)))
                            (%class-node-add-edge sink-node neighbor-sink required-space))))))
              (setf thresh (calculate-threshold (.thresh-strategy this) thresh root current-node)))
          (setf current-node (aref (.align bal) (.id current-node)))
          (when (eq current-node root) (return))))
      (finish-block (.thresh-strategy this) root))))

(defun %bk-place-classes (this bal)
  (let ((sinks (new-jlist)))
    (jdo-map (k n (.sink-nodes this))
      k
      (when (= (.indegree n) 0) (jl-add sinks n)))
    (loop until (jl-is-empty sinks)
          do (let ((n (jl-poll-first sinks)))
               (when (null (.class-shift n))
                 (setf (.class-shift n) 0d0))
               (jdo (e (.outgoing n))
                 (let ((tgt (.target e)))
                   (cond ((null (.class-shift tgt))
                          (setf (.class-shift tgt) (+ (.class-shift n) (.separation e))))
                         ((eq (.vdir bal) v-direction.down)
                          (setf (.class-shift tgt) (math.min (.class-shift tgt) (+ (.class-shift n) (.separation e)))))
                         (t
                          (setf (.class-shift tgt) (math.max (.class-shift tgt) (+ (.class-shift n) (.separation e))))))
                   (decf (.indegree tgt))
                   (when (= (.indegree tgt) 0)
                     (jl-add sinks tgt))))))
    (jdo-map (k n (.sink-nodes this))
      k
      (setf (aref (.shift bal) (.id (.node n))) (.class-shift n)))))

(defun %bk-get-or-create-class-node (this sink-node)
  (let ((node (jm-get (.sink-nodes this) sink-node)))
    (unless node
      (setf node (new-class-node))
      (setf (.node node) sink-node)
      (jm-put (.sink-nodes this) (.node node) node))
    node))

(defun %class-node-add-edge (this target separation)
  (let ((se (new-class-edge)))
    (setf (.target se) target
          (.separation se) separation)
    (incf (.indegree target))
    (jl-add (.outgoing this) se)))

;;; ------------------------------------------------------------ ThresholdStrategy

(defjconst threshold-strategy.threshold double.max-value)
(defjconst threshold-strategy.epsilon 0.0001d0)

(defjmethod init ((this threshold-strategy) the-bal the-ni)
  (setf (.bal this) the-bal
        (.ni this) the-ni)
  (js-clear (.block-finished this))
  (jl-clear (.post-processables-queue this))
  (jl-clear (.post-processables-stack this)))

(defjmethod finish-block ((this threshold-strategy) n)
  (js-add (.block-finished this) n))

(defjgeneric calculate-threshold 3)
(defjgeneric post-process 0)

(defjmethod get-other ((this threshold-strategy) edge n)
  (cond ((eq (get-node (get-source edge)) n) (get-node (get-target edge)))
        ((eq (get-node (get-target edge)) n) (get-node (get-source edge)))
        (t (jthrow 'illegal-argument-exception "Node ~A is neither source nor target of edge ~A" n edge))))

;; NullThresholdStrategy

(defjmethod calculate-threshold ((this null-threshold-strategy) old-thresh block-root current-node)
  (declare (ignore old-thresh block-root current-node))
  (if (eq (.vdir (.bal this)) v-direction.up)
      double.positive-infinity
      double.negative-infinity))

(defjmethod post-process ((this null-threshold-strategy))
  nil)

;; SimpleThresholdStrategy

(defjmethod calculate-threshold ((this simple-threshold-strategy) old-thresh block-root current-node)
  (let* ((bal (.bal this))
         (is-root (eq block-root current-node))
         (is-last (eq (aref (.align bal) (.id current-node)) block-root)))
    (if (not (or is-root is-last))
        old-thresh
        (let ((tt old-thresh))
          ;; RIGHT and LEFT branches are identical in ELK
          (when is-root
            (setf tt (%sts-get-bound this block-root t)))
          (when (and (infinite-p tt) is-last)
            (setf tt (%sts-get-bound this current-node nil)))
          tt))))

(defun %sts-pick-edge (this pp)
  (let* ((bal (.bal this))
         (edges (if (.is-root pp)
                    (if (eq (.hdir bal) h-direction.right)
                        (get-incoming-edges (.free pp)) (get-outgoing-edges (.free pp)))
                    (if (eq (.hdir bal) h-direction.left)
                        (get-incoming-edges (.free pp)) (get-outgoing-edges (.free pp)))))
         (has-edges nil))
    (jdo (e edges)
      (let ((only-dummies (aref (.od bal) (.id (aref (.root bal) (.id (.free pp)))))))
        (unless (or (and (not only-dummies) (is-in-layer-edge e))
                    (aref (.su bal) (.id (aref (.root bal) (.id (.free pp))))))
          (setf has-edges t)
          (when (js-contains (.block-finished this)
                             (aref (.root bal) (.id (get-other this e (.free pp)))))
            (setf (.has-edges pp) t
                  (.edge pp) e)
            (return-from %sts-pick-edge pp)))))
    (setf (.has-edges pp) has-edges
          (.edge pp) nil)
    pp))

(defun %sts-get-bound (this block-node is-root)
  (let* ((bal (.bal this))
         (invalid (if (eq (.vdir bal) v-direction.up) double.positive-infinity double.negative-infinity))
         (pick (%sts-pick-edge this (new-postprocessable block-node is-root))))
    (cond
      ((and (null (.edge pick)) (.has-edges pick))
       (jl-add (.post-processables-queue this) pick)
       invalid)
      ((.edge pick)
       (let* ((left (get-source (.edge pick)))
              (right (get-target (.edge pick)))
              (y (.y bal)) (is (.inner-shift bal)) (root (.root bal))
              (threshold
                (if is-root
                    (let* ((root-port (if (eq (.hdir bal) h-direction.right) right left))
                           (other-port (if (eq (.hdir bal) h-direction.right) left right))
                           (other-root (aref root (.id (get-node other-port)))))
                      (- (+ (aref y (.id other-root))
                            (aref is (.id (get-node other-port)))
                            (.y (get-position other-port))
                            (.y (get-anchor other-port)))
                         (aref is (.id (get-node root-port)))
                         (.y (get-position root-port))
                         (.y (get-anchor root-port))))
                    (let* ((root-port (if (eq (.hdir bal) h-direction.left) right left))
                           (other-port (if (eq (.hdir bal) h-direction.left) left right)))
                      (- (+ (aref y (.id (aref root (.id (get-node other-port)))))
                            (aref is (.id (get-node other-port)))
                            (.y (get-position other-port))
                            (.y (get-anchor other-port)))
                         (aref is (.id (get-node root-port)))
                         (.y (get-position root-port))
                         (.y (get-anchor root-port)))))))
         (setf (aref (.su bal) (.id (aref root (.id (get-node left))))) t)
         (setf (aref (.su bal) (.id (aref root (.id (get-node right))))) t)
         threshold))
      (t invalid))))

(defjmethod post-process ((this simple-threshold-strategy))
  (let ((bal (.bal this))
        (queue (.post-processables-queue this))
        (stack (.post-processables-stack this)))
    (loop until (jl-is-empty queue)
          do (let* ((pp (jl-poll-first queue))
                    (pick (%sts-pick-edge this pp)))
               (when (.edge pick)
                 (let ((edge (.edge pick))
                       (only-dummies (aref (.od bal) (.id (aref (.root bal) (.id (.free pp)))))))
                   (unless (and (not only-dummies) (is-in-layer-edge edge))
                     (unless (%sts-process this pp)
                       (jl-add stack pp)))))))
    (loop until (jl-is-empty stack)
          do (%sts-process this (jl-remove-last stack)))))

(defun %sts-process (this pp)
  (let* ((bal (.bal this))
         (edge (.edge pp))
         (fix (if (eq (get-node (get-source edge)) (.free pp)) (get-target edge) (get-source edge)))
         (block (if (eq (get-node (get-source edge)) (.free pp)) (get-source edge) (get-target edge)))
         (delta (calculate-delta bal fix block)))
    (cond
      ((and (> delta 0) (< delta threshold-strategy.threshold))
       (let ((available-space (check-space-above bal (get-node block) delta (.ni this))))
         (shift-block bal (get-node block) (- available-space))
         (> available-space 0)))
      ((and (< delta 0) (< (- delta) threshold-strategy.threshold))
       (let ((available-space (check-space-below bal (get-node block) (- delta) (.ni this))))
         (shift-block bal (get-node block) available-space)
         (> available-space 0)))
      (t nil))))

(defjctor postprocessable (free is-root)
  (setf (.free this) free
        (.is-root this) is-root))

;;; ------------------------------------------------------------ BKNodePlacer

(defjconst bk-node-placer.min-layers-for-conflicts 3)

(defjmethod get-layout-processor-configuration ((this bk-node-placer) graph)
  (%p4-layout-processor-configuration graph))

(defjmethod process ((this bk-node-placer) layered-graph monitor)
  (begin monitor "Brandes & Koepf node placement" 1)
  (setf (.l-graph this) layered-graph)
  (setf (.ni this) (neighborhood-information.build-for layered-graph))
  (let* ((ni (.ni this))
         (align (get-property layered-graph layered-options.node-placement-bk-fixed-alignment))
         (favor-straight-edges (get-property layered-graph layered-options.node-placement-favor-straight-edges))
         (layouts (new-jlist 4)))
    (setf (.produce-balanced-layout this)
          (or (and (eq align fixed-alignment.none) (not favor-straight-edges))
              (eq align fixed-alignment.balanced)))
    (%bk-mark-conflicts this layered-graph)
    (flet ((mk (v h) (new-bk-aligned-layout layered-graph (.node-count ni) v h)))
      (enum-case (get-property layered-graph layered-options.node-placement-bk-fixed-alignment)
        (fixed-alignment.leftdown (jl-add layouts (mk v-direction.down h-direction.left)))
        (fixed-alignment.leftup (jl-add layouts (mk v-direction.up h-direction.left)))
        (fixed-alignment.rightdown (jl-add layouts (mk v-direction.down h-direction.right)))
        (fixed-alignment.rightup (jl-add layouts (mk v-direction.up h-direction.right)))
        (t (let ((leftdown (mk v-direction.down h-direction.left))
                 (leftup (mk v-direction.up h-direction.left))
                 (rightdown (mk v-direction.down h-direction.right))
                 (rightup (mk v-direction.up h-direction.right)))
             (jl-add layouts rightdown)
             (jl-add layouts rightup)
             (jl-add layouts leftdown)
             (jl-add layouts leftup)))))
    (let ((aligner (new-bk-aligner layered-graph ni)))
      (jdo (bal layouts)
        (vertical-alignment aligner bal (.marked-edges this))
        (inside-block-shift aligner bal)))
    (let ((compacter (new-bk-compactor layered-graph ni)))
      (jdo (bal layouts)
        (horizontal-compaction compacter bal)))
    (let ((chosen-layout nil))
      (when (.produce-balanced-layout this)
        (let ((balanced (%bk-create-balanced-layout this layouts (.node-count ni))))
          (when (%bk-check-order-constraint layered-graph balanced)
            (setf chosen-layout balanced))))
      (when (null chosen-layout)
        (jdo (bal layouts)
          (when (%bk-check-order-constraint layered-graph bal)
            (when (or (null chosen-layout) (> (layout-size chosen-layout) (layout-size bal)))
              (setf chosen-layout bal)))))
      (when (null chosen-layout)
        (setf chosen-layout (jl-get layouts 0)))
      (jdo (layer (get-layers layered-graph))
        (jdo (node (get-nodes layer))
          (setf (.y (get-position node))
                (+ (aref (.y chosen-layout) (.id node)) (aref (.inner-shift chosen-layout) (.id node))))))
      (jdo (bal layouts) (cleanup bal))
      (cleanup ni)
      (js-clear (.marked-edges this))
      (done monitor))))

(defun %bk-mark-conflicts (this layered-graph)
  (let* ((ni (.ni this))
         (layers (get-layers layered-graph))
         (number-of-layers (length layers)))
    (when (< number-of-layers bk-node-placer.min-layers-for-conflicts)
      (return-from %bk-mark-conflicts))
    (let ((layer-size (make-array number-of-layers :initial-element 0)))
      (loop for layer across layers for i from 0
            do (setf (aref layer-size i) (length (get-nodes layer))))
      ;; Java's iterator starts at layer 2: in iteration i the current layer is layer i + 1
      (loop for i from 1 below (1- number-of-layers)
            do (let* ((current-layer (jl-get layers (1+ i)))
                      (nodes (get-nodes current-layer))
                      (k-0 0) (l 0))
                 (loop for l-1 from 0 below (aref layer-size (1+ i))
                       do (let ((v-l-i (jl-get nodes l-1)))
                            (when (or (= l-1 (1- (aref layer-size (1+ i))))
                                      (%bk-incident-to-inner-segment this v-l-i (1+ i) i))
                              (let ((k-1 (1- (aref layer-size i))))
                                (when (%bk-incident-to-inner-segment this v-l-i (1+ i) i)
                                  (setf k-1 (aref (.node-index ni)
                                                  (.id (get-first (jl-get (jl-get (.left-neighbors ni) (.id v-l-i)) 0))))))
                                (loop while (<= l l-1)
                                      do (let ((v-l (jl-get nodes l)))
                                           (unless (%bk-incident-to-inner-segment this v-l (1+ i) i)
                                             (jdo (upper-neighbor (jl-get (.left-neighbors ni) (.id v-l)))
                                               (let ((k (aref (.node-index ni) (.id (get-first upper-neighbor)))))
                                                 (when (or (< k k-0) (> k k-1))
                                                   (js-add (.marked-edges this) (get-second upper-neighbor))))))
                                           (incf l)))
                                (setf k-0 k-1))))))))))

(defun %bk-create-balanced-layout (this layouts node-count)
  (let* ((no-of-layouts (length layouts))
         (lgraph (.l-graph this))
         (balanced (new-bk-aligned-layout lgraph node-count nil nil))
         (width (make-array no-of-layouts :initial-element 0d0))
         (min (make-array no-of-layouts :initial-element 0d0))
         (max (make-array no-of-layouts :initial-element 0d0))
         (min-width-layout 0))
    (dotimes (i no-of-layouts)
      (setf (aref min i) (jd integer.max-value)
            (aref max i) (jd integer.min-value)))
    (dotimes (i no-of-layouts)
      (let ((bal (jl-get layouts i)))
        (setf (aref width i) (layout-size bal))
        (when (> (aref width min-width-layout) (aref width i))
          (setf min-width-layout i))
        (jdo (l (get-layers lgraph))
          (jdo (n (get-nodes l))
            (let ((node-pos-y (+ (aref (.y bal) (.id n)) (aref (.inner-shift bal) (.id n)))))
              (setf (aref min i) (math.min (aref min i) node-pos-y))
              (setf (aref max i) (math.max (aref max i) (+ node-pos-y (.y (get-size n))))))))))
    (let ((shift (make-array no-of-layouts :initial-element 0d0)))
      (dotimes (i no-of-layouts)
        (if (eq (.vdir (jl-get layouts i)) v-direction.down)
            (setf (aref shift i) (- (aref min min-width-layout) (aref min i)))
            (setf (aref shift i) (- (aref max min-width-layout) (aref max i)))))
      (let ((calculated-ys (make-array no-of-layouts :initial-element 0d0)))
        (jdo (layer (get-layers lgraph))
          (jdo (node (get-nodes layer))
            (dotimes (i no-of-layouts)
              (let ((bal (jl-get layouts i)))
                (setf (aref calculated-ys i)
                      (+ (aref (.y bal) (.id node)) (aref (.inner-shift bal) (.id node)) (aref shift i)))))
            (setf calculated-ys (sort calculated-ys #'<))
            (setf (aref (.y balanced) (.id node))
                  (/ (+ (aref calculated-ys 1) (aref calculated-ys 2)) 2d0))
            (setf (aref (.inner-shift balanced) (.id node)) 0d0)))))
    balanced))

(defun %bk-incident-to-inner-segment (this node layer1 layer2)
  (let ((ni (.ni this)))
    (when (eq (get-type node) node-type.long-edge)
      (jdo (edge (get-incoming-edges node))
        (let ((source-node (get-node (get-source edge))))
          (when (and (eq (get-type source-node) node-type.long-edge)
                     (= (aref (.layer-index ni) (.id (get-layer source-node))) layer2)
                     (= (aref (.layer-index ni) (.id (get-layer node))) layer1))
            (return-from %bk-incident-to-inner-segment t)))))
    nil))

(defjstatic bk-node-placer.get-edge (source target)
  (jdo (edge (get-connected-edges source))
    (when (or (eq (get-node (get-target edge)) target)
              (eq (get-node (get-source edge)) target))
      (return-from bk-node-placer.get-edge/2 edge)))
  nil)

(defjstatic bk-node-placer.get-blocks (bal)
  ;; LinkedHashMap: CL hash tables iterate in insertion order in SBCL as long as
  ;; nothing is removed, which is the case here.
  (let ((blocks (new-jmap)))
    (jdo (layer (get-layers (.layered-graph bal)))
      (jdo (node (get-nodes layer))
        (let* ((root (aref (.root bal) (.id node)))
               (contents (jm-get blocks root)))
          (unless contents
            (setf contents (new-jlist))
            (jm-put blocks root contents))
          (jl-add contents node))))
    blocks))

(defjstatic bk-node-placer.get-classes (bal monitor)
  (declare (ignore monitor))
  (let ((classes (new-jmap))
        (roots (new-jlist)))
    (loop for r across (.root bal) unless (find r roots) do (jl-add roots r))
    (jdo (root roots)
      (when (null root) (return))
      (let* ((sink (aref (.sink bal) (.id root)))
             (contents (jm-get classes sink)))
        (unless contents
          (setf contents (new-jlist))
          (jm-put classes sink contents))
        (jl-add contents root)))
    classes))

(defun %bk-check-order-constraint (layered-graph bal)
  (let ((feasible t))
    (jdo (layer (get-layers layered-graph))
      (let ((pos double.negative-infinity))
        (jdo (node (get-nodes layer))
          (let* ((base (+ (aref (.y bal) (.id node)) (aref (.inner-shift bal) (.id node))))
                 (top (- base (.top (get-margin node))))
                 (bottom (+ base (.y (get-size node)) (.bottom (get-margin node)))))
            (if (and (> top pos) (> bottom pos))
                (setf pos (+ base (.y (get-size node)) (.bottom (get-margin node))))
                (progn (setf feasible nil) (return))))))
      (unless feasible (return)))
    feasible))

;;;; p4nodes.lisp -- org.eclipse.elk.alg.layered.p4nodes
;;;; SimpleNodePlacer, InteractiveNodePlacer, LinearSegmentsNodePlacer, NetworkSimplexPlacer.

(in-package #:elk)

;;; ------------------------------------------------------------ SimpleNodePlacer

(defjmethod get-layout-processor-configuration ((this simple-node-placer) graph)
  (%p4-layout-processor-configuration graph))

(defjmethod process ((this simple-node-placer) layered-graph monitor)
  (begin monitor "Simple node placement" 1)
  (let ((spacings (get-property layered-graph layered-internal-properties.spacings))
        (max-height 0d0))
    ;; first iteration: determine the height of each layer
    (jdo (layer (get-layers layered-graph))
      (let ((layer-size (get-size layer))
            (last-node nil))
        (setf (.y layer-size) 0d0)
        (jdo (node (get-nodes layer))
          (when last-node
            (incf (.y layer-size) (get-vertical-spacing spacings node last-node)))
          (incf (.y layer-size) (+ (.top (get-margin node)) (.y (get-size node)) (.bottom (get-margin node))))
          (setf last-node node))
        (setf max-height (math.max max-height (.y layer-size)))))
    ;; second iteration: center the nodes of each layer around the tallest layer
    (jdo (layer (get-layers layered-graph))
      (let* ((layer-size (get-size layer))
             (pos (/ (- max-height (.y layer-size)) 2))
             (last-node nil))
        (jdo (node (get-nodes layer))
          (when last-node
            (incf pos (get-vertical-spacing spacings node last-node)))
          (incf pos (.top (get-margin node)))
          (setf (.y (get-position node)) pos)
          (incf pos (+ (.y (get-size node)) (.bottom (get-margin node))))
          (setf last-node node)))))
  (done monitor))

;;; ------------------------------------------------------------ InteractiveNodePlacer

(defjmethod get-layout-processor-configuration ((this interactive-node-placer) graph)
  (%p4-layout-processor-configuration graph))

(defjmethod process ((this interactive-node-placer) layered-graph monitor)
  (begin monitor "Interactive node placement" 1)
  (setf (.spacings this) (get-property layered-graph layered-internal-properties.spacings))
  (jdo (layer (get-layers layered-graph))
    (%inp-place-nodes this layer))
  (done monitor))

(defun %inp-place-nodes (this layer)
  (let ((min-valid-y double.negative-infinity)
        (prev-node-type node-type.normal)
        (spacings (.spacings this)))
    (jdo (node (get-nodes layer))
      (let ((node-type (get-type node)))
        (unless (eq node-type node-type.normal)
          (let ((original-y (get-property node layered-internal-properties.original-dummy-node-position)))
            (if (null original-y)
                (progn
                  (setf min-valid-y (math.max min-valid-y 0d0))
                  (setf (.y (get-position node))
                        (+ min-valid-y (get-vertical-spacing spacings node-type prev-node-type))))
                (setf (.y (get-position node)) original-y))))
        (let ((spacing (get-vertical-spacing spacings node-type prev-node-type)))
          (when (< (.y (get-position node)) (+ min-valid-y spacing (.top (get-margin node))))
            (setf (.y (get-position node)) (+ min-valid-y spacing (.top (get-margin node))))))
        (setf min-valid-y (+ (.y (get-position node)) (.y (get-size node)) (.bottom (get-margin node))))
        (setf prev-node-type node-type)))))

;;; ------------------------------------------------------------ LinearSegmentsNodePlacer

;; LinearSegment

(defjmethod region ((this linear-segment))
  (let ((seg this))
    (loop while (.ref-segment seg) do (setf seg (.ref-segment seg)))
    seg))

(defjmethod split ((this linear-segment) node new-id)
  (let* ((nodes (.nodes this))
         (node-index (jl-index-of nodes node))
         (new-segment (new-linear-segment)))
    (setf (.id new-segment) new-id)
    (loop while (< node-index (length nodes))
          do (let ((moved-node (jl-remove-at nodes node-index)))
               (setf (.id moved-node) new-id)
               (jl-add (.nodes new-segment) moved-node)))
    new-segment))

(defjmethod to-string ((this linear-segment))
  (format nil "ls~A" (coerce (.nodes this) 'list)))

(defjmethod compare-to ((this linear-segment) other)
  (- (.id this) (.id other)))

(defjmethod equals ((this linear-segment) object)
  (and (typep object 'linear-segment) (= (.id this) (.id object))))

(defjmethod hash-code ((this linear-segment)) (.id this))

;; the placer

(defproperty linear-segments-node-placer.input-prio "linearSegments.inputPrio" 0)
(defproperty linear-segments-node-placer.output-prio "linearSegments.outputPrio" 0)

(defjconst linear-segments-node-placer.threshold-factor 20.0d0)
(defjconst linear-segments-node-placer.pendulum-iters 4)
(defjconst linear-segments-node-placer.final-iters 3)
(defjconst linear-segments-node-placer.overlap-detect 0.0001d0)

(defjmethod get-layout-processor-configuration ((this linear-segments-node-placer) graph)
  (%p4-layout-processor-configuration graph))

(defjmethod process ((this linear-segments-node-placer) layered-graph monitor)
  (begin monitor "Linear segments node placement" 1)
  (setf (.spacings this) (get-property layered-graph layered-internal-properties.spacings))
  (%lsp-sort-linear-segments this layered-graph monitor)
  (%lsp-create-unbalanced-placement this layered-graph)
  (%lsp-balance-placement this layered-graph)
  (%lsp-post-process this layered-graph)
  (setf (.linear-segments this) nil
        (.spacings this) nil)
  (done monitor))

(defun %lsp-sort-linear-segments (this layered-graph monitor)
  (let ((segment-list (new-jlist)))
    (jdo (layer (get-layers layered-graph))
      (jdo (node (get-nodes layer))
        (setf (.id node) -1)
        (let ((inprio integer.min-value) (outprio integer.min-value))
          (jdo (port (get-ports node))
            (jdo (edge (get-incoming-edges port))
              (setf inprio (max inprio (get-property edge layered-options.priority-straightness))))
            (jdo (edge (get-outgoing-edges port))
              (setf outprio (max outprio (get-property edge layered-options.priority-straightness)))))
          (set-property node linear-segments-node-placer.input-prio inprio)
          (set-property node linear-segments-node-placer.output-prio outprio))))
    (let ((next-id 0))
      (jdo (layer (get-layers layered-graph))
        (jdo (node (get-nodes layer))
          (when (< (.id node) 0)
            (let ((segment (new-linear-segment)))
              (setf (.id segment) next-id) (incf next-id)
              (%lsp-fill-segment node segment)
              (jl-add segment-list segment))))))
    (let ((outgoing-list (new-jlist))
          (incoming-count-list (new-jlist)))
      (dotimes (i (length segment-list))
        (jl-add outgoing-list (new-jlist))
        (jl-add incoming-count-list 0))
      (%lsp-create-dependency-graph-edges this monitor layered-graph segment-list outgoing-list incoming-count-list)
      (let* ((segments (coerce segment-list 'simple-vector))
             (outgoing (coerce outgoing-list 'simple-vector))
             (incoming-count (coerce incoming-count-list 'simple-vector))
             (next-rank 0)
             (no-incoming (new-jlist))
             (new-ranks (make-array (length segments) :initial-element 0)))
        (dotimes (i (length segments))
          (when (= (aref incoming-count i) 0)
            (jl-add no-incoming (aref segments i))))
        (loop until (jl-is-empty no-incoming)
              do (let ((segment (jl-remove-at no-incoming 0)))
                   (setf (aref new-ranks (.id segment)) next-rank) (incf next-rank)
                   (loop until (jl-is-empty (aref outgoing (.id segment)))
                         do (let ((target (jl-remove-at (aref outgoing (.id segment)) 0)))
                              (decf (aref incoming-count (.id target)))
                              (when (= (aref incoming-count (.id target)) 0)
                                (jl-add no-incoming target))))))
        (let ((ls-array (make-array (length segments) :initial-element nil)))
          (setf (.linear-segments this) ls-array)
          (dotimes (i (length segments))
            (let ((ls (aref segments i))
                  (rank (aref new-ranks i)))
              (setf (aref ls-array rank) ls)
              (setf (.id ls) rank)
              (jdo (node (.nodes ls))
                (setf (.id node) rank))))
          ls-array)))))

(defun %lsp-create-dependency-graph-edges (this monitor layered-graph segment-list outgoing-list incoming-count-list)
  (declare (ignore this monitor))
  (let ((next-linear-segment-id (length segment-list))
        (layer-index 0))
    (jdo (layer (get-layers layered-graph))
      (let ((nodes (get-nodes layer)))
        (unless (jl-is-empty nodes)
          (let* ((iter-pos 0)
                 (index-in-layer 0)
                 (previous-node nil)
                 (current-node (prog1 (jl-get nodes iter-pos) (incf iter-pos)))
                 (current-segment nil))
            (loop while current-node
                  do (setf current-segment (jl-get segment-list (.id current-node)))
                     (when (>= (.index-in-last-layer current-segment) 0)
                       (let ((cycle-segment nil))
                         (loop for j from (1+ index-in-layer) below (length nodes)
                               do (let ((cycle-node (jl-get nodes j)))
                                    (setf cycle-segment (jl-get segment-list (.id cycle-node)))
                                    (if (and (= (.last-layer cycle-segment) (.last-layer current-segment))
                                             (< (.index-in-last-layer cycle-segment)
                                                (.index-in-last-layer current-segment)))
                                        (return)
                                        (setf cycle-segment nil))))
                         (when cycle-segment
                           (when previous-node
                             (jl-set incoming-count-list (.id current-node)
                                     (1- (jl-get incoming-count-list (.id current-node))))
                             (jl-remove (jl-get outgoing-list (.id previous-node)) current-segment))
                           (setf current-segment (split current-segment current-node next-linear-segment-id))
                           (incf next-linear-segment-id)
                           (jl-add segment-list current-segment)
                           (jl-add outgoing-list (new-jlist))
                           (if previous-node
                               (progn
                                 (jl-add (jl-get outgoing-list (.id previous-node)) current-segment)
                                 (jl-add incoming-count-list 1))
                               (jl-add incoming-count-list 0)))))
                     (let ((next-node nil))
                       (when (< iter-pos (length nodes))
                         (setf next-node (jl-get nodes iter-pos)) (incf iter-pos)
                         (let ((next-segment (jl-get segment-list (.id next-node))))
                           (jl-add (jl-get outgoing-list (.id current-node)) next-segment)
                           (jl-set incoming-count-list (.id next-node)
                                   (1+ (jl-get incoming-count-list (.id next-node))))))
                       (setf (.last-layer current-segment) layer-index)
                       (setf (.index-in-last-layer current-segment) index-in-layer)
                       (incf index-in-layer)
                       (setf previous-node current-node
                             current-node next-node)))
            (incf layer-index)))))))

(defun %lsp-fill-segment (node segment)
  (let ((node-type (get-type node)))
    (if (>= (.id node) 0)
        (return-from %lsp-fill-segment nil)
        (progn
          (setf (.id node) (.id segment))
          (jl-add (.nodes segment) node)))
    (setf (.node-type segment) node-type)
    (when (or (eq node-type node-type.long-edge) (eq node-type node-type.north-south-port))
      (jdo (source-port (get-ports node))
        (jdo (target-port (get-successor-ports source-port))
          (let* ((target-node (get-node target-port))
                 (target-node-type (get-type target-node)))
            (when (and (not (eq (get-layer node) (get-layer target-node)))
                       (or (eq target-node-type node-type.long-edge)
                           (eq target-node-type node-type.north-south-port)))
              (when (%lsp-fill-segment target-node segment)
                (return-from %lsp-fill-segment t)))))))
    t))

(defun %lsp-create-unbalanced-placement (this layered-graph)
  (let* ((n (length (get-layers layered-graph)))
         (node-count (make-array n :initial-element 0))
         (recent-node-type (make-array n :initial-element nil))
         (recent-node (make-array n :initial-element nil)))
    (loop for segment across (.linear-segments this)
          do (let ((uppermost-place 0d0))
               (jdo (node (.nodes segment))
                 (let ((layer-index (get-index (get-layer node))))
                   (incf (aref node-count layer-index))
                   (let ((spacing (get-property layered-graph layered-options.spacing-edge-edge)))
                     (when (> (aref node-count layer-index) 0)
                       (when (aref recent-node layer-index)
                         (setf spacing (get-vertical-spacing (.spacings this) (aref recent-node layer-index) node))))
                     (setf uppermost-place (math.max uppermost-place
                                                     (+ (.y (get-size (get-layer node))) spacing))))))
               (jdo (node (.nodes segment))
                 (setf (.y (get-position node)) (+ uppermost-place (.top (get-margin node))))
                 (let ((layer (get-layer node)))
                   (setf (.y (get-size layer)) (+ uppermost-place (.top (get-margin node))
                                                  (.y (get-size node)) (.bottom (get-margin node))))
                   (setf (aref recent-node-type (get-index layer)) (get-type node))
                   (setf (aref recent-node (get-index layer)) node)))))))

(defun %lsp-balance-placement (this layered-graph)
  (let* ((deflection-dampening (jd (get-property layered-graph
                                                 layered-options.node-placement-linear-segments-deflection-dampening)))
         (thoroughness (get-property layered-graph layered-options.thoroughness))
         (pendulum-iters linear-segments-node-placer.pendulum-iters)
         (final-iters linear-segments-node-placer.final-iters)
         (threshold (/ linear-segments-node-placer.threshold-factor thoroughness))
         (ready nil)
         (mode layered-p4nodes-mode.forw-pendulum)
         (last-total-deflection (jd integer.max-value)))
    (loop
      (let ((incoming (not (eq mode layered-p4nodes-mode.backw-pendulum)))
            (outgoing (not (eq mode layered-p4nodes-mode.forw-pendulum)))
            (total-deflection 0d0))
        (loop for segment across (.linear-segments this)
              do (setf (.ref-segment segment) nil)
                 (%lsp-calc-deflection this segment incoming outgoing deflection-dampening)
                 (incf total-deflection (abs (.deflection segment))))
        (loop while (%lsp-merge-regions this layered-graph))
        (loop for segment across (.linear-segments this)
              do (let ((deflection (.deflection (region segment))))
                   (unless (= deflection 0)
                     (jdo (node (.nodes segment))
                       (incf (.y (get-position node)) deflection)))))
        (if (or (eq mode layered-p4nodes-mode.forw-pendulum) (eq mode layered-p4nodes-mode.backw-pendulum))
            (progn
              (decf pendulum-iters)
              (cond ((and (<= pendulum-iters 0)
                          (or (< total-deflection last-total-deflection)
                              (> (- pendulum-iters) thoroughness)))
                     (setf mode layered-p4nodes-mode.rubber
                           last-total-deflection (jd integer.max-value)))
                    ((eq mode layered-p4nodes-mode.forw-pendulum)
                     (setf mode layered-p4nodes-mode.backw-pendulum
                           last-total-deflection total-deflection))
                    (t
                     (setf mode layered-p4nodes-mode.forw-pendulum
                           last-total-deflection total-deflection))))
            (progn
              (setf ready (or (>= total-deflection last-total-deflection)
                              (< (- last-total-deflection total-deflection) threshold)))
              (setf last-total-deflection total-deflection)
              (when ready (decf final-iters)))))
      (when (and ready (<= final-iters 0)) (return)))))

(defun %lsp-calc-deflection (this segment incoming outgoing deflection-dampening)
  (let ((segment-deflection 0d0)
        (node-weight-sum 0)
        (segments (.linear-segments this)))
    (jdo (node (.nodes segment))
      (let* ((node-deflection 0d0)
             (edge-weight-sum 0)
             (input-prio (if incoming (get-property node linear-segments-node-placer.input-prio) integer.min-value))
             (output-prio (if outgoing (get-property node linear-segments-node-placer.output-prio) integer.min-value))
             (min-prio (max input-prio output-prio)))
        (jdo (port (get-ports node))
          (let ((portpos (+ (.y (get-position node)) (.y (get-position port)) (.y (get-anchor port)))))
            (flet ((consider (edge other-port)
                     (let ((other-node (get-node other-port)))
                       (unless (eq segment (aref segments (.id other-node)))
                         (let ((other-prio (max (get-property other-node linear-segments-node-placer.input-prio)
                                                (get-property other-node linear-segments-node-placer.output-prio)))
                               (prio (get-property edge layered-options.priority-straightness)))
                           (when (and (>= prio min-prio) (>= prio other-prio))
                             (incf node-deflection (- (+ (.y (get-position other-node))
                                                         (.y (get-position other-port))
                                                         (.y (get-anchor other-port)))
                                                      portpos))
                             (incf edge-weight-sum)))))))
              (when outgoing
                (jdo (edge (get-outgoing-edges port))
                  (consider edge (get-target edge))))
              (when incoming
                (jdo (edge (get-incoming-edges port))
                  (consider edge (get-source edge)))))))
        (when (> edge-weight-sum 0)
          (incf segment-deflection (/ node-deflection edge-weight-sum))
          (incf node-weight-sum))))
    (if (> node-weight-sum 0)
        (setf (.deflection segment) (/ (* deflection-dampening segment-deflection) node-weight-sum)
              (.weight segment) node-weight-sum)
        (setf (.deflection segment) 0d0
              (.weight segment) 0))))

(defun %lsp-merge-regions (this layered-graph)
  (let* ((changed nil)
         (node-spacing (jd (get-property layered-graph layered-options.spacing-node-node)))
         (threshold (* linear-segments-node-placer.overlap-detect node-spacing))
         (segments (.linear-segments this)))
    (jdo (layer (get-layers layered-graph))
      (let* ((nodes (get-nodes layer))
             (node1 (jl-first nodes))
             (region1 (region (aref segments (.id node1)))))
        (loop for k from 1 below (length nodes)
              do (let* ((node2 (jl-get nodes k))
                        (region2 (region (aref segments (.id node2)))))
                   (unless (eq region1 region2)
                     (let* ((spacing (get-vertical-spacing (.spacings this) node1 node2))
                            (node1-extent (+ (.y (get-position node1)) (.y (get-size node1))
                                             (.bottom (get-margin node1)) (.deflection region1) spacing))
                            (node2-extent (+ (- (.y (get-position node2)) (.top (get-margin node2)))
                                             (.deflection region2))))
                       (when (> node1-extent (+ node2-extent threshold))
                         (let ((weight-sum (+ (.weight region1) (.weight region2))))
                           (setf (.deflection region2)
                                 (/ (+ (* (.weight region2) (.deflection region2))
                                       (* (.weight region1) (.deflection region1)))
                                    weight-sum))
                           (setf (.weight region2) weight-sum)
                           (setf (.ref-segment region1) region2)
                           (setf changed t)))))
                   (setf node1 node2
                         region1 region2)))))
    changed))

(defun %lsp-post-process (this layered-graph)
  (declare (ignore layered-graph))
  (let ((spacings (.spacings this)))
    (loop for segment across (.linear-segments this)
          do (let ((min-room-above (jd integer.max-value))
                   (min-room-below (jd integer.max-value)))
               (jdo (node (.nodes segment))
                 (let ((index (get-index node))
                       (nodes (get-nodes (get-layer node)))
                       room-above room-below)
                   (if (> index 0)
                       (let* ((neighbor (jl-get nodes (1- index)))
                              (spacing (get-vertical-spacing spacings node neighbor)))
                         (setf room-above (- (- (.y (get-position node)) (.top (get-margin node)))
                                             (+ (.y (get-position neighbor)) (.y (get-size neighbor))
                                                (.bottom (get-margin neighbor)) spacing))))
                       (setf room-above (- (.y (get-position node)) (.top (get-margin node)))))
                   (setf min-room-above (math.min room-above min-room-above))
                   (if (< index (1- (length nodes)))
                       (let* ((neighbor (jl-get nodes (1+ index)))
                              (spacing (get-vertical-spacing spacings node neighbor)))
                         (setf room-below (- (- (.y (get-position neighbor)) (.top (get-margin neighbor)))
                                             (+ (.y (get-position node)) (.y (get-size node))
                                                (.bottom (get-margin node)) spacing))))
                       (setf room-below (* 2 (.y (get-position node)))))
                   (setf min-room-below (math.min room-below min-room-below))))
               (let ((min-displacement (jd integer.max-value))
                     (found-place nil))
                 (let ((first-node (jl-get (.nodes segment) 0)))
                   (jdo (target (get-ports first-node))
                     (let ((pos (+ (.y (get-position first-node)) (.y (get-position target)) (.y (get-anchor target)))))
                       (jdo (edge (get-incoming-edges target))
                         (let* ((source (get-source edge))
                                (d (- (+ (.y (get-position (get-node source))) (.y (get-position source))
                                         (.y (get-anchor source)))
                                      pos)))
                           (when (and (< (abs d) (abs min-displacement))
                                      (< (abs d) (if (< d 0) min-room-above min-room-below)))
                             (setf min-displacement d
                                   found-place t)))))))
                 (let ((last-node (jl-last (.nodes segment))))
                   (jdo (source (get-ports last-node))
                     (let ((pos (+ (.y (get-position last-node)) (.y (get-position source)) (.y (get-anchor source)))))
                       (jdo (edge (get-outgoing-edges source))
                         (let* ((target (get-target edge))
                                (d (- (+ (.y (get-position (get-node target))) (.y (get-position target))
                                         (.y (get-anchor target)))
                                      pos)))
                           (when (and (< (abs d) (abs min-displacement))
                                      (< (abs d) (if (< d 0) min-room-above min-room-below)))
                             (setf min-displacement d
                                   found-place t)))))))
                 (when (and found-place (/= min-displacement 0))
                   (jdo (node (.nodes segment))
                     (incf (.y (get-position node)) min-displacement))))))))

;;; ------------------------------------------------------------ NetworkSimplexPlacer

(defjconst network-simplex-placer.edge-weight-base 4d0)
(defjconst network-simplex-placer.small-edge-weight 0.1d0)
(defjconst network-simplex-placer.long-edge-vs-path-factor 2d0)
(defjconst network-simplex-placer.node-size-weight-static 10000d0)
(defjconst network-simplex-placer.node-size-weight-flexible 1d0)
(defjconst network-simplex-placer.epsilon 0.00001d0)
(defjconst network-simplex-placer.visited -1)
(defjconst network-simplex-placer.other 0)
(defjconst network-simplex-placer.junction 2)

(defjmethod get-layout-processor-configuration ((this network-simplex-placer) graph)
  (%p4-layout-processor-configuration graph))

(defun %nsp-execute-network-simplex (ngraph iter-limit monitor)
  (execute (with-balancing (with-iteration-limit (network-simplex.for-graph ngraph) iter-limit) nil)
           monitor))

(defjmethod process ((this network-simplex-placer) layered-graph progress-monitor)
  (begin progress-monitor "Network simplex node placement" 1)
  (setf (.l-graph this) layered-graph)
  (setf (.spacings this) (get-property layered-graph layered-internal-properties.spacings))
  ;; #1 build the auxiliary graph
  (%nsp-prepare this)
  (%nsp-build-initial-auxiliary-graph this)
  (%nsp-insert-north-south-auxiliary-edges this)
  (%nsp-insert-in-layer-edge-auxiliary-edges this)
  (when (get-property (.l-graph this) layered-options.node-placement-favor-straight-edges)
    (let ((pm (sub-task progress-monitor 1)))
      (begin pm "Straight Edges Pre-Processing" 1)
      (%nsp-prefer-straight-edges this)
      (done pm)))
  (make-connected (.n-graph this))
  ;; #2 execute the network simplex
  (let ((iter-limit (* (get-property layered-graph layered-options.thoroughness)
                       (length (.nodes (.n-graph this))))))
    (%nsp-execute-network-simplex (.n-graph this) iter-limit (sub-task progress-monitor 1))
    (unless (zerop (jsize (.flexible-where-space-permits-edges this)))
      (let ((pm (sub-task progress-monitor 1)))
        (begin pm "Flexible Where Space Processing" 1)
        (%nsp-insert-flexible-where-space-auxiliary-edges this)
        (jdo (edge (.flexible-where-space-permits-edges this))
          (setf (.weight edge) network-simplex-placer.node-size-weight-flexible))
        (%nsp-execute-network-simplex (.n-graph this) iter-limit (sub-task pm 1))
        (done pm))))
  (when (get-property layered-graph layered-options.node-placement-favor-straight-edges)
    (let ((pm (sub-task progress-monitor 1)))
      (begin pm "Straight Edges Post-Processing" 1)
      (%nsp-post-process-two-paths this)
      (done pm)))
  ;; #3 apply positions
  (%nsp-apply-positions this)
  (%nsp-cleanup this)
  (done progress-monitor))

(defun %nsp-prepare (this)
  (setf (.n-graph this) (new-n-graph))
  (let ((node-idx 0) (edge-idx 0))
    (jdo (l (get-layers (.l-graph this)))
      (jdo (l-node (get-nodes l))
        (setf (.id l-node) node-idx) (incf node-idx)
        (jdo (e (get-outgoing-edges l-node))
          (setf (.id e) edge-idx) (incf edge-idx))
        (let ((anchor-must-be-integer (network-simplex-placer.is-flexible-node l-node)))
          (jdo (p (get-ports l-node))
            (when anchor-must-be-integer
              (let ((y (.y (get-anchor p))))
                (when (/= y (math.floor y))
                  (let ((offset (- y (math.round y))))
                    (decf (.y (get-anchor p)) offset)))))
            (let ((y (+ (.y (get-position p)) (.y (get-anchor p)))))
              (when (/= y (math.floor y))
                (let ((offset (- y (math.round y))))
                  (decf (.y (get-position p)) offset))))))))
    (setf (.node-count this) node-idx
          (.edge-count this) edge-idx
          (.node-reps this) (make-array node-idx :initial-element nil)
          (.edge-reps this) (make-array edge-idx :initial-element nil))
    (js-clear (.flexible-where-space-permits-edges this))))

(defun %nsp-cleanup (this)
  (setf (.l-graph this) nil (.n-graph this) nil (.node-reps this) nil (.edge-reps this) nil)
  (clrhash (.port-map this))
  (setf (.node-state this) nil (.crossing this) nil (.two-paths this) nil)
  (js-clear (.flexible-where-space-permits-edges this)))

(defun %nsp-build-initial-auxiliary-graph (this)
  (jdo (l (get-layers (.l-graph this)))
    (%nsp-transform-layer this l))
  (%nsp-transform-edges this))

(defun %nsp-new-edge (delta weight source target &optional (origin nil origin-p))
  (create (target (source (weight (delta (if origin-p (n-edge.of origin) (n-edge.of)) delta) weight) source) target)))

(defun %nsp-transform-layer (this layer)
  (let ((last-rep nil))
    (jdo (l-node (get-nodes layer))
      (let ((node-rep (if (network-simplex-placer.is-flexible-node l-node)
                          (%nsp-transform-fixed-order-node this l-node)
                          (%nsp-transform-fixed-pos-node this l-node))))
        (setf (aref (.node-reps this) (.id l-node)) node-rep)
        (when last-rep
          (let ((spacing (+ (.bottom (get-margin (.origin last-rep)))
                            (get-vertical-spacing (.spacings this) (.origin last-rep) l-node)
                            (.top (get-margin l-node)))))
            (unless (.is-flexible last-rep)
              (incf spacing (.y (get-size (.origin last-rep)))))
            ;; Java: .delta(...).weight(0).source(...).target(...)
            (create (target (source (weight (delta (n-edge.of) (to-int (math.ceil spacing))) 0)
                                    (.tail last-rep))
                            (.head node-rep)))))
        (setf last-rep node-rep)))))

(defun %nsp-new-nnode (graph origin type)
  (let ((b (n-node.of)))
    (when origin (setf b (origin b origin)))
    (create (j-type b type) graph)))

(defun %nsp-transform-fixed-pos-node (this l-node)
  (let ((single-node (%nsp-new-nnode (.n-graph this) l-node "non-flexible")))
    (jdo (p (get-ports l-node))
      (when (contains port-side.sides-east-west (get-side p))
        (jm-put (.port-map this) p single-node)))
    (new-node-rep l-node nil single-node single-node)))

(defun %nsp-transform-fixed-order-node (this l-node)
  (let* ((top-left (%nsp-new-nnode (.n-graph this) l-node "flexible-head"))
         (bottom-left (%nsp-new-nnode (.n-graph this) l-node "flexible-tail"))
         (corners (new-node-rep l-node t top-left bottom-left))
         (min-height (.y (get-size l-node)))
         (nf (node-flexibility.get-node-flexibility l-node))
         (size-weight network-simplex-placer.node-size-weight-static))
    (when (is-flexible-size nf)
      (setf size-weight network-simplex-placer.node-size-weight-flexible))
    ;; Java: .weight(...).delta(...).source(...).target(...)
    (let ((node-size-edge (create (target (source (delta (weight (n-edge.of) size-weight)
                                                         (to-int (math.ceil min-height)))
                                                  top-left)
                                          bottom-left))))
      (when (eq nf node-flexibility.node-size-where-space-permits)
        (js-add (.flexible-where-space-permits-edges this) node-size-edge)))
    (%nsp-transform-ports this (reverse (get-port-side-view l-node port-side.west)) corners)
    (%nsp-transform-ports this (get-port-side-view l-node port-side.east) corners)
    corners))

(defun %nsp-transform-ports (this ports corners)
  (when (zerop (jsize ports))
    (return-from %nsp-transform-ports))
  (let ((port-spacing (spacings.get-individual-or-default (.origin corners) layered-options.spacing-port-port))
        (port-surrounding (spacings.get-individual-or-default (.origin corners)
                                                              layered-options.spacing-ports-surrounding))
        (last-n-node (.head corners))
        (last-port nil))
    (when (null port-surrounding)
      (setf port-surrounding (new-elk-margin)))
    (jdo (port ports)
      (let ((spacing (if (null last-port)
                         (.top port-surrounding)
                         (+ port-spacing (.y (get-size last-port)))))
            (n-node (%nsp-new-nnode (.n-graph this) port "port")))
        (jm-put (.port-map this) port n-node)
        ;; Java: .weight(0).delta(...).source(...).target(...)
        (create (target (source (delta (weight (n-edge.of) 0) (to-int (math.ceil spacing))) last-n-node) n-node))
        (setf last-port port
              last-n-node n-node)))
    (create (target (source (delta (weight (n-edge.of) 0)
                                   (to-int (math.ceil (+ (.bottom port-surrounding) (.y (get-size last-port))))))
                            last-n-node)
                    (.tail corners)))))

(defun %nsp-transform-edges (this)
  (jdo (layer (get-layers (.l-graph this)))
    (jdo (node (get-nodes layer))
      (jdo (e (get-outgoing-edges node))
        (when (network-simplex-placer.is-handled-edge e)
          (%nsp-transform-edge this e))))))

(defun %nsp-transform-edge (this l-edge)
  (let* ((dummy (create (j-type (n-node.of) "edge") (.n-graph this)))
         (src-rep (aref (.node-reps this) (.id (get-node (get-source l-edge)))))
         (tgt-rep (aref (.node-reps this) (.id (get-node (get-target l-edge)))))
         (src-port (get-source l-edge))
         (tgt-port (get-target l-edge))
         (src-offset (.y (get-anchor src-port)))
         (tgt-offset (.y (get-anchor tgt-port))))
    (unless (.is-flexible src-rep)
      (incf src-offset (.y (get-position src-port))))
    (unless (.is-flexible tgt-rep)
      (incf tgt-offset (.y (get-position tgt-port))))
    (let* ((tgt-delta (to-int (math.max 0d0 (- src-offset tgt-offset))))
           (src-delta (to-int (math.max 0d0 (- tgt-offset src-offset))))
           (weight (%nsp-get-edge-weight l-edge))
           ;; Java: NEdge.of(lEdge).weight(...).delta(...).source(...).target(...)
           (left (create (target (source (delta (weight (n-edge.of l-edge) weight) src-delta) dummy)
                                 (jm-get (.port-map this) (get-source l-edge)))))
           (right (create (target (source (delta (weight (n-edge.of l-edge) weight) tgt-delta) dummy)
                                  (jm-get (.port-map this) (get-target l-edge))))))
      (setf (aref (.edge-reps this) (.id l-edge)) (new-edge-rep l-edge dummy left right)))))

(defun %nsp-insert-in-layer-edge-auxiliary-edges (this)
  (jdo (l (get-layers (.l-graph this)))
    (jdo (n (get-nodes l))
      (when (eq (get-type n) node-type.normal)
        (jdo (in-layer-edge (get-connected-edges n))
          (when (is-in-layer-edge in-layer-edge)
            (let* ((src-is-dummy (not (eq (get-type (get-node (get-source in-layer-edge))) node-type.normal)))
                   (the-port (if src-is-dummy (get-target in-layer-edge) (get-source in-layer-edge)))
                   (dummy-node (get-node (get-other in-layer-edge the-port)))
                   (port-rep (jm-get (.port-map this) the-port))
                   (dummy-rep (.head (aref (.node-reps this) (.id dummy-node))))
                   src tgt)
              (if (< (get-index (get-node the-port)) (get-index dummy-node))
                  (setf src port-rep tgt dummy-rep)
                  (setf src dummy-rep tgt port-rep))
              (create (target (source (weight (delta (n-edge.of) 0) network-simplex-placer.edge-weight-base)
                                      src)
                              tgt)))))))))

(defun %nsp-insert-north-south-auxiliary-edges (this)
  (let ((reps (.node-reps this)))
    (jdo (l (get-layers (.l-graph this)))
      (jdo (n (get-nodes l))
        (jdo (sp (get-port-side-view n port-side.south))
          (let ((other (get-property sp layered-internal-properties.port-dummy)))
            (when other
              (create (target (source (weight (delta (n-edge.of) 0) network-simplex-placer.small-edge-weight)
                                      (.tail (aref reps (.id n))))
                              (.head (aref reps (.id other))))))))
        (jdo (sp (get-port-side-view n port-side.north))
          (let ((other (get-property sp layered-internal-properties.port-dummy)))
            (when other
              (create (target (source (weight (delta (n-edge.of) 0) network-simplex-placer.small-edge-weight)
                                      (.tail (aref reps (.id other))))
                              (.head (aref reps (.id n))))))))))))

(defun %nsp-insert-flexible-where-space-auxiliary-edges (this)
  (let* ((ngraph (.n-graph this))
         (min-layer (reduce #'min (map 'list #'.layer (.nodes ngraph))))
         (max-layer (reduce #'max (map 'list #'.layer (.nodes ngraph))))
         (used-layers (- max-layer min-layer))
         (global-source (create (n-node.of) ngraph))
         (global-sink (create (n-node.of) ngraph)))
    (create (target (source (delta (weight (n-edge.of) (* network-simplex-placer.node-size-weight-static 2))
                                   used-layers)
                            global-source)
                    global-sink))
    (loop for nr across (.node-reps this)
          when (and (eq (get-type (.origin nr)) node-type.normal)
                    (> (jsize (get-ports (.origin nr))) 1))
            do (create (target (source (delta (weight (n-edge.of) 0) (- (.layer (.tail nr)) min-layer))
                                       global-source)
                               (.tail nr)))
               (create (target (source (delta (weight (n-edge.of) 0) (- used-layers (.layer (.head nr))))
                                       (.head nr))
                               global-sink)))))

(defun %nsp-apply-positions (this)
  (jdo (l (get-layers (.l-graph this)))
    (jdo (l-node (get-nodes l))
      (let* ((node-rep (aref (.node-reps this) (.id l-node)))
             (min-y (jd (.layer (.head node-rep))))
             (max-y (jd (.layer (.tail node-rep)))))
        (setf (.y (get-position l-node)) min-y)
        (let ((size-delta (- (- max-y min-y) (.y (get-size l-node))))
              (flexible-node (network-simplex-placer.is-flexible-node l-node))
              (nf (node-flexibility.get-node-flexibility l-node)))
          (when (and flexible-node (is-flexible-size-where-space-permits nf))
            (incf (.y (get-size l-node)) size-delta))
          (when (and flexible-node (is-flexible-ports nf))
            (jdo (p (get-ports l-node))
              (when (contains port-side.sides-east-west (get-side p))
                (let ((n-node (jm-get (.port-map this) p)))
                  (setf (.y (get-position p)) (- (.layer n-node) min-y)))))
            (jdo (label (get-labels l-node))
              (%nsp-adjust-label-position l-node label size-delta))
            (when (is-flexible-size-where-space-permits nf)
              (jdo (p (get-port-side-view l-node port-side.south))
                (incf (.y (get-position p)) size-delta)))))))))

(defun %nsp-adjust-label-position (node label size-delta)
  (let ((placement (get-property node layered-options.node-labels-placement)))
    (cond ((contains placement node-label-placement.v-bottom)
           (incf (.y (get-position label)) size-delta))
          ((contains placement node-label-placement.v-center)
           (incf (.y (get-position label)) (/ size-delta 2d0))))))

(defun %nsp-get-edge-weight (edge)
  (let ((priority (max 1 (get-property edge layered-options.priority-straightness)))
        (edge-type-weight (%nsp-get-edge-weight-types (get-type (get-node (get-source edge)))
                                                      (get-type (get-node (get-target edge))))))
    (* priority edge-type-weight)))

(defun %nsp-get-edge-weight-types (node-type1 node-type2)
  (cond ((and (eq node-type1 node-type.normal) (eq node-type2 node-type.normal))
         (* 1 network-simplex-placer.edge-weight-base))
        ((or (eq node-type1 node-type.normal) (eq node-type2 node-type.normal))
         (* 2 network-simplex-placer.edge-weight-base))
        (t (* 8 network-simplex-placer.edge-weight-base))))

(defjstatic network-simplex-placer.is-handled-edge (edge)
  (and (not (is-self-loop edge)) (not (is-in-layer-edge edge))))

;; NodeRep / EdgeRep

(defjctor node-rep (origin is-flexible top bottom)
  (setf (.origin this) origin
        (.is-flexible this) is-flexible
        (.head this) top
        (.tail this) bottom))

(defjctor edge-rep (origin dummy left right)
  (declare (ignore dummy))
  (setf (.origin this) origin
        (.left this) left
        (.right this) right))

(defjmethod is-straight ((this edge-rep))
  (= (not-straight-by this) 0))

(defjmethod not-straight-by ((this edge-rep))
  (let ((left (.left this)) (right (.right this)))
    (- (- (.layer (.target left)) (.delta left))
       (- (.layer (.target right)) (.delta right)))))

;; Flexible ports

(defjstatic network-simplex-placer.is-flexible-node (l-node)
  (block nil
    (unless (eq (get-type l-node) node-type.normal) (return nil))
    (when (<= (jsize (get-ports l-node)) 1) (return nil))
    (let ((pc (get-property l-node layered-options.port-constraints)))
      (when (is-pos-fixed pc) (return nil)))
    (let ((nf (node-flexibility.get-node-flexibility l-node)))
      (when (eq nf node-flexibility.none) (return nil))
      (unless (is-flexible-size-where-space-permits nf)
        (let ((port-spacing (spacings.get-individual-or-default l-node layered-options.spacing-port-port))
              (additional-port-spacing (get-property l-node layered-options.spacing-ports-surrounding)))
          (when (null additional-port-spacing)
            (setf additional-port-spacing (new-elk-margin port-spacing port-spacing port-spacing port-spacing)))
          (let* ((west-ports (get-port-side-view l-node port-side.west))
                 (required-west-height (+ (.top additional-port-spacing) (.bottom additional-port-spacing)
                                          (* (1- (jsize west-ports)) port-spacing))))
            (when (> required-west-height (.y (get-size l-node))) (return nil)))
          (let* ((east-ports (get-port-side-view l-node port-side.east))
                 (required-east-height (+ (.top additional-port-spacing) (.bottom additional-port-spacing)
                                          (* (1- (jsize east-ports)) port-spacing))))
            (when (> required-east-height (.y (get-size l-node))) (return nil)))))
      t)))

;; Path

(defmethod jiterable-items ((p path)) (.edges p))
(defmethod size/0 ((p path)) (length (.edges p)))
(defmethod is-empty/0 ((p path)) (zerop (length (.edges p))))
(defmethod j-get/1 ((p path) i) (jl-get (.edges p) i))
(defmethod add/1 ((p path) e) (jl-add (.edges p) e))
(defmethod clear/0 ((p path)) (jl-clear (.edges p)))

(defjmethod contains-long-edge-dummy ((this path))
  (let ((edges (.edges this)))
    (cond ((jl-is-empty edges) nil)
          ((eq (get-type (get-node (get-source (jl-get edges 0)))) node-type.long-edge) t)
          (t (some (lambda (e) (eq (get-type (get-node (get-target e))) node-type.long-edge)) edges)))))

(defjmethod contains-flexible-node ((this path) p)
  (let ((edges (.edges this)))
    (cond ((jl-is-empty edges) nil)
          ((funcall p (node-flexibility.get-node-flexibility (get-node (get-source (jl-get edges 0))))) t)
          (t (some (lambda (e) (funcall p (node-flexibility.get-node-flexibility (get-node (get-target e)))))
                   edges)))))

(defjmethod order-two-path ((this path))
  (let ((edges (.edges this)))
    (unless (= (length edges) 2)
      (jthrow 'illegal-state-exception "Order only allowed for two paths."))
    (let ((first (jl-get edges 0))
          (second (jl-get edges 1)))
      (unless (eq (get-node (get-target first)) (get-node (get-source second)))
        (jl-clear edges)
        (jl-add edges second)
        (jl-add edges first)))))

(defjmethod is-two-path-center-node-flexible ((this path))
  (network-simplex-placer.is-flexible-node (get-node (get-target (jl-get (.edges this) 0)))))

;; Edge straightening

(defun %nsp-prefer-straight-edges (this)
  (setf (.node-state this) (make-array (.node-count this) :initial-element 0))
  (setf (.two-paths this) (new-jlist))
  (jdo (l (get-layers (.l-graph this)))
    (jdo (n (get-nodes l))
      (setf (aref (.node-state this) (.id n)) (network-simplex-placer.get-node-state n))))
  (%nsp-mark-edge-crossings this)
  (let ((identified-paths (%nsp-identify-paths this)))
    (jdo (path identified-paths)
      (let ((edges (.edges path)))
        (cond
          ((<= (length edges) 1))
          ((= (length edges) 2)
           (order-two-path path)
           (unless (is-two-path-center-node-flexible path)
             (jl-add (.two-paths this) path)))
          ((or (contains-long-edge-dummy path)
               (contains-flexible-node path (lambda (nf) (is-flexible-size-where-space-permits nf)))))
          (t
           (let ((last nil) (n (length edges)))
             (dotimes (i n)
               (let* ((cur (aref edges i))
                      (cur-rep (aref (.edge-reps this) (.id cur)))
                      (weight (if (or (null last) (= i (1- n)))
                                  (%nsp-get-edge-weight-types node-type.normal node-type.long-edge)
                                  (%nsp-get-edge-weight-types node-type.long-edge node-type.long-edge))))
                 (setf weight (* weight network-simplex-placer.long-edge-vs-path-factor))
                 (let ((old-left-weight (.weight (.left cur-rep))))
                   (setf (.weight (.left cur-rep))
                         (math.max old-left-weight (+ old-left-weight (- weight old-left-weight)))))
                 (let ((old-right-weight (.weight (.right cur-rep))))
                   (setf (.weight (.right cur-rep))
                         (math.max old-right-weight (+ old-right-weight (- weight old-right-weight)))))
                 (setf last cur))))))))))

(defun %nsp-post-process-two-paths (this)
  (let ((q (jlist-from (.two-paths this)))
        (s (new-jlist)))
    (loop until (jl-is-empty q)
          do (let ((path (jl-poll-first q)))
               (when (%nsp-improve-two-path this path t)
                 (jl-add s path))))
    (loop until (jl-is-empty s)
          do (%nsp-improve-two-path this (jl-remove-last s) nil))))

(defun %nsp-length (edge)
  (- (abs (- (.layer (.source edge)) (.layer (.target edge)))) (.delta edge)))

(defun %nsp-improve-two-path (this path probe)
  (let* ((edges (.edges path))
         (left-edge (aref (.edge-reps this) (.id (jl-get edges 0))))
         (right-edge (aref (.edge-reps this) (.id (jl-get edges 1)))))
    (when (and (is-straight left-edge) (is-straight right-edge))
      (return-from %nsp-improve-two-path nil))
    (let ((center-origin (.origin (.target (.right left-edge)))))
      (unless (typep center-origin 'l-node)
        (return-from %nsp-improve-two-path nil))
      (let* ((center-node center-origin)
             (n-node (aref (.node-reps this) (.id center-node)))
             (node-index (get-index center-node))
             (layer-nodes (get-nodes (get-layer center-node)))
             (above-dist double.positive-infinity)
             (below-dist double.positive-infinity))
        (when (> node-index 0)
          (let* ((above (jl-get layer-nodes (1- node-index)))
                 (above-rep (aref (.node-reps this) (.id above)))
                 (spacing (math.ceil (get-vertical-spacing (.spacings this) above center-node))))
            (setf above-dist (- (- (.layer (.head n-node)) (.top (get-margin center-node)))
                                (+ (.layer (.head above-rep)) (.y (get-size above)) (.bottom (get-margin above)))
                                spacing))))
        (when (< node-index (1- (length layer-nodes)))
          (let* ((below (jl-get layer-nodes (1+ node-index)))
                 (below-rep (aref (.node-reps this) (.id below)))
                 (spacing (math.ceil (get-vertical-spacing (.spacings this) below center-node))))
            (setf below-dist (- (- (.layer (.head below-rep)) (.top (get-margin below)))
                                (+ (.layer (.head n-node)) (.y (get-size center-node))
                                   (.bottom (get-margin center-node)))
                                spacing))))
        (when (and probe (%nsp-fuzzy-equals above-dist below-dist network-simplex-placer.epsilon))
          (return-from %nsp-improve-two-path t))
        (let* ((a (%nsp-length (.left left-edge)))
               (b (- (%nsp-length (.right left-edge))))
               (c (- (%nsp-length (.left right-edge))))
               (d (%nsp-length (.right right-edge)))
               (case-d (and (> (not-straight-by left-edge) 0) (< (not-straight-by right-edge) 0)))
               (case-c (and (< (not-straight-by left-edge) 0) (> (not-straight-by right-edge) 0)))
               (lhs (+ (.layer (.target (.left left-edge))) (.delta (.right left-edge))))
               (rhs (+ (.layer (.target (.right right-edge))) (.delta (.left right-edge))))
               (case-b (< lhs rhs))
               (case-a (> lhs rhs))
               (move 0))
          (when (and (not case-d) (not case-c))
            (cond (case-a
                   (cond ((> (+ above-dist c) 0) (setf move c))
                         ((> (- below-dist a) 0) (setf move a))))
                  (case-b
                   (cond ((> (+ above-dist b) 0) (setf move b))
                         ((> (- below-dist d) 0) (setf move d))))))
          (incf (.layer (.head n-node)) move)
          (when (.is-flexible n-node)
            (incf (.layer (.tail n-node)) move))
          nil)))))

(defun %nsp-fuzzy-equals (a b tolerance)
  "Guava DoubleMath.fuzzyEquals."
  (or (<= (abs (- a b)) tolerance)
      (= a b)
      (and (nan-p a) (nan-p b))))

;; Path identification

(defun %nsp-identify-paths (this)
  (let ((paths (new-jlist)))
    (jdo (l (get-layers (.l-graph this)))
      (jdo (junction (get-nodes l))
        (when (= (aref (.node-state this) (.id junction)) network-simplex-placer.junction)
          (jdo (e (get-connected-edges junction))
            (when (network-simplex-placer.is-handled-edge e)
              (let ((path (%nsp-follow this e junction (new-path))))
                (when (> (length (.edges path)) 1)
                  (jl-add paths path))))))))
    paths))

(defun %nsp-follow (this edge current path)
  (let ((other (get-other edge current))
        (state (.node-state this)))
    (jl-add (.edges path) edge)
    (when (or (= (aref state (.id other)) network-simplex-placer.visited)
              (= (aref state (.id other)) network-simplex-placer.junction)
              (aref (.crossing this) (.id edge)))
      (return-from %nsp-follow path))
    (setf (aref state (.id other)) network-simplex-placer.visited)
    (jdo (incident (get-connected-edges other))
      (unless (or (not (network-simplex-placer.is-handled-edge incident)) (eq incident edge))
        (return-from %nsp-follow (%nsp-follow this incident other path))))
    path))

(defjstatic network-simplex-placer.get-node-state (node)
  (let ((inco 0) (ouco 0))
    (jdo (p (get-ports node))
      (incf inco (count-if-not (lambda (e) (is-self-loop e)) (to-jvector (get-incoming-edges p))))
      (incf ouco (count-if-not (lambda (e) (is-self-loop e)) (to-jvector (get-outgoing-edges p))))
      (when (or (> inco 1) (> ouco 1))
        (return-from network-simplex-placer.get-node-state/1 network-simplex-placer.junction)))
    (if (= (+ inco ouco) 1)
        network-simplex-placer.junction
        network-simplex-placer.other)))

;; Mark crossings

(defun %nsp-mark-edge-crossings (this)
  (setf (.crossing this) (make-array (.edge-count this) :initial-element nil))
  (let ((layers (get-layers (.l-graph this))))
    (loop for i from 1 below (length layers)
          do (%nsp-mark-crossing-edges this (jl-get layers (1- i)) (jl-get layers i)))))

(defun %nsp-mark-crossing-edges (this left right)
  (let ((open-edges (new-jlist))
        (crossing (.crossing this)))
    (jdo (node (get-nodes left))
      (jdo (port (get-port-side-view node port-side.east))
        (jdo (edge (get-outgoing-edges port))
          (unless (or (is-in-layer-edge edge) (is-self-loop edge)
                      (not (eq (get-layer (get-node (get-target edge))) right)))
            (jl-add open-edges edge)))))
    (jdo (node (reverse (get-nodes right)))
      (jdo (port (get-port-side-view node port-side.west))
        (jdo (edge (get-incoming-edges port))
          (unless (or (is-in-layer-edge edge) (is-self-loop edge)
                      (not (eq (get-layer (get-node (get-source edge))) left)))
            (unless (jl-is-empty open-edges)
              ;; ListIterator from the end: idx is the index of the element last returned by previous()
              (let* ((idx (1- (length open-edges)))
                     (last (aref open-edges idx)))
                (loop while (and (not (eq last edge)) (> idx 0))
                      do (setf (aref crossing (.id last)) t
                               (aref crossing (.id edge)) t)
                         (decf idx)
                         (setf last (aref open-edges idx)))
                (when (> idx 0)
                  (jl-remove-at open-edges idx))))))))))

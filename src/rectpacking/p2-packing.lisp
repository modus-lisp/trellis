;;;; p2-packing.lisp -- org.eclipse.elk.alg.rectpacking.p2packing.

(in-package #:elk)

;;; ------------------------------------------------------------ PackingStrategy

(defjmethod create ((this packing-strategy))
  (enum-case this
    (packing-strategy.compaction (new-compactor/0))
    (packing-strategy.simple (new-simple-placement/0))
    (packing-strategy.none (new-no-placement/0))
    (t nil)))

;;; ------------------------------------------------------------ InitialPlacement

(defjstatic initial-placement.place (rectangles bounding-width node-node-spacing)
  (let* ((rows (new-jlist))
         (row (new-rect-row/2 0d0 node-node-spacing))
         (drawing-height 0d0)
         (current-width 0d0))
    (add-block row (new-block/4 0d0 0d0 row node-node-spacing))
    (jdo (rect rectangles)
      (let* ((block (get-last-block row))
             (potential-row-width
               (+ current-width (get-width rect)
                  (if (is-empty (get-children (jl-get (get-children row) 0)))
                      0d0
                      node-node-spacing))))
        (when (or (> potential-row-width bounding-width)
                  (get-property rect rect-packing-options.in-new-row))
          (setf current-width 0d0)
          (incf drawing-height (+ (get-height row) node-node-spacing))
          (jl-add rows row)
          (setf row (new-rect-row/2 drawing-height node-node-spacing))
          (setf block (new-block/4 0d0 (get-y row) row node-node-spacing))
          (add-block row block)
          (setf current-width 0d0))
        (if (or (is-empty (get-children block))
                (and (not (get-property (get-parent rect) rect-packing-options.packing-compaction-row-height-reevaluation))
                     (initial-placement.is-similar-height block rect node-node-spacing)))
            (add-child block rect)
            (let ((new-block (new-block/4 (+ (get-x block) (get-width block) node-node-spacing)
                                          (get-y row) row node-node-spacing)))
              (add-block row new-block)
              (add-child new-block rect)))
        (setf current-width (+ (get-x rect) (get-width rect)))))
    (jl-add rows row)
    rows))

(defjstatic initial-placement.place-rect-in-block (row block rect bounding-width node-node-spacing)
  (block rect-in-block
    (when (initial-placement.is-similar-height block rect node-node-spacing)
      (cond ((and (<= (+ (get-last-row-new-x block) (get-width rect) node-node-spacing) bounding-width)
                  (or (<= (+ (- (get-last-row-y block) (get-y row)) (get-height rect)) (get-height row))
                      (= (size (get-children row)) 1)))
             (add-child block rect)
             (return-from rect-in-block t))
            ((and (<= (+ (get-x block) (get-width rect)) bounding-width)
                  (<= (+ (get-y block) (get-height block) (get-height rect) node-node-spacing)
                      (+ (get-y row) (get-height row))))
             (add-child-in-new-row block rect)
             (return-from rect-in-block t))))
    nil))

(defjstatic initial-placement.is-similar-height (block rect node-node-spacing)
  (declare (ignore node-node-spacing))
  (if (and (>= (get-height rect) (get-smallest-rect-height block))
           (<= (get-height rect) (get-min-height block)))
      t
      (and (<= (* (get-average-height block) 0.5d0) (get-height rect))
           (>= (* (get-average-height block) 1.5d0) (get-height rect)))))

;;; ------------------------------------------------------------ NoPlacement

(defjmethod process ((this no-placement) graph progress-monitor)
  (begin progress-monitor "No Compaction" 1)
  (let* ((padding (get-property graph rect-packing-options.padding))
         (rectangles (get-children graph))
         (size (drawing-util.calculate-dimensions/1 rectangles))
         (width (math.max (.x size) (- (get-property graph rectpacking-internal-properties.min-width)
                                       (get-horizontal padding))))
         (height (math.max (.y size) (- (get-property graph rectpacking-internal-properties.min-height)
                                        (get-vertical padding))))
         (additional-height (- height (.y size))))
    (set-property graph rectpacking-internal-properties.additional-height additional-height)
    (set-property graph rectpacking-internal-properties.drawing-width width)
    (set-property graph rectpacking-internal-properties.drawing-height (+ height additional-height)))
  (done progress-monitor)
  nil)

(defjmethod get-layout-processor-configuration ((this no-placement) graph)
  (declare (ignore graph))
  nil)

;;; ------------------------------------------------------------ SimplePlacement

(defjmethod process ((this simple-placement) graph progress-monitor)
  (begin progress-monitor "No Compaction" 1)
  (let* ((target-width (get-property graph rectpacking-internal-properties.target-width))
         (node-node-spacing (get-property graph rect-packing-options.spacing-node-node))
         (padding (get-property graph rect-packing-options.padding)))
    (drawing-util.reset-coordinates (get-children graph))
    (let* ((rows (initial-placement.place (get-children graph) target-width node-node-spacing))
           (rectangles (get-children graph))
           (size nil))
      (if (null rows)
          (setf size (drawing-util.calculate-dimensions/1 rectangles))
          (progn
            (jdo (row rows)
              (jdo (block (get-children row))
                (let ((stack (new-block-stack/3 (get-x block) (get-y block)
                                                (get-property graph rect-packing-options.spacing-node-node))))
                  (add-block stack block)
                  (jl-add (get-stacks row) stack))))
            (setf size (drawing-util.calculate-dimensions/2 rows node-node-spacing))))
      (let* ((width (math.max (.x size) (- (get-property graph rectpacking-internal-properties.min-width)
                                           (get-horizontal padding))))
             (height (math.max (.y size) (- (get-property graph rectpacking-internal-properties.min-height)
                                            (get-vertical padding))))
             (additional-height (- height (.y size))))
        (set-property graph rectpacking-internal-properties.additional-height additional-height)
        (set-property graph rectpacking-internal-properties.drawing-width width)
        (set-property graph rectpacking-internal-properties.drawing-height (+ height additional-height))
        (set-property graph rectpacking-internal-properties.rows rows))))
  (done progress-monitor)
  nil)

(defjmethod get-layout-processor-configuration ((this simple-placement) graph)
  (declare (ignore graph))
  nil)

;;; ------------------------------------------------------------ Compactor

(defjmethod process ((this compactor) graph progress-monitor)
  (begin progress-monitor "Compaction" 1)
  (let* ((rectangles (get-children graph))
         (aspect-ratio (get-property graph rect-packing-options.aspect-ratio))
         (node-node-spacing (get-property graph rect-packing-options.spacing-node-node))
         (padding (get-property graph rect-packing-options.padding))
         (second-it (new-row-filling-and-compaction/2 aspect-ratio node-node-spacing))
         (drawing (start second-it rectangles progress-monitor graph padding)))
    (copy-row-width-change-values this graph second-it)
    (let ((iterations (get-property graph rect-packing-options.packing-compaction-iterations)))
      (loop while (> iterations 1)
            do (let* ((clone (clone this graph))
                      (old-sm (get-scale-measure drawing)))
                 (configure-second-iteration this graph clone drawing)
                 (setf second-it (new-row-filling-and-compaction/2 aspect-ratio node-node-spacing))
                 (let* ((new-drawing (start second-it rectangles progress-monitor clone padding))
                        (new-sm (get-scale-measure new-drawing)))
                   (when (and (>= new-sm old-sm) (not (nan-p new-sm)))
                     (loop for i from 0 below (size (get-children clone))
                           do (copy-position this (jl-get (get-children clone) i)
                                          (jl-get (get-children graph) i)))
                     (copy-row-width-change-values this graph second-it)
                     (set-drawing-width drawing (get-drawing-width new-drawing))
                     (set-drawing-height drawing (get-drawing-height new-drawing))))
                 (decf iterations))))
    (set-property graph rectpacking-internal-properties.drawing-height (get-drawing-height drawing))
    (set-property graph rectpacking-internal-properties.drawing-width (get-drawing-width drawing)))
  (done progress-monitor)
  nil)

(defjmethod copy-row-width-change-values ((this compactor) graph compaction)
  (set-property graph rectpacking-internal-properties.min-row-increase (.potential-row-width-increase-min compaction))
  (set-property graph rectpacking-internal-properties.max-row-increase (.potential-row-width-increase-max compaction))
  (set-property graph rectpacking-internal-properties.min-row-decrease (.potential-row-width-decrease-min compaction))
  (set-property graph rectpacking-internal-properties.max-row-decrease (.potential-row-width-decrease-max compaction))
  nil)

(defjmethod get-layout-processor-configuration ((this compactor) graph)
  (declare (ignore graph))
  nil)

(defjmethod configure-second-iteration ((this compactor) layout-graph clone drawing)
  (let ((padding (get-property layout-graph rect-packing-options.padding))
        (aspect-ratio (get-property layout-graph rect-packing-options.aspect-ratio)))
    (cond
      ((and (> (size (get-children layout-graph)) 1)
            (/= (get-property layout-graph rectpacking-internal-properties.min-row-increase) double.positive-infinity)
            (< (/ (+ (get-drawing-width drawing) (get-horizontal padding))
                  (+ (get-drawing-height drawing) (get-vertical padding)))
               aspect-ratio))
       (set-property clone rectpacking-internal-properties.target-width
                     (+ (get-property layout-graph rectpacking-internal-properties.target-width)
                        (get-property layout-graph rectpacking-internal-properties.min-row-increase))))
      ((and (> (size (get-children layout-graph)) 1)
            (/= (get-property layout-graph rectpacking-internal-properties.min-row-decrease) double.positive-infinity)
            (> (/ (+ (get-drawing-width drawing) (get-horizontal padding))
                  (+ (get-drawing-height drawing) (get-vertical padding)))
               aspect-ratio))
       (set-property clone rectpacking-internal-properties.target-width
                     (math.max (get-property layout-graph rectpacking-internal-properties.min-width)
                               (- (get-property clone rectpacking-internal-properties.target-width)
                                  (get-property layout-graph rectpacking-internal-properties.min-row-decrease))))))
    nil))

(defjmethod clone ((this compactor) node)
  (let ((clone (create-elk-node elk-graph-factory.e-instance)))
    (copy-properties clone node)
    (jdo (child (get-children node))
      (let ((new-child (create-elk-node elk-graph-factory.e-instance)))
        (set-parent new-child clone)
        (set-dimensions new-child (get-width child) (get-height child))
        (set-identifier new-child (get-identifier child))
        (set-location new-child (get-x child) (get-y child))
        (jl-add (get-children clone) new-child)
        (copy-properties new-child child)))
    clone))

(defjmethod copy-position ((this compactor) node other)
  (set-dimensions other (get-width node) (get-height node))
  (set-location other (get-x node) (get-y node))
  (loop for i from 0 below (size (get-children node))
        do (copy-position this (jl-get (get-children node) i)
                       (jl-get (get-children other) i)))
  nil)

;;; ------------------------------------------------------------ RowFillingAndCompaction

(defjctor row-filling-and-compaction (aspect-ratio node-node-spacing)
  (setf (.aspect-ratio this) aspect-ratio
        (.node-node-spacing this) node-node-spacing
        (.potential-row-width-decrease-min this) double.positive-infinity
        (.potential-row-width-decrease-max this) 0d0
        (.potential-row-width-increase-min this) double.positive-infinity
        (.potential-row-width-increase-max this) 0d0))

(defjmethod start ((this row-filling-and-compaction) rectangles progress-monitor layout-graph padding)
  (declare (ignore rectangles progress-monitor))
  (let* ((target-width (get-property layout-graph rectpacking-internal-properties.target-width))
         (min-width (get-property layout-graph rectpacking-internal-properties.min-width))
         (min-height (get-property layout-graph rectpacking-internal-properties.min-height))
         (nns (.node-node-spacing this)))
    (drawing-util.reset-coordinates (get-children layout-graph))
    (let ((rows (initial-placement.place (get-children layout-graph) target-width nns))
          (row-idx 0))
      (loop while (< row-idx (size rows))
            do (let ((current-row (jl-get rows row-idx)))
                 (when (/= row-idx 0)
                   (let ((previous-row (jl-get rows (1- row-idx))))
                     (set-y current-row (+ (get-y previous-row) (get-height previous-row) nns))))
                 (let ((result (compaction.compact row-idx rows target-width nns
                                                   (get-property layout-graph rect-packing-options.packing-compaction-row-height-reevaluation))))
                   (if (get-second result)
                       (progn
                         (jdo (block (get-children current-row))
                           (set-fixed block nil)
                           (set-position-fixed block nil)
                           (reset-block block))
                         (reset-stacks current-row)
                         (set-width current-row target-width)
                         (decf row-idx))
                       (progn
                         (adjust-width-and-height this current-row)
                         (when (< (1+ row-idx) (size rows))
                           (setf (.potential-row-width-increase-max this)
                                 (math.max (- (+ (get-width current-row) nns
                                                 (get-width (get-first-block (jl-get rows (1+ row-idx)))))
                                              target-width)
                                           (.potential-row-width-decrease-max this)))
                           (setf (.potential-row-width-increase-min this)
                                 (math.min (- (+ (get-width current-row) nns
                                                 (get-width (get-first-block (jl-get rows (1+ row-idx)))))
                                              target-width)
                                           (.potential-row-width-decrease-min this)))
                           (when (/= (size (get-stacks current-row)) 0)
                             (let ((v (+ (get-width (jl-get (get-stacks current-row) (1- (size (get-stacks current-row)))))
                                         (if (<= (size (get-stacks current-row)) 1) 0d0 nns))))
                               (setf (.potential-row-width-decrease-max this)
                                     (math.max (.potential-row-width-decrease-max this) v))
                               (setf (.potential-row-width-decrease-min this)
                                     (math.min (.potential-row-width-decrease-max this) v)))))
                         (when (= (size rows) 1)
                           (let* ((last-stack (jl-get (get-stacks current-row) (1- (size (get-stacks current-row)))))
                                  (last-block (jl-get (get-blocks last-stack) (1- (size (get-blocks last-stack))))))
                             (jdo (block-row (get-rows last-block))
                               (setf (.potential-row-width-decrease-max this)
                                     (math.max (.potential-row-width-decrease-max this)
                                               (- (get-width last-block) (get-width block-row))))
                               (setf (.potential-row-width-decrease-min this)
                                     (math.min (.potential-row-width-decrease-min this)
                                               (- (get-width last-block) (get-width block-row))))
                               (setf (.potential-row-width-increase-max this)
                                     (math.max (.potential-row-width-increase-max this)
                                               (+ (get-width block-row) nns)))
                               (setf (.potential-row-width-increase-min this)
                                     (math.min (.potential-row-width-increase-min this)
                                               (+ (get-width block-row) nns)))))))))
                 (incf row-idx)))
      (let* ((size (drawing-util.calculate-dimensions/2 rows nns))
             (total-width (math.max (.x size) (- min-width (get-horizontal padding))))
             (height (math.max (.y size) (- min-height (get-vertical padding))))
             (additional-height (- height (.y size))))
        (set-property layout-graph rectpacking-internal-properties.additional-height additional-height)
        (set-property layout-graph rectpacking-internal-properties.rows rows)
        (new-drawing-data/4 (.aspect-ratio this) total-width (+ (.y size) additional-height)
                            drawing-data-descriptor.whole-drawing)))))

(defjmethod adjust-width-and-height ((this row-filling-and-compaction) row)
  (let ((max-height 0d0)
        (max-width 0d0)
        (index 0))
    (jdo (stack (get-stacks row))
      (update-dimension stack)
      (setf max-height (math.max max-height (get-height stack)))
      (incf max-width (+ (get-width stack) (if (> index 0) (.node-node-spacing this) 0d0)))
      (incf index))
    (set-height row max-height)
    (set-width row max-width)
    nil))

;;;; orthogonal.lisp -- org.eclipse.elk.alg.layered.p5edges.orthogonal(.direction)

(in-package #:elk)

;;; ======================================================================
;;; BaseRoutingDirectionStrategy and its three implementations
;;; ======================================================================

(defjstatic base-routing-direction-strategy.for-routing-direction (direction)
  (enum-case direction
    (routing-direction.west-to-east (new-west-to-east-routing-strategy))
    (routing-direction.north-to-south (new-north-to-south-routing-strategy))
    (routing-direction.south-to-north (new-south-to-north-routing-strategy))
    (t (jthrow 'illegal-argument-exception))))

(defjmethod add-junction-point-if-necessary ((this base-routing-direction-strategy) edge segment pos vertical)
  (let ((p (if vertical (.y pos) (.x pos))))
    ;; If we already have this junction point, don't bother
    (when (jl-contains (.created-junction-points this) pos)
      (return-from add-junction-point-if-necessary nil))
    (let ((point-inside-edge-segment (and (> p (get-start-coordinate segment))
                                          (< p (get-end-coordinate segment))))
          (point-at-segment-boundary nil)
          (in (get-incoming-connection-coordinates segment))
          (out (get-outgoing-connection-coordinates segment)))
      (when (and (not (jl-is-empty in)) (not (jl-is-empty out)))
        ;; Is the bend point at the start and joins another edge at the same position?
        (when (and (< (abs (- p (jl-first in))) orthogonal-routing-generator.tolerance)
                   (< (abs (- p (jl-first out))) orthogonal-routing-generator.tolerance))
          (setf point-at-segment-boundary t))
        ;; Is the bend point at the end and joins another edge at the same position?
        (when (and (< (abs (- p (jl-last in))) orthogonal-routing-generator.tolerance)
                   (< (abs (- p (jl-last out))) orthogonal-routing-generator.tolerance))
          (setf point-at-segment-boundary t)))
      (when (or point-inside-edge-segment point-at-segment-boundary)
        ;; create a new junction point for the edge at the bend point's position
        (let ((junction-points (get-property edge layered-options.junction-points)))
          (when (null junction-points)
            (setf junction-points (new-k-vector-chain))
            (set-property edge layered-options.junction-points junction-points))
          (let ((jpoint (new-k-vector pos)))
            (add junction-points jpoint)
            (jl-add (.created-junction-points this) jpoint)))))))

(defjmethod get-created-junction-points ((this base-routing-direction-strategy))
  (.created-junction-points this))

(defjmethod clear-created-junction-points ((this base-routing-direction-strategy))
  (jl-clear (.created-junction-points this)))

(defjgeneric get-port-position-on-hyper-node 1)
(defjgeneric get-source-port-side 0)
(defjgeneric get-target-port-side 0)
(defjgeneric calculate-bend-points 3)

;;; WestToEast

(defjmethod get-port-position-on-hyper-node ((this west-to-east-routing-strategy) port)
  (+ (.y (get-position (get-node port))) (.y (get-position port)) (.y (get-anchor port))))
(defjmethod get-source-port-side ((this west-to-east-routing-strategy)) port-side.east)
(defjmethod get-target-port-side ((this west-to-east-routing-strategy)) port-side.west)

(defjmethod calculate-bend-points ((this west-to-east-routing-strategy) segment start-pos edge-spacing)
  ;; We don't do anything with dummy segments; they are dealt with when their partner is processed
  (when (is-dummy segment)
    (return-from calculate-bend-points nil))
  (let ((segment-x (+ start-pos (* (get-routing-slot segment) edge-spacing))))
    (jdo (port (get-ports segment))
      (let ((source-y (.y (get-absolute-anchor port))))
        (jdo (edge (get-outgoing-edges port))
          (unless (is-self-loop edge)
            (let* ((target (get-target edge))
                   (target-y (.y (get-absolute-anchor target))))
              (when (> (abs (- source-y target-y)) orthogonal-routing-generator.tolerance)
                (let* ((current-x segment-x)
                       (current-segment segment)
                       (bend (new-k-vector current-x source-y)))
                  (add (get-bend-points edge) bend)
                  (add-junction-point-if-necessary this edge current-segment bend t)
                  ;; If this segment was split, we need two additional bend points
                  (let ((split-partner (get-split-partner segment)))
                    (when split-partner
                      (let ((split-y (jl-get (get-incoming-connection-coordinates split-partner) 0)))
                        (setf bend (new-k-vector current-x split-y))
                        (add (get-bend-points edge) bend)
                        (add-junction-point-if-necessary this edge current-segment bend t)
                        ;; Advance to the split partner's routing slot
                        (setf current-x (+ start-pos (* (get-routing-slot split-partner) edge-spacing))
                              current-segment split-partner)
                        (setf bend (new-k-vector current-x split-y))
                        (add (get-bend-points edge) bend)
                        (add-junction-point-if-necessary this edge current-segment bend t))))
                  (setf bend (new-k-vector current-x target-y))
                  (add (get-bend-points edge) bend)
                  (add-junction-point-if-necessary this edge current-segment bend t))))))))))

;;; NorthToSouth / SouthToNorth differ only in the sign of the slot offset.

(defjmethod get-port-position-on-hyper-node ((this north-to-south-routing-strategy) port)
  (+ (.x (get-position (get-node port))) (.x (get-position port)) (.x (get-anchor port))))
(defjmethod get-source-port-side ((this north-to-south-routing-strategy)) port-side.south)
(defjmethod get-target-port-side ((this north-to-south-routing-strategy)) port-side.north)

(defjmethod get-port-position-on-hyper-node ((this south-to-north-routing-strategy) port)
  (+ (.x (get-position (get-node port))) (.x (get-position port)) (.x (get-anchor port))))
(defjmethod get-source-port-side ((this south-to-north-routing-strategy)) port-side.north)
(defjmethod get-target-port-side ((this south-to-north-routing-strategy)) port-side.south)

(defun %p5-vertical-bend-points (this segment start-pos edge-spacing sign)
  (when (is-dummy segment)
    (return-from %p5-vertical-bend-points nil))
  (let ((segment-y (+ start-pos (* sign (get-routing-slot segment) edge-spacing))))
    (jdo (port (get-ports segment))
      (let ((source-x (.x (get-absolute-anchor port))))
        (jdo (edge (get-outgoing-edges port))
          (unless (is-self-loop edge)
            (let* ((target (get-target edge))
                   (target-x (.x (get-absolute-anchor target))))
              (when (> (abs (- source-x target-x)) orthogonal-routing-generator.tolerance)
                (let* ((current-y segment-y)
                       (current-segment segment)
                       (bend (new-k-vector source-x current-y)))
                  (add (get-bend-points edge) bend)
                  (add-junction-point-if-necessary this edge current-segment bend nil)
                  (let ((split-partner (get-split-partner segment)))
                    (when split-partner
                      (let ((split-x (jl-get (get-incoming-connection-coordinates split-partner) 0)))
                        (setf bend (new-k-vector split-x current-y))
                        (add (get-bend-points edge) bend)
                        (add-junction-point-if-necessary this edge current-segment bend nil)
                        (setf current-y (+ start-pos (* sign (get-routing-slot split-partner) edge-spacing))
                              current-segment split-partner)
                        (setf bend (new-k-vector split-x current-y))
                        (add (get-bend-points edge) bend)
                        (add-junction-point-if-necessary this edge current-segment bend nil))))
                  (setf bend (new-k-vector target-x current-y))
                  (add (get-bend-points edge) bend)
                  (add-junction-point-if-necessary this edge current-segment bend nil))))))))))

(defjmethod calculate-bend-points ((this north-to-south-routing-strategy) segment start-pos edge-spacing)
  (%p5-vertical-bend-points this segment start-pos edge-spacing 1))

(defjmethod calculate-bend-points ((this south-to-north-routing-strategy) segment start-pos edge-spacing)
  (%p5-vertical-bend-points this segment start-pos edge-spacing -1))

;;; ======================================================================
;;; HyperEdgeSegment
;;; ======================================================================

(defjctor hyper-edge-segment (routing-strategy)
  (setf (.routing-strategy this) routing-strategy))

(defjmethod add-port-positions ((this hyper-edge-segment) port hyper-edge-segment-map)
  (jm-put hyper-edge-segment-map port this)
  (jl-add (.ports this) port)
  (let ((port-pos (get-port-position-on-hyper-node (.routing-strategy this) port)))
    ;; add the new port position to the respective list
    (if (eq (get-side port) (get-source-port-side (.routing-strategy this)))
        (hyper-edge-segment.insert-sorted (.incoming-connection-coordinates this) port-pos)
        (hyper-edge-segment.insert-sorted (.outgoing-connection-coordinates this) port-pos)))
  ;; update start and end coordinates
  (recompute-extent this)
  ;; add connected ports
  (jdo (other-port (get-connected-ports port))
    (unless (jm-contains-key hyper-edge-segment-map other-port)
      (add-port-positions this other-port hyper-edge-segment-map))))

(defjstatic hyper-edge-segment.insert-sorted (list value)
  ;; Java compares against the list element narrowed to float (floatValue()).
  (let ((i 0) (n (length list)))
    (loop while (< i n)
          do (let ((next (%p5-float (aref list i))))
               (cond ((= next value) (return-from hyper-edge-segment.insert-sorted/2 nil))
                     ((> next value) (return))))
             (incf i))
    (jl-add-at list i (jd value))))

(defjmethod get-ports ((this hyper-edge-segment)) (.ports this))
(defjmethod get-routing-slot ((this hyper-edge-segment)) (.routing-slot this))
(defjmethod set-routing-slot ((this hyper-edge-segment) slot) (setf (.routing-slot this) slot))
(defjmethod get-start-coordinate ((this hyper-edge-segment)) (.start-position this))
(defjmethod get-end-coordinate ((this hyper-edge-segment)) (.end-position this))
(defjmethod get-incoming-connection-coordinates ((this hyper-edge-segment)) (.incoming-connection-coordinates this))
(defjmethod get-outgoing-connection-coordinates ((this hyper-edge-segment)) (.outgoing-connection-coordinates this))
(defjmethod get-outgoing-segment-dependencies ((this hyper-edge-segment)) (.outgoing-segment-dependencies this))
(defjmethod get-out-weight ((this hyper-edge-segment)) (.out-dep-weight this))
(defjmethod set-out-weight ((this hyper-edge-segment) w) (setf (.out-dep-weight this) w))
(defjmethod get-critical-out-weight ((this hyper-edge-segment)) (.critical-out-dep-weight this))
(defjmethod set-critical-out-weight ((this hyper-edge-segment) w) (setf (.critical-out-dep-weight this) w))
(defjmethod get-incoming-segment-dependencies ((this hyper-edge-segment)) (.incoming-segment-dependencies this))
(defjmethod get-in-weight ((this hyper-edge-segment)) (.in-dep-weight this))
(defjmethod set-in-weight ((this hyper-edge-segment) w) (setf (.in-dep-weight this) w))
(defjmethod get-critical-in-weight ((this hyper-edge-segment)) (.critical-in-dep-weight this))
(defjmethod set-critical-in-weight ((this hyper-edge-segment) w) (setf (.critical-in-dep-weight this) w))
(defjmethod get-split-partner ((this hyper-edge-segment)) (.split-partner this))
(defjmethod set-split-partner ((this hyper-edge-segment) p) (setf (.split-partner this) p))
(defjmethod get-split-by ((this hyper-edge-segment)) (.split-by this))
(defjmethod set-split-by ((this hyper-edge-segment) s) (setf (.split-by this) s))

(defjmethod get-length ((this hyper-edge-segment))
  (- (get-end-coordinate this) (get-start-coordinate this)))

(defjmethod represents-hyperedge ((this hyper-edge-segment))
  (> (+ (length (.incoming-connection-coordinates this))
        (length (.outgoing-connection-coordinates this)))
     2))

(defjmethod is-dummy ((this hyper-edge-segment))
  (and (.split-partner this) (null (.split-by this))))

(defjmethod recompute-extent ((this hyper-edge-segment))
  (setf (.start-position this) double.nan
        (.end-position this) double.nan)
  (recompute-extent this (.incoming-connection-coordinates this))
  (recompute-extent this (.outgoing-connection-coordinates this)))

(defjmethod recompute-extent ((this hyper-edge-segment) positions)
  ;; this code assumes that the positions are sorted ascendingly
  (unless (jl-is-empty positions)
    (setf (.start-position this)
          (if (nan-p (.start-position this))
              (jl-first positions)
              (math.min (.start-position this) (jl-first positions))))
    (setf (.end-position this)
          (if (nan-p (.end-position this))
              (jl-last positions)
              (math.max (.end-position this) (jl-last positions))))))

(defjmethod simulate-split ((this hyper-edge-segment))
  (let ((new-split (new-hyper-edge-segment (.routing-strategy this)))
        (new-split-partner (new-hyper-edge-segment (.routing-strategy this))))
    (jl-add-all (.incoming-connection-coordinates new-split) (.incoming-connection-coordinates this))
    (setf (.split-by new-split) (.split-by this)
          (.split-partner new-split) new-split-partner)
    (recompute-extent new-split)
    (jl-add-all (.outgoing-connection-coordinates new-split-partner) (.outgoing-connection-coordinates this))
    (setf (.split-partner new-split-partner) new-split)
    (recompute-extent new-split-partner)
    (pair.of new-split new-split-partner)))

(defjmethod split-at ((this hyper-edge-segment) split-position)
  (let ((partner (new-hyper-edge-segment (.routing-strategy this))))
    (setf (.split-partner this) partner)
    (set-split-partner partner this)
    ;; Move all target positions over to the new segment
    (jl-add-all (.outgoing-connection-coordinates partner) (.outgoing-connection-coordinates this))
    (jl-clear (.outgoing-connection-coordinates this))
    ;; Link the two
    (jl-add (.outgoing-connection-coordinates this) split-position)
    (jl-add (.incoming-connection-coordinates partner) split-position)
    (recompute-extent this)
    (recompute-extent partner)
    ;; Clear dependencies so they can be regenerated later
    (loop until (jl-is-empty (.incoming-segment-dependencies this))
          do (j-remove (jl-get (.incoming-segment-dependencies this) 0)))
    (loop until (jl-is-empty (.outgoing-segment-dependencies this))
          do (j-remove (jl-get (.outgoing-segment-dependencies this) 0)))
    partner))

(defjmethod compare-to ((this hyper-edge-segment) other)
  (- (.mark this) (.mark other)))

(defjmethod equals ((this hyper-edge-segment) object)
  (and (typep object 'hyper-edge-segment) (= (.mark this) (.mark object))))

(defjmethod hash-code ((this hyper-edge-segment)) (.mark this))

(defjmethod to-string ((this hyper-edge-segment))
  (with-output-to-string (s)
    (write-char #\{ s)
    (let ((ports (.ports this)))
      (loop for i from 0 below (length ports)
            for port = (aref ports i)
            do (let ((name (get-designation (get-node port))))
                 (when (null name)
                   (setf name (jstr "n" (get-index (get-node port)))))
                 (write-string name s)
                 (when (< (1+ i) (length ports)) (write-char #\, s)))))
    (write-char #\} s)))

;;; ======================================================================
;;; HyperEdgeSegmentDependency
;;; ======================================================================

(defjconst hyper-edge-segment-dependency.critical-dependency-weight 1)

(defjctor hyper-edge-segment-dependency (type source target weight)
  (setf (.type this) type
        (.weight this) weight)
  (set-source this source)
  (set-target this target))

(defjstatic hyper-edge-segment-dependency.create-and-add-regular (source target weight)
  (new-hyper-edge-segment-dependency dependency-type.regular source target weight))

(defjstatic hyper-edge-segment-dependency.create-and-add-critical (source target)
  (new-hyper-edge-segment-dependency dependency-type.critical source target
                                     hyper-edge-segment-dependency.critical-dependency-weight))

(defjmethod j-remove ((this hyper-edge-segment-dependency))
  (set-source this nil)
  (set-target this nil))

(defjmethod j-reverse ((this hyper-edge-segment-dependency))
  (let ((old-source (.source this)) (old-target (.target this)))
    (set-source this old-target)
    (set-target this old-source)))

(defun %p5-remove-identical (list x)
  "List.remove(Object) for an element type with identity equals."
  (let ((i (position x list)))
    (when i (jl-remove-at list i) t)))

(defjmethod get-type ((this hyper-edge-segment-dependency)) (.type this))
(defjmethod get-source ((this hyper-edge-segment-dependency)) (.source this))
(defjmethod set-source ((this hyper-edge-segment-dependency) new-source)
  (when (.source this)
    (%p5-remove-identical (get-outgoing-segment-dependencies (.source this)) this))
  (setf (.source this) new-source)
  (when (.source this)
    (jl-add (get-outgoing-segment-dependencies (.source this)) this)))
(defjmethod get-target ((this hyper-edge-segment-dependency)) (.target this))
(defjmethod set-target ((this hyper-edge-segment-dependency) new-target)
  (when (.target this)
    (%p5-remove-identical (get-incoming-segment-dependencies (.target this)) this))
  (setf (.target this) new-target)
  (when (.target this)
    (jl-add (get-incoming-segment-dependencies (.target this)) this)))
(defjmethod get-weight ((this hyper-edge-segment-dependency)) (.weight this))

(defjmethod to-string ((this hyper-edge-segment-dependency))
  (jstr (and (.source this) (to-string (.source this))) "->"
        (and (.target this) (to-string (.target this))) " (" (name (.type this)) ")"))

;;; ======================================================================
;;; HyperEdgeCycleDetector
;;; ======================================================================

(defjstatic hyper-edge-cycle-detector.detect-cycles (segments critical-only random)
  (let ((result (new-jlist))
        (sources (new-jlist))
        (sinks (new-jlist)))
    (hyper-edge-cycle-detector.initialize segments sources sinks critical-only)
    (hyper-edge-cycle-detector.compute-linear-ordering-marks segments sources sinks critical-only random)
    ;; process edges that point left
    (jdo (source segments)
      (jdo (out-dependency (get-outgoing-segment-dependencies source))
        (when (or (not critical-only) (eq (get-type out-dependency) dependency-type.critical))
          (when (> (.mark source) (.mark (get-target out-dependency)))
            (jl-add result out-dependency)))))
    result))

(defjstatic hyper-edge-cycle-detector.initialize (segments sources sinks critical-only)
  (let ((next-mark -1))
    (jdo (segment segments)
      (setf (.mark segment) next-mark)
      (decf next-mark)
      (let* ((critical-in-weight
               (loop for dep across (get-incoming-segment-dependencies segment)
                     when (eq (get-type dep) dependency-type.critical) sum (get-weight dep)))
             (critical-out-weight
               (loop for dep across (get-outgoing-segment-dependencies segment)
                     when (eq (get-type dep) dependency-type.critical) sum (get-weight dep)))
             (in-weight critical-in-weight)
             (out-weight critical-out-weight))
        (unless critical-only
          (setf in-weight (loop for dep across (get-incoming-segment-dependencies segment) sum (get-weight dep))
                out-weight (loop for dep across (get-outgoing-segment-dependencies segment) sum (get-weight dep))))
        (set-in-weight segment in-weight)
        (set-critical-in-weight segment critical-in-weight)
        (set-out-weight segment out-weight)
        (set-critical-out-weight segment critical-out-weight)
        (cond ((= out-weight 0) (jl-add sinks segment))
              ((= in-weight 0) (jl-add sources segment)))))))

(defun %p5-tree-set-remove (set x)
  "TreeSet<HyperEdgeSegment>.remove: SET is kept sorted by mark; removes the
element comparing equal (same mark) to X."
  (let ((i (position (.mark x) set :key #'.mark :test #'=)))
    (when i (jl-remove-at set i) t)))

(defjstatic hyper-edge-cycle-detector.compute-linear-ordering-marks (segments sources sinks critical-only random)
  ;; TreeSet ordered by mark (all marks are distinct and negative at this point)
  (let* ((unprocessed (let ((v (jlist-from segments)))
                        (jl-sort v (lambda (a b) (- (.mark a) (.mark b))))
                        ;; TreeSet drops elements comparing equal to one already present
                        (let ((out (new-jlist)))
                          (loop for s across v
                                unless (and (plusp (length out)) (= (.mark (jl-last out)) (.mark s)))
                                  do (jl-add out s))
                          out)))
         (max-segments (new-jlist))
         (mark-base (length segments))
         (next-sink-mark (1- mark-base))
         (next-source-mark (1+ mark-base)))
    (loop until (jl-is-empty unprocessed)
          do (loop until (jl-is-empty sinks)
                   do (let ((sink (jl-remove-first sinks)))
                        (%p5-tree-set-remove unprocessed sink)
                        (setf (.mark sink) next-sink-mark)
                        (decf next-sink-mark)
                        (hyper-edge-cycle-detector.update-neighbors sink sources sinks critical-only)))
             (loop until (jl-is-empty sources)
                   do (let ((source (jl-remove-first sources)))
                        (%p5-tree-set-remove unprocessed source)
                        (setf (.mark source) next-source-mark)
                        (incf next-source-mark)
                        (hyper-edge-cycle-detector.update-neighbors source sources sinks critical-only)))
             (let ((max-outflow integer.min-value))
               (loop for segment across (copy-seq unprocessed)
                     do (when (and (not critical-only)
                                   (> (get-critical-out-weight segment) 0)
                                   (<= (get-critical-in-weight segment) 0))
                          (jl-clear max-segments)
                          (jl-add max-segments segment)
                          (return))
                        (let ((outflow (- (get-out-weight segment) (get-in-weight segment))))
                          (when (>= outflow max-outflow)
                            (when (> outflow max-outflow)
                              (jl-clear max-segments)
                              (setf max-outflow outflow))
                            (jl-add max-segments segment)))))
             (unless (jl-is-empty max-segments)
               (let ((max-node (jl-get max-segments (next-int random (length max-segments)))))
                 (%p5-tree-set-remove unprocessed max-node)
                 (setf (.mark max-node) next-source-mark)
                 (incf next-source-mark)
                 (hyper-edge-cycle-detector.update-neighbors max-node sources sinks critical-only)
                 (jl-clear max-segments))))
    ;; shift ranks that are left of the mark base so that sinks now have higher marks than sources
    (let ((shift-base (1+ (length segments))))
      (jdo (node segments)
        (when (< (.mark node) mark-base)
          (incf (.mark node) shift-base))))))

(defjstatic hyper-edge-cycle-detector.update-neighbors (node sources sinks critical-only)
  (jdo (dep (get-outgoing-segment-dependencies node))
    (when (or (not critical-only) (eq (get-type dep) dependency-type.critical))
      (let ((target (get-target dep)))
        (when (and (< (.mark target) 0) (> (get-weight dep) 0))
          (set-in-weight target (- (get-in-weight target) (get-weight dep)))
          (when (eq (get-type dep) dependency-type.critical)
            (set-critical-in-weight target (- (get-critical-in-weight target) (get-weight dep))))
          (when (and (<= (get-in-weight target) 0) (> (get-out-weight target) 0))
            (jl-add sources target))))))
  (jdo (dep (get-incoming-segment-dependencies node))
    (when (or (not critical-only) (eq (get-type dep) dependency-type.critical))
      (let ((source (get-source dep)))
        (when (and (< (.mark source) 0) (> (get-weight dep) 0))
          (set-out-weight source (- (get-out-weight source) (get-weight dep)))
          (when (eq (get-type dep) dependency-type.critical)
            (set-critical-out-weight source (- (get-critical-out-weight source) (get-weight dep))))
          (when (and (<= (get-out-weight source) 0) (> (get-in-weight source) 0))
            (jl-add sinks source)))))))

;;; ======================================================================
;;; HyperEdgeSegmentSplitter
;;; ======================================================================

(defjctor free-area (start-position end-position)
  (setf (.start-position this) start-position
        (.end-position this) end-position
        (.size this) (- end-position start-position)))

(defjctor area-rating (dependencies crossings)
  (setf (.dependencies this) dependencies
        (.crossings this) crossings))

(defjctor hyper-edge-segment-splitter (routing-generator)
  (setf (.routing-generator this) routing-generator))

(defjmethod split-segments ((this hyper-edge-segment-splitter) dependencies-to-resolve segments critical-conflict-threshold)
  (when (jl-is-empty dependencies-to-resolve)
    (return-from split-segments nil))
  (let* ((free-areas (find-free-areas this segments critical-conflict-threshold))
         (segments-to-split (decide-which-segments-to-split this dependencies-to-resolve))
         (sorted (jl-sort (jlist-from segments-to-split)
                          (lambda (a b) (double.compare (get-length a) (get-length b))))))
    (jdo (segment sorted)
      (split this segment segments free-areas critical-conflict-threshold))))

(defjmethod find-free-areas ((this hyper-edge-segment-splitter) segments critical-conflict-threshold)
  (let ((free-areas (new-jlist))
        (coords '()))
    (jdo (s segments) (jdo (c (get-incoming-connection-coordinates s)) (push c coords)))
    (jdo (s segments) (jdo (c (get-outgoing-connection-coordinates s)) (push c coords)))
    (let ((sorted (sort (coerce (nreverse coords) 'vector) (lambda (a b) (< (double.compare a b) 0)))))
      (loop for i from 1 below (length sorted)
            do (when (>= (- (aref sorted i) (aref sorted (1- i))) (* 2 critical-conflict-threshold))
                 (jl-add free-areas (new-free-area (+ (aref sorted (1- i)) critical-conflict-threshold)
                                                   (- (aref sorted i) critical-conflict-threshold))))))
    free-areas))

(defjmethod decide-which-segments-to-split ((this hyper-edge-segment-splitter) dependencies)
  ;; LinkedHashSet<HyperEdgeSegment> (equality by mark): a list searched with EQUALS
  (let ((segments-to-split (new-jlist)))
    (jdo (dependency dependencies)
      (let ((source-segment (get-source dependency))
            (target-segment (get-target dependency)))
        (unless (or (jl-contains segments-to-split source-segment)
                    (jl-contains segments-to-split target-segment))
          (let ((segment-to-split source-segment)
                (segment-causing-split target-segment))
            (when (and (represents-hyperedge source-segment) (not (represents-hyperedge target-segment)))
              (setf segment-to-split target-segment
                    segment-causing-split source-segment))
            (jl-add segments-to-split segment-to-split)
            (set-split-by segment-to-split segment-causing-split)))))
    segments-to-split))

(defjmethod split ((this hyper-edge-segment-splitter) segment segments free-areas critical-conflict-threshold)
  (let ((split-position (compute-position-to-split-and-update-free-areas
                         this segment free-areas critical-conflict-threshold)))
    (jl-add segments (split-at segment split-position))
    (update-dependencies this segment segments)))

(defjmethod update-dependencies ((this hyper-edge-segment-splitter) segment segments)
  (let ((split-causing-segment (get-split-by segment))
        (split-partner (get-split-partner segment)))
    (hyper-edge-segment-dependency.create-and-add-critical segment split-causing-segment)
    (hyper-edge-segment-dependency.create-and-add-critical split-causing-segment split-partner)
    (jdo (other-segment segments)
      (unless (or (eq other-segment split-causing-segment)
                  (eq other-segment segment)
                  (eq other-segment split-partner))
        (create-dependency-if-necessary (.routing-generator this) other-segment segment)
        (create-dependency-if-necessary (.routing-generator this) other-segment split-partner)))))

(defjmethod compute-position-to-split-and-update-free-areas ((this hyper-edge-segment-splitter) segment free-areas critical-conflict-threshold)
  (let ((first-possible-area-index -1)
        (last-possible-area-index -1))
    (loop for i from 0 below (length free-areas)
          for curr-area = (aref free-areas i)
          do (cond ((> (.start-position curr-area) (get-end-coordinate segment)) (return))
                   ((>= (.end-position curr-area) (get-start-coordinate segment))
                    (when (< first-possible-area-index 0)
                      (setf first-possible-area-index i))
                    (setf last-possible-area-index i))))
    (let ((split-position (hyper-edge-segment-splitter.center segment)))
      (when (>= first-possible-area-index 0)
        (let ((best-area-index (choose-best-area-index this segment free-areas
                                                       first-possible-area-index last-possible-area-index)))
          (setf split-position (hyper-edge-segment-splitter.center (jl-get free-areas best-area-index)))
          (use-area this free-areas best-area-index critical-conflict-threshold)))
      split-position)))

(defjmethod choose-best-area-index ((this hyper-edge-segment-splitter) segment free-areas from-index to-index)
  (let ((best-area-index from-index))
    (when (< from-index to-index)
      (let* ((split-segments (simulate-split segment))
             (split-segment (get-first split-segments))
             (split-partner (get-second split-segments))
             (best-area (jl-get free-areas best-area-index))
             (best-rating (rate-area this segment split-segment split-partner best-area)))
        (loop for i from (1+ from-index) to to-index
              do (let* ((curr-area (jl-get free-areas i))
                        (curr-rating (rate-area this segment split-segment split-partner curr-area)))
                   (when (is-better this curr-area curr-rating best-area best-rating)
                     (setf best-area curr-area
                           best-rating curr-rating
                           best-area-index i))))))
    best-area-index))

(defjmethod rate-area ((this hyper-edge-segment-splitter) segment split-segment split-partner area)
  (let ((area-centre (hyper-edge-segment-splitter.center area)))
    (jl-clear (get-outgoing-connection-coordinates split-segment))
    (jl-add (get-outgoing-connection-coordinates split-segment) area-centre)
    (jl-clear (get-incoming-connection-coordinates split-partner))
    (jl-add (get-incoming-connection-coordinates split-partner) area-centre)
    (let ((rating (new-area-rating 0 0)))
      (jdo (dependency (get-incoming-segment-dependencies segment))
        (let ((other-segment (get-source dependency)))
          (update-considering-both-orderings this rating split-segment other-segment)
          (update-considering-both-orderings this rating split-partner other-segment)))
      (jdo (dependency (get-outgoing-segment-dependencies segment))
        (let ((other-segment (get-target dependency)))
          (update-considering-both-orderings this rating split-segment other-segment)
          (update-considering-both-orderings this rating split-partner other-segment)))
      (incf (.dependencies rating) 2)
      (incf (.crossings rating) (count-crossings-for-single-ordering this split-segment (get-split-by segment)))
      (incf (.crossings rating) (count-crossings-for-single-ordering this (get-split-by segment) split-partner))
      rating)))

(defjmethod update-considering-both-orderings ((this hyper-edge-segment-splitter) rating s1 s2)
  (let ((c12 (count-crossings-for-single-ordering this s1 s2))
        (c21 (count-crossings-for-single-ordering this s2 s1)))
    (if (= c12 c21)
        (when (> c12 0)
          (incf (.dependencies rating) 2)
          (incf (.crossings rating) c12))
        (progn
          (incf (.dependencies rating) 1)
          (incf (.crossings rating) (min c12 c21))))))

(defjmethod count-crossings-for-single-ordering ((this hyper-edge-segment-splitter) left right)
  (+ (orthogonal-routing-generator.count-crossings
      (get-outgoing-connection-coordinates left) (get-start-coordinate right) (get-end-coordinate right))
     (orthogonal-routing-generator.count-crossings
      (get-incoming-connection-coordinates right) (get-start-coordinate left) (get-end-coordinate left))))

(defjmethod is-better ((this hyper-edge-segment-splitter) curr-area curr-rating best-area best-rating)
  (cond ((< (.crossings curr-rating) (.crossings best-rating)) t)
        ((= (.crossings curr-rating) (.crossings best-rating))
         (cond ((< (.dependencies curr-rating) (.dependencies best-rating)) t)
               ((= (.dependencies curr-rating) (.dependencies best-rating))
                (> (.size curr-area) (.size best-area)))
               (t nil)))
        (t nil)))

(defjmethod use-area ((this hyper-edge-segment-splitter) free-areas used-area-index critical-conflict-threshold)
  (let ((old-area (jl-get free-areas used-area-index)))
    (jl-remove-at free-areas used-area-index)
    (when (>= (/ (.size old-area) 2) critical-conflict-threshold)
      (let* ((insert-index used-area-index)
             (old-area-centre (hyper-edge-segment-splitter.center old-area))
             (new-end1 (- old-area-centre critical-conflict-threshold)))
        (when (<= (.start-position old-area) (- old-area-centre critical-conflict-threshold))
          (jl-add-at free-areas insert-index (new-free-area (.start-position old-area) new-end1))
          (incf insert-index))
        (let ((new-start2 (+ old-area-centre critical-conflict-threshold)))
          (when (<= new-start2 (.end-position old-area))
            (jl-add-at free-areas insert-index (new-free-area new-start2 (.end-position old-area)))))))))

(defjstatic hyper-edge-segment-splitter.center (s)
  (etypecase s
    (hyper-edge-segment (hyper-edge-segment-splitter.center (get-start-coordinate s) (get-end-coordinate s)))
    (free-area (hyper-edge-segment-splitter.center (.start-position s) (.end-position s)))))

(defjstatic hyper-edge-segment-splitter.center (p1 p2)
  (/ (+ p1 p2) 2))

;;; ======================================================================
;;; OrthogonalRoutingGenerator
;;; ======================================================================

(defjconst orthogonal-routing-generator.tolerance 1d-3)
(defconstant +p5-critical-conflicts-detected+ -1)
(defconstant +p5-conflict-threshold-factor+ 0.5d0)
(defconstant +p5-critical-conflict-threshold-factor+ 0.2d0)
(defconstant +p5-conflict-penalty+ 1)
(defconstant +p5-crossing-penalty+ 16)

(defjctor orthogonal-routing-generator (direction edge-spacing debug-prefix)
  (setf (.routing-strategy this) (base-routing-direction-strategy.for-routing-direction direction)
        (.edge-spacing this) edge-spacing
        (.conflict-threshold this) (* +p5-conflict-threshold-factor+ edge-spacing)
        (.debug-prefix this) debug-prefix))

(defjmethod route-edges ((this orthogonal-routing-generator) monitor layered-graph source-layer-nodes
                         source-layer-index target-layer-nodes start-pos)
  (declare (ignore monitor source-layer-index))
  (let ((port-to-edge-segment-map (new-jmap))
        (edge-segments (new-jlist))
        (strategy (.routing-strategy this)))
    (create-hyper-edge-segments this source-layer-nodes (get-source-port-side strategy)
                                edge-segments port-to-edge-segment-map)
    (create-hyper-edge-segments this target-layer-nodes (get-target-port-side strategy)
                                edge-segments port-to-edge-segment-map)
    (setf (.critical-conflict-threshold this)
          (* +p5-critical-conflict-threshold-factor+ (minimum-horizontal-segment-distance this edge-segments)))
    (let ((critical-dependency-count 0))
      (loop for first-idx from 0 below (1- (length edge-segments))
            for first-segment = (aref edge-segments first-idx)
            do (loop for second-idx from (1+ first-idx) below (length edge-segments)
                     do (incf critical-dependency-count
                              (create-dependency-if-necessary this first-segment
                                                              (aref edge-segments second-idx)))))
      ;; (debug output omitted)
      (let ((random (get-property layered-graph layered-internal-properties.random)))
        (when (>= critical-dependency-count 2)
          (break-critical-cycles this edge-segments random))
        (orthogonal-routing-generator.break-non-critical-cycles edge-segments random))
      (orthogonal-routing-generator.topological-numbering edge-segments)
      (let ((rank-count -1))
        (jdo (node edge-segments)
          (unless (< (abs (- (get-start-coordinate node) (get-end-coordinate node)))
                     orthogonal-routing-generator.tolerance)
            (setf rank-count (max rank-count (get-routing-slot node)))
            (calculate-bend-points strategy node start-pos (.edge-spacing this))))
        (clear-created-junction-points strategy)
        (1+ rank-count)))))

(defjmethod minimum-horizontal-segment-distance ((this orthogonal-routing-generator) edge-segments)
  (let ((in '()) (out '()))
    (jdo (s edge-segments)
      (jdo (c (get-incoming-connection-coordinates s)) (push c in))
      (jdo (c (get-outgoing-connection-coordinates s)) (push c out)))
    (math.min (minimum-difference this (nreverse in))
              (minimum-difference this (nreverse out)))))

(defjmethod minimum-difference ((this orthogonal-routing-generator) numbers)
  (let* ((sorted (stable-sort (copy-list numbers) (lambda (a b) (< (double.compare a b) 0))))
         (distinct (let ((acc '()))
                     (dolist (x sorted (nreverse acc))
                       (unless (and acc (= 0 (double.compare (car acc) x)))
                         (push x acc)))))
         (min-difference double.max-value))
    (when (>= (length distinct) 2)
      (loop for (prev cur) on distinct while cur
            do (setf min-difference (math.min min-difference (- cur prev)))))
    min-difference))

(defjmethod create-hyper-edge-segments ((this orthogonal-routing-generator) nodes port-side hyper-edges
                                        port-to-hyper-edge-segment-map)
  (when nodes
    (jdo (node nodes)
      (jdo (port (get-ports node port-type.output port-side))
        (let ((hyper-edge (jm-get port-to-hyper-edge-segment-map port)))
          (when (null hyper-edge)
            (setf hyper-edge (new-hyper-edge-segment (.routing-strategy this)))
            (jl-add hyper-edges hyper-edge)
            (add-port-positions hyper-edge port port-to-hyper-edge-segment-map)))))))

(defjmethod create-dependency-if-necessary ((this orthogonal-routing-generator) he1 he2)
  (when (or (< (abs (- (get-start-coordinate he1) (get-end-coordinate he1))) orthogonal-routing-generator.tolerance)
            (< (abs (- (get-start-coordinate he2) (get-end-coordinate he2))) orthogonal-routing-generator.tolerance))
    (return-from create-dependency-if-necessary 0))
  (let* ((conflicts1 (count-conflicts this (get-outgoing-connection-coordinates he1)
                                      (get-incoming-connection-coordinates he2)))
         (conflicts2 (count-conflicts this (get-outgoing-connection-coordinates he2)
                                      (get-incoming-connection-coordinates he1)))
         (critical (or (= conflicts1 +p5-critical-conflicts-detected+)
                       (= conflicts2 +p5-critical-conflicts-detected+)))
         (critical-dependency-count 0))
    (if critical
        (progn
          (when (= conflicts1 +p5-critical-conflicts-detected+)
            (hyper-edge-segment-dependency.create-and-add-critical he2 he1)
            (incf critical-dependency-count))
          (when (= conflicts2 +p5-critical-conflicts-detected+)
            (hyper-edge-segment-dependency.create-and-add-critical he1 he2)
            (incf critical-dependency-count)))
        (let* ((crossings1 (+ (orthogonal-routing-generator.count-crossings
                               (get-outgoing-connection-coordinates he1)
                               (get-start-coordinate he2) (get-end-coordinate he2))
                              (orthogonal-routing-generator.count-crossings
                               (get-incoming-connection-coordinates he2)
                               (get-start-coordinate he1) (get-end-coordinate he1))))
               (crossings2 (+ (orthogonal-routing-generator.count-crossings
                               (get-outgoing-connection-coordinates he2)
                               (get-start-coordinate he1) (get-end-coordinate he1))
                              (orthogonal-routing-generator.count-crossings
                               (get-incoming-connection-coordinates he1)
                               (get-start-coordinate he2) (get-end-coordinate he2))))
               (dep-value1 (+ (* +p5-conflict-penalty+ conflicts1) (* +p5-crossing-penalty+ crossings1)))
               (dep-value2 (+ (* +p5-conflict-penalty+ conflicts2) (* +p5-crossing-penalty+ crossings2))))
          (cond ((< dep-value1 dep-value2)
                 (hyper-edge-segment-dependency.create-and-add-regular he1 he2 (- dep-value2 dep-value1)))
                ((> dep-value1 dep-value2)
                 (hyper-edge-segment-dependency.create-and-add-regular he2 he1 (- dep-value1 dep-value2)))
                ((and (> dep-value1 0) (> dep-value2 0))
                 (hyper-edge-segment-dependency.create-and-add-regular he1 he2 0)
                 (hyper-edge-segment-dependency.create-and-add-regular he2 he1 0)))))
    critical-dependency-count))

(defjmethod count-conflicts ((this orthogonal-routing-generator) posis1 posis2)
  (let ((conflicts 0))
    (when (and (plusp (length posis1)) (plusp (length posis2)))
      (let ((i1 1) (i2 1)
            (pos1 (aref posis1 0))
            (pos2 (aref posis2 0))
            (cct (.critical-conflict-threshold this))
            (ct (.conflict-threshold this)))
        (loop
          (cond ((and (> pos1 (- pos2 cct)) (< pos1 (+ pos2 cct)))
                 (return-from count-conflicts -1))
                ((and (> pos1 (- pos2 ct)) (< pos1 (+ pos2 ct)))
                 (incf conflicts)))
          (cond ((and (<= pos1 pos2) (< i1 (length posis1)))
                 (setf pos1 (aref posis1 i1)) (incf i1))
                ((and (<= pos2 pos1) (< i2 (length posis2)))
                 (setf pos2 (aref posis2 i2)) (incf i2))
                (t (return))))))
    conflicts))

(defjstatic orthogonal-routing-generator.count-crossings (posis start end)
  (let ((crossings 0))
    (jdo (pos posis)
      (cond ((> pos end) (return))
            ((>= pos start) (incf crossings))))
    crossings))

(defjmethod break-critical-cycles ((this orthogonal-routing-generator) edge-segments random)
  (let ((cycle-dependencies (hyper-edge-cycle-detector.detect-cycles edge-segments t random)))
    (when (null (.segment-splitter this))
      (setf (.segment-splitter this) (new-hyper-edge-segment-splitter this)))
    (split-segments (.segment-splitter this) cycle-dependencies edge-segments
                    (.critical-conflict-threshold this))))

(defjstatic orthogonal-routing-generator.break-non-critical-cycles (edge-segments random)
  (let ((cycle-dependencies (hyper-edge-cycle-detector.detect-cycles edge-segments nil random)))
    (jdo (cycle-dependency cycle-dependencies)
      (if (= (get-weight cycle-dependency) 0)
          (j-remove cycle-dependency)
          (j-reverse cycle-dependency)))))

(defjstatic orthogonal-routing-generator.topological-numbering (segments)
  (let ((sources (new-jlist))
        (rightward-targets (new-jlist)))
    (jdo (node segments)
      (set-in-weight node (length (get-incoming-segment-dependencies node)))
      (set-out-weight node (length (get-outgoing-segment-dependencies node)))
      (when (= (get-in-weight node) 0)
        (jl-add sources node))
      (when (and (= (get-out-weight node) 0)
                 (= (length (get-incoming-connection-coordinates node)) 0))
        (jl-add rightward-targets node)))
    (let ((max-rank -1))
      (loop until (jl-is-empty sources)
            do (let ((node (jl-remove-at sources 0)))
                 (jdo (dep (get-outgoing-segment-dependencies node))
                   (let ((target (get-target dep)))
                     (set-routing-slot target (max (get-routing-slot target) (1+ (get-routing-slot node))))
                     (setf max-rank (max max-rank (get-routing-slot target)))
                     (set-in-weight target (1- (get-in-weight target)))
                     (when (= (get-in-weight target) 0)
                       (jl-add sources target))))))
      (when (> max-rank -1)
        (jdo (node rightward-targets)
          (set-routing-slot node max-rank))
        (loop until (jl-is-empty rightward-targets)
              do (let ((node (jl-remove-at rightward-targets 0)))
                   (jdo (dep (get-incoming-segment-dependencies node))
                     (let ((source (get-source dep)))
                       (unless (> (length (get-incoming-connection-coordinates source)) 0)
                         (set-routing-slot source (min (get-routing-slot source) (1- (get-routing-slot node))))
                         (set-out-weight source (1- (get-out-weight source)))
                         (when (= (get-out-weight source) 0)
                           (jl-add rightward-targets source)))))))))))

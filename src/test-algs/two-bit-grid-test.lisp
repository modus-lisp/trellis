;;;; two-bit-grid-test.lisp -- port of org.eclipse.elk.alg.disco.test.TwoBitGridTest.

(in-package #:elk)

(defun %tbg-setup () (new-two-bit-grid 35 3))

(defalgtest two-bit-grid-test dimension-test
  (let* ((test-grid (%tbg-setup))
         (second-grid (new-two-bit-grid 64 64)))
    (assert-equals 35 (get-width test-grid))
    (assert-equals 3 (get-height test-grid))
    (assert-equals 64 (get-width second-grid))
    (assert-equals 64 (get-height second-grid))))

(defalgtest two-bit-grid-test in-bounds-test
  (let ((test-grid (%tbg-setup)))
    (assert-true (in-bounds test-grid 0 0))
    (assert-false (in-bounds test-grid -1 0))
    (assert-false (in-bounds test-grid 0 -1))
    (assert-false (in-bounds test-grid -1 -1))
    (assert-true (in-bounds test-grid 34 2))
    (assert-false (in-bounds test-grid 34 3))
    (assert-false (in-bounds test-grid 35 2))
    (assert-false (in-bounds test-grid 35 3))
    (assert-true (in-bounds test-grid 17 1))))

(defalgtest two-bit-grid-test cell-test
  (let ((test-grid (%tbg-setup)))
    (assert-true (is-empty test-grid 0 0))
    (assert-true (is-empty test-grid 34 2))
    (set-blocked test-grid 0 0)
    (assert-true (is-blocked test-grid 0 0))
    (assert-false (is-empty test-grid 0 0))
    (assert-false (is-weakly-blocked test-grid 0 0))
    (set-weakly-blocked test-grid 1 0)
    (assert-true (is-blocked test-grid 0 0))
    (assert-false (is-empty test-grid 0 0))
    (assert-false (is-weakly-blocked test-grid 0 0))
    (assert-false (is-blocked test-grid 1 0))
    (assert-false (is-empty test-grid 1 0))
    (assert-true (is-weakly-blocked test-grid 1 0))
    (set-empty test-grid 0 0)
    (assert-false (is-blocked test-grid 0 0))
    (assert-true (is-empty test-grid 0 0))
    (assert-false (is-weakly-blocked test-grid 0 0))
    (assert-false (is-blocked test-grid 1 0))
    (assert-false (is-empty test-grid 1 0))
    (assert-true (is-weakly-blocked test-grid 1 0))
    (assert-true (is-empty test-grid 33 2))
    (set-blocked test-grid 33 2)
    (assert-false (is-blocked test-grid 0 0))
    (assert-true (is-empty test-grid 0 0))
    (assert-false (is-weakly-blocked test-grid 0 0))
    (assert-false (is-blocked test-grid 1 0))
    (assert-false (is-empty test-grid 1 0))
    (assert-true (is-weakly-blocked test-grid 1 0))
    (assert-false (is-blocked test-grid 1 0))
    (assert-false (is-empty test-grid 1 0))
    (assert-true (is-weakly-blocked test-grid 1 0))
    (assert-true (is-blocked test-grid 33 2))
    (assert-false (is-empty test-grid 33 2))
    (assert-false (is-weakly-blocked test-grid 33 2))
    (let ((g (new-two-bit-grid 64 64)))
      (dotimes (yi (get-height g)) (dotimes (xi (get-width g)) (set-blocked g xi yi)))
      (dotimes (yi (get-height g)) (dotimes (xi (get-width g)) (assert-true (is-blocked g xi yi))))
      (dotimes (yi (get-height g)) (dotimes (xi (get-width g)) (set-weakly-blocked g xi yi)))
      (dotimes (yi (get-height g)) (dotimes (xi (get-width g)) (assert-true (is-weakly-blocked g xi yi))))
      (dotimes (yi (get-height g)) (dotimes (xi (get-width g)) (set-empty g xi yi)))
      (dotimes (yi (get-height g)) (dotimes (xi (get-width g)) (assert-true (is-empty g xi yi)))))))

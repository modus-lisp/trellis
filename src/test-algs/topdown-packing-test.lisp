;;;; topdown-packing-test.lisp -- port of org.eclipse.elk.alg.topdown.test.TopdownPackingTest.

(in-package #:elk)

(defun %tdp-create-graph (n)
  (let ((graph (elk-graph-util.create-graph)))
    (dotimes (i n) (elk-graph-util.create-node graph))
    graph))

(defun %tdp-child (graph i) (j-get (get-children graph) i))

(defun %tdp-assert-box (node x y w h)
  (assert-near x (get-x node) 0.00001)
  (assert-near y (get-y node) 0.00001)
  (assert-near w (get-width node) 0.00001)
  (assert-near h (get-height node) 0.00001))

(defalgtest topdown-packing-test test-empty-graph
  (algs-init)
  (let ((graph (elk-graph-util.create-graph)))
    (layout (new-topdownpacking-layout-provider) graph (new-basic-progress-monitor))))

(defalgtest topdown-packing-test test-two-nodes
  (algs-init)
  (let* ((graph (%tdp-create-graph 2))
         (hw (get-property graph core-options.topdown-hierarchical-node-width))
         (ar (get-property graph core-options.topdown-hierarchical-node-aspect-ratio))
         (padding (get-property graph core-options.padding))
         (nns (get-property graph core-options.spacing-node-node))
         (provider (new-topdownpacking-layout-provider))
         (predicted (get-predicted-graph-size provider graph)))
    (assert-near (+ (.left padding) (* 2 hw) nns (.right padding)) (.x predicted) 0.00001)
    (assert-near (+ (.top padding) (/ hw ar) (.bottom padding)) (.y predicted) 0.00001)
    (layout provider graph (new-basic-progress-monitor))
    (let ((c1 (%tdp-child graph 0)) (c2 (%tdp-child graph 1)))
      (%tdp-assert-box c1 (.left padding) (.top padding) hw (/ hw ar))
      (%tdp-assert-box c2 (+ (.left padding) hw nns) (.top padding) hw (/ hw ar)))))

(defalgtest topdown-packing-test test-three-nodes
  (algs-init)
  (let* ((graph (%tdp-create-graph 3))
         (hw (get-property graph core-options.topdown-hierarchical-node-width))
         (ar (get-property graph core-options.topdown-hierarchical-node-aspect-ratio))
         (padding (get-property graph core-options.padding))
         (nns (get-property graph core-options.spacing-node-node))
         (provider (new-topdownpacking-layout-provider))
         (predicted (get-predicted-graph-size provider graph)))
    (assert-near (+ (.left padding) (* 2 hw) nns (.right padding)) (.x predicted) 0.00001)
    (assert-near (+ (.top padding) (* 2 (/ hw ar)) nns (.bottom padding)) (.y predicted) 0.00001)
    (layout provider graph (new-basic-progress-monitor))
    (let ((c1 (%tdp-child graph 0)) (c2 (%tdp-child graph 1)) (c3 (%tdp-child graph 2)))
      (%tdp-assert-box c1 (.left padding) (.top padding) hw (/ hw ar))
      (%tdp-assert-box c2 (+ (.left padding) hw nns) (.top padding) hw (/ hw ar))
      (%tdp-assert-box c3 (.left padding) (+ (.top padding) (/ hw ar) nns) (+ (* 2 hw) nns) (/ hw ar)))))

(defalgtest topdown-packing-test test-five-nodes
  (algs-init)
  (let* ((graph (%tdp-create-graph 5))
         (hw (get-property graph core-options.topdown-hierarchical-node-width))
         (ar (get-property graph core-options.topdown-hierarchical-node-aspect-ratio))
         (padding (get-property graph core-options.padding))
         (nns (get-property graph core-options.spacing-node-node))
         (provider (new-topdownpacking-layout-provider))
         (predicted (get-predicted-graph-size provider graph)))
    (assert-near (+ (.left padding) (* 3 hw) (* 2 nns) (.right padding)) (.x predicted) 0.00001)
    (assert-near (+ (.top padding) (* 2 (/ hw ar)) nns (.bottom padding)) (.y predicted) 0.00001)
    (layout provider graph (new-basic-progress-monitor))
    (let* ((expanded (+ hw (* 0.5d0 (+ hw nns))))
           (c4 (%tdp-child graph 3))
           (c5 (%tdp-child graph 4)))
      (%tdp-assert-box c4 (.left padding) (+ (.top padding) (/ hw ar) nns) expanded (/ hw ar))
      (layout provider graph (new-basic-progress-monitor))
      (%tdp-assert-box c5 (+ (.left padding) expanded nns) (+ (.top padding) (/ hw ar) nns)
                       expanded (/ hw ar)))))

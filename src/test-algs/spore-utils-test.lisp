;;;; spore-utils-test.lisp -- port of org.eclipse.elk.alg.spore.test.UtilsTest.

(in-package #:elk)

(defun %su-inf-p (x)
  (or (= x double.positive-infinity) (= x double.negative-infinity)))

(defun %su-test-overlap-computation (r1 r2)
  "Move R2 along the centre line so it no longer overlaps R1 and check the distance >= 0."
  (let* ((o (utils.overlap r1 r2))
         (c1 (get-center r1))
         (c2 (get-center r2))
         (d (sub (clone c2) c1))
         (c3 (add (clone c1) (scale d o)))
         (r3 (new-elk-rectangle r2)))
    (move r3 (sub (clone c3) c2))
    (common-compare-fuzzy.ge (elk-math.shortest-distance r1 r3) 0.0)))

(defalgtest utils-test overlap-test
  (let* ((r1 (new-elk-rectangle 0 0 40 80))
         (rs (jlist (new-elk-rectangle 0 0 70 20)
                    (new-elk-rectangle 10 50 70 20)
                    (new-elk-rectangle -40 30 70 20)
                    (new-elk-rectangle -60 70 70 20)
                    (new-elk-rectangle -10 70 70 20)
                    (new-elk-rectangle -20 -10 70 20)
                    (new-elk-rectangle 10 20 20 20)
                    (new-elk-rectangle -20 -20 100 120)
                    (new-elk-rectangle 0 -0.001 40 80))))
    (jdo (r rs) (assert-true (%su-test-overlap-computation r1 r)))))

(defun %su-test-underlap-computation (r1 r2)
  (let* ((n1 (new-node (get-center r1) r1))
         (n2 (new-node (get-center r2) r2))
         (underlap (underlap n1 n2)))
    ;; The underlap equals the distance in the direction of the centres.
    (assert-true (common-compare-fuzzy.eq underlap (distance n1 n2 (sub (clone (.vertex n1)) (.vertex n2)))))
    (translate n2 (scale-to-length (sub (clone (.vertex n1)) (.vertex n2)) underlap))
    (common-compare-fuzzy.eq (elk-math.shortest-distance (.rect n1) (.rect n2)) 0.0)))

(defalgtest utils-test underlap-test
  (let* ((r1 (new-elk-rectangle 0 0 20 60))
         (rectangles (jlist (new-elk-rectangle 40 20 20 20)
                            (new-elk-rectangle 40 40 20 20)
                            (new-elk-rectangle 30 70 20 20)
                            (new-elk-rectangle 20 80 20 20)
                            (new-elk-rectangle 10 80 20 20)
                            (new-elk-rectangle 0 80 20 20)
                            (new-elk-rectangle -30 70 20 20)
                            (new-elk-rectangle -40 40 20 20)
                            (new-elk-rectangle -40 20 20 20)
                            (new-elk-rectangle -30 -20 20 20)
                            (new-elk-rectangle -20 -40 20 20)
                            (new-elk-rectangle 0 -30 20 20)
                            (new-elk-rectangle 30 -30 20 20)
                            (new-elk-rectangle 20 0 20 20)
                            (new-elk-rectangle 0 60 20 20))))
    (jdo (r rectangles) (assert-true (%su-test-underlap-computation r1 r)))))

(defalgtest utils-test distance-test
  (let* ((r1 (new-elk-rectangle 0 0 20 60))
         (rectangles (jlist (new-elk-rectangle 40 20 20 20)
                            (new-elk-rectangle 40 40 20 20)
                            (new-elk-rectangle 30 70 20 20)
                            (new-elk-rectangle 20 80 20 20)
                            (new-elk-rectangle 10 80 20 20)
                            (new-elk-rectangle 0 80 20 20)
                            (new-elk-rectangle -30 70 20 20)
                            (new-elk-rectangle -40 40 20 20)
                            (new-elk-rectangle -40 20 20 20)
                            (new-elk-rectangle -30 -20 20 20)
                            (new-elk-rectangle -20 -40 20 20)
                            (new-elk-rectangle 0 -30 20 20)
                            (new-elk-rectangle 30 -30 20 20)
                            (new-elk-rectangle 20 0 20 20)
                            (new-elk-rectangle 0 60 20 20)))
         ;; (direction . should-collide)
         (vectors (list (cons (new-k-vector -20 20) t)
                        (cons (new-k-vector -80 0) nil)
                        (cons (new-k-vector -20 9) nil)
                        (cons (new-k-vector 0 50) nil)
                        (cons (new-k-vector -9.99 50) nil)
                        (cons (new-k-vector 60 60) nil)
                        (cons (new-k-vector -30 50) t)
                        (cons (new-k-vector -20 130) t)
                        (cons (new-k-vector -20 -21) nil)))
         (n1 (new-node (get-center r1) r1)))
    (declare (ignorable rectangles))
    (dolist (v vectors)
      (let* ((n2 (new-node (get-center (jl-get rectangles 12))
                           (new-elk-rectangle (jl-get rectangles 12))))
             (distance (distance n1 n2 (car v))))
        (if (cdr v)
            (progn
              (translate n2 (scale-to-length (car v) distance))
              (assert-true (common-compare-fuzzy.eq (elk-math.shortest-distance (.rect n1) (.rect n2)) 0.0)))
            (assert-true (%su-inf-p distance)))))))

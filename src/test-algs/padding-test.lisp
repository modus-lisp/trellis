;;;; padding-test.lisp -- port of org.eclipse.elk.alg.rectpacking.PaddingTest.

(in-package #:elk)

(defalgtest padding-test test-top-padding
  (let* ((parent (elk-graph-util.create-graph)) (n1 (elk-graph-util.create-node parent)) (n2 (elk-graph-util.create-node parent)) (n3 (elk-graph-util.create-node parent)) (n4 (elk-graph-util.create-node parent)))
    (set-property parent core-options.algorithm rect-packing-options.algorithm-id)
    (set-property parent rect-packing-options.aspect-ratio 1.3)
    (set-property parent core-options.spacing-node-node 10.0)
    (set-property parent core-options.padding (new-elk-padding 1000 0 0 0))
    (set-dimensions n1 30 30)
    (set-dimensions n2 30 30)
    (set-dimensions n3 30 30)
    (set-dimensions n4 30 30)
    (layout (new-rect-packing-layout-provider) parent (new-basic-progress-monitor))
    (assert-near 150.0 (get-width parent) 1)
    (assert-near 1030.0 (get-height parent) 1)
    (assert-near 0.0 (get-x n1) 1)
    (assert-near 1000.0 (get-y n1) 1)
    (assert-near 40.0 (get-x n2) 1)
    (assert-near 1000.0 (get-y n2) 1)
    (assert-near 80.0 (get-x n3) 1)
    (assert-near 1000.0 (get-y n3) 1)
    (assert-near 120.0 (get-x n4) 1)
    (assert-near 1000.0 (get-y n4) 1)))


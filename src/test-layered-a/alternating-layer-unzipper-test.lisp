    (layout layered-layout graph (new-null-elk-progress-monitor))
    (assert-true (< (get-x node1) (get-x node2)))
    (assert-true (< (get-x node1) (get-x node4)))
    (assert-true (< (get-x node3) (get-x node2)))
    (assert-true (< (get-x node3) (get-x node4)))
    (assert-true (< (get-x node2) (get-x node21)))
    (assert-true (< (get-x node2) (get-x node23)))
    (assert-true (< (get-x node4) (get-x node21)))
    (assert-true (< (get-x node4) (get-x node23)))
    (assert-true (< (get-x node21) (get-x node22)))
    (assert-true (< (get-x node23) (get-x node22)))))

(defun alternating-layer-unzipper-test.multiple-incoming-edges ()

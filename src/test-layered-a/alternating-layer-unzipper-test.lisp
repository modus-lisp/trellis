         (node1 (%la-node graph)) (node2 (%la-node graph)) (node3 (%la-node graph))
         (node4 (%la-node graph)) (node-final (%la-node graph)))
    (dotimes (i 5) (%la-edge node1 node2))
    (dotimes (i 4) (%la-edge node1 node3))
    (%la-edge node1 node4)
    (%la-edge node2 node-final) (%la-edge node3 node-final) (%la-edge node4 node-final)
    (%la-unzip-graph graph)

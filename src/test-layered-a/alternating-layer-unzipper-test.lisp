(defun alternating-layer-unzipper-test.reset-on-long-edges ()
  (let* ((layered-layout (%la-setup))
         (graph (elk-graph-util.create-graph))
         (node1 (%la-node graph)) (node2 (%la-node graph)) (node3 (%la-node graph))
         (node4 (%la-node graph)) (node5 (%la-node graph)))
    (%la-edge node1 node2) (%la-edge node1 node3)
    ;; long edge
    (%la-edge node1 node5)
    (%la-edge node1 node4) (%la-edge node4 node5)
    (%la-unzip-graph graph)
    (set-property node2 layered-options.layer-unzipping-layer-split 2)
    (set-property node2 layered-options.layer-unzipping-reset-on-long-edges t)
    (layout layered-layout graph (new-null-elk-progress-monitor))
    (assert-true (< (get-x node1) (get-x node2)))
    (assert-true (< (get-x node1) (get-x node4)))
    (assert-true (< (get-x node2) (get-x node3)))
    (assert-true (< (get-x node3) (get-x node5)))
    (assert-true (< (get-x node4) (get-x node3)))))

(defun alternating-layer-unzipper-test.no-reset-on-long-edges ()
  (let* ((layered-layout (%la-setup))
         (graph (elk-graph-util.create-graph))
         (node1 (%la-node graph)) (node2 (%la-node graph)) (node3 (%la-node graph))
         (node4 (%la-node graph)) (node5 (%la-node graph)) (node6 (%la-node graph)))
    (%la-edge node1 node2) (%la-edge node1 node3)
    ;; long edge
    (%la-edge node1 node5)
    (%la-edge node1 node4) (%la-edge node4 node5)
    (%la-edge node1 node6)
    (%la-unzip-graph graph)
    (set-property node2 layered-options.layer-unzipping-layer-split 2)
    (set-property node2 layered-options.layer-unzipping-reset-on-long-edges nil)
    (layout layered-layout graph (new-null-elk-progress-monitor))
    (assert-true (< (get-x node1) (get-x node2)))
    (assert-true (< (get-x node1) (get-x node6)))
    (assert-true (< (get-x node2) (get-x node3)))
    (assert-true (< (get-x node2) (get-x node4)))
    (assert-true (< (get-x node3) (get-x node5)))
    (assert-true (< (get-x node4) (get-x node5)))
    (assert-true (< (get-x node6) (get-x node3)))
    (assert-true (< (get-x node6) (get-x node4)))))


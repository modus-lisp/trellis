;;;; alternating-layer-unzipper-test.lisp -- port of
;;;; org.eclipse.elk.alg.layered.intermediate.AlternatingLayerUnzipperTest.
;;;; Plain JUnit class (@Before builds the layout provider); tests are functions,
;;;; run with (alternating-layer-unzipper-test.run-all).

(in-package #:elk)

(defun alternating-layer-unzipper-test.simple-two-split ()
  (let* ((layered-layout (%la-setup))
         (graph (elk-graph-util.create-graph))
         (node1 (%la-node graph)) (node2 (%la-node graph)) (node3 (%la-node graph))
         (node4 (%la-node graph)) (node-final (%la-node graph)))
    (%la-edge node1 node2) (%la-edge node1 node3) (%la-edge node1 node4)
    (%la-edge node2 node-final) (%la-edge node3 node-final) (%la-edge node4 node-final)
    (%la-unzip-graph graph)
    (set-property node2 layered-options.layer-unzipping-layer-split 2)
    (layout layered-layout graph (new-null-elk-progress-monitor))
    (assert-true (< (get-x node1) (get-x node2)))
    (assert-true (< (get-x node1) (get-x node4)))
    (assert-true (< (get-x node2) (get-x node3)))
    (assert-true (< (get-x node4) (get-x node3)))
    (assert-true (< (get-x node3) (get-x node-final)))))


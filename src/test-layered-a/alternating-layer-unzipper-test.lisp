         (node21 (%la-node graph)) (node22 (%la-node graph)) (node23 (%la-node graph)))
    (%la-edge node1 node21) (%la-edge node2 node21) (%la-edge node2 node22)
    (%la-edge node3 node21) (%la-edge node3 node22) (%la-edge node4 node22) (%la-edge node4 node23)
    (%la-unzip-graph graph)
    (set-property node1 layered-options.layer-unzipping-layer-split 2)

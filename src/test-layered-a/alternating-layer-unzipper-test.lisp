  (alternating-layer-unzipper-test.simple-three-split)
  (alternating-layer-unzipper-test.dangling-outgoing)
  (alternating-layer-unzipper-test.dangling-incoming)
  (alternating-layer-unzipper-test.multiple-layers-split)
  (alternating-layer-unzipper-test.multiple-incoming-edges)
  (alternating-layer-unzipper-test.multiple-outgoing-edges)
  (alternating-layer-unzipper-test.mixed-dangling-incoming)
  (alternating-layer-unzipper-test.mixed-dangling-outgoing)
  (alternating-layer-unzipper-test.mixed-two-three-layer-split)
  (alternating-layer-unzipper-test.reset-on-long-edges)
  (alternating-layer-unzipper-test.no-reset-on-long-edges))

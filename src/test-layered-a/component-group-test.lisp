;;;; component-group-test.lisp -- port of
;;;; org.eclipse.elk.alg.layered.components.ComponentGroupTest.  Plain JUnit
;;;; class: its tests are ordinary functions, run with (component-group-test.run-all).

(in-package #:elk)

(defun %cgt-generate-graph (connections)
  (let ((graph (new-l-graph)))
    (set-property graph layered-internal-properties.ext-port-connections connections)
    graph))

(defun component-group-test.test-valid-constraints ()
  (let ((group (new-component-group)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-south)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-south)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-west)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-west)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-east)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-east)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-none)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-none)))
    (setf group (new-component-group))
    (assert-true (add group (%cgt-generate-graph port-side.sides-east-west)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-east-west)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-west)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-west)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-east)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-east)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-none)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-none)))
    (setf group (new-component-group))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north-south)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north-south)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-south)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-south)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-none)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-none)))
    (setf group (new-component-group))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north-east-south-west)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north-west)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north-east)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-south-west)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-east-south)))))

(defun component-group-test.test-invalid-constraints ()
  (let ((group (new-component-group)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-east-west)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-south)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-south-west)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-east-south)))
    (setf group (new-component-group))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north-south)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-east-west)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-east-west)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-east-south-west)))
    (setf group (new-component-group))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north-west)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north-east)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-south-west)))
    (assert-true (add group (%cgt-generate-graph port-side.sides-east-south)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-east-south)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-east-west)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-east-south-west)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-south-west)))
    (setf group (new-component-group))
    (assert-true (add group (%cgt-generate-graph port-side.sides-north-east-south-west)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-none)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-south)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-east-west)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-east-south)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-east-west)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-east-south-west)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-south-west)))
    (assert-false (add group (%cgt-generate-graph port-side.sides-north-east-south-west)))))

(defun component-group-test.run-all ()
  (component-group-test.test-valid-constraints)
  (component-group-test.test-invalid-constraints))

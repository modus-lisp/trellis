(in-package #:elk)

(defun %cs-graph ()
  "The @Test preamble: a graph with the sort-by-input-model options, shared by every case."
  (let ((parent (elk-graph-util.create-graph)))
    (set-property parent core-options.algorithm layered-options.algorithm-id)
    (set-property parent layered-options.consider-model-order-strategy ordering-strategy.prefer-edges)
    (set-property parent layered-options.consider-model-order-port-model-order nil)
    (set-property parent layered-options.crossing-minimization-strategy crossing-minimization-strategy.none)
    (set-property parent layered-options.crossing-minimization-greedy-switch-type greedy-switch-type.off)
    (set-property parent core-options.direction core-direction.right)
    (set-property parent core-options.padding (new-elk-padding 0d0))
    (set-property parent core-options.spacing-node-node 10d0)
    (set-property parent layered-options.spacing-node-node-between-layers 20d0)
    (set-property parent layered-options.cycle-breaking-strategy cycle-breaking-strategy.model-order)
    parent))

(defun %cs-node (parent)
  "ElkGraphUtil.createNode(parent) with setDimensions(20, 20) and FIXED_SIDE port constraints."
  (let ((node (elk-graph-util.create-node parent)))
    (set-width node 20d0)
    (set-height node 20d0)
    (set-property node layered-options.port-constraints port-constraints.fixed-side)
    node))

(defun %cs-port (node side)
  "ElkGraphUtil.createPort(node) with LayeredOptions.PORT_SIDE set."
  (let ((port (elk-graph-util.create-port node)))
    (set-property port layered-options.port-side side)
    port))

(defun %cs-layout (parent null-monitor-p)
  "layoutProvider.layout(parent, monitor); the monitor is the Java one the test passes."
  (with-java-floats
    (layout (new-layered-layout-provider) parent
            (if null-monitor-p (new-null-elk-progress-monitor) (new-basic-progress-monitor)))))



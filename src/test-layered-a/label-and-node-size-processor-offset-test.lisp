;;;; label-and-node-size-processor-offset-test.lisp -- port of
;;;; org.eclipse.elk.alg.layered.intermediate.LabelAndNodeSizeProcessorOffsetTest.

(in-package #:elk)

(defun %lansopt-generate-node (graph port-constraints)
  ;; We need to set coordinates and don't want to add constants for them all
  (let ((node (elk-graph-util.create-node graph)))
    (set-property node layered-options.port-constraints port-constraints)
    (set-width node 100d0)
    ;; Create ports
    (let ((n-port (elk-graph-util.create-port node))
          (s-port (elk-graph-util.create-port node))
          (e-port (elk-graph-util.create-port node))
          (w-port (elk-graph-util.create-port node)))
      (set-property n-port layered-options.port-border-offset 0d0)
      (set-property n-port layered-options.port-side port-side.north)
      (set-x n-port 50d0)
      (set-y n-port -300d0)
      (set-property s-port layered-options.port-border-offset 0d0)
      (set-property s-port layered-options.port-side port-side.south)
      (set-x s-port 50d0)
      (set-y s-port 300d0)
      (set-property e-port layered-options.port-border-offset 0d0)
      (set-property e-port layered-options.port-side port-side.east)
      (set-x e-port 300d0)
      (set-y e-port 50d0)
      (set-property w-port layered-options.port-border-offset 0d0)
      (set-property w-port layered-options.port-side port-side.west)
      (set-x w-port -300d0)
      (set-y w-port 50d0))
    node))

(defun %lansopt-error-message (port)
  (format nil "Port (~A) does not touch border of node with port constraints ~A"
          (get-side port) (get-property (get-node port) layered-options.port-constraints)))

(deflayouttest label-and-node-size-processor-offset-test
  (:algorithm "org.eclipse.elk.layered")
  (:default-configuration)
  (:graph produce-graph ()
    (let ((graph (elk-graph-util.create-graph)))
      (%lansopt-generate-node graph port-constraints.free)
      (%lansopt-generate-node graph port-constraints.fixed-side)
      (%lansopt-generate-node graph port-constraints.fixed-order)
      (%lansopt-generate-node graph port-constraints.fixed-ratio)
      (%lansopt-generate-node graph port-constraints.fixed-pos)
      graph))
  (:after-processor test-port-positions
    (:processors (label-and-node-size-processor)) (graph)
    (jdo (layer graph)
      (jdo (node layer)
        (jdo (port (get-ports node))
          (let ((side (get-side port)))
            (cond
              ((eq side port-side.north)
               (%la-assert-equals-delta (%lansopt-error-message port)
                                        (- (.y (get-size port)))
                                        (.y (get-position port)) 0d0))
              ((eq side port-side.south)
               (%la-assert-equals-delta (%lansopt-error-message port)
                                        (.y (get-size node))
                                        (.y (get-position port)) 0d0))
              ((eq side port-side.east)
               (%la-assert-equals-delta (%lansopt-error-message port)
                                        (.x (get-size node))
                                        (.x (get-position port)) 0d0))
              ((eq side port-side.west)
               (%la-assert-equals-delta (%lansopt-error-message port)
                                        (- (.x (get-size port)))
                                        (.x (get-position port)) 0d0))))))))

;;;; between-layer-edge-two-node-crossings-counter-test.lisp -- port of
;;;; org.eclipse.elk.alg.layered.intermediate.greedyswitch.BetweenLayerEdgeTwoNodeCrossingsCounterTest.
;;;; A plain JUnit class extending the greedy-switch TestGraphCreator (no @Before),
;;;; so each @Test is a defun that makes its own instance (THIS).
;;;; (between-layer-edge-two-node-crossings-counter-test.run-all) runs every test.

(in-package #:elk)

(defjclass between-layer-edge-two-node-crossings-counter-test (layered-greedyswitch-test-graph-creator)
  ((crossing-counter nil)
   (upper-node nil)
   (lower-node nil)
   (layer-to-count-in nil)
   (node-order nil)))

(defjctor between-layer-edge-two-node-crossings-counter-test ()
  nil)

(defun %bl-fail-message (this configuration)
  (format nil "With configuration: ~A in Layer ~A between the nodes: Upper node ~A and lower Node ~A"
          configuration (.layer-to-count-in this)
          (get-index (.upper-node this)) (get-index (.lower-node this))))

(defun %bl-assert (this configuration expected-crossings crossings)
  (assert-equals/2 (%bl-fail-message this configuration) expected-crossings crossings))

(defun %bl-set-upper-node (this node-index)
  (setf (.upper-node this) (jl-get (get-nodes (.layer-to-count-in this)) node-index)))

(defun %bl-set-lower-node (this node-index)
  (setf (.lower-node this) (jl-get (get-nodes (.layer-to-count-in this)) node-index)))

(defun %bl-east-upper-lower-is (this expected)
  (count-eastern-edge-crossings (.crossing-counter this) (.upper-node this) (.lower-node this))
  (%bl-assert this " east, upper lower " expected (get-upper-lower-crossings (.crossing-counter this))))

(defun %bl-east-lower-upper-is (this expected)
  (count-eastern-edge-crossings (.crossing-counter this) (.upper-node this) (.lower-node this))
  (%bl-assert this " east, lower upper " expected (get-lower-upper-crossings (.crossing-counter this))))

(defun %bl-west-upper-lower-is (this expected)
  (count-western-edge-crossings (.crossing-counter this) (.upper-node this) (.lower-node this))
  (%bl-assert this " west, upper lower " expected (get-upper-lower-crossings (.crossing-counter this))))

(defun %bl-west-lower-upper-is (this expected)
  (count-western-edge-crossings (.crossing-counter this) (.upper-node this) (.lower-node this))
  (%bl-assert this " west, lower upper " expected (get-lower-upper-crossings (.crossing-counter this))))

(defun %bl-both-lower-upper-is (this expected)
  (count-both-side-crossings (.crossing-counter this) (.upper-node this) (.lower-node this))
  (%bl-assert this " both, lower upper " expected (get-lower-upper-crossings (.crossing-counter this))))

(defun %bl-both-upper-lower-is (this expected)
  (count-both-side-crossings (.crossing-counter this) (.upper-node this) (.lower-node this))
  (%bl-assert this " both, upper lower " expected (get-upper-lower-crossings (.crossing-counter this))))

(defun %bl-prepare (this layer-index)
  "nodeOrder = getGraph().toNodeArray(); layerToCountIn = layer; new counter(nodeOrder, layerIndex)."
  (setf (.node-order this) (to-node-array (get-graph this)))
  (setf (.layer-to-count-in this) (jl-get (get-layers (get-graph this)) layer-index))
  (setf (.crossing-counter this)
        (new-between-layer-edge-two-node-crossings-counter (.node-order this) layer-index)))


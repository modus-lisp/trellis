(defun between-layer-edge-two-node-crossings-counter-test.multiple-edges-into-same-port-causes-no-crossings ()
  (let* ((this (new-between-layer-edge-two-node-crossings-counter-test))
         (left-layer (make-layer this (get-graph this)))
         (right-layer (make-layer this (get-graph this)))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (bottom-right (add-node-to-layer this right-layer))
         (bottom-right-port (add-port-on-side this bottom-right port-side.west)))
    (east-west-edge-from-to this top-left bottom-right-port)
    (east-west-edge-from-to this top-left bottom-right-port)
    (east-west-edge-from-to this bottom-left bottom-right-port)
    (set-up-ids this)
    (%bl-prepare this 0)
    (%bl-set-upper-node this 0)
    (%bl-set-lower-node this 1)
    (%bl-east-upper-lower-is this 0)
    ;; Java asserts the eastern upper-lower count a second time here; ported 1:1.
    (%bl-east-upper-lower-is this 0)))

;; @Ignore in Java: not run by run-all.
(defun between-layer-edge-two-node-crossings-counter-test.partly-fixed-partly-unfixed-port-order ()
  (let* ((this (new-between-layer-edge-two-node-crossings-counter-test))
         (left-node (add-node-to-layer this (make-layer this (get-graph this))))
         (right-nodes (add-nodes-to-layer this 2 (make-layer this (get-graph this)))))
    (set-fixed-order-constraint this (aref right-nodes 0))
    (set-fixed-order-constraint this (aref right-nodes 1))
    (let* ((left-top-port (add-port-on-side this left-node port-side.east))
           (left-lower-port (add-port-on-side this left-node port-side.east))
           (right-upper-node-lower-port (add-port-on-side this (aref right-nodes 0) port-side.west))
           (right-upper-node-top-port (add-port-on-side this (aref right-nodes 0) port-side.west))
           (right-lower-port (add-port-on-side this (aref right-nodes 1) port-side.west)))
      (add-edge-between-ports this left-top-port right-upper-node-top-port)
      (add-edge-between-ports this left-top-port right-lower-port)
      (add-edge-between-ports this left-lower-port right-upper-node-lower-port))
    (%bl-prepare this 1)
    (%bl-set-upper-node this 0)
    (%bl-set-lower-node this 1)
    (%bl-both-upper-lower-is this 1)))


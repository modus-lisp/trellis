;;;; greedy-switch-processor-test.lisp -- port of
;;;; org.eclipse.elk.alg.layered.intermediate.greedyswitch.GreedySwitchProcessorTest.
;;;; A @RunWith(Parameterized) class extending the greedy-switch TestGraphCreator:
;;;; each test is a defun that makes its own instance (THIS) and the
;;;; greedy-switch-processor-test.run-all function runs every test once per
;;;; parameter row (ONE_SIDED_GREEDY_SWITCH, TWO_SIDED_GREEDY_SWITCH).
;;;; Hamcrest is(List) on node lists is an element-wise identity comparison here.

(in-package #:elk)

(defjclass greedy-switch-processor-test (layered-greedyswitch-test-graph-creator)
  ((greedy-switcher nil)
   (monitor nil)
   (greedy-type nil)))

(defjctor greedy-switch-processor-test (gt)
  (setf (.greedy-type this) gt)
  (setf (.greedy-switcher this) (new-layer-sweep-crossing-minimizer gt))
  (setf (.monitor this) (new-basic-progress-monitor)))

(defparameter *greedy-switch-processor-test-greedy-types*
  (list cross-min-type.one-sided-greedy-switch
        cross-min-type.two-sided-greedy-switch))

(defun %gsp-new (greedy-type)
  "A fresh instance per test, after the @BeforeClass plain-java initialisation."
  (initialize-plain-java-layout)
  (new-greedy-switch-processor-test greedy-type))

(defun %gsp-nodes-as-list (nodes)
  (coerce nodes 'list))

(defun %gsp-assert-nodes (message expected actual)
  "assertThat(message, actual, is(expected)) for two node lists."
  (let ((ok (equal (%gsp-nodes-as-list expected) (%gsp-nodes-as-list actual))))
    (if message
        (assert-true/1 message ok)
        (assert-true ok))))

(defun %gsp-start (this)
  "startGreedySwitcherWithCurrentType()"
  (process (.greedy-switcher this) (get-graph this) (.monitor this)))

(defun greedy-switch-processor-test.should-switch-cross (gt)
  (let ((this (%gsp-new gt)))
    (get-cross-formed-graph this)
    (let (expected-one expected-two)
      (if (eq gt cross-min-type.one-sided-greedy-switch)
          (setf expected-one (copy-of-nodes-in-layer this 0)
                expected-two (copy-of-switch-order-of-nodes-in-layer this 0 1 1))
          (setf expected-one (copy-of-switch-order-of-nodes-in-layer this 0 1 0)
                expected-two (copy-of-nodes-in-layer this 1)))
      (%gsp-start this)
      (%gsp-assert-nodes "Layer one" expected-one (copy-of-nodes-in-layer this 0))
      (%gsp-assert-nodes "Layer two" expected-two (copy-of-nodes-in-layer this 1)))))

(defun greedy-switch-processor-test.constraints-prevent-switch-in-second-layer (gt)
  (let ((this (%gsp-new gt)))
    (get-cross-formed-graph-with-constraints-in-second-layer this)
    (let ((expected-one (copy-of-switch-order-of-nodes-in-layer this 0 1 0))
          (expected-two (copy-of-nodes-in-layer this 1)))
      (%gsp-start this)
      (%gsp-assert-nodes "Layer one" expected-one (copy-of-nodes-in-layer this 0))
      (%gsp-assert-nodes "Layer two" expected-two (copy-of-nodes-in-layer this 1)))))

(defun greedy-switch-processor-test.constraints-prevent-any-switch (gt)
  (let ((this (%gsp-new gt)))
    (get-cross-formed-graph-constraints-prevent-any-switch this)
    (let ((expected-one (copy-of-nodes-in-layer this 0))
          (expected-two (copy-of-nodes-in-layer this 1)))
      (%gsp-start this)
      (%gsp-assert-nodes "Layer one" expected-one (copy-of-nodes-in-layer this 0))
      (%gsp-assert-nodes "Layer two" expected-two (copy-of-nodes-in-layer this 1)))))

(defun greedy-switch-processor-test.layout-unit-constraint-prevents-switch (gt)
  (let ((this (%gsp-new gt)))
    (get-nodes-in-different-layout-units-prevent-switch this)
    (let ((expected-two (copy-of-nodes-in-layer this 1)))
      (%gsp-start this)
      (%gsp-assert-nodes "Layer one" expected-two (copy-of-nodes-in-layer this 1)))))

(defun greedy-switch-processor-test.one-node (gt)
  (let ((this (%gsp-new gt)))
    (get-one-node-graph this)
    (let ((layer-index 0))
      (copy-of-switch-order-of-nodes-in-layer this 0 0 layer-index))))

(defun greedy-switch-processor-test.in-layer-switchable (gt)
  (let ((this (%gsp-new gt)))
    (get-in-layer-edges-graph this)
    (let ((expected-order (copy-of-switch-order-of-nodes-in-layer this 0 1 1)))
      (%gsp-start this)
      (%gsp-assert-nodes nil expected-order (copy-of-nodes-in-layer this 1)))))

(defun greedy-switch-processor-test.multiple-edges-between-same-nodes (gt)
  (let ((this (%gsp-new gt)))
    (get-multiple-edges-between-same-nodes-graph this)
    (let (expected-one expected-two)
      (if (eq gt cross-min-type.one-sided-greedy-switch)
          (setf expected-one (copy-of-nodes-in-layer this 0)
                expected-two (copy-of-switch-order-of-nodes-in-layer this 0 1 1))
          (setf expected-one (copy-of-switch-order-of-nodes-in-layer this 0 1 0)
                expected-two (copy-of-nodes-in-layer this 1)))
      (%gsp-start this)
      (%gsp-assert-nodes "Layer one" expected-one (copy-of-nodes-in-layer this 0))
      (%gsp-assert-nodes "Layer two" expected-two (copy-of-nodes-in-layer this 1)))))

(defun greedy-switch-processor-test.self-loops (gt)
  (let* ((this (%gsp-new gt))
         (left-layer (make-layer this (get-graph this)))
         (right-layer (make-layer this (get-graph this)))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer))
         (top-left-port (add-port-on-side this top-left port-side.east))
         (bottom-left-port (add-port-on-side this bottom-left port-side.east)))
    (set-up-ids this)
    (let ((self-loop-cross-graph (get-graph this)))
      (jdo (layer self-loop-cross-graph)
        (jdo (node layer)
          (self-loop-on this node port-side.east)
          (self-loop-on this node port-side.east)
          (self-loop-on this node port-side.east)
          (self-loop-on this node port-side.west)
          (self-loop-on this node port-side.west)
          (self-loop-on this node port-side.west))))
    (let ((top-right-port (add-port-on-side this top-right port-side.west))
          (bottom-right-port (add-port-on-side this bottom-right port-side.west)))
      (add-edge-between-ports this top-left-port bottom-right-port)
      (add-edge-between-ports this bottom-left-port top-right-port))
    (let ((expected-one nil)
          (expected-two nil))
      (if (eq gt cross-min-type.one-sided-greedy-switch)
          (setf expected-one (copy-of-nodes-in-layer this 0)
                expected-two (copy-of-switch-order-of-nodes-in-layer this 0 1 1))
          (setf expected-one (copy-of-switch-order-of-nodes-in-layer this 0 1 0)
                expected-two (copy-of-nodes-in-layer this 1)))
      (%gsp-start this)
      (%gsp-assert-nodes "Layer one" expected-one (copy-of-nodes-in-layer this 0))
      (%gsp-assert-nodes "Layer two" expected-two (copy-of-nodes-in-layer this 1)))))

(defun greedy-switch-processor-test.north-south-port-crossing (gt)
  (let ((this (%gsp-new gt)))
    (setf (.graph this) (get-north-south-downward-crossing-graph
                         (new-north-south-edge-test-graph-creator)))
    (let* ((layer-index 0)
           (expected-order-two-sided (jl-copy (copy-of-nodes-in-layer this layer-index)))
           (expected-order-one-sided (copy-of-switch-order-of-nodes-in-layer this 1 2 layer-index)))
      (%gsp-start this)
      (if (eq gt cross-min-type.one-sided-greedy-switch)
          (%gsp-assert-nodes nil expected-order-one-sided (copy-of-nodes-in-layer this layer-index))
          (%gsp-assert-nodes nil expected-order-two-sided (copy-of-nodes-in-layer this layer-index))))))

(defun greedy-switch-processor-test.more-complex (gt)
  (let ((this (%gsp-new gt)))
    (get-more-complex-three-layer-graph this)
    (let ((expected-two (copy-of-nodes-in-layer this 1))
          (expected-three (copy-of-switch-order-of-nodes-in-layer this 0 1 2)))
      (%gsp-start this)
      (%gsp-assert-nodes "Layer two" expected-two (copy-of-nodes-in-layer this 1))
      (%gsp-assert-nodes "Layer three" expected-three (copy-of-nodes-in-layer this 2)))))

(defun greedy-switch-processor-test.switch-only-for-one-sided (gt)
  (let ((this (%gsp-new gt)))
    (get-switch-only-one-sided this)
    (let* ((layer-index 1)
           (expected-one-sided (copy-of-switch-order-of-nodes-in-layer this 0 1 layer-index))
           (expected-two-sided (jl-copy (copy-of-nodes-in-layer this layer-index))))
      (%gsp-start this)
      (if (eq gt cross-min-type.one-sided-greedy-switch)
          (%gsp-assert-nodes nil expected-one-sided (copy-of-nodes-in-layer this layer-index))
          (%gsp-assert-nodes nil expected-two-sided (copy-of-nodes-in-layer this layer-index))))))

(defun greedy-switch-processor-test.does-not-worsen-cross-amount (gt)
  (let ((this (%gsp-new gt)))
    (get-graph-which-could-be-worsened-by-switch this)
    (let ((expected-first (jl-copy (copy-of-nodes-in-layer this 0)))
          (expected-second (jl-copy (copy-of-nodes-in-layer this 1))))
      (%gsp-start this)
      (%gsp-assert-nodes "Layer one" expected-first (copy-of-nodes-in-layer this 0))
      (%gsp-assert-nodes "Layer two" expected-second (copy-of-nodes-in-layer this 1)))))

(defun greedy-switch-processor-test.switch-more-than-once (gt)
  (let* ((this (%gsp-new gt))
         (left-nodes (add-nodes-to-layer this 2 (make-layer this (get-graph this))))
         (right-nodes (add-nodes-to-layer this 4 (make-layer this (get-graph this))))
         (left-top-port (add-port-on-side this (aref left-nodes 0) port-side.east))
         (left-lower-port (add-port-on-side this (aref left-nodes 1) port-side.east))
         (right-top-port (add-port-on-side this (aref right-nodes 0) port-side.west)))
    (add-edge-between-ports this left-lower-port right-top-port)
    (east-west-edge-from-to this left-lower-port (aref right-nodes 2))
    (add-edge-between-ports this left-top-port right-top-port)
    (east-west-edge-from-to this left-top-port (aref right-nodes 1))
    (east-west-edge-from-to this left-top-port (aref right-nodes 3))
    (set-up-ids this)
    (let* ((one-sided-first-layer (jl-copy (copy-of-nodes-in-layer this 0)))
           (one-sided-first-switch-second-layer (copy-of-switch-order-of-nodes-in-layer this 0 1 1))
           (one-sided-second-switch-second-layer
             (get-copy-with-switched-order this 2 3 one-sided-first-switch-second-layer))
           (one-sided-third-switch-second-layer
             (get-copy-with-switched-order this 1 2 one-sided-second-switch-second-layer))
           (two-sided-first-layer (copy-of-switch-order-of-nodes-in-layer this 0 1 0))
           (two-sided-first-switch-second-layer (copy-of-switch-order-of-nodes-in-layer this 1 2 1))
           (two-sided-second-switch-second-layer
             (get-copy-with-switched-order this 0 1 two-sided-first-switch-second-layer)))
      (%gsp-start this)
      (if (eq gt cross-min-type.one-sided-greedy-switch)
          (progn
            (%gsp-assert-nodes "Layer one" one-sided-first-layer (copy-of-nodes-in-layer this 0))
            (%gsp-assert-nodes "Layer two" one-sided-third-switch-second-layer
                               (copy-of-nodes-in-layer this 1)))
          (progn
            (%gsp-assert-nodes "Layer one" two-sided-first-layer (copy-of-nodes-in-layer this 0))
            (%gsp-assert-nodes "Layer two" two-sided-second-switch-second-layer
                               (copy-of-nodes-in-layer this 1)))))))

(defun greedy-switch-processor-test.run-all ()
  "Every test method, once per parameter row (Parameterized)."
  (dolist (gt *greedy-switch-processor-test-greedy-types*)
    (greedy-switch-processor-test.should-switch-cross gt)
    (greedy-switch-processor-test.constraints-prevent-switch-in-second-layer gt)
    (greedy-switch-processor-test.constraints-prevent-any-switch gt)
    (greedy-switch-processor-test.layout-unit-constraint-prevents-switch gt)
    (greedy-switch-processor-test.one-node gt)
    (greedy-switch-processor-test.in-layer-switchable gt)
    (greedy-switch-processor-test.multiple-edges-between-same-nodes gt)
    (greedy-switch-processor-test.self-loops gt)
    (greedy-switch-processor-test.north-south-port-crossing gt)
    (greedy-switch-processor-test.more-complex gt)
    (greedy-switch-processor-test.switch-only-for-one-sided gt)
    (greedy-switch-processor-test.does-not-worsen-cross-amount gt)
    (greedy-switch-processor-test.switch-more-than-once gt)))

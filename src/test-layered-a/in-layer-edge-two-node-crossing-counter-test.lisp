;;;; in-layer-edge-two-node-crossing-counter-test.lisp -- port of
;;;; org.eclipse.elk.alg.layered.intermediate.greedyswitch.InLayerEdgeTwoNodeCrossingCounterTest.
;;;; A plain JUnit class extending InLayerEdgeTestGraphCreator (no @Before), so each
;;;; @Test is a defun that makes its own instance (THIS).
;;;; (in-layer-edge-two-node-crossing-counter-test.run-all) runs every test that is not
;;;; @Ignore'd in Java.

(in-package #:elk)

(defjclass in-layer-edge-two-node-crossing-counter-test (in-layer-edge-test-graph-creator)
  ((left-counter nil)
   (right-counter nil)
   (lower-upper-crossings 0)
   (upper-lower-crossings 0)
   (node-order nil)))

(defjctor in-layer-edge-two-node-crossing-counter-test ()
  nil)

(defun %ilt-assert (message expected actual)
  (assert-equals/2 message expected actual))

(defun %ilt-check (this upper-lower lower-upper)
  (%ilt-assert "upperLowerCrossings" upper-lower (.upper-lower-crossings this))
  (%ilt-assert "lowerUpperCrossings" lower-upper (.lower-upper-crossings this)))

(defun %ilt-count-in-layer (this layer-index upper-node-index lower-node-index)
  (%ilt-init-counter-for-layer-index this layer-index)
  (%ilt-count-crossings this upper-node-index lower-node-index))

(defun %ilt-count-crossings (this upper-node-index lower-node-index)
  (let ((left-crossings (count-in-layer-crossings-between-nodes-in-both-orders
                         (.left-counter this)
                         (aref (.node-order this) upper-node-index)
                         (aref (.node-order this) lower-node-index)
                         port-side.west))
        (right-crossings (count-in-layer-crossings-between-nodes-in-both-orders
                          (.right-counter this)
                          (aref (.node-order this) upper-node-index)
                          (aref (.node-order this) lower-node-index)
                          port-side.east)))
    (setf (.upper-lower-crossings this) (+ (get-first left-crossings) (get-first right-crossings)))
    (setf (.lower-upper-crossings this) (+ (get-second left-crossings) (get-second right-crossings)))))

(defun %ilt-init-counter-for-layer-index (this layer-index)
  (let* ((current-order (to-node-array (get-graph this)))
         (nodes (aref current-order layer-index)))
    (setf (.node-order this) nodes)
    (%ilt-number-ids-ascendingly nodes)
    (setf (.left-counter this)
          (new-crossings-counter (make-array (%ilt-n-ports current-order) :initial-element 0)))
    (setf (.right-counter this)
          (new-crossings-counter (make-array (%ilt-n-ports current-order) :initial-element 0)))
    (init-port-positions-for-in-layer-crossings (.left-counter this) nodes port-side.west)
    (init-port-positions-for-in-layer-crossings (.right-counter this) nodes port-side.east)))

(defun %ilt-n-ports (current-order)
  (let ((n-ports 0))
    (loop for layer across current-order
          do (loop for n across layer
                   do (incf n-ports (size (get-ports n)))))
    n-ports))

(defun %ilt-number-ids-ascendingly (nodes)
  (dotimes (i (length nodes))
    (setf (.id (aref nodes i)) i)))

(defun %ilt-switch-order-and-notify-counter (this index-one index-two)
  (switch-nodes (.left-counter this) (aref (.node-order this) index-one)
                (aref (.node-order this) index-two) port-side.west)
  (switch-nodes (.right-counter this) (aref (.node-order this) index-one)
                (aref (.node-order this) index-two) port-side.east)
  (let ((one (aref (.node-order this) index-one)))
    (setf (aref (.node-order this) index-one) (aref (.node-order this) index-two))
    (setf (aref (.node-order this) index-two) one)))


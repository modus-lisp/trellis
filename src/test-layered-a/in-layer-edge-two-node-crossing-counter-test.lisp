(defun in-layer-edge-two-node-crossing-counter-test.multiple-edges-into-one-port-should-not-cause-crossing ()
  (let* ((this (new-in-layer-edge-two-node-crossing-counter-test))
         (nodes (add-nodes-to-layer this 3 (make-layer this (get-graph this))))
         (port-side port-side.east)
         (port-one (add-port-on-side this (aref nodes 0) port-side))
         (port-two (add-port-on-side this (aref nodes 1) port-side))
         (port-three (add-port-on-side this (aref nodes 2) port-side)))
    (add-edge-between-ports this port-one port-three)
    (add-edge-between-ports this port-two port-three)
    (%ilt-count-in-layer this 0 0 1)
    (%ilt-check this 0 0)))


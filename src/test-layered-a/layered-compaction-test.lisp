(defun layered-compaction-test.test-no-spacing-applied-within-groups ()
  ;; Care has to be taken when calculating the initial position of a CGroup not to include
  ;; any spacing between the group nodes.  This test asserts that the initial position of
  ;; the groups is as expected.
  (let* ((graph (%lct-graph))
         (one (%lct-add-node graph (new-c-test-node (%lct-rect 0d0 0d0 20d0 20d0))))
         (two (%lct-add-node graph (new-c-test-node (%lct-rect 20d0 10d0 20d0 20d0))))
         (three (%lct-add-node graph (new-c-test-node (%lct-rect 40d0 20d0 20d0 20d0))))
         (four (%lct-add-node graph (new-c-test-node (%lct-rect 22d0 80d0 20d0 20d0))))
         (five (%lct-add-node graph (new-c-test-node (%lct-rect 42d0 90d0 20d0 20d0))))
         (six (%lct-add-node graph (new-c-test-node (%lct-rect 62d0 100d0 20d0 20d0)))))
    (%lct-add-group graph (new-layered-c-group (list one two three)))
    (%lct-add-group graph (new-layered-c-group (list four five six)))
    (let ((c (%lct-compacter graph)))
      (change-direction c core-direction.left)
      (compact c)
      (change-direction c core-direction.right)
      (compact c)
      (change-direction c core-direction.up)
      (compact c)
      (change-direction c core-direction.down)
      (compact c)
      (finish c))
    (%lct-assert 0d0 (%lct-x one))
    (%lct-assert 20d0 (%lct-x two))
    (%lct-assert 40d0 (%lct-x three))
    (%lct-assert 0d0 (%lct-x four))
    (%lct-assert 20d0 (%lct-x five))
    (%lct-assert 40d0 (%lct-x six))
    (%lct-assert 0d0 (%lct-y one))
    (%lct-assert 10d0 (%lct-y two))
    (%lct-assert 20d0 (%lct-y three))
    (%lct-assert 35d0 (%lct-y four))
    (%lct-assert 45d0 (%lct-y five))
    (%lct-assert 55d0 (%lct-y six))
    t))

(defun layered-compaction-test.test-subsequent-directions-compaction ()
  ;; Testing subsequent calls with different directions
  (let* ((graph (%lct-graph))
         (one (%lct-add-node graph (new-c-test-node (%lct-rect 0d0 0d0 20d0 20d0))))
         (two (%lct-add-node graph (new-c-test-node (%lct-rect 25d0 0d0 20d0 20d0))))
         (three (%lct-add-node graph (new-c-test-node (%lct-rect 0d0 25d0 20d0 20d0))))
         (four (%lct-add-node graph (new-c-test-node (%lct-rect 25d0 25d0 20d0 20d0))))
         (directions (enum-set.of core-direction.left core-direction.right core-direction.up core-direction.down)))
    ;; subsequently apply all combinations of four subsequent compaction steps
    (jdo (d1 directions)
      (jdo (d2 directions)
        (jdo (d3 directions)
          (jdo (d4 directions)
            (let ((c (%lct-compacter graph)))
              (change-direction c d1)
              (compact c)
              (change-direction c d2)
              (compact c)
              (change-direction c d3)
              (compact c)
              (change-direction c d4)
              (compact c)
              (finish c))
            ;; the way we modeled the graph, every node should stay where it is
            (let ((current-directions (format nil "~A ~A ~A ~A" (name d1) (name d2) (name d3) (name d4))))
              (%lct-assert-msg current-directions 0d0 (%lct-x one))
              (%lct-assert-msg current-directions 0d0 (%lct-y one))
              (%lct-assert-msg current-directions 25d0 (%lct-x two))
              (%lct-assert-msg current-directions 0d0 (%lct-y two))
              (%lct-assert-msg current-directions 0d0 (%lct-x three))
              (%lct-assert-msg current-directions 25d0 (%lct-y three))
              (%lct-assert-msg current-directions 25d0 (%lct-x four))
              (%lct-assert-msg current-directions 25d0 (%lct-y four)))))))
    t))

(defun layered-compaction-test.test-horizontal-spacings ()
  ;; Horizontal spacing should be preserved when compaction leftwards or rightwards.
  (let* ((graph (%lct-graph))
         (one (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 0d0 0d0 20d0 20d0) 5d0 0d0)))
         (two (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 50d0 0d0 20d0 20d0) 7d0 0d0)))
         (three (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 150d0 0d0 20d0 20d0) 10d0 0d0))))
    (finish (compact (change-direction (%lct-compacter graph) core-direction.left)))
    (%lct-assert 0d0 (%lct-x one))
    (%lct-assert 27d0 (%lct-x two))
    (%lct-assert 57d0 (%lct-x three))
    (finish (compact (change-direction (%lct-compacter graph) core-direction.right)))
    (%lct-assert 0d0 (%lct-x one))
    (%lct-assert 27d0 (%lct-x two))
    (%lct-assert 57d0 (%lct-x three))
    (finish (compact (change-direction (%lct-compacter graph) core-direction.left)))
    (%lct-assert 0d0 (%lct-x one))
    (%lct-assert 27d0 (%lct-x two))
    (%lct-assert 57d0 (%lct-x three))
    t))

(defun layered-compaction-test.test-vertical-spacing-during-horizontal-compaction ()
  ;; "Two" is "center node". Node "one" is supposed to be blocked by "two", while "three" can move freely.
  (let* ((graph (%lct-graph))
         (one (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 150d0 11d0 20d0 20d0) 0d0 10d0)))
         (two (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 0d0 40d0 20d0 20d0) 0d0 5d0)))
         (three (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 150d0 76d0 20d0 20d0) 0d0 15d0))))
    (finish (compact (change-direction (%lct-compacter graph) core-direction.left)))
    (%lct-assert 20d0 (%lct-x one))
    (%lct-assert 0d0 (%lct-x two))
    (%lct-assert 0d0 (%lct-x three))
    t))

(defun layered-compaction-test.test-vetical-spacings ()
  ;; Vertical spacing should be preserved when compaction upwards or downwards.
  (let* ((graph (%lct-graph))
         (one (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 0d0 0d0 20d0 20d0) 0d0 5d0)))
         (two (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 0d0 50d0 20d0 20d0) 0d0 7d0)))
         (three (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 0d0 150d0 20d0 20d0) 0d0 10d0))))
    (finish (compact (change-direction (%lct-compacter graph) core-direction.up)))
    (%lct-assert 0d0 (%lct-y one))
    (%lct-assert 27d0 (%lct-y two))
    (%lct-assert 57d0 (%lct-y three))
    (finish (compact (change-direction (%lct-compacter graph) core-direction.down)))
    (%lct-assert 0d0 (%lct-y one))
    (%lct-assert 27d0 (%lct-y two))
    (%lct-assert 57d0 (%lct-y three))
    (finish (compact (change-direction (%lct-compacter graph) core-direction.up)))
    (%lct-assert 0d0 (%lct-y one))
    (%lct-assert 27d0 (%lct-y two))
    (%lct-assert 57d0 (%lct-y three))
    t))

(defun layered-compaction-test.test-horizontal-spacing-during-vertical-compaction ()
  ;; "Two" is "center node". Node "one" is supposed to be blocked by "two", while "three" can move freely.
  (let* ((graph (%lct-graph))
         (one (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 16d0 150d0 20d0 20d0) 5d0 0d0)))
         (two (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 40d0 0d0 20d0 20d0) 10d0 0d0)))
         (three (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 76d0 150d0 20d0 20d0) 15d0 0d0))))
    (finish (compact (change-direction (%lct-compacter graph) core-direction.up)))
    (%lct-assert 20d0 (%lct-y one))
    (%lct-assert 0d0 (%lct-y two))
    (%lct-assert 0d0 (%lct-y three))
    t))

(defun layered-compaction-test.run-all ()
  (layered-compaction-test.test-left-compaction)
  (layered-compaction-test.test-left-compaction-equal-coordinate)
  (layered-compaction-test.test-left-compaction-spacing-aware)
  (layered-compaction-test.test-right-compaction)
  (layered-compaction-test.test-up-compaction)
  (layered-compaction-test.test-down-compaction)
  (layered-compaction-test.test-left-group-compaction)
  (layered-compaction-test.test-right-group-compaction)
  (layered-compaction-test.test-up-group-compaction)
  (layered-compaction-test.test-down-group-compaction)
  (layered-compaction-test.test-no-spacing-applied-within-groups)
  (layered-compaction-test.test-subsequent-directions-compaction)
  (layered-compaction-test.test-horizontal-spacings)
  (layered-compaction-test.test-vertical-spacing-during-horizontal-compaction)
  (layered-compaction-test.test-vetical-spacings)
  (layered-compaction-test.test-horizontal-spacing-during-vertical-compaction))

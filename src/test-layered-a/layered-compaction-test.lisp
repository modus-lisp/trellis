;;;; layered-compaction-test.lisp -- port of
;;;; org.eclipse.elk.alg.layered.compaction.CompactionTest.
;;;; A plain JUnit class: each @Test is one defun named
;;;; layered-compaction-test.<test-name>, and layered-compaction-test.run-all
;;;; calls them all.  The nested CTestNode / CTestNodeSpacing classes are
;;;; defined here, as CNode subclasses with fixed spacings.

(in-package #:elk)

(defparameter layered-compaction-test.epsilon 0.0001d0)
(defparameter layered-compaction-test.spacing 5d0)

;;; ------------------------------------------------------------ nested classes

(defjclass c-test-node (layered-c-node) ())

(defjctor c-test-node (rect)
  (setf (.hitbox this) rect))

(defjmethod get-horizontal-spacing ((this c-test-node))
  layered-compaction-test.spacing)

(defjmethod get-vertical-spacing ((this c-test-node))
  layered-compaction-test.spacing)

(defjmethod apply-element-position ((this c-test-node))
  ;; hitbox.x = hitbox.x
  (setf (.x (.hitbox this)) (.x (.hitbox this))))

(defjmethod get-element-position ((this c-test-node))
  (.x (.hitbox this)))

(defjmethod to-string ((this c-test-node))
  "") ; dont spam the debug output

(defjclass c-test-node-spacing (c-test-node)
  ((h-spacing 0d0)
   (v-spacing 0d0)))

(defjctor c-test-node-spacing (rect h-spacing v-spacing)
  (super-ctor c-test-node this rect)
  (setf (.h-spacing this) h-spacing
        (.v-spacing this) v-spacing))

(defjmethod get-horizontal-spacing ((this c-test-node-spacing))
  (.h-spacing this))

(defjmethod get-vertical-spacing ((this c-test-node-spacing))
  (.v-spacing this))

;;; ------------------------------------------------------------ helpers

(defun %lct-compacter (graph)
  "new OneDimensionalCompactor(graph).setConstraintAlgorithm(QUADRATIC_CONSTRAINTS)."
  (set-constraint-algorithm (new-layered-one-dimensional-compactor graph)
                            layered-one-dimensional-compactor.quadratic-constraints))

(defun %lct-graph ()
  (new-layered-c-graph (enum-set.all-of 'core-direction)))

(defun %lct-add-node (graph node)
  (jl-add (.c-nodes graph) node)
  node)

(defun %lct-add-group (graph group)
  (jl-add (.c-groups graph) group)
  group)

(defun %lct-rect (x y w h)
  (new-elk-rectangle x y w h))

(defun %lct-assert (expected actual)
  (%la-assert-equals-delta "" expected actual layered-compaction-test.epsilon))

(defun %lct-assert-msg (message expected actual)
  (%la-assert-equals-delta message expected actual layered-compaction-test.epsilon))

(defun %lct-x (node) (.x (.hitbox node)))
(defun %lct-y (node) (.y (.hitbox node)))

;;; ------------------------------------------------------------ tests

(defun layered-compaction-test.test-left-compaction ()
  (let* ((graph (%lct-graph))
         (left (%lct-add-node graph (new-c-test-node (%lct-rect 0d0 0d0 20d0 20d0))))
         (right (%lct-add-node graph (new-c-test-node (%lct-rect 30d0 0d0 20d0 20d0)))))
    (finish (compact (change-direction (%lct-compacter graph) core-direction.left)))
    (%lct-assert 0d0 (%lct-x left))
    (%lct-assert 25d0 (%lct-x right))
    t))

(defun layered-compaction-test.test-left-compaction-equal-coordinate ()
  (let* ((graph (%lct-graph))
         (top (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 0d0 0d0 20d0 20d0) 0d0 0d0)))
         (bot (%lct-add-node graph (new-c-test-node-spacing (%lct-rect 30d0 20d0 20d0 20d0) 0d0 0d0))))
    (finish (compact (change-direction
                      (set-constraint-algorithm (%lct-compacter graph)
                                                layered-one-dimensional-compactor.scanline-constraints)
                      core-direction.left)))
    (%lct-assert 0d0 (%lct-x top))
    (%lct-assert 0d0 (%lct-x bot))
    t))


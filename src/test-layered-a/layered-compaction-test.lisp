(defun layered-compaction-test.test-left-group-compaction ()
  ;; The connection indicates a grouping, not an edge.
  (let* ((graph (%lct-graph))
         (left (%lct-add-node graph (new-c-test-node (%lct-rect 0d0 0d0 20d0 20d0))))
         (upper-right (%lct-add-node graph (new-c-test-node (%lct-rect 40d0 5d0 20d0 20d0))))
         (lower-right (%lct-add-node graph (new-c-test-node (%lct-rect 30d0 25d0 20d0 20d0)))))
    (%lct-add-group graph (new-layered-c-group (list upper-right lower-right)))
    (finish (compact (change-direction (%lct-compacter graph) core-direction.left)))
    (%lct-assert 0d0 (%lct-x left))
    (%lct-assert 25d0 (%lct-x upper-right))
    (%lct-assert 15d0 (%lct-x lower-right))
    t))


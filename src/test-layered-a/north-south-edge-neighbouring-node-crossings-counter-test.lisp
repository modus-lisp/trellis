;;;; north-south-edge-neighbouring-node-crossings-counter-test.lisp -- port of
;;;; org.eclipse.elk.alg.layered.intermediate.greedyswitch.NorthSouthEdgeNeighbouringNodeCrossingsCounterTest.
;;;; A plain JUnit class (@BeforeClass plain-java init) extending
;;;; NorthSouthEdgeTestGraphCreator.  Each test is a defun that makes its own instance
;;;; (THIS) and calls initialize-plain-java-layout first, as the class's @BeforeClass does.
;;;; (north-south-edge-neighbouring-node-crossings-counter-test.run-all) runs every test.

(in-package #:elk)

(defjclass north-south-edge-neighbouring-node-crossings-counter-test (north-south-edge-test-graph-creator)
  ((counter nil)
   ;; the layer's node array, captured on first use (setLayerIfNotSet)
   (layer nil)))

(defjctor north-south-edge-neighbouring-node-crossings-counter-test ()
  nil)

(defun %nsn-new ()
  (initialize-plain-java-layout)
  (new-north-south-edge-neighbouring-node-crossings-counter-test))

(defun %nsn-check (this upper-lower lower-upper)
  (assert-equals/1 upper-lower (get-upper-lower-crossings (.counter this)))
  (assert-equals/1 lower-upper (get-lower-upper-crossings (.counter this))))

(defun %nsn-set-layer-if-not-set (this layer-index)
  (unless (.layer this)
    (setf (.layer this) (aref (to-node-array (get-graph this)) layer-index))))

(defun %nsn-count-in-layer-between-nodes (this layer-index upper-node-index lower-node-index)
  (%nsn-set-layer-if-not-set this layer-index)
  (setf (.counter this) (new-north-south-edge-neighbouring-node-crossings-counter (.layer this)))
  (count-crossings (.counter this)
                   (aref (.layer this) upper-node-index)
                   (aref (.layer this) lower-node-index)))

(defun %nsn-switch-nodes (this upper lower)
  (let ((upper-node (aref (.layer this) upper))
        (lower-node (aref (.layer this) lower)))
    (setf (aref (.layer this) upper) lower-node)
    (setf (aref (.layer this) lower) upper-node)))

(defun %nsn-switch-and-recount (this upper-node-index lower-node-index)
  (%nsn-switch-nodes this upper-node-index lower-node-index)
  (count-crossings (.counter this)
                   (aref (.layer this) upper-node-index)
                   (aref (.layer this) lower-node-index)))


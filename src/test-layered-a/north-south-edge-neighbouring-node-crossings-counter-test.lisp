(defun north-south-edge-neighbouring-node-crossings-counter-test.given-polyline-routing-when-more-than-one-edge-into-ns-node-counts-these-too ()
  (let* ((this (%nsn-new))
         (left-node (add-node-to-layer this (make-layer this (get-graph this))))
         (middle-nodes (add-nodes-to-layer this 3 (make-layer this (get-graph this))))
         (right-nodes (add-nodes-to-layer this 2 (make-layer this (get-graph this)))))
    (set-fixed-order-constraint this (aref middle-nodes 2))
    (add-north-south-edge this port-side.north (aref middle-nodes 2) (aref middle-nodes 1) (aref right-nodes 0) nil)
    (add-north-south-edge this port-side.north (aref middle-nodes 2) (aref middle-nodes 0) left-node t)
    (let ((middle-node-port (jl-get (get-ports (aref middle-nodes 1)) 0)))
      (east-west-edge-from-to this middle-node-port (aref right-nodes 1)))
    (set-property (get-graph this) layered-options.edge-routing edge-routing.polyline)
    (%nsn-count-in-layer-between-nodes this 1 0 1)
    (%nsn-check this 2 1)))

(defun north-south-edge-neighbouring-node-crossings-counter-test.given-multiple-edges-in-one-ns-node-counts-crossings ()
  (let* ((this (%nsn-new))
         (left-node (add-node-to-layer this (make-layer this)))
         (middle-layer (add-nodes-to-layer this 3 (make-layer this)))
         (right-layer (add-nodes-to-layer this 2 (make-layer this))))
    (set-fixed-order-constraint this (aref middle-layer 2))
    (add-north-south-edge this port-side.north (aref middle-layer 2) (aref middle-layer 1) left-node t)
    (let ((normal-node-port (add-port-on-side this (aref right-layer 1) port-side.west))
          (dummy-node-port (add-port-on-side this (aref middle-layer 1) port-side.east)))
      (add-edge-between-ports this dummy-node-port normal-node-port)
      (let ((origin-port (jl-get (get-ports (aref middle-layer 2)) 0)))
        (set-property dummy-node-port layered-internal-properties.origin origin-port)))
    (add-north-south-edge this port-side.north (aref middle-layer 2) (aref middle-layer 0) (aref right-layer 0) nil)
    (%nsn-count-in-layer-between-nodes this 1 0 1)
    (%nsn-check this 1 0)))

(defun north-south-edge-neighbouring-node-crossings-counter-test.edges-in-both-directions ()

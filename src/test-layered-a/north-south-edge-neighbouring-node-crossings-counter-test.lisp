         (middle-layer (add-nodes-to-layer this 3 (make-layer this)))
         (right-layer (add-nodes-to-layer this 2 (make-layer this))))
    (set-fixed-order-constraint this (aref middle-layer 2))
    (add-north-south-edge this port-side.north (aref middle-layer 2) (aref middle-layer 1) (aref left-layer 1) t)
    (let ((normal-node-port (add-port-on-side this (aref right-layer 1) port-side.west))
          (dummy-node-port (add-port-on-side this (aref middle-layer 1) port-side.east)))
      (add-edge-between-ports this dummy-node-port normal-node-port)
      (let ((origin-port (jl-get (get-ports (aref middle-layer 2)) 0)))
        (set-property dummy-node-port layered-internal-properties.origin origin-port)))
    (add-north-south-edge this port-side.north (aref middle-layer 2) (aref middle-layer 0) (aref left-layer 0) t)
    (let ((normal-node-port (add-port-on-side this (aref right-layer 0) port-side.west))
          (dummy-node-port (add-port-on-side this (aref middle-layer 0) port-side.east)))
      (add-edge-between-ports this dummy-node-port normal-node-port)
      (let ((origin-port (jl-get (get-ports (aref middle-layer 2)) 1)))
        (set-property dummy-node-port layered-internal-properties.origin origin-port)))
    (%nsn-count-in-layer-between-nodes this 1 0 1)
    (%nsn-check this 1 1)))

(defun north-south-edge-neighbouring-node-crossings-counter-test.multiple-edges-in-both-directions-ns-node ()
  (let* ((this (%nsn-new))
         (left-layer (add-nodes-to-layer this 2 (make-layer this)))
         (middle-layer (add-nodes-to-layer this 3 (make-layer this)))
         (right-layer (add-nodes-to-layer this 2 (make-layer this))))
    (set-fixed-order-constraint this (aref middle-layer 2))
    (add-north-south-edge this port-side.north (aref middle-layer 2) (aref middle-layer 1) (aref left-layer 1) t)
    (let ((normal-node-port (add-port-on-side this (aref right-layer 1) port-side.west))
          (dummy-node-port (add-port-on-side this (aref middle-layer 1) port-side.east)))
      (add-edge-between-ports this dummy-node-port normal-node-port)
      (add-edge-between-ports this dummy-node-port normal-node-port)
      (let ((origin-port (jl-get (get-ports (aref middle-layer 2)) 0)))
        (set-property dummy-node-port layered-internal-properties.origin origin-port)))
    (add-north-south-edge this port-side.north (aref middle-layer 2) (aref middle-layer 0) (aref right-layer 0) nil)
    (let ((normal-node-port (add-port-on-side this (aref right-layer 0) port-side.east))
          (dummy-node-port (add-port-on-side this (aref middle-layer 0) port-side.west)))
      (add-edge-between-ports this dummy-node-port normal-node-port)
      (add-edge-between-ports this dummy-node-port normal-node-port)
      (let ((origin-port (jl-get (get-ports (aref middle-layer 2)) 1)))
        (set-property dummy-node-port layered-internal-properties.origin origin-port)))
    (%nsn-count-in-layer-between-nodes this 1 0 1)
    (%nsn-check this 2 2)))


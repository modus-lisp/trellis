  (let* ((left-node (add-node-to-layer this (make-layer this (get-graph this))))
         (middle-nodes (add-nodes-to-layer this 4 (make-layer this (get-graph this))))
         (right-nodes (add-nodes-to-layer this 3 (make-layer this (get-graph this)))))
    (set-as-long-edge-dummy this (aref middle-nodes 0))
    (east-west-edge-from-to this left-node (aref middle-nodes 0))
    (east-west-edge-from-to this (aref middle-nodes 0) (aref right-nodes 1))
    (east-west-edge-from-to this (aref middle-nodes 1) (aref right-nodes 0))
    (east-west-edge-from-to this (aref middle-nodes 1) (aref right-nodes 0))
    (add-north-south-edge this port-side.south (aref middle-nodes 1) (aref middle-nodes 2) (aref right-nodes 2) nil)
    (get-graph this)))

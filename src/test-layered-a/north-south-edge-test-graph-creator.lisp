;;;; north-south-edge-test-graph-creator.lisp -- port of
;;;; org.eclipse.elk.alg.layered.intermediate.greedyswitch.NorthSouthEdgeTestGraphCreator.
;;;; A graph creator (not a test) extending the greedy-switch TestGraphCreator.
;;;; Each getXxx method keeps its Java name, builds the graph in THIS and returns it.

(in-package #:elk)

(defjclass north-south-edge-test-graph-creator (layered-greedyswitch-test-graph-creator) ())

(defjctor north-south-edge-test-graph-creator ()
  nil)

(defjmethod get-north-south-upward-crossing-graph ((this north-south-edge-test-graph-creator))
  (let* ((left-nodes (add-nodes-to-layer this 3 (make-layer this (get-graph this))))
         (right-nodes (add-nodes-to-layer this 2 (make-layer this (get-graph this)))))
    (add-north-south-edge this port-side.north (aref left-nodes 2) (aref left-nodes 1) (aref right-nodes 1) nil)
    (add-north-south-edge this port-side.north (aref left-nodes 2) (aref left-nodes 0) (aref right-nodes 0) nil)
    (set-fixed-order-constraint this (aref left-nodes 2))
    (get-graph this)))

(defjmethod get-north-south-upward-multiple-crossing-graph ((this north-south-edge-test-graph-creator))
  (let* ((left-nodes (add-nodes-to-layer this 4 (make-layer this (get-graph this))))
         (right-nodes (add-nodes-to-layer this 3 (make-layer this (get-graph this)))))
    (add-north-south-edge this port-side.north (aref left-nodes 3) (aref left-nodes 2) (aref right-nodes 2) nil)
    (add-north-south-edge this port-side.north (aref left-nodes 3) (aref left-nodes 1) (aref right-nodes 1) nil)
    (add-north-south-edge this port-side.north (aref left-nodes 3) (aref left-nodes 0) (aref right-nodes 0) nil)
    (set-fixed-order-constraint this (aref left-nodes 3))
    (get-graph this)))

(defjmethod get-three-layer-north-south-crossing-graph ((this north-south-edge-test-graph-creator))
  (let* ((left-node (add-node-to-layer this (make-layer this (get-graph this))))
         (middle-nodes (add-nodes-to-layer this 3 (make-layer this (get-graph this))))
         (right-node (add-node-to-layer this (make-layer this (get-graph this)))))
    (set-fixed-order-constraint this (aref middle-nodes 0))
    (set-fixed-order-constraint this right-node)
    (add-north-south-edge this port-side.south (aref middle-nodes 0) (aref middle-nodes 2) right-node nil)
    (add-north-south-edge this port-side.south (aref middle-nodes 0) (aref middle-nodes 1) right-node nil)
    (east-west-edge-from-to this left-node (aref middle-nodes 0))
    (get-graph this)))

(defjmethod get-three-layer-north-south-crossing-should-switch-graph ((this north-south-edge-test-graph-creator))
  (add-node-to-layer this (make-layer this (get-graph this)))
  (let* ((middle-nodes (add-nodes-to-layer this 3 (make-layer this (get-graph this))))
         (right-nodes (add-nodes-to-layer this 2 (make-layer this (get-graph this)))))
    (set-fixed-order-constraint this (aref middle-nodes 0))
    (set-as-north-south-node this (aref middle-nodes 1))
    (set-as-north-south-node this (aref middle-nodes 2))
    (set-property (aref middle-nodes 2) layered-internal-properties.origin (aref middle-nodes 0))
    (set-property (aref middle-nodes 1) layered-internal-properties.origin (aref middle-nodes 0))
    (let* ((left-bottom-node-right-port (add-port-on-side this (aref middle-nodes 2) port-side.east))
           (right-node-bottom-port (add-port-on-side this (aref right-nodes 1) port-side.west)))
      (add-edge-between-ports this left-bottom-node-right-port right-node-bottom-port)
      (let ((left-top-node-right-port (add-port-on-side this (aref middle-nodes 0) port-side.south)))
        (set-property left-bottom-node-right-port layered-internal-properties.origin
                      left-top-node-right-port)))
    (let* ((left-middle-node-right-port (add-port-on-side this (aref middle-nodes 1) port-side.east))
           (right-node-top-port (add-port-on-side this (aref right-nodes 0) port-side.west)))
      (add-edge-between-ports this left-middle-node-right-port right-node-top-port)
      (let ((left-top-node-left-port (add-port-on-side this (aref middle-nodes 0) port-side.south)))
        (set-property left-middle-node-right-port layered-internal-properties.origin
                      left-top-node-left-port)))
    (get-graph this)))


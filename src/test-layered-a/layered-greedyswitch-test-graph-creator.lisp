(defjmethod get-cross-with-many-self-loops-graph ((this layered-greedyswitch-test-graph-creator))
  (let* ((left-layer (make-layer this (.graph this)))
         (right-layer (make-layer this (.graph this)))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer))
         (top-left-port (add-port-on-side this top-left port-side.east))
         (bottom-left-port (add-port-on-side this bottom-left port-side.east)))
    (set-up-ids this)
    (let ((self-loop-cross-graph (.graph this)))
      (jdo (layer self-loop-cross-graph)
        (jdo (node layer)
          (self-loop-on this node port-side.east)
          (self-loop-on this node port-side.east)
          (self-loop-on this node port-side.east)
          (self-loop-on this node port-side.west)
          (self-loop-on this node port-side.west)
          (self-loop-on this node port-side.west)))
      (let ((top-right-port (add-port-on-side this top-right port-side.west))
            (bottom-right-port (add-port-on-side this bottom-right port-side.west)))
        (add-edge-between-ports this top-left-port bottom-right-port)
        (add-edge-between-ports this bottom-left-port top-right-port))
      self-loop-cross-graph)))

(defjmethod self-loop-on ((this layered-greedyswitch-test-graph-creator) node side)
  (add-edge-between-ports this
                          (add-port-on-side this node side)
                          (add-port-on-side this node side)))

(defjmethod get-more-complex-three-layer-graph ((this layered-greedyswitch-test-graph-creator))
  (let* ((left-layer (make-layer this (.graph this)))
         (middle-layer (make-layer this (.graph this)))
         (right-layer (make-layer this (.graph this)))
         (left-nodes (add-nodes-to-layer this 3 left-layer))
         (middle-nodes (add-nodes-to-layer this 2 middle-layer))
         (right-nodes (add-nodes-to-layer this 3 right-layer))
         (left-middle-node-port (add-port-on-side this (aref left-nodes 1) port-side.east))
         (middle-lower-node-port-east (add-port-on-side this (aref middle-nodes 1) port-side.east))
         (middle-upper-node-port-east (add-port-on-side this (aref middle-nodes 0) port-side.east))
         (right-upper-node-port (add-port-on-side this (aref right-nodes 0) port-side.west))
         (right-middle-node-port (add-port-on-side this (aref right-nodes 1) port-side.west)))
    (set-up-ids this)
    (add-edge-between-ports this middle-upper-node-port-east right-upper-node-port)
    (add-edge-between-ports this middle-upper-node-port-east right-middle-node-port)
    (add-edge-between-ports this middle-upper-node-port-east right-middle-node-port)
    (east-west-edge-from-to this middle-lower-node-port-east (aref right-nodes 2))
    (east-west-edge-from-to this left-middle-node-port (aref middle-nodes 0))
    (east-west-edge-from-to this (aref middle-nodes 1) right-upper-node-port)
    (east-west-edge-from-to this left-middle-node-port (aref middle-nodes 1))
    (east-west-edge-from-to this (aref left-nodes 2) (aref middle-nodes 0))
    (east-west-edge-from-to this (aref left-nodes 0) (aref middle-nodes 0))
    (set-up-ids this)
    (.graph this)))


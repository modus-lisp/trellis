         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer)))
    (declare (ignorable bottom-right))
    (east-west-edge-from-to this top-left bottom-right)
    (let ((bottom-left-first-port (add-port-on-side this bottom-left port-side.east))
          (bottom-left-second-port (add-port-on-side this bottom-left port-side.east))
          (top-right-first-port (add-port-on-side this top-right port-side.west))
          (top-right-second-port (add-port-on-side this top-right port-side.west)))
      (add-edge-between-ports this bottom-left-first-port top-right-first-port)
      (add-edge-between-ports this bottom-left-second-port top-right-second-port))
    (set-up-ids this)
    (.graph this)))

(defjmethod two-edges-into-same-port-crosses-when-switched ((this layered-greedyswitch-test-graph-creator))

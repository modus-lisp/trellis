;;;; layered-greedyswitch-test-graph-creator.lisp -- port of
;;;; org.eclipse.elk.alg.layered.intermediate.greedyswitch.TestGraphCreator (the
;;;; greedy-switch package's own creator; the layered package's TestGraphCreator
;;;; is layered-test-graph-creator in test-layered-c).  Also holds the nested
;;;; MockRandom class (layered-greedyswitch-mock-random), which is only used here.
;;;;
;;;; Helper graph creators are not tests: every protected/public method keeps its
;;;; mechanical name and takes the creator as THIS.  Overloads that share an arity
;;;; are specialised on the parameter that tells them apart.

(in-package #:elk)

;; protected static class MockRandom extends Random: nextBoolean returns a fixed
;; flag, nextFloat/nextDouble return an incrementing float (Java float rounding is
;; kept by storing the running value as a single-float).
(defjclass layered-greedyswitch-mock-random (java-random)
  ((next-boolean-value t)
   (change-by 0.0001d0)
   (current 0.0f0)))

(defjctor layered-greedyswitch-mock-random ()
  (random-set-seed this 0))

(defjmethod set-next-boolean ((this layered-greedyswitch-mock-random) b)
  (setf (.next-boolean-value this) b))
(defjmethod set-change-by ((this layered-greedyswitch-mock-random) d)
  (setf (.change-by this) d))
(defjmethod set-current ((this layered-greedyswitch-mock-random) f)
  (setf (.current this) (coerce f 'single-float)))

(defmethod next-boolean/0 ((this layered-greedyswitch-mock-random))
  (.next-boolean-value this))
(defmethod next-float/0 ((this layered-greedyswitch-mock-random))
  (setf (.current this) (coerce (+ (.current this) (.change-by this)) 'single-float))
  (.current this))
(defmethod next-double/0 ((this layered-greedyswitch-mock-random))
  (coerce (next-float/0 this) 'double-float))

(defjclass layered-greedyswitch-test-graph-creator ()
  ((port-id 0)
   (node-id 0)
   (edge-id 0)
   ;; protected LGraph graph
   (graph nil)
   ;; protected MockRandom random
   (random nil)))

(defjctor layered-greedyswitch-test-graph-creator ()
  (setf (.graph this) (new-l-graph))
  (setf (.random this) (new-layered-greedyswitch-mock-random))
  (set-up-graph this (.graph this)))

(defjmethod get-graph ((this layered-greedyswitch-test-graph-creator))
  (set-up-graph this (.graph this))
  (.graph this))

(defjmethod set-up-graph ((this layered-greedyswitch-test-graph-creator) g)
  (set-up-ids this)
  (set-property g layered-options.edge-routing edge-routing.orthogonal)
  (set-property g layered-internal-properties.random (.random this))
  (set-property g layered-options.hierarchy-handling hierarchy-handling.include-children)
  g)

(defjmethod get-empty-graph ((this layered-greedyswitch-test-graph-creator))
  (setf (.graph this) (new-l-graph))
  (set-up-graph this (.graph this))
  (.graph this))

(defjmethod get-two-nodes-no-connection-graph ((this layered-greedyswitch-test-graph-creator))
  (let ((layer (make-layer this (.graph this))))
    (add-node-to-layer this layer)
    (add-node-to-layer this layer))
  (set-up-ids this)
  (.graph this))

(defjmethod set-up-ids ((this layered-greedyswitch-test-graph-creator))
  (let ((graphs (new-jlist)))
    (jl-add graphs (.graph this))
    (loop until (jl-is-empty graphs)
          do (let ((l-id 0)
                   (p-id 0)
                   (g (jl-remove-first graphs)))
               (jdo (l g)
                 (setf (.id l) l-id)
                 (incf l-id)
                 (let ((i 0))
                   (jdo (n l)
                     (let ((nested-graph (get-nested-graph n)))
                       (when nested-graph
                         (jl-add graphs nested-graph)))
                     (setf (.id n) i)
                     (incf i)
                     (jdo (p (get-ports n))
                       (setf (.id p) p-id)
                       (incf p-id)))))))))

(defjmethod get-cross-formed-graph ((this layered-greedyswitch-test-graph-creator))
  (let* ((left-layer (make-layer this (.graph this)))
         (right-layer (make-layer this (.graph this)))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer)))
    (east-west-edge-from-to this top-left bottom-right)
    (east-west-edge-from-to this bottom-left top-right)
    (set-up-ids this)
    (.graph this)))

(defjmethod multiple-edges-and-single-edge ((this layered-greedyswitch-test-graph-creator))
  (let* ((left-layer (make-layer this (.graph this)))
         (right-layer (make-layer this (.graph this)))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (bottom-right (add-node-to-layer this right-layer)))
    (east-west-edge-from-to this top-left bottom-right)
    (east-west-edge-from-to this top-left bottom-right)
    (east-west-edge-from-to this bottom-left bottom-right)
    (set-up-ids this)
    (.graph this)))

(defjmethod get-cross-formed-graph-with-constraints-in-second-layer ((this layered-greedyswitch-test-graph-creator))
  (get-cross-formed-graph this)
  (let* ((layer-one (jl-get (get-layers (.graph this)) 1))
         (top-node (jl-get (get-nodes layer-one) 0))
         (second-node (jl-get (get-nodes layer-one) 1)))
    (set-in-layer-order-constraint this top-node second-node))
  (set-up-ids this)
  (.graph this))

(defjmethod get-cross-formed-graph-constraints-prevent-any-switch ((this layered-greedyswitch-test-graph-creator))
  (let* ((left-layer (make-layer this (.graph this)))
         (right-layer (make-layer this (.graph this)))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer)))
    (east-west-edge-from-to this top-left bottom-right)
    (east-west-edge-from-to this bottom-left top-right)
    (set-in-layer-order-constraint this top-right bottom-right)
    (set-in-layer-order-constraint this top-left bottom-left)
    (set-up-ids this)
    (.graph this)))


         (right-layer (make-layer this (.graph this)))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer))
         (top-right-port (add-port-on-side this top-right port-side.west))
         (bottom-left-port (add-port-on-side this bottom-left port-side.east)))
    (add-edge-between-ports this bottom-left-port top-right-port)
    (let ((top-left-port (add-port-on-side this top-left port-side.east)))
      (add-edge-between-ports this top-left-port top-right-port))
    (east-west-edge-from-to this bottom-left bottom-right)
    (set-up-ids this)
    (.graph this)))

(defjmethod two-edges-into-same-port-resolves-crossing-when-switched ((this layered-greedyswitch-test-graph-creator))
  (let* ((left-layer (make-layer this (.graph this)))
         (right-layer (make-layer this (.graph this)))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer))
         (top-left-port (add-port-on-side this top-left port-side.east))
         (bottom-left-port (add-port-on-side this bottom-left port-side.east))
         (bottom-right-port (add-port-on-side this bottom-right port-side.west)))
    (add-edge-between-ports this top-left-port bottom-right-port)
    (add-edge-between-ports this bottom-left-port bottom-right-port)
    (east-west-edge-from-to this bottom-left top-right)
    (set-up-ids this)
    (.graph this)))

(defjmethod two-edges-into-same-port-from-east-with-fixed-port-order ((this layered-greedyswitch-test-graph-creator))
  (let* ((left-layer (make-layer this (.graph this)))
         (right-layer (make-layer this (.graph this)))
         (top-left (add-node-to-layer this left-layer))
         (bottom-left (add-node-to-layer this left-layer))
         (top-right (add-node-to-layer this right-layer))
         (bottom-right (add-node-to-layer this right-layer)))
    (set-fixed-order-constraint this bottom-left)
    (set-fixed-order-constraint this top-right)
    (let* ((top-left-port (add-port-on-side this top-left port-side.east))
           (bottom-left-port (add-port-on-side this bottom-left port-side.east))
           (top-right-port (add-port-on-side this top-right port-side.west))
           (bottom-right-port (add-port-on-side this bottom-right port-side.west)))
      (add-edge-between-ports this bottom-left-port bottom-right-port)
      (add-edge-between-ports this bottom-left-port top-right-port)
      (add-edge-between-ports this top-left-port top-right-port))
    (set-up-ids this)
    (.graph this)))

(defjmethod get-current-order ((this layered-greedyswitch-test-graph-creator) g)
  (let* ((layers (get-layers g))
         (node-order (make-array (size layers) :initial-element nil)))
    (dotimes (i (size layers))
      (let* ((layer (jl-get layers i))
             (nodes (get-nodes layer)))
        (setf (aref node-order i) (make-array (size nodes) :initial-element nil))
        (dotimes (j (size nodes))
          (setf (aref (aref node-order i) j) (jl-get nodes j)))))
    node-order))

(defjmethod set-as-north-south-node ((this layered-greedyswitch-test-graph-creator) node)
  (set-type node node-type.north-south-port))

(defjmethod add-north-south-edge ((this layered-greedyswitch-test-graph-creator) side node-with-ns-ports
                                  north-south-dummy node-with-east-west-ports node-with-east-west-ports-is-origin)
  (let* ((normal-node-east-of-ns-port-node
           (< (get-index (get-layer node-with-east-west-ports))
              (get-index (get-layer node-with-ns-ports))))
         (direction (if normal-node-east-of-ns-port-node port-side.west port-side.east))
         (target-node-port-side (opposed direction))
         (normal-node-port (add-port-on-side this node-with-east-west-ports target-node-port-side))
         (dummy-node-port (add-port-on-side this north-south-dummy direction)))
    (if node-with-east-west-ports-is-origin
        (add-edge-between-ports this normal-node-port dummy-node-port)
        (add-edge-between-ports this dummy-node-port normal-node-port))
    (set-property north-south-dummy layered-internal-properties.in-layer-layout-unit node-with-ns-ports)
    (set-property north-south-dummy layered-internal-properties.origin node-with-ns-ports)
    (set-as-north-south-node this north-south-dummy)
    (let ((origin-port (add-port-on-side this node-with-ns-ports side)))
      (set-property dummy-node-port layered-internal-properties.origin origin-port)
      (set-property origin-port layered-internal-properties.port-dummy north-south-dummy))
    (let* ((bary-assoc (jlist north-south-dummy))
           (other-bary-assocs (get-property node-with-ns-ports layered-internal-properties.barycenter-associates)))
      (if (null other-bary-assocs)
          (set-property node-with-ns-ports layered-internal-properties.barycenter-associates bary-assoc)
          (jl-add-all other-bary-assocs bary-assoc)))
    (if (eq side port-side.north)
        (jl-add (get-property north-south-dummy layered-internal-properties.in-layer-successor-constraints)
                node-with-ns-ports)
        (jl-add (get-property node-with-ns-ports layered-internal-properties.in-layer-successor-constraints)
                north-south-dummy))))

(defjmethod set-in-layer-order-constraint ((this layered-greedyswitch-test-graph-creator) this-node before-this-node)
  (let ((scnd-node-as-list (jlist before-this-node)))
    (set-property this-node layered-internal-properties.in-layer-successor-constraints scnd-node-as-list)))

(defjmethod set-as-long-edge-dummy ((this layered-greedyswitch-test-graph-creator) node)
  (set-type node node-type.long-edge)
  (set-property node layered-internal-properties.in-layer-layout-unit nil))

(defjmethod set-port-order-fixed ((this layered-greedyswitch-test-graph-creator) node)
  (set-property node layered-options.port-constraints port-constraints.fixed-order)
  (add (get-property (get-graph node) layered-internal-properties.graph-properties)
       layered-graph-properties.non-free-ports))

(defjmethod make-layers ((this layered-greedyswitch-test-graph-creator) amount)
  (make-layers this amount (.graph this)))

(defjmethod make-layers ((this layered-greedyswitch-test-graph-creator) amount g)
  (let ((layers (make-array amount :initial-element nil)))
    (dotimes (i amount)
      (setf (aref layers i) (make-layer this g)))
    layers))

(defjmethod set-fixed-order-constraint ((this layered-greedyswitch-test-graph-creator) (node l-node))
  (set-property node layered-options.port-constraints port-constraints.fixed-order))

(defjmethod set-fixed-order-constraint ((this layered-greedyswitch-test-graph-creator) (nodes vector))
  (loop for n across nodes
        do (set-fixed-order-constraint this n)))

(defjmethod add-in-layer-edge ((this layered-greedyswitch-test-graph-creator) (node-one l-node) (node-two l-node) port-side)
  (let ((port-one (add-port-on-side this node-one port-side))
        (port-two (add-port-on-side this node-two port-side)))
    (add-edge-between-ports this port-one port-two)))

(defjmethod add-in-layer-edge ((this layered-greedyswitch-test-graph-creator) (node-one l-node) (port-two l-port) port-side)
  (let ((port-one (add-port-on-side this node-one port-side)))
    (add-edge-between-ports this port-one port-two)))

(defjmethod add-in-layer-edge ((this layered-greedyswitch-test-graph-creator) (port-one l-port) (node-two l-node))
  (let* ((port-side (get-side port-one))
         (port-two (add-port-on-side this node-two port-side)))
    (add-edge-between-ports this port-one port-two)))

(defjmethod add-nodes-to-layer ((this layered-greedyswitch-test-graph-creator) amount-of-nodes left-layer)
  (let ((nodes (make-array amount-of-nodes :initial-element nil)))
    (dotimes (j amount-of-nodes)
      (setf (aref nodes j) (add-node-to-layer this left-layer)))
    nodes))

(defjmethod make-layer ((this layered-greedyswitch-test-graph-creator))
  (make-layer this (.graph this)))

(defjmethod make-layer ((this layered-greedyswitch-test-graph-creator) g)
  (let* ((layers (get-layers g))
         (layer (new-layer g)))
    (jl-add layers layer)
    layer))

(defjmethod add-node-to-layer ((this layered-greedyswitch-test-graph-creator) layer)
  (let ((node (new-l-node (get-graph layer))))
    (set-type node node-type.normal)
    (set-property node layered-internal-properties.in-layer-layout-unit node)
    (set-layer node layer)
    (setf (.id node) (.node-id this))
    (incf (.node-id this))
    node))

(defjmethod east-west-edge-from-to ((this layered-greedyswitch-test-graph-creator) (left l-node) (right l-node))
  (let ((left-port (add-port-on-side this left port-side.east))
        (right-port (add-port-on-side this right port-side.west)))
    (add-edge-between-ports this left-port right-port)))

(defjmethod east-west-edge-from-to ((this layered-greedyswitch-test-graph-creator) (left-port l-port) (right l-node))
  (add-edge-between-ports this left-port (add-port-on-side this right port-side.west)))

(defjmethod east-west-edge-from-to ((this layered-greedyswitch-test-graph-creator) (left l-node) (right-port l-port))
  (add-edge-between-ports this (add-port-on-side this left port-side.east) right-port))

(defjmethod add-edge-between-ports ((this layered-greedyswitch-test-graph-creator) from to)
  (let ((edge (new-l-edge)))
    (set-source edge from)
    (set-target edge to)
    (setf (.id edge) (.edge-id this))
    (incf (.edge-id this))
    edge))

(defjmethod add-port-on-side ((this layered-greedyswitch-test-graph-creator) node port-side)
  (let ((port (add-port-to this node)))
    (set-side port port-side)
    (unless (is-side-fixed (get-property node layered-options.port-constraints))
      (set-property node layered-options.port-constraints port-constraints.fixed-side))
    port))

(defjmethod add-ports-on-side ((this layered-greedyswitch-test-graph-creator) n node port-side)
  (let ((ps (make-array n :initial-element nil)))
    (dotimes (i n)
      (setf (aref ps i) (add-port-on-side this node port-side)))
    ps))

(defjmethod add-port-to ((this layered-greedyswitch-test-graph-creator) node)
  (let ((port (new-l-port)))
    (set-node port node)
    (setf (.id port) (.port-id this))
    (incf (.port-id this))
    port))

(defjmethod multiple-edges-into-one-port-and-free-port-order ((this layered-greedyswitch-test-graph-creator))
  (let ((nodes (add-nodes-to-layer this 3 (make-layer this (.graph this)))))
    (add-in-layer-edge this (aref nodes 0) (aref nodes 2) port-side.west)
    (let ((port-upper-node (add-port-on-side this (aref nodes 0) port-side.west)))
      (add-edge-between-ports this port-upper-node (add-port-on-side this (aref nodes 2) port-side.west))
      (add-edge-between-ports this port-upper-node (add-port-on-side this (aref nodes 1) port-side.west)))
    (set-up-ids this)
    (.graph this)))

(defjmethod get-only-correctly-improved-by-best-of-forward-and-backward-sweeps-in-single-layer ((this layered-greedyswitch-test-graph-creator))
  (let ((left-node (add-node-to-layer this (make-layer this (.graph this)))))
    (set-fixed-order-constraint this left-node)
    (let ((right-nodes (add-nodes-to-layer this 3 (make-layer this (.graph this)))))
      (east-west-edge-from-to this left-node (aref right-nodes 2))
      (east-west-edge-from-to this left-node (aref right-nodes 2))
      (east-west-edge-from-to this left-node (aref right-nodes 1))
      (add-in-layer-edge this (aref right-nodes 0) (aref right-nodes 2) port-side.west)))
  (set-up-ids this)
  (.graph this))

(defjmethod get-list-copy-in-index-order ((this layered-greedyswitch-test-graph-creator) li is)
  (let ((list (new-jlist)))
    (dolist (i is)
      (jl-add list (jl-get li i)))
    list))

(defjmethod get-array-in-index-order ((this layered-greedyswitch-test-graph-creator) arr is)
  (let ((copy (copy-seq arr))
        (j 0))
    (dolist (i is)
      (setf (aref copy j) (aref arr i))
      (incf j))
    copy))

(defjmethod copy-of-list-switching-order ((this layered-greedyswitch-test-graph-creator) i j li)
  (let* ((list-copy (jl-copy li))
         (first (jl-get list-copy i))
         (second (jl-get list-copy j)))
    (jl-set list-copy i second)
    (jl-set list-copy j first)
    list-copy))

(defjmethod switch-order-in-array ((this layered-greedyswitch-test-graph-creator) i j arr)
  (let* ((copy (copy-seq arr))
         (first (aref arr i))
         (snd (aref arr j)))
    (setf (aref copy j) first)
    (setf (aref copy i) snd)
    copy))

(defjmethod add-external-port-dummy-node-to-layer ((this layered-greedyswitch-test-graph-creator) layer port)
  (let ((node (add-node-to-layer this layer)))
    (set-property node layered-internal-properties.origin port)
    (set-type node node-type.external-port)
    (set-property node layered-internal-properties.ext-port-side (get-side port))
    (set-property port layered-internal-properties.port-dummy node)
    (set-property port layered-internal-properties.inside-connections t)
    (let ((ps (get-property (get-graph node) layered-internal-properties.graph-properties)))
      (add ps layered-graph-properties.external-ports))
    node))

(defjmethod add-external-port-dummies-to-layer ((this layered-greedyswitch-test-graph-creator) layer ports)
  (let* ((n (length ports))
         (nodes (make-array n :initial-element nil))
         (side (get-side (aref ports 0))))
    (dotimes (i n)
      (let ((port-index (if (eq side port-side.east) i (- n 1 i))))
        (setf (aref nodes i)
              (add-external-port-dummy-node-to-layer this layer (aref ports port-index)))))
    nodes))

(defjmethod nested-graph ((this layered-greedyswitch-test-graph-creator) node)
  (set-property node layered-internal-properties.compound-node t)
  (let ((nested-graph (get-nested-graph node)))
    (when (null nested-graph)
      (setf nested-graph (new-l-graph))
      (set-up-graph this nested-graph)
      (set-nested-graph node nested-graph)
      (set-parent-node nested-graph node))
    nested-graph))

(defjmethod switch-order-of-nodes-in-layer ((this layered-greedyswitch-test-graph-creator) node-one node-two layer)
  (let* ((nodes (get-nodes layer))
         (first-node (jl-get nodes node-one))
         (second-node (jl-get nodes node-two))
         (switched-list (jl-copy nodes)))
    (jl-set switched-list node-one second-node)
    (jl-set switched-list node-two first-node)
    switched-list))

(defjmethod copy-of-nodes-in-layer ((this layered-greedyswitch-test-graph-creator) layer-index)
  (jl-copy (get-nodes (jl-get (get-layers (.graph this)) layer-index))))

(defjmethod copy-of-switch-order-of-nodes-in-layer ((this layered-greedyswitch-test-graph-creator) node-one node-two layer-index)
  (let ((layer (copy-of-nodes-in-layer this layer-index)))
    (get-copy-with-switched-order this node-one node-two layer)))

(defjmethod get-copy-with-switched-order ((this layered-greedyswitch-test-graph-creator) node-one node-two layer)
  (let* ((first-node (jl-get layer node-one))
         (second-node (jl-get layer node-two))
         (switched-list (jl-copy layer)))
    (jl-set switched-list node-one second-node)
    (jl-set switched-list node-two first-node)
    switched-list))

(defjmethod east-west-edges-from-to ((this layered-greedyswitch-test-graph-creator) number-of-nodes left right)
  (dotimes (i number-of-nodes)
    (east-west-edge-from-to this left right)))

(defjmethod copy-ports-in-index-order ((this layered-greedyswitch-test-graph-creator) node indices)
  (let ((res (new-jlist)))
    (dolist (i indices)
      (jl-add res (jl-get (get-ports node) i)))
    res))

(defjmethod get-random ((this layered-greedyswitch-test-graph-creator))
  (.random this))

(defjmethod set-random ((this layered-greedyswitch-test-graph-creator) random)
  (setf (.random this) random))

(defjmethod set-on-all-graphs ((this layered-greedyswitch-test-graph-creator) prop val g)
  (set-property g prop val)
  (jdo (node g)
    (let ((nested-graph (get-nested-graph node)))
      (when nested-graph
        (set-on-all-graphs this prop val nested-graph)))))

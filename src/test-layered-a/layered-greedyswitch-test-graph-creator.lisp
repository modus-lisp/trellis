(defjmethod get-in-layer-edges-graph ((this layered-greedyswitch-test-graph-creator))
  (let* ((left-layer (make-layer this (.graph this)))
         (middle-layer (make-layer this (.graph this)))
         (right-layer (make-layer this (.graph this)))
         (left-node (add-node-to-layer this left-layer))
         (middle-nodes (add-nodes-to-layer this 3 middle-layer))
         (right-node (add-node-to-layer this right-layer)))
    (east-west-edge-from-to this (aref middle-nodes 1) right-node)
    (east-west-edge-from-to this left-node (aref middle-nodes 1))
    (add-in-layer-edge this (aref middle-nodes 0) (aref middle-nodes 2) port-side.west)
    (set-up-ids this)
    (.graph this)))


;;;; preserveorder.lisp -- org.eclipse.elk.alg.layered.intermediate.preserveorder
;;;; CMGroupModelOrderCalculator, ModelOrderNodeComparator, ModelOrderPortComparator
;;;; and the PortSideComparator inner class of the latter.
;;;;
;;;; The two comparators are FUNCALLABLE instances: Java passes them to
;;;; Collections.sort, which here calls the function, so (funcall cmp a b) and
;;;; (compare cmp a b) are the same thing.  Both public constructors of each class
;;;; take a Layer or an array as previousLayer; one constructor dispatches on it.

(in-package #:elk)

;;; ------------------------------------------------------------ CMGroupModelOrderCalculator

(defjstatic cm-group-model-order-calculator.calculate-model-order-or-group-model-order
    (element other parent offset)
  (let ((enforce-group-model-order
          (eq (get-property parent layered-options.consider-model-order-group-model-order-cm-group-order-strategy)
              group-order-strategy.enforced))
        (enforced-orders
          (get-property parent layered-options.consider-model-order-group-model-order-cm-enforced-group-orders)))
    (cond ((not (has-property element layered-internal-properties.model-order))
           -1)
          (enforce-group-model-order
           (if (and (contains enforced-orders
                              (get-property element layered-options.consider-model-order-group-model-order-crossing-minimization-id))
                    (contains enforced-orders
                              (get-property other layered-options.consider-model-order-group-model-order-crossing-minimization-id)))
               (+ offset (get-property element layered-internal-properties.model-order))
               (get-property element layered-internal-properties.model-order)))
          (t (get-property element layered-internal-properties.model-order)))))

;;; ------------------------------------------------------------ helpers shared by both comparators

(defun %mo-previous-layer-vector (previous-layer)
  "A Layer is copied to an array of its nodes; an array is kept as it is."
  (if (typep previous-layer 'layer)
      (coerce (get-nodes previous-layer) 'simple-vector)
      previous-layer))

(defun %mo-install-funcallable (comparator)
  (sb-mop:set-funcallable-instance-function
   comparator
   (lambda (a b) (compare comparator a b)))
  comparator)

(defun %mo-first-port-with-incoming (node)
  "The first port of NODE that has incoming edges, or NIL."
  (loop for p across (get-ports node)
        when (not (is-empty (get-incoming-edges p)))
          return p))

(defun %mo-first-port-with-outgoing (node)
  (loop for p across (get-ports node)
        when (not (is-empty (get-outgoing-edges p)))
          return p))

;;; ------------------------------------------------------------ ModelOrderNodeComparator

(defjctor model-order-node-comparator (graph previous-layer ordering-strategy long-edge-ordering-strategy
                                       group-order-strategy before-ports)
  (setf (.graph this) graph
        (.ordering-strategy this) ordering-strategy
        (.group-order-strategy this) group-order-strategy
        (.long-edge-node-order this) long-edge-ordering-strategy
        (.before-ports this) before-ports
        (.previous-layer this) (%mo-previous-layer-vector previous-layer))
  (%mo-install-funcallable this))

(defjmethod compare ((this model-order-node-comparator) n1 n2)
  (block cmp
    (let ((bigger-than (.bigger-than this))
          (smaller-than (.smaller-than this)))
      (cond ((not (jm-contains-key bigger-than n1))
             (jm-put bigger-than n1 (new-jset)))
            ((js-contains (jm-get bigger-than n1) n2)
             (return-from cmp 1)))
      (cond ((not (jm-contains-key bigger-than n2))
             (jm-put bigger-than n2 (new-jset)))
            ((js-contains (jm-get bigger-than n2) n1)
             (return-from cmp -1)))
      (cond ((not (jm-contains-key smaller-than n1))
             (jm-put smaller-than n1 (new-jset)))
            ((js-contains (jm-get smaller-than n1) n2)
             (return-from cmp -1)))
      (cond ((not (jm-contains-key smaller-than n2))
             (jm-put smaller-than n2 (new-jset)))
            ((js-contains (jm-get bigger-than n2) n1)
             (return-from cmp 1))))
    (when (or (eq (.ordering-strategy this) ordering-strategy.prefer-edges)
              (not (has-property n1 layered-internal-properties.model-order))
              (not (has-property n2 layered-internal-properties.model-order)))
      (let ((p1-source-port (%mo-source-port-in-previous-layer n1))
            (p2-source-port (%mo-source-port-in-previous-layer n2)))
        (when (and p1-source-port p2-source-port)
          (let ((p1-node (get-node p1-source-port))
                (p2-node (get-node p2-source-port)))
            (when (and p1-node (eq p1-node p2-node))
              (loop for port across (get-ports p1-node)
                    do (cond ((eq port p1-source-port)
                              (%mo-update-bigger-and-smaller this n2 n1)
                              (return-from cmp -1))
                             ((eq port p2-source-port)
                              (%mo-update-bigger-and-smaller this n1 n2)
                              (return-from cmp 1))))
              (let ((n1-edge-order (%mo-model-order-from-connected-edges this n1))
                    (n2-edge-order (%mo-model-order-from-connected-edges this n2)))
                (if (> n1-edge-order n2-edge-order)
                    (progn (%mo-update-bigger-and-smaller this n1 n2)
                           (return-from cmp 1))
                    (progn (%mo-update-bigger-and-smaller this n2 n1)
                           (return-from cmp -1)))))
            (loop for previous-node across (.previous-layer this)
                  do (cond ((eq previous-node p1-node)
                            (%mo-update-bigger-and-smaller this n2 n1)
                            (return-from cmp -1))
                           ((eq previous-node p2-node)
                            (%mo-update-bigger-and-smaller this n1 n2)
                            (return-from cmp 1))))))
        (when (or (and p1-source-port (not p2-source-port))
                  (and (not p1-source-port) p2-source-port))
          (let ((compared-with-long-edge-feedback (%mo-handle-helper-dummy-nodes this n1 n2)))
            (when (/= compared-with-long-edge-feedback 0)
              (if (> compared-with-long-edge-feedback 0)
                  (%mo-update-bigger-and-smaller this n1 n2)
                  (%mo-update-bigger-and-smaller this n2 n1))
              (return-from cmp compared-with-long-edge-feedback)))
          (when (or (not (has-property n1 layered-internal-properties.model-order))
                    (not (has-property n2 layered-internal-properties.model-order)))
            (let ((n1-model-order (%mo-model-order-from-connected-edges this n1))
                  (n2-model-order (%mo-model-order-from-connected-edges this n2)))
              (if (> n1-model-order n2-model-order)
                  (progn (%mo-update-bigger-and-smaller this n1 n2)
                         (return-from cmp 1))
                  (progn (%mo-update-bigger-and-smaller this n2 n1)
                         (return-from cmp -1))))))
        (when (and (not p1-source-port) (not p2-source-port))
          (let ((compared-with-long-edge-feedback (%mo-handle-helper-dummy-nodes this n1 n2)))
            (when (/= compared-with-long-edge-feedback 0)
              (if (> compared-with-long-edge-feedback 0)
                  (%mo-update-bigger-and-smaller this n1 n2)
                  (%mo-update-bigger-and-smaller this n2 n1))
              (return-from cmp compared-with-long-edge-feedback))))))
    (cond ((and (has-property n1 layered-internal-properties.model-order)
                (has-property n2 layered-internal-properties.model-order))
           (let ((n1-model-order
                   (cm-group-model-order-calculator.calculate-model-order-or-group-model-order
                    n1 n2 (.graph this)
                    (get-property (.graph this) layered-internal-properties.max-model-order-nodes)))
                 (n2-model-order
                   (cm-group-model-order-calculator.calculate-model-order-or-group-model-order
                    n2 n1 (.graph this)
                    (get-property (.graph this) layered-internal-properties.max-model-order-nodes))))
             (if (> n1-model-order n2-model-order)
                 (progn (%mo-update-bigger-and-smaller this n1 n2) 1)
                 (progn (%mo-update-bigger-and-smaller this n2 n1) -1))))
          (t (%mo-update-bigger-and-smaller this n2 n1)
             -1))))

(defun %mo-source-port-in-previous-layer (n)
  "The source port of the first incoming edge of N's ports that comes from the previous layer, or NIL."
  (loop for p across (get-ports n)
        do (when (not (is-empty (get-incoming-edges p)))
             (when (= (.id (get-layer (get-node (get-source (jl-get (get-incoming-edges p) 0)))))
                      (1- (.id (get-layer n))))
               (return (get-source (jl-get (get-incoming-edges p) 0)))))))

(defun %mo-model-order-from-connected-edges (this n)
  (let ((source-port (%mo-first-port-with-incoming n)))
    (when source-port
      (let ((edge (jl-get (get-incoming-edges source-port) 0)))
        (when edge
          (return-from %mo-model-order-from-connected-edges
            (get-property edge layered-internal-properties.model-order)))))
    (return-value (.long-edge-node-order this))))

(defun %mo-update-bigger-and-smaller (this bigger smaller)
  (let* ((bigger-than (.bigger-than this))
         (smaller-than (.smaller-than this))
         (bigger-node-bigger-than (jm-get bigger-than bigger))
         (smaller-node-bigger-than (jm-get bigger-than smaller))
         (bigger-node-smaller-than (jm-get smaller-than bigger))
         (smaller-node-smaller-than (jm-get smaller-than smaller)))
    (js-add bigger-node-bigger-than smaller)
    (js-add smaller-node-smaller-than bigger)
    (jdo (very-small smaller-node-bigger-than)
      (js-add bigger-node-bigger-than very-small)
      (js-add (jm-get smaller-than very-small) bigger)
      (js-add-all (jm-get smaller-than very-small) bigger-node-smaller-than))
    (jdo (very-big bigger-node-smaller-than)
      (js-add smaller-node-smaller-than very-big)
      (js-add (jm-get bigger-than very-big) smaller)
      (js-add-all (jm-get bigger-than very-big) smaller-node-bigger-than))))

(defun %mo-handle-helper-dummy-nodes (this n1 n2)
  (cond
    ((and (eq (get-type n1) node-type.long-edge) (eq (get-type n2) node-type.normal))
     (let* ((dummy-node-source-node (get-node (%mo-first-incoming-source-port-of-node n1)))
            (dummy-node-target-node (get-node (%mo-first-outgoing-target-port-of-node n1)))
            (dummy-layer-id (.id (get-layer n1))))
       (cond ((and (/= (.id (get-layer dummy-node-source-node)) dummy-layer-id)
                   (/= (.id (get-layer dummy-node-target-node)) dummy-layer-id))
              0)
             ((eq dummy-node-source-node n2)
              (%mo-update-bigger-and-smaller this n1 n2)
              1)
             ((eq dummy-node-target-node n2)
              (%mo-update-bigger-and-smaller this n1 n2)
              1)
             (t (compare this dummy-node-source-node n2)))))
    ((and (eq (get-type n1) node-type.normal) (eq (get-type n2) node-type.long-edge))
     (let* ((dummy-node-source-node (get-node (%mo-first-incoming-source-port-of-node n2)))
            (dummy-node-target-node (get-node (%mo-first-outgoing-target-port-of-node n2)))
            (dummy-layer-id (.id (get-layer n1))))
       (cond ((and (/= (.id (get-layer dummy-node-source-node)) dummy-layer-id)
                   (/= (.id (get-layer dummy-node-target-node)) dummy-layer-id))
              0)
             ((eq dummy-node-source-node n1)
              (%mo-update-bigger-and-smaller this n2 n1)
              -1)
             ((eq dummy-node-target-node n1)
              (%mo-update-bigger-and-smaller this n2 n1)
              -1)
             (t (compare this n1 dummy-node-source-node)))))
    ((and (eq (get-type n1) node-type.long-edge) (eq (get-type n2) node-type.long-edge))
     (%mo-handle-long-edge-pair this n1 n2))
    (t 0)))

(defun %mo-handle-long-edge-pair (this n1 n2)
  (let* ((n1-dummy-node-source-port (%mo-first-incoming-source-port-of-node n1))
         (n1-dummy-node-target-port (%mo-first-outgoing-target-port-of-node n1))
         (n1-dummy-source-node (get-node n1-dummy-node-source-port))
         (n1-dummy-target-node (get-node n1-dummy-node-target-port))
         (n1-layer-id (.id (get-layer n1)))
         (n1-source-feedback-node nil)
         (n1-target-feedback-node nil)
         (n2-dummy-node-source-port (%mo-first-incoming-source-port-of-node n2))
         (n2-dummy-node-target-port (%mo-first-outgoing-target-port-of-node n2))
         (n2-dummy-source-node (get-node n2-dummy-node-source-port))
         (n2-dummy-target-node (get-node n2-dummy-node-target-port))
         (n2-layer-id (.id (get-layer n2)))
         (n2-source-feedback-node nil)
         (n2-target-feedback-node nil)
         (n1-reference-node n1)
         (n2-reference-node n2))
    (cond ((= (.id (get-layer n1-dummy-source-node)) n1-layer-id)
           (setf n1-source-feedback-node t
                 n1-reference-node n1-dummy-source-node))
          ((= (.id (get-layer n1-dummy-target-node)) n1-layer-id)
           (setf n1-target-feedback-node t
                 n1-reference-node n1-dummy-target-node)))
    (cond ((= (.id (get-layer n2-dummy-source-node)) n2-layer-id)
           (setf n2-source-feedback-node t
                 n2-reference-node n2-dummy-source-node))
          ((= (.id (get-layer n2-dummy-target-node)) n2-layer-id)
           (setf n2-target-feedback-node t
                 n2-reference-node n2-dummy-target-node)))
    (when (eq n1-reference-node n2-reference-node)
      (if (.before-ports this)
          (cond ((and n1-source-feedback-node n2-source-feedback-node)
                 (let ((return-value
                         (compare (new-model-order-port-comparator (.graph this) (.previous-layer this)
                                                                   (.ordering-strategy this) nil
                                                                   n2-target-feedback-node)
                                  n1-dummy-node-source-port n2-dummy-node-source-port)))
                   (if (> return-value 0)
                       (progn (%mo-update-bigger-and-smaller this n2 n1) (return-from %mo-handle-long-edge-pair 1))
                       (progn (%mo-update-bigger-and-smaller this n1 n2) (return-from %mo-handle-long-edge-pair -1)))))
                ((and n1-source-feedback-node n2-target-feedback-node)
                 (%mo-update-bigger-and-smaller this n2 n1)
                 (return-from %mo-handle-long-edge-pair 1))
                ((and n1-target-feedback-node n2-source-feedback-node)
                 (%mo-update-bigger-and-smaller this n1 n2)
                 (return-from %mo-handle-long-edge-pair -1))
                ((and n1-target-feedback-node n2-target-feedback-node)
                 (return-from %mo-handle-long-edge-pair 0)))
          (loop for port across (get-ports n1-reference-node)
                do (cond ((eq n1-dummy-node-source-port port)
                          (%mo-update-bigger-and-smaller this n2 n1)
                          (return-from %mo-handle-long-edge-pair -1))
                         ((eq n2-dummy-node-source-port port)
                          (%mo-update-bigger-and-smaller this n1 n2)
                          (return-from %mo-handle-long-edge-pair 1))))))
    (compare this n1-reference-node n2-reference-node)))

(defun %mo-first-incoming-source-port-of-node (node)
  (get-source (jl-get (get-incoming-edges (%mo-first-port-with-incoming node)) 0)))

(defun %mo-first-outgoing-target-port-of-node (node)
  (get-target (jl-get (get-outgoing-edges (%mo-first-port-with-outgoing node)) 0)))

(defjmethod clear-transitive-ordering ((this model-order-node-comparator))
  (setf (.bigger-than this) (new-jmap)
        (.smaller-than this) (new-jmap)))

;;; ------------------------------------------------------------ PortSideComparator (inner class)

(defjctor port-side-comparator ())

(defjmethod compare ((this port-side-comparator) ps1 ps2)
  (integer.compare (ordinal ps1) (ordinal ps2)))

;;; ------------------------------------------------------------ ModelOrderPortComparator

(defjctor model-order-port-comparator (graph previous-layer strategy target-node-model-order port-model-order)
  (setf (.graph this) graph
        (.previous-layer this) (%mo-previous-layer-vector previous-layer)
        (.strategy this) strategy
        (.target-node-model-order this) target-node-model-order
        (.port-model-order this) port-model-order)
  (%mo-install-funcallable this))

(defjmethod compare ((this model-order-port-comparator) original-p1 original-p2)
  (block cmp
    (let ((p1 original-p1)
          (p2 original-p2)
          (bigger-than (.bigger-than this))
          (smaller-than (.smaller-than this)))
      (cond ((not (jm-contains-key bigger-than p1))
             (jm-put bigger-than p1 (new-jset)))
            ((js-contains (jm-get bigger-than p1) p2)
             (return-from cmp 1)))
      (cond ((not (jm-contains-key bigger-than p2))
             (jm-put bigger-than p2 (new-jset)))
            ((js-contains (jm-get bigger-than p2) p1)
             (return-from cmp -1)))
      (cond ((not (jm-contains-key smaller-than p1))
             (jm-put smaller-than p1 (new-jset)))
            ((js-contains (jm-get smaller-than p1) p2)
             (return-from cmp -1)))
      (cond ((not (jm-contains-key smaller-than p2))
             (jm-put smaller-than p2 (new-jset)))
            ((js-contains (jm-get bigger-than p2) p1)
             (return-from cmp 1))))
    (let ((p1 original-p1)
          (p2 original-p2))
      (when (not (eq (get-side p1) (get-side p2)))
        (let ((result (compare (new-port-side-comparator) (get-side p1) (get-side p2))))
          (if (> result 0)
              (%mop-update-bigger-and-smaller this p1 p2 1)
              (%mop-update-bigger-and-smaller this p2 p1 1))
          (return-from cmp result)))
      (let ((reverse-order 1))
        (when (and (not (is-empty (get-incoming-edges p1)))
                   (not (is-empty (get-incoming-edges p2))))
          (when (or (and (eq (get-side p1) port-side.west) (eq (get-side p2) port-side.west))
                    (and (eq (get-side p1) port-side.north) (eq (get-side p2) port-side.north))
                    (and (eq (get-side p1) port-side.south) (eq (get-side p2) port-side.south)))
            (setf reverse-order (- reverse-order)))
          (let* ((p1-source-port (get-source (jl-get (get-incoming-edges p1) 0)))
                 (p2-source-port (get-source (jl-get (get-incoming-edges p2) 0)))
                 (p1-node (get-node p1-source-port))
                 (p2-node (get-node p2-source-port)))
            (when (eq p1-node p2-node)
              (loop for port across (get-ports p1-node)
                    do (cond ((eq p1-source-port port)
                              (%mop-update-bigger-and-smaller this p2 p1 reverse-order)
                              (return-from cmp (- reverse-order)))
                             ((eq p2-source-port port)
                              (%mop-update-bigger-and-smaller this p1 p2 reverse-order)
                              (return-from cmp reverse-order)))))
            (when (and (eq (get-type (get-node p1-source-port)) node-type.long-edge)
                       (eq (get-type (get-node p2-source-port)) node-type.long-edge)
                       (= (.id (get-layer p1-node)) (.id (get-layer p2-node)))
                       (= (.id (get-layer p1-node)) (.id (get-layer (get-node p1)))))
              (let* ((prev-layer (get-layer p1-node))
                     (in-previous-layer (%mop-check-reference-layer (get-nodes prev-layer) p1-node p2-node)))
                (when (/= in-previous-layer 0)
                  (when (and (eq (get-side p1) port-side.east) (eq (get-side p2) port-side.east))
                    (setf reverse-order (- reverse-order)))
                  (if (> in-previous-layer 0)
                      (progn (%mop-update-bigger-and-smaller this p1 p2 reverse-order)
                             (return-from cmp reverse-order))
                      (progn (%mop-update-bigger-and-smaller this p2 p1 reverse-order)
                             (return-from cmp (- reverse-order)))))))
            (let ((in-previous-layer (%mop-check-reference-layer (.previous-layer this) p1-node p2-node)))
              (when (/= in-previous-layer 0)
                (if (> in-previous-layer 0)
                    (progn (%mop-update-bigger-and-smaller this p1 p2 reverse-order)
                           (return-from cmp reverse-order))
                    (progn (%mop-update-bigger-and-smaller this p2 p1 reverse-order)
                           (return-from cmp (- reverse-order))))))
            (when (.port-model-order this)
              (let ((result (%mop-check-port-model-order this p1 p2)))
                (when (/= result 0)
                  (if (> result 0)
                      (progn (%mop-update-bigger-and-smaller this p1 p2 reverse-order)
                             (return-from cmp reverse-order))
                      (progn (%mop-update-bigger-and-smaller this p2 p1 reverse-order)
                             (return-from cmp (- reverse-order)))))))))
        (when (and (not (is-empty (get-outgoing-edges p1)))
                   (not (is-empty (get-outgoing-edges p2))))
          (when (or (and (eq (get-side p1) port-side.west) (eq (get-side p2) port-side.west))
                    (and (eq (get-side p1) port-side.south) (eq (get-side p2) port-side.south)))
            (setf reverse-order (- reverse-order)))
          (let* ((p1-target-node (get-property p1 layered-internal-properties.long-edge-target-node))
                 (p2-target-node (get-property p2 layered-internal-properties.long-edge-target-node)))
            (when (and (eq (.strategy this) ordering-strategy.prefer-nodes)
                       p1-target-node p2-target-node
                       (has-property p1-target-node layered-internal-properties.model-order)
                       (has-property p2-target-node layered-internal-properties.model-order))
              (let ((p1-mo (cm-group-model-order-calculator.calculate-model-order-or-group-model-order
                            p1-target-node p2-target-node (.graph this)
                            (get-property (.graph this) layered-internal-properties.max-model-order-nodes)))
                    (p2-mo (cm-group-model-order-calculator.calculate-model-order-or-group-model-order
                            p2-target-node p1-target-node (.graph this)
                            (get-property (.graph this) layered-internal-properties.max-model-order-nodes))))
                (if (> p1-mo p2-mo)
                    (progn (%mop-update-bigger-and-smaller this p1 p2 reverse-order)
                           (return-from cmp reverse-order))
                    (progn (%mop-update-bigger-and-smaller this p2 p1 reverse-order)
                           (return-from cmp (- reverse-order))))))
            (when (.port-model-order this)
              (let ((result (%mop-check-port-model-order this p1 p2)))
                (when (/= result 0)
                  (if (> result 0)
                      (progn (%mop-update-bigger-and-smaller this p1 p2 reverse-order)
                             (return-from cmp reverse-order))
                      (progn (%mop-update-bigger-and-smaller this p2 p1 reverse-order)
                             (return-from cmp (- reverse-order)))))))
            (let ((p1-order 0)
                  (p2-order 0))
              (when (has-property (jl-get (get-outgoing-edges p1) 0) layered-internal-properties.model-order)
                (setf p1-order
                      (cm-group-model-order-calculator.calculate-model-order-or-group-model-order
                       (jl-get (get-outgoing-edges p1) 0) (jl-get (get-outgoing-edges p2) 0) (.graph this)
                       (+ (length (get-outgoing-edges p1)) (length (get-incoming-edges p1))))))
              (when (has-property (jl-get (get-outgoing-edges p2) 0) layered-internal-properties.model-order)
                (setf p2-order
                      (cm-group-model-order-calculator.calculate-model-order-or-group-model-order
                       (jl-get (get-outgoing-edges p2) 0) (jl-get (get-outgoing-edges p1) 0) (.graph this)
                       (+ (length (get-outgoing-edges p2)) (length (get-incoming-edges p2))))))
              (when (and p1-target-node (eq p1-target-node p2-target-node))
                (if (> p1-order p2-order)
                    (progn (%mop-update-bigger-and-smaller this p1 p2 reverse-order)
                           (return-from cmp reverse-order))
                    (progn (%mop-update-bigger-and-smaller this p2 p1 reverse-order)
                           (return-from cmp (- reverse-order)))))
              (when (.target-node-model-order this)
                (when (jm-contains-key (.target-node-model-order this) p1-target-node)
                  (setf p1-order (jm-get (.target-node-model-order this) p1-target-node)))
                (when (jm-contains-key (.target-node-model-order this) p2-target-node)
                  (setf p2-order (jm-get (.target-node-model-order this) p2-target-node))))
              (if (> p1-order p2-order)
                  (progn (%mop-update-bigger-and-smaller this p1 p2 reverse-order)
                         (return-from cmp reverse-order))
                  (progn (%mop-update-bigger-and-smaller this p2 p1 reverse-order)
                         (return-from cmp (- reverse-order)))))))
        (cond ((and (not (is-empty (get-incoming-edges p1)))
                    (not (is-empty (get-outgoing-edges p2))))
               (%mop-update-bigger-and-smaller this p1 p2 reverse-order)
               (return-from cmp 1))
              ((and (not (is-empty (get-outgoing-edges p1)))
                    (not (is-empty (get-incoming-edges p2))))
               (%mop-update-bigger-and-smaller this p2 p1 reverse-order)
               (return-from cmp -1))
              ((and (has-property p1 layered-internal-properties.model-order)
                    (has-property p2 layered-internal-properties.model-order))
               (let* ((number-of-ports (length (get-ports (get-node p1))))
                      (p1-mo (cm-group-model-order-calculator.calculate-model-order-or-group-model-order
                              p1 p2 (.graph this) number-of-ports))
                      (p2-mo (cm-group-model-order-calculator.calculate-model-order-or-group-model-order
                              p2 p1 (.graph this) number-of-ports)))
                 (when (or (and (eq (get-side p1) port-side.west) (eq (get-side p2) port-side.west))
                           (and (eq (get-side p1) port-side.south) (eq (get-side p2) port-side.south)))
                   (setf reverse-order (- reverse-order)))
                 (if (> p1-mo p2-mo)
                     (progn (%mop-update-bigger-and-smaller this p1 p2 reverse-order)
                            (return-from cmp reverse-order))
                     (progn (%mop-update-bigger-and-smaller this p2 p1 reverse-order)
                            (return-from cmp (- reverse-order))))))
              (t (%mop-update-bigger-and-smaller this p2 p1 reverse-order)
                 (return-from cmp (- reverse-order))))))))

(defun %mop-check-reference-layer (nodes p1-node p2-node)
  (loop for node across nodes
        do (cond ((eq node p1-node) (return-from %mop-check-reference-layer -1))
                 ((eq node p2-node) (return-from %mop-check-reference-layer 1))))
  0)

(defjmethod check-port-model-order ((this model-order-port-comparator) p1 p2)
  (%mop-check-port-model-order this p1 p2))

(defun %mop-check-port-model-order (this p1 p2)
  (let ((number-of-ports (length (get-ports (get-node p1)))))
    (if (and (has-property p1 layered-internal-properties.model-order)
             (has-property p2 layered-internal-properties.model-order))
        (let ((p1-order (cm-group-model-order-calculator.calculate-model-order-or-group-model-order
                         p1 p2 (.graph this) number-of-ports))
              (p2-order (cm-group-model-order-calculator.calculate-model-order-or-group-model-order
                         p2 p1 (.graph this) number-of-ports)))
          (integer.compare p1-order p2-order))
        0)))

(defun %mop-update-bigger-and-smaller (this bigger-ori smaller-ori reverse-order)
  (let ((bigger bigger-ori)
        (smaller smaller-ori))
    (when (< reverse-order 0)
      (setf bigger smaller-ori
            smaller bigger-ori))
    (let* ((bigger-than (.bigger-than this))
           (smaller-than (.smaller-than this))
           (bigger-port-bigger-than (jm-get bigger-than bigger))
           (smaller-port-bigger-than (jm-get bigger-than smaller))
           (bigger-port-smaller-than (jm-get smaller-than bigger))
           (smaller-port-smaller-than (jm-get smaller-than smaller)))
      (js-add bigger-port-bigger-than smaller)
      (js-add smaller-port-smaller-than bigger)
      (jdo (very-small smaller-port-bigger-than)
        (js-add bigger-port-bigger-than very-small)
        (js-add (jm-get smaller-than very-small) bigger)
        (js-add-all (jm-get smaller-than very-small) bigger-port-smaller-than))
      (jdo (very-big bigger-port-smaller-than)
        (js-add smaller-port-smaller-than very-big)
        (js-add (jm-get bigger-than very-big) smaller)
        (js-add-all (jm-get bigger-than very-big) smaller-port-bigger-than)))))

(defjmethod clear-transitive-ordering ((this model-order-port-comparator))
  (setf (.bigger-than this) (new-jmap)
        (.smaller-than this) (new-jmap)))

;;;; unzipping.lisp -- org.eclipse.elk.alg.layered.intermediate.unzipping
;;;; AlternatingLayerUnzipper.

(in-package #:elk)

(defjmethod process ((this alternating-layer-unzipper) graph progress-monitor)
  (declare (ignore progress-monitor))
  (let ((insertion-layer-offset 1)
        (new-layers (new-jlist)))
    (loop for i from 0 below (length (get-layers graph))
          do (block layer-body
               (let* ((layer (jl-get (get-layers graph) i))
                      (n (%alu-get-layer-split-property layer))
                      (reset-on-long-edges (%alu-get-reset-on-long-edges-property layer))
                      (minimize-edge-length (%alu-get-minimize-edge-length-property layer)))
                 (when minimize-edge-length
                   (let ((max-width 0d0)
                         (average-height 0d0))
                     (jdo (node (get-nodes layer))
                       (setf max-width (math.max max-width (.x (get-size node))))
                       (incf average-height (.y (get-size node))))
                     (setf average-height (/ average-height (float (length (get-nodes layer)) 1d0)))
                     ;; add spacings for heuristic to get closer to zero spacing situation
                     (incf max-width
                           (math.max (* 2 (get-property graph layered-options.spacing-edge-node-between-layers))
                                     (math.max (* (length (get-nodes layer))
                                                  (get-property graph layered-options.spacing-edge-edge-between-layers))
                                               (get-property graph layered-options.spacing-node-node-between-layers))))
                     (incf average-height
                           (math.max (get-property graph layered-options.spacing-node-node)
                                     (get-property graph layered-options.spacing-edge-node)))
                     ;; apply heuristic
                     (when (>= (/ max-width average-height)
                               (/ (length (get-nodes layer)) 4d0))
                       (return-from layer-body nil))))
                 (when (>= (length (get-nodes layer)) n)
                   (let ((sub-layers (list layer)))
                     (loop for j from 0 below (1- n)
                           do (let ((new-layer (new-layer graph)))
                                (jl-add new-layers (new-pair new-layer (+ i j insertion-layer-offset)))
                                (setf sub-layers (append sub-layers (list new-layer)))))
                     (setf sub-layers (coerce sub-layers 'simple-vector))
                     (incf insertion-layer-offset (1- n))
                     (let ((nodes-in-layer (length (get-nodes (aref sub-layers 0))))
                           (j 0) (node-index 0) (target-layer 0))
                       (loop while (< j nodes-in-layer)
                             do (let ((node (jl-get (get-nodes (aref sub-layers 0)) node-index)))
                                  (if (not (eq (get-type node) node-type.nonshifting-placeholder))
                                      (incf node-index
                                            (%alu-shift-node graph sub-layers (rem target-layer n) node-index))
                                      (progn
                                        (decf j)
                                        (decf target-layer)))
                                  (when (and reset-on-long-edges
                                             (eq (get-type node) node-type.long-edge))
                                    (setf target-layer -1))
                                  (incf j)
                                  (incf node-index)
                                  (incf target-layer)))))))))
    (jdo (new-layer-pair new-layers)
      (jl-add-at (get-layers graph) (get-second new-layer-pair) (get-first new-layer-pair)))
    (jdo (layer (get-layers graph))
      (let ((node-list (get-nodes layer))
            (i 0))
        (loop while (< i (length node-list))
              do (let ((node (jl-get node-list i)))
                   (if (or (eq (get-type node) node-type.placeholder)
                           (eq (get-type node) node-type.nonshifting-placeholder))
                       (jl-remove-at node-list i)
                       (incf i))))))
    nil))

(defun %alu-get-layer-split-property (layer)
  (let ((layer-split integer.max-value)
        (property-unset t))
    (loop for i from 0 below (length (get-nodes layer))
          do (let ((node (jl-get (get-nodes layer) i)))
               (when (has-property node layered-options.layer-unzipping-layer-split)
                 (setf property-unset nil)
                 (let ((node-value (get-property node layered-options.layer-unzipping-layer-split)))
                   (setf layer-split (if (< layer-split node-value) layer-split node-value))))))
    (when property-unset
      (setf layer-split (get-default layered-options.layer-unzipping-layer-split)))
    layer-split))

(defun %alu-get-reset-on-long-edges-property (layer)
  (loop for i from 0 below (length (get-nodes layer))
        do (let ((node (jl-get (get-nodes layer) i)))
             (when (has-property node layered-options.layer-unzipping-reset-on-long-edges)
               (when (not (get-property node layered-options.layer-unzipping-reset-on-long-edges))
                 (return-from %alu-get-reset-on-long-edges-property nil)))))
  t)

(defun %alu-get-minimize-edge-length-property (layer)
  (loop for i from 0 below (length (get-nodes layer))
        do (let ((node (jl-get (get-nodes layer) i)))
             (when (has-property node layered-options.layer-unzipping-minimize-edge-length)
               (when (get-property node layered-options.layer-unzipping-minimize-edge-length)
                 (return-from %alu-get-minimize-edge-length-property t)))))
  nil)

(defun %alu-shift-node (graph sub-layers target-layer node-index)
  (let ((node (jl-get (get-nodes (aref sub-layers 0)) node-index))
        (edge-count 0))
    (when (> target-layer 0)
      (set-layer node (aref sub-layers target-layer)))
    (let ((no-incoming-edges t)
          (reversed-incoming-edges (jl-reverse (jlist-from (get-incoming-edges node)))))
      (jdo (incoming-edge reversed-incoming-edges)
        (setf no-incoming-edges nil)
        (let ((next-edge-to-split incoming-edge))
          (loop for layer-index from 0 below target-layer
                do (let ((dummy-node (%alu-create-dummy-node graph next-edge-to-split)))
                     (if (> (+ node-index edge-count) (length (get-nodes (aref sub-layers layer-index))))
                         (set-layer dummy-node (aref sub-layers layer-index))
                         (set-layer dummy-node (+ node-index edge-count) (aref sub-layers layer-index)))
                     (setf next-edge-to-split
                           (long-edge-splitter.split-edge next-edge-to-split dummy-node)))))
        (when (> target-layer 0)
          (incf edge-count 1)))
      (when no-incoming-edges
        (loop for layer-index from 0 below target-layer
              do (let ((dummy-node (new-l-node graph)))
                   (set-type dummy-node node-type.placeholder)
                   (if (> (+ node-index edge-count) (length (get-nodes (aref sub-layers layer-index))))
                       (set-layer dummy-node (aref sub-layers layer-index))
                       (set-layer dummy-node (+ node-index edge-count) (aref sub-layers layer-index)))))
        (when (> target-layer 0)
          (incf edge-count 1))))
    (let ((extra-edge nil))
      (jdo (outgoing-edge (get-outgoing-edges node))
        (let ((next-edge-to-split outgoing-edge))
          (loop for layer-index from (1+ target-layer) below (length sub-layers)
                do (let ((dummy-node (%alu-create-dummy-node graph next-edge-to-split)))
                     (set-layer dummy-node (aref sub-layers layer-index))
                     (setf next-edge-to-split
                           (long-edge-splitter.split-edge next-edge-to-split dummy-node)))))
        (loop for layer-index from 0 to target-layer
              do (when extra-edge
                   (let ((placeholder (new-l-node graph)))
                     (set-type placeholder node-type.nonshifting-placeholder)
                     (if (> (1+ node-index) (length (get-nodes (aref sub-layers layer-index))))
                         (set-layer placeholder (aref sub-layers layer-index))
                         (set-layer placeholder (1+ node-index) (aref sub-layers layer-index))))))
        (when extra-edge
          (incf edge-count 1))
        (setf extra-edge t)))
    (if (> edge-count 0)
        (1- edge-count)
        0)))

(defun %alu-create-dummy-node (graph next-edge-to-split)
  (let ((dummy-node (new-l-node graph)))
    (set-type dummy-node node-type.long-edge)
    (set-property dummy-node layered-internal-properties.origin next-edge-to-split)
    (set-property dummy-node layered-options.port-constraints port-constraints.fixed-pos)
    dummy-node))

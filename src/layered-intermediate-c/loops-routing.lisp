;;;; loops-routing.lisp -- org.eclipse.elk.alg.layered.intermediate.loops.routing

(in-package #:elk)

;;; ------------------------------------------------------------ AbstractSelfLoopRouter

(defjgeneric route-self-loops 1)

;;; ------------------------------------------------------------ RoutingDirector

(defun %lic-compare-by-id (p1 p2)
  (integer.compare (.id (get-l-port p1)) (.id (get-l-port p2))))

(defconstant +lic-unconnected-port-penalty+ 1)
(defconstant +lic-connected-port-penalty+ 3)

(defjmethod determine-loop-routes ((this routing-director) sl-holder)
  ;; Start by giving IDs to all ports according to their order in the port list
  (let ((l-ports (get-ports (get-l-node sl-holder))))
    (loop for i from 0 below (length l-ports) do (setf (.id (aref l-ports i)) i)))
  (jdo (sl-loop (get-sl-hyper-loops sl-holder))
    (jl-sort (get-sl-ports sl-loop) #'%lic-compare-by-id))
  (jdo (sl-loop (get-sl-hyper-loops sl-holder))
    (enum-case (get-self-loop-type sl-loop)
      (self-loop-type.one-side
       (let ((side (get-side (get-l-port (aref (get-sl-ports sl-loop) 0)))))
         (%lic-assign-leftmost-rightmost-ports sl-loop side side)))
      (self-loop-type.two-sides-corner
       (let ((sides (port-restorer.sorted-two-side-loop-port-sides sl-loop)))
         (%lic-assign-leftmost-rightmost-ports sl-loop (aref sides 0) (aref sides 1))))
      (self-loop-type.two-sides-opposing (%lic-determine-two-side-opposing-loop-routes this sl-loop))
      (self-loop-type.three-sides (%lic-determine-three-side-loop-routes sl-loop))
      (self-loop-type.four-sides (%lic-determine-four-side-loop-routes this sl-loop)))
    (%lic-compute-occupied-port-sides sl-loop))
  (setf (.port-penalties this) nil))

(defun %lic-compute-occupied-port-sides (sl-loop)
  (let ((curr (get-side (get-l-port (get-leftmost-port sl-loop))))
        (target (get-side (get-l-port (get-rightmost-port sl-loop)))))
    (loop until (eq curr target)
          do (add (get-occupied-port-sides sl-loop) curr)
             (setf curr (right curr)))
    (add (get-occupied-port-sides sl-loop) curr)))

(defun %lic-determine-two-side-opposing-loop-routes (this sl-loop)
  (let* ((sides (port-restorer.sorted-two-side-loop-port-sides sl-loop))
         (sl-holder (get-sl-holder sl-loop))
         (o1l (%lic-lowest-port-on-side sl-loop (aref sides 0)))
         (o1r (%lic-highest-port-on-side sl-loop (aref sides 1)))
         (o1p (%lic-compute-edge-penalty this sl-holder o1l o1r))
         (o2l (%lic-lowest-port-on-side sl-loop (aref sides 1)))
         (o2r (%lic-highest-port-on-side sl-loop (aref sides 0)))
         (o2p (%lic-compute-edge-penalty this sl-holder o2l o2r)))
    (if (<= o1p o2p)
        (progn (set-leftmost-port sl-loop o1l) (set-rightmost-port sl-loop o1r))
        (progn (set-leftmost-port sl-loop o2l) (set-rightmost-port sl-loop o2r)))))

(defun %lic-determine-three-side-loop-routes (sl-loop)
  (let ((leftmost nil) (rightmost nil))
    (enum-case (%lic-compute-missing-port-side sl-loop)
      (port-side.north (setf leftmost port-side.east rightmost port-side.west))
      (port-side.east (setf leftmost port-side.south rightmost port-side.north))
      (port-side.south (setf leftmost port-side.west rightmost port-side.east))
      (port-side.west (setf leftmost port-side.north rightmost port-side.south)))
    (%lic-assign-leftmost-rightmost-ports sl-loop leftmost rightmost)))

(defun %lic-compute-missing-port-side (sl-loop)
  (let ((sides (%lic-sl-port-sides sl-loop)))
    (loop for side across (port-side.values)
          when (and (not (eq side port-side.undefined)) (not (contains sides side)))
            do (return side))))

(defun %lic-determine-four-side-loop-routes (this sl-loop)
  ;; The self loop ports are sorted by ID
  (let* ((sorted (get-sl-ports sl-loop))
         (sl-holder (get-sl-holder sl-loop))
         (worst-left (aref sorted (1- (length sorted))))
         (worst-right (aref sorted 0))
         (worst-penalty (%lic-compute-edge-penalty this sl-holder worst-left worst-right)))
    (loop for ri from 1 below (length sorted)
          do (let* ((cl (aref sorted (1- ri)))
                    (cr (aref sorted ri))
                    (cp (%lic-compute-edge-penalty this sl-holder cl cr)))
               (when (> cp worst-penalty)
                 (setf worst-left cl worst-right cr worst-penalty cp))))
    ;; Since we _don't_ want to draw the self loop between the left and right ports, we switch them here
    (set-leftmost-port sl-loop worst-right)
    (set-rightmost-port sl-loop worst-left)))

(defun %lic-assign-leftmost-rightmost-ports (sl-loop leftmost-side rightmost-side)
  (set-leftmost-port sl-loop (%lic-lowest-port-on-side sl-loop leftmost-side))
  (set-rightmost-port sl-loop (%lic-highest-port-on-side sl-loop rightmost-side)))

(defun %lic-lowest-port-on-side (sl-loop side)
  ;; Stream.min: first minimal element
  (let ((best nil))
    (jdo (p (get-sl-ports-by-side sl-loop side))
      (when (or (null best) (< (%lic-compare-by-id p best) 0)) (setf best p)))
    (or best (jthrow 'no-such-element-exception "No value present"))))

(defun %lic-highest-port-on-side (sl-loop side)
  ;; Stream.max: last maximal element
  (let ((best nil))
    (jdo (p (get-sl-ports-by-side sl-loop side))
      (when (or (null best) (>= (%lic-compare-by-id p best) 0)) (setf best p)))
    (or best (jthrow 'no-such-element-exception "No value present"))))

(defun %lic-compute-edge-penalty (this sl-holder leftmost-port rightmost-port)
  (when (null (.port-penalties this))
    (%lic-compute-penalties this sl-holder))
  (let* ((pen (.port-penalties this))
         (port-count (length (get-ports (get-l-node sl-holder))))
         (lid (.id (get-l-port leftmost-port)))
         (rid (.id (get-l-port rightmost-port)))
         (left-of-r (- rid 1)))
    (when (< left-of-r 0) (setf left-of-r (- port-count 1)))
    (if (<= lid left-of-r)
        (- (aref pen left-of-r) (aref pen lid))
        (+ (- (aref pen (- port-count 1)) (aref pen lid)) (aref pen left-of-r)))))

(defun %lic-compute-penalties (this sl-holder)
  (let* ((ports (get-ports (get-l-node sl-holder)))
         (pen (make-array (length ports) :initial-element 0))
         (sum 0))
    (loop for i from 0 below (length ports)
          do (let ((p (aref ports i)))
               (if (and (is-empty (get-incoming-edges p)) (is-empty (get-outgoing-edges p)))
                   (incf sum +lic-unconnected-port-penalty+)
                   (incf sum +lic-connected-port-penalty+))
               (setf (aref pen i) sum)))
    (setf (.port-penalties this) pen)))

;;; ------------------------------------------------------------ RoutingSlotAssigner

(defjmethod assign-routing-slots ((this routing-slot-assigner) sl-holder)
  (let ((label-crossing-matrix (%lic-compute-label-crossing-matrix sl-holder)))
    (%lic-create-crossing-graph this sl-holder label-crossing-matrix)
    (orthogonal-routing-generator.break-non-critical-cycles
     (.hyper-edge-segments this)
     (get-property (get-graph (get-l-node sl-holder)) layered-internal-properties.random))
    (%lic-do-assign-routing-slots this sl-holder label-crossing-matrix)
    (setf (.hyper-edge-segments this) nil
          (.sl-loop-to-segment-map this) nil
          (.sl-loop-activity-over-ports this) nil)))

(defun %lic-compute-label-crossing-matrix (sl-holder)
  (let ((label-id 0))
    (jdo (sl-loop (get-sl-hyper-loops sl-holder))
      (when (get-sl-labels sl-loop)
        (setf (.id (get-sl-labels sl-loop)) label-id)
        (incf label-id)))
    (let ((m (make-array (list label-id label-id) :initial-element nil))
          (sl-loops (get-sl-hyper-loops sl-holder)))
      (loop for i from 0 below (length sl-loops)
            do (let ((l1 (aref sl-loops i)))
                 (when (get-sl-labels l1)
                   (loop for j from (1+ i) below (length sl-loops)
                         do (let ((l2 (aref sl-loops j)))
                              (when (get-sl-labels l2)
                                (let ((overlap (%lic-labels-overlap l1 l2))
                                      (a (.id (get-sl-labels l1)))
                                      (b (.id (get-sl-labels l2))))
                                  (setf (aref m a b) overlap
                                        (aref m b a) overlap))))))))
      m)))

(defun %lic-labels-overlap (sl-loop1 sl-loop2)
  (let ((l1 (get-sl-labels sl-loop1))
        (l2 (get-sl-labels sl-loop2)))
    (cond ((or (null l1) (null l2)) nil)
          ((or (not (eq (get-side l1) (get-side l2)))
               (eq (get-side l1) port-side.east)
               (eq (get-side l1) port-side.west))
           nil)
          (t (let* ((start1 (.x (get-position l1)))
                    (end1 (+ start1 (.x (get-size l1))))
                    (start2 (.x (get-position l2)))
                    (end2 (+ start2 (.x (get-size l2)))))
               (and (<= start1 end2) (>= end1 start2)))))))

(defun %lic-labels-overlap-matrix (sl-loop1 sl-loop2 matrix)
  (if (or (null (get-sl-labels sl-loop1)) (null (get-sl-labels sl-loop2)))
      nil
      (aref matrix (.id (get-sl-labels sl-loop1)) (.id (get-sl-labels sl-loop2)))))

(defun %lic-create-crossing-graph (this sl-holder matrix)
  (let ((sl-loops (get-sl-hyper-loops sl-holder)))
    (setf (.hyper-edge-segments this) (new-jlist (length sl-loops))
          (.sl-loop-to-segment-map this) (new-jmap))
    (jdo (sl-loop sl-loops)
      (let ((segment (new-hyper-edge-segment nil)))
        (jl-add (.hyper-edge-segments this) segment)
        (jm-put (.sl-loop-to-segment-map this) sl-loop segment)))
    (setf (.sl-loop-activity-over-ports this) (new-jmap))
    (%lic-compute-loop-activity this sl-holder)
    (loop for i from 0 below (1- (length sl-loops))
          do (let ((l1 (aref sl-loops i)))
               (loop for j from (1+ i) below (length sl-loops)
                     do (%lic-create-dependencies this l1 (aref sl-loops j) matrix))))))

(defun %lic-compute-loop-activity (this sl-holder)
  (let ((l-ports (get-ports (get-l-node sl-holder))))
    (jdo (sl-loop (get-sl-hyper-loops sl-holder))
      (let ((activity (make-array (length l-ports) :initial-element nil)))
        (jm-put (.sl-loop-activity-over-ports this) sl-loop activity)
        (let ((idx (- (.id (get-l-port (get-leftmost-port sl-loop))) 1))
              (target (.id (get-l-port (get-rightmost-port sl-loop)))))
          (loop until (= idx target)
                do (setf idx (mod (+ idx 1) (length l-ports)))
                   (setf (aref activity idx) t)))))))

(defun %lic-create-dependencies (this l1 l2 matrix)
  (let ((first-above (%lic-count-crossings this l1 l2))
        (second-above (%lic-count-crossings this l2 l1))
        (s1 (jm-get (.sl-loop-to-segment-map this) l1))
        (s2 (jm-get (.sl-loop-to-segment-map this) l2)))
    (cond ((< first-above second-above)
           (hyper-edge-segment-dependency.create-and-add-regular s1 s2 (- second-above first-above)))
          ((< second-above first-above)
           (hyper-edge-segment-dependency.create-and-add-regular s2 s1 (- first-above second-above)))
          ((or (/= first-above 0) (%lic-labels-overlap-matrix l1 l2 matrix))
           (hyper-edge-segment-dependency.create-and-add-regular s1 s2 0)
           (hyper-edge-segment-dependency.create-and-add-regular s2 s1 0)))))

(defun %lic-count-crossings (this upper lower)
  (let ((activity (jm-get (.sl-loop-activity-over-ports this) lower))
        (crossings 0))
    (jdo (sl-port (get-sl-ports upper))
      (when (aref activity (.id (get-l-port sl-port))) (incf crossings)))
    crossings))

(defun %lic-do-assign-routing-slots (this sl-holder matrix)
  (%lic-assign-raw-routing-slots-to-segments this)
  (%lic-assign-raw-routing-slots-to-loops this sl-holder)
  (%lic-shift-towards-node this sl-holder matrix))

(defun %lic-assign-raw-routing-slots-to-segments (this)
  (let ((sinks (new-jlist)))
    (jdo (segment (.hyper-edge-segments this))
      (set-in-weight segment (jsize (get-incoming-segment-dependencies segment)))
      (set-out-weight segment (jsize (get-outgoing-segment-dependencies segment)))
      (when (= (get-out-weight segment) 0)
        (set-routing-slot segment 0)
        (jl-add sinks segment)))
    (loop until (jl-is-empty sinks)
          do (let* ((segment (jl-poll-first sinks))
                    (next-slot (+ (get-routing-slot segment) 1)))
               (jdo (dep (get-incoming-segment-dependencies segment))
                 (let ((src (get-source dep)))
                   (set-routing-slot src (max (get-routing-slot src) next-slot))
                   (set-out-weight src (- (get-out-weight src) 1))
                   (when (= (get-out-weight src) 0)
                     (jl-add sinks src))))))))

(defun %lic-assign-raw-routing-slots-to-loops (this sl-holder)
  (jdo (sl-loop (get-sl-hyper-loops sl-holder))
    (let ((slot (get-routing-slot (jm-get (.sl-loop-to-segment-map this) sl-loop))))
      (jdo (port-side (get-occupied-port-sides sl-loop))
        (set-routing-slot sl-loop port-side slot)))))

(defun %lic-shift-towards-node (this sl-holder matrix)
  (let ((next-free (make-array (length (get-ports (get-l-node sl-holder))) :initial-element 0)))
    (dolist (side (list port-side.north port-side.east port-side.south port-side.west))
      (%lic-shift-towards-node-on-side this sl-holder side next-free matrix))))

(defun %lic-shift-towards-node-on-side (this sl-holder side next-free matrix)
  (let ((sl-loops (remove-if-not (lambda (l) (contains (get-occupied-port-sides l) side))
                                 (to-jvector (get-sl-hyper-loops sl-holder))))
        (min-idx integer.max-value)
        (max-idx integer.min-value)
        (n-labels (array-dimension matrix 0)))
    (setf sl-loops (stable-sort sl-loops #'< :key (lambda (l) (get-routing-slot l side))))
    (jdo (l-port (get-ports (get-l-node sl-holder)))
      (when (eq (get-side l-port) side)
        (setf min-idx (min min-idx (.id l-port))
              max-idx (max max-idx (.id l-port)))))
    (if (= min-idx integer.max-value)
        ;; There are no ports on this side
        (loop for i from 0 below (length sl-loops)
              do (set-routing-slot (aref sl-loops i) side i))
        (let ((slot-assigned-to-label (make-array n-labels :initial-element -1)))
          (loop for sl-loop across sl-loops
                do (let ((active (jm-get (.sl-loop-activity-over-ports this) sl-loop))
                         (lowest 0))
                     (loop for px from min-idx to max-idx
                           do (when (aref active px)
                                (setf lowest (max lowest (aref next-free px)))))
                     (when (get-sl-labels sl-loop)
                       (let ((our (.id (get-sl-labels sl-loop)))
                             (conflicts (new-jset)))
                         (dotimes (other n-labels)
                           (when (aref matrix our other)
                             (js-add conflicts (aref slot-assigned-to-label other))))
                         (loop while (js-contains conflicts lowest) do (incf lowest))))
                     (set-routing-slot sl-loop side lowest)
                     (loop for px from min-idx to max-idx
                           do (when (aref active px)
                                (setf (aref next-free px) (+ lowest 1))))
                     (when (get-sl-labels sl-loop)
                       (setf (aref slot-assigned-to-label (.id (get-sl-labels sl-loop))) lowest))))))))

;;; ------------------------------------------------------------ LabelPlacer

(defjmethod place-labels ((this layered-label-placer) sl-holder label-manager monitor)
  (declare (ignore monitor))
  (%lic-assign-side-and-alignment sl-holder)
  (jdo (sl-loop (get-sl-hyper-loops sl-holder))
    (when (get-sl-labels sl-loop)
      (when label-manager
        (%lic-manage-labels sl-loop label-manager))
      (%lic-compute-coordinates sl-loop))))

(defun %lic-assign-side-and-alignment (sl-holder)
  (let* ((northern nil) (southern nil)
         (ordering (get-property (get-l-node sl-holder) layered-options.edge-routing-self-loop-ordering))
         (sequenced (eq ordering self-loop-ordering-strategy.sequenced)))
    (when sequenced
      (setf northern (new-jlist) southern (new-jlist)))
    (jdo (sl-loop (get-sl-hyper-loops sl-holder))
      (when (get-sl-labels sl-loop)
        (enum-case (get-self-loop-type sl-loop)
          (self-loop-type.one-side
           (let ((loop-side (first (enum-set-items (get-occupied-port-sides sl-loop)))))
             (cond ((and sequenced (eq loop-side port-side.north)) (jl-add northern sl-loop))
                   ((and sequenced (eq loop-side port-side.south)) (jl-add southern sl-loop))
                   (t (%lic-assign-one-sided-simple sl-loop loop-side)))))
          (self-loop-type.two-sides-corner (%lic-assign-two-sides-corner sl-loop))
          ((self-loop-type.two-sides-opposing self-loop-type.three-sides)
           (%lic-assign-two-sides-opposing-and-three-sides sl-loop))
          (self-loop-type.four-sides (%lic-assign-four-sides sl-loop)))))
    (when northern
      (unless (jl-is-empty northern)
        (%lic-assign-one-sided-sequenced northern port-side.north))
      (unless (jl-is-empty southern)
        (%lic-assign-one-sided-sequenced southern port-side.south)))))

(defun %lic-clear-inline (sl-loop)
  (jdo (label (get-l-labels (get-sl-labels sl-loop)))
    (set-property label layered-options.edge-labels-inline nil)))

(defun %lic-assign-one-sided-simple (sl-loop loop-side)
  (%lic-clear-inline sl-loop)
  (enum-case loop-side
    ((port-side.east port-side.west)
     (let ((topmost (get-leftmost-port sl-loop)))
       (when (< (.y (get-position (get-l-port (get-rightmost-port sl-loop))))
                (.y (get-position (get-l-port topmost))))
         (setf topmost (get-rightmost-port sl-loop)))
       (%lic-set-side-and-alignment sl-loop loop-side layered-alignment.top topmost)))
    ((port-side.north port-side.south)
     (%lic-set-side-and-alignment sl-loop loop-side layered-alignment.center nil))))

(defun %lic-assign-one-sided-sequenced (sl-loops port-side)
  (let ((id 0))
    (jdo (l-port (get-ports (get-l-node (get-sl-holder (aref sl-loops 0)))))
      (setf (.id l-port) id)
      (incf id)))
  (flet ((lid (l) (.id (get-l-port (get-leftmost-port l)))))
    (if (eq port-side port-side.north)
        (jl-sort sl-loops (lambda (a b) (integer.compare (lid a) (lid b))))
        (jl-sort sl-loops (lambda (a b) (integer.compare (lid b) (lid a))))))
  (let ((li 0) (ri (1- (length sl-loops))))
    (loop while (< li ri)
          do (let* ((left (aref sl-loops li))
                    (right (aref sl-loops ri))
                    (left-ref (if (eq port-side port-side.north) (get-rightmost-port left) (get-leftmost-port left)))
                    (right-ref (if (eq port-side port-side.north) (get-leftmost-port right) (get-rightmost-port right))))
               (%lic-set-side-and-alignment left port-side layered-alignment.right left-ref)
               (%lic-set-side-and-alignment right port-side layered-alignment.left right-ref)
               (incf li) (decf ri)))
    (when (= li ri)
      (%lic-set-side-and-alignment (aref sl-loops li) port-side layered-alignment.center nil))))

(defun %lic-assign-two-sides-corner (sl-loop)
  (let ((ls (get-side (get-l-port (get-leftmost-port sl-loop))))
        (rs (get-side (get-l-port (get-rightmost-port sl-loop)))))
    (%lic-clear-inline sl-loop)
    (cond ((eq ls port-side.north)
           (%lic-set-side-and-alignment sl-loop port-side.north layered-alignment.left (get-leftmost-port sl-loop)))
          ((eq rs port-side.north)
           (%lic-set-side-and-alignment sl-loop port-side.north layered-alignment.right (get-rightmost-port sl-loop)))
          ((eq ls port-side.south)
           (%lic-set-side-and-alignment sl-loop port-side.south layered-alignment.right (get-leftmost-port sl-loop)))
          ((eq rs port-side.south)
           (%lic-set-side-and-alignment sl-loop port-side.south layered-alignment.left (get-rightmost-port sl-loop))))))

(defun %lic-assign-two-sides-opposing-and-three-sides (sl-loop)
  (let ((occupied (get-occupied-port-sides sl-loop))
        (inline nil))
    (jdo (label (get-l-labels (get-sl-labels sl-loop)))
      (when (get-property label layered-options.edge-labels-inline)
        (setf inline t)
        (return)))
    (cond ((not (contains occupied port-side.north))
           (%lic-set-side-and-alignment sl-loop port-side.south layered-alignment.center nil))
          ((not (contains occupied port-side.south))
           (%lic-set-side-and-alignment sl-loop port-side.north layered-alignment.center nil))
          ((not (contains occupied port-side.west))
           (%lic-set-side-and-alignment sl-loop (if inline port-side.east port-side.north)
                                        (if inline layered-alignment.center layered-alignment.left)
                                        (if inline nil (get-leftmost-port sl-loop))))
          ((not (contains occupied port-side.east))
           (%lic-set-side-and-alignment sl-loop (if inline port-side.west port-side.north)
                                        (if inline layered-alignment.center layered-alignment.right)
                                        (if inline nil (get-rightmost-port sl-loop)))))))

(defun %lic-assign-four-sides (sl-loop)
  ;; (sic) ELK uses the leftmost port for both sides
  (let ((ls (get-side (get-l-port (get-leftmost-port sl-loop))))
        (rs (get-side (get-l-port (get-leftmost-port sl-loop)))))
    (%lic-clear-inline sl-loop)
    (if (or (eq ls port-side.north) (eq rs port-side.north))
        (%lic-set-side-and-alignment sl-loop port-side.south layered-alignment.center nil)
        (%lic-set-side-and-alignment sl-loop port-side.north layered-alignment.center nil))))

(defun %lic-set-side-and-alignment (sl-loop side alignment ref)
  (let ((l (get-sl-labels sl-loop)))
    (set-side l side)
    (set-alignment l alignment)
    (set-alignment-reference-sl-port l ref)))

(defun %lic-manage-labels (sl-loop label-manager)
  (let* ((sl-labels (get-sl-labels sl-loop))
         (align-ref (get-alignment-reference-sl-port sl-labels))
         (l-node (get-l-node (get-sl-holder sl-loop)))
         (node-size (get-size l-node))
         (margins (get-margin l-node))
         (target-width 0.0))
    (enum-case (get-alignment sl-labels)
      (layered-alignment.center
       (setf target-width (+ (.left margins) (.x node-size) (.right margins))))
      (layered-alignment.left
       (setf target-width (+ (- (.x node-size)
                                (.x (get-position (get-l-port align-ref)))
                                (.x (get-anchor (get-l-port align-ref))))
                             (.right margins))))
      (layered-alignment.right
       (setf target-width (+ (.left margins) (.x (get-position (get-l-port align-ref)))
                             (.x (get-anchor (get-l-port align-ref))))))
      (layered-alignment.top
       (setf target-width label-management-processor.min-width-edge-labels)))
    (apply-label-management sl-labels label-manager
                            (math.max target-width label-management-processor.min-width-edge-labels))))

(defun %lic-compute-coordinates (sl-loop)
  (let* ((sl-labels (get-sl-labels sl-loop))
         (align-ref (get-alignment-reference-sl-port sl-labels))
         (size (get-size sl-labels))
         (pos (get-position sl-labels)))
    (enum-case (get-alignment sl-labels)
      (layered-alignment.center
       (setf (.x pos) (/ (- (.x (get-size (get-l-node (get-sl-holder sl-loop)))) (.x size)) 2)))
      (layered-alignment.left
       (setf (.x pos) (+ (.x (get-position (get-l-port align-ref))) (.x (get-anchor (get-l-port align-ref))))))
      (layered-alignment.right
       (setf (.x pos) (- (+ (.x (get-position (get-l-port align-ref))) (.x (get-anchor (get-l-port align-ref))))
                         (.x size))))
      (layered-alignment.top
       (setf (.y pos) (+ (.y (get-position (get-l-port align-ref))) (.y (get-anchor (get-l-port align-ref)))))))))

;;; ------------------------------------------------------------ OrthogonalSelfLoopRouter

(defjmethod route-self-loops ((this orthogonal-self-loop-router) sl-holder)
  (let* ((l-node (get-l-node sl-holder))
         (node-size (get-size l-node))
         (node-margins (get-margin l-node))
         (edge-edge (l-graph-util.get-individual-or-inherited l-node layered-options.spacing-edge-edge))
         (edge-label (l-graph-util.get-individual-or-inherited l-node layered-options.spacing-edge-label))
         (node-sl (l-graph-util.get-individual-or-inherited l-node layered-options.spacing-node-self-loop))
         (new-margins (new-l-margin)))
    (j-set new-margins node-margins)
    (let ((positions (%lic-compute-routing-slot-positions sl-holder edge-edge edge-label node-sl)))
      (jdo (sl-loop (get-sl-hyper-loops sl-holder))
        (jdo (sl-edge (get-sl-edges sl-loop))
          (let* ((l-edge (get-l-edge sl-edge))
                 (direction (%lic-compute-edge-routing-direction sl-edge))
                 (bend-points (compute-orthogonal-bend-points this sl-edge direction positions)))
            (setf bend-points (modify-bend-points this sl-edge direction bend-points))
            (clear (get-bend-points l-edge))
            (add-all (get-bend-points l-edge) bend-points)
            (jdo (bp bend-points) (%lic-update-new-node-margins node-size new-margins bp))))
        (let ((sl-labels (get-sl-labels sl-loop)))
          (when sl-labels
            (%lic-router-place-labels sl-loop sl-labels positions edge-label)
            (%lic-update-new-node-margins-labels node-size new-margins sl-labels)))))
    (j-set node-margins new-margins)))

(defun %lic-compute-edge-routing-direction (sl-edge)
  (let* ((sp (get-l-port (get-sl-source sl-edge)))
         (ss (get-side sp))
         (tp (get-l-port (get-sl-target sl-edge)))
         (ts (get-side tp)))
    (cond ((eq ss ts)
           (if (< (.id sp) (.id tp)) edge-routing-direction.clockwise edge-routing-direction.counter-clockwise))
          ((eq (right ss) ts) edge-routing-direction.clockwise)
          ((eq (left ss) ts) edge-routing-direction.counter-clockwise)
          ((contains (get-occupied-port-sides (get-sl-hyper-loop sl-edge)) (right ss))
           edge-routing-direction.clockwise)
          (t edge-routing-direction.counter-clockwise))))

(defun %lic-router-place-labels (sl-loop sl-labels positions edge-label-distance)
  (let* ((label-side (get-side sl-labels))
         (label-position (aref (aref positions (ordinal label-side)) (get-routing-slot sl-loop label-side)))
         (inline nil))
    (jdo (label (get-l-labels sl-labels))
      (when (get-property label layered-options.edge-labels-inline)
        (setf inline t)
        (return)))
    (when inline (setf edge-label-distance 0))
    (enum-case label-side
      (port-side.north
       (decf label-position (+ edge-label-distance (.y (get-size sl-labels))))
       (setf (.y (get-position sl-labels)) label-position))
      (port-side.south
       (incf label-position edge-label-distance)
       (setf (.y (get-position sl-labels)) label-position))
      (port-side.west
       (decf label-position (+ edge-label-distance (.x (get-size sl-labels))))
       (setf (.x (get-position sl-labels)) label-position))
      (port-side.east
       (incf label-position edge-label-distance)
       (setf (.x (get-position sl-labels)) label-position)))))

(defun %lic-update-new-node-margins (node-size m bp)
  (setf (.left m) (math.max (.left m) (- (.x bp)))
        (.right m) (math.max (.right m) (- (.x bp) (.x node-size)))
        (.top m) (math.max (.top m) (- (.y bp)))
        (.bottom m) (math.max (.bottom m) (- (.y bp) (.y node-size)))))

(defun %lic-update-new-node-margins-labels (node-size m sl-labels)
  (let ((pos (new-k-vector (get-position sl-labels))))
    (%lic-update-new-node-margins node-size m pos)
    (add pos (get-size sl-labels))
    (%lic-update-new-node-margins node-size m pos)))

(defun %lic-compute-routing-slot-positions (sl-holder edge-edge edge-label node-sl)
  (let* ((n (length (port-side.values)))
         (positions (make-array n)))
    (loop for side across (port-side.values)
          do (setf (aref positions (ordinal side))
                   (make-array (aref (get-routing-slot-count sl-holder) (ordinal side)) :initial-element 0.0)))
    (%lic-initialize-with-max-label-height positions sl-holder port-side.north)
    (%lic-initialize-with-max-label-height positions sl-holder port-side.south)
    (dolist (side (list port-side.north port-side.east port-side.south port-side.west))
      (%lic-compute-positions positions sl-holder side edge-edge edge-label node-sl))
    positions))

(defun %lic-initialize-with-max-label-height (positions sl-holder port-side)
  (let ((side-positions (aref positions (ordinal port-side))))
    (jdo (sl-loop (get-sl-hyper-loops sl-holder))
      (let ((sl-labels (get-sl-labels sl-loop)))
        (when (and sl-labels (eq (get-side sl-labels) port-side))
          (let ((slot (get-routing-slot sl-loop port-side)))
            (setf (aref side-positions slot)
                  (math.max (aref side-positions slot) (.y (get-size sl-labels))))))))))

(defun %lic-compute-positions (positions sl-holder port-side edge-edge edge-label node-sl)
  (let ((curr (%lic-compute-baseline-position sl-holder port-side node-sl))
        (factor (if (or (eq port-side port-side.north) (eq port-side port-side.west)) -1 1))
        (side-positions (aref positions (ordinal port-side))))
    (loop for slot from 0 below (length side-positions)
          do (let ((largest (aref side-positions slot)))
               (when (> largest 0) (incf largest edge-label))
               (setf (aref side-positions slot) curr)
               (incf curr (* factor (+ largest edge-edge)))))))

(defun %lic-compute-baseline-position (sl-holder port-side node-sl)
  (let* ((l-node (get-l-node sl-holder))
         (m (get-margin l-node)))
    (enum-case port-side
      (port-side.north (- (- (.top m)) node-sl))
      (port-side.east (+ (.x (get-size l-node)) (.right m) node-sl))
      (port-side.south (+ (.y (get-size l-node)) (.bottom m) node-sl))
      (port-side.west (- (- (.left m)) node-sl))
      (t -1))))

(defjmethod compute-orthogonal-bend-points ((this orthogonal-self-loop-router) sl-edge routing-direction positions)
  (let ((bend-points (new-k-vector-chain)))
    (%lic-add-outer-bend-point sl-edge (get-sl-source sl-edge) positions bend-points)
    (%lic-add-corner-bend-points sl-edge routing-direction positions bend-points)
    (%lic-add-outer-bend-point sl-edge (get-sl-target sl-edge) positions bend-points)
    bend-points))

(defjmethod modify-bend-points ((this orthogonal-self-loop-router) sl-edge routing-direction bend-points)
  (declare (ignore sl-edge routing-direction))
  bend-points)

(defun %lic-add-outer-bend-point (sl-edge sl-port positions bend-points)
  (let* ((sl-loop (get-sl-hyper-loop sl-edge))
         (l-port (get-l-port sl-port))
         (port-side (get-side l-port))
         (result (%lic-get-base-vector port-side (get-routing-slot sl-loop port-side) positions))
         (anchor (add (clone (get-position l-port)) (get-anchor l-port))))
    (enum-case (get-side l-port)
      ((port-side.north port-side.south) (incf (.x result) (.x anchor)))
      ((port-side.east port-side.west) (incf (.y result) (.y anchor))))
    (add bend-points result)))

(defun %lic-add-corner-bend-points (sl-edge routing-direction positions bend-points)
  (let ((src (get-l-port (get-sl-source sl-edge)))
        (tgt (get-l-port (get-sl-target sl-edge))))
    (unless (eq (get-side src) (get-side tgt))
      (let* ((sl-loop (get-sl-hyper-loop sl-edge))
             (label-side nil) (l-size nil)
             (inline (is-inline sl-edge)))
        (when (and inline (get-sl-labels sl-loop))
          (setf label-side (get-label-side sl-edge)
                l-size (get-size (get-sl-labels sl-loop))))
        (let ((curr (get-side src)) (next nil))
          (loop until (eq curr (get-side tgt))
                do (setf next (if (eq routing-direction edge-routing-direction.clockwise) (right curr) (left curr)))
                   (let ((cc (%lic-get-base-vector curr (get-routing-slot sl-loop curr) positions))
                         (nc (%lic-get-base-vector next (get-routing-slot sl-loop next) positions)))
                     (when (and inline label-side l-size)
                       (cond ((eq curr label-side) (%lic-adjust-vector-for-label-side cc label-side l-size))
                             ((eq next label-side) (%lic-adjust-vector-for-label-side nc label-side l-size))))
                     (add bend-points (add cc nc)))
                   (setf curr next)))))))

(defun %lic-get-base-vector (port-side routing-slot positions)
  (let ((position (aref (aref positions (ordinal port-side)) routing-slot)))
    (enum-case port-side
      ((port-side.north port-side.south) (new-k-vector 0.0 position))
      ((port-side.east port-side.west) (new-k-vector position 0.0))
      (t nil))))

(defun %lic-adjust-vector-for-label-side (v label-side label-size)
  (enum-case label-side
    (port-side.north (decf (.y v) (/ (.y label-size) 2)))
    (port-side.south (incf (.y v) (/ (.y label-size) 2)))
    (port-side.west (decf (.x v) (/ (.x label-size) 2)))
    (port-side.east (incf (.x v) (/ (.x label-size) 2)))))

;;; ------------------------------------------------------------ PolylineSelfLoopRouter

(defjconst polyline-self-loop-router.corner-distance 10.0)
(defjconst polyline-self-loop-router.tolerance 0.01)

(defjmethod modify-bend-points ((this polyline-self-loop-router) sl-edge routing-direction bend-points)
  (declare (ignore routing-direction))
  (let ((src (get-l-port (get-sl-source sl-edge))))
    (add bend-points 0 (add (clone (get-position src)) (get-anchor src))))
  (let ((tgt (get-l-port (get-sl-target sl-edge))))
    (add bend-points (add (clone (get-position tgt)) (get-anchor tgt))))
  (cut-corners this bend-points polyline-self-loop-router.corner-distance))

(defjmethod cut-corners ((this polyline-self-loop-router) bend-points distance)
  (let ((result (new-k-vector-chain))
        (bps (to-jvector bend-points)))
    (when (>= (length bps) 2)
      (let ((corner (aref bps 0))
            (next (aref bps 1))
            (previous nil))
        (loop for i from 2 below (length bps)
              do (setf previous corner corner next next (aref bps i))
                 (let* ((offset1 (%lic-near-zero-to-zero (sub (clone previous) corner)))
                        (offset2 (%lic-near-zero-to-zero (sub (clone next) corner)))
                        (eff distance))
                   (setf eff (math.min eff (/ (abs (+ (.x offset1) (.y offset1))) 2)))
                   (setf eff (math.min eff (/ (abs (+ (.x offset2) (.y offset2))) 2)))
                   (setf (.x offset1) (* (math.signum (.x offset1)) eff)
                         (.y offset1) (* (math.signum (.y offset1)) eff)
                         (.x offset2) (* (math.signum (.x offset2)) eff)
                         (.y offset2) (* (math.signum (.y offset2)) eff))
                   (add result (add offset1 corner))
                   (add result (add offset2 corner))))))
    result))

(defun %lic-fuzzy-equals (a b tolerance)
  "Guava DoubleMath.fuzzyEquals"
  (or (<= (abs (- a b)) tolerance) (= a b) (and (nan-p a) (nan-p b))))

(defun %lic-are-orthogonally-routed (previous corner next)
  (let ((tol polyline-self-loop-router.tolerance))
    (or (and (%lic-fuzzy-equals (.x previous) (.x corner) tol) (%lic-fuzzy-equals (.y corner) (.y next) tol))
        (and (%lic-fuzzy-equals (.y previous) (.y corner) tol) (%lic-fuzzy-equals (.x corner) (.x next) tol)))))

(defun %lic-near-zero-to-zero (v)
  (let ((tol polyline-self-loop-router.tolerance))
    (when (and (>= (.x v) (- tol)) (<= (.x v) tol)) (setf (.x v) 0.0))
    (when (and (>= (.y v) (- tol)) (<= (.y v) tol)) (setf (.y v) 0.0))
    v))

;;; ------------------------------------------------------------ SplineSelfLoopRouter

(defjconst spline-self-loop-router.dim 3)
(defjconst spline-self-loop-router.half 0.5)

(defjmethod modify-bend-points ((this spline-self-loop-router) sl-edge routing-direction bend-points)
  (let* ((edge-label-distance (l-graph-util.get-individual-or-inherited
                               (get-l-node (get-sl-holder (get-sl-hyper-loop sl-edge)))
                               layered-options.spacing-edge-label))
         (spline-bps (new-k-vector-chain (jlist (%lic-relative-port-anchor (get-sl-source sl-edge))))))
    (%lic-add-spline-control-points sl-edge routing-direction bend-points spline-bps edge-label-distance)
    (add spline-bps (%lic-relative-port-anchor (get-sl-target sl-edge)))
    (get-bezier-cp (new-nub-spline t spline-self-loop-router.dim spline-bps))))

(defun %lic-relative-port-anchor (sl-port)
  (let ((l-port (get-l-port sl-port)))
    (add (new-k-vector (get-position l-port)) (get-anchor l-port))))

(defun %lic-add-spline-control-points (sl-edge routing-direction ortho new-bps edge-label-distance)
  (let* ((ortho-v (to-jvector ortho))
         (curr (get-side (get-l-port (get-sl-source sl-edge))))
         (first-bp (aref ortho-v 0)))
    (loop for i from 1 below (length ortho-v)
          do (let ((second-bp (aref ortho-v i)))
               (add new-bps first-bp)
               (let ((mid (scale (add (new-k-vector first-bp) second-bp) spline-self-loop-router.half))
                     (offset (scale (new-k-vector (splines-math.port-side-to-direction curr)) edge-label-distance)))
                 (add mid offset)
                 (add new-bps mid))
               (setf first-bp second-bp
                     curr (if (eq routing-direction edge-routing-direction.clockwise) (right curr) (left curr)))))
    (add new-bps (aref ortho-v (1- (length ortho-v))))))

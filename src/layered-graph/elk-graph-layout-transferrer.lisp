;;;; elk-graph-layout-transferrer.lisp -- org.eclipse.elk.alg.layered.graph.transform.ElkGraphLayoutTransferrer
;;;;
;;;; Java's private static helpers that share a name with a private instance
;;;; helper (applyNodeLayout, applyEdgeLayout, applyParentNodeLayout) are
;;;; qualified statics here: elk-graph-layout-transferrer.apply-node-layout/3
;;;; etc.  The instance versions keep the plain names, so the two arities
;;;; never share one call macro kind.

(in-package #:elk)

(defjconst elk-graph-layout-transferrer.zero-offset (new-k-vector))

(defjmethod apply-layout ((this elk-graph-layout-transferrer) lgraph)
  (let ((graph-origin (get-property lgraph layered-internal-properties.origin)))
    (when (typep graph-origin 'elk-node)
      (let* ((parent-elk-node graph-origin)
             (parent-lnode (get-parent-node lgraph))
             (offset (new-k-vector (get-offset lgraph)))
             (l-padding (get-padding lgraph)))
        (incf (.x offset) (.left l-padding))
        (incf (.y offset) (.top l-padding))
        (let ((size-options (get-property parent-elk-node layered-options.node-size-options)))
          (when (contains size-options size-options.compute-padding)
            (let ((padding (get-property parent-elk-node layered-options.padding)))
              (set-bottom padding (.bottom l-padding))
              (set-top padding (.top l-padding))
              (set-left padding (.left l-padding))
              (set-right padding (.right l-padding)))))
        (let ((edge-list (new-jlist)))
          (jdo (lnode (get-layerless-nodes lgraph))
            (cond ((elk-graph-layout-transferrer.represents-node lnode)
                   (apply-node-layout this lnode offset))
                  ((and (elk-graph-layout-transferrer.represents-external-port lnode) (null parent-lnode))
                   (let* ((elkport (get-property lnode layered-internal-properties.origin))
                          (port-position (l-graph-util.get-external-port-position
                                          lgraph lnode (get-width elkport) (get-height elkport))))
                     (set-location elkport (.x port-position) (.y port-position)))))
            (jdo (port (get-ports lnode))
              (jdo (edge (get-outgoing-edges port))
                (unless (l-graph-util.is-descendant (get-node (get-target edge)) lnode)
                  (jl-add edge-list edge)))))
          (when parent-lnode
            (jdo (port (get-ports parent-lnode))
              (jdo (edge (get-outgoing-edges port))
                (when (l-graph-util.is-descendant (get-node (get-target edge)) parent-lnode)
                  (jl-add edge-list edge)))))
          (let ((routing (get-property parent-elk-node layered-options.edge-routing)))
            (jdo (ledge edge-list)
              (apply-edge-layout this ledge routing offset l-padding)))
          (apply-parent-node-layout this lgraph)
          (jdo (lnode (get-layerless-nodes lgraph))
            (let ((nested-graph (get-nested-graph lnode)))
              (when nested-graph
                (apply-layout this nested-graph)))))))))

(defjmethod apply-node-layout ((this elk-graph-layout-transferrer) lnode offset)
  (let* ((elknode (get-property lnode layered-internal-properties.origin))
         (node-id (get-property lnode layered-options.crossing-minimization-position-id))
         (layer-id (get-property lnode layered-options.layering-layer-id)))
    (set-property elknode layered-options.crossing-minimization-position-id node-id)
    (set-property elknode layered-options.layering-layer-id layer-id)
    (set-x elknode (+ (.x (get-position lnode)) (.x offset)))
    (set-y elknode (+ (.y (get-position lnode)) (.y offset)))
    (when (or (not (is-empty (get-property elknode layered-options.node-size-constraints)))
              (get-nested-graph lnode)
              (and (eq (get-property (get-graph lnode) layered-options.node-placement-strategy)
                       node-placement-strategy.network-simplex)
                   (is-flexible-size-where-space-permits
                    (node-flexibility.get-node-flexibility lnode))))
      (set-width elknode (.x (get-size lnode)))
      (set-height elknode (.y (get-size lnode))))
    (jdo (lport (get-ports lnode))
      (let ((origin (get-property lport layered-internal-properties.origin)))
        (when (typep origin 'elk-port)
          (set-location origin (.x (get-position lport)) (.y (get-position lport)))
          (set-property origin layered-options.port-side (get-side lport)))))
    (let ((node-has-label-placement (not (is-empty (get-property lnode layered-options.node-labels-placement)))))
      (jdo (llabel (get-labels lnode))
        (when (or node-has-label-placement
                  (not (is-empty (get-property llabel layered-options.node-labels-placement))))
          (let ((elklabel (get-property llabel layered-internal-properties.origin)))
            (set-dimensions elklabel (.x (get-size llabel)) (.y (get-size llabel)))
            (set-location elklabel (.x (get-position llabel)) (.y (get-position llabel)))))))
    (unless (port-label-placement.is-fixed (get-property lnode layered-options.port-labels-placement))
      (jdo (lport (get-ports lnode))
        (jdo (llabel (get-labels lport))
          (let ((elklabel (get-property llabel layered-internal-properties.origin)))
            (set-width elklabel (.x (get-size llabel)))
            (set-height elklabel (.y (get-size llabel)))
            (set-location elklabel (.x (get-position llabel)) (.y (get-position llabel))))))))
  nil)

(defjmethod apply-edge-layout ((this elk-graph-layout-transferrer) ledge routing offset additional-padding)
  (declare (ignorable additional-padding))
  (let ((elkedge (get-property ledge layered-internal-properties.origin)))
    (when elkedge
      (let* ((bend-points (get-bend-points ledge))
             (edge-offset (new-k-vector offset))
             (source-point nil))
        (add edge-offset (calculate-hierarchical-offset this ledge))
        (if (l-graph-util.is-descendant (get-node (get-target ledge)) (get-node (get-source ledge)))
            (let ((source-port (get-source ledge)))
              (setf source-point (k-vector.sum (list (get-position source-port) (get-anchor source-port))))
              (sub source-point offset))
            (setf source-point (clone (get-absolute-anchor (get-source ledge)))))
        (add-first bend-points source-point)
        (let ((target-point (clone (get-absolute-anchor (get-target ledge)))))
          (when (get-property ledge layered-internal-properties.target-offset)
            (add target-point (get-property ledge layered-internal-properties.target-offset)))
          (add-last bend-points target-point))
        (offset bend-points edge-offset)
        (let ((elkedge-section (elk-graph-util.first-edge-section elkedge t t)))
          (set-incoming-shape elkedge-section (jl-get (get-sources elkedge) 0))
          (set-outgoing-shape elkedge-section (jl-get (get-targets elkedge) 0))
          (elk-util.apply-vector-chain bend-points elkedge-section))
        (jdo (llabel (get-labels ledge))
          (let ((elklabel (get-property llabel layered-internal-properties.origin)))
            (set-width elklabel (.x (get-size llabel)))
            (set-height elklabel (.y (get-size llabel)))
            (set-location elklabel
                          (+ (.x (get-position llabel)) (.x edge-offset))
                          (+ (.y (get-position llabel)) (.y edge-offset)))
            (set-property elklabel label-dummy-switcher.include-label
                          (get-property llabel label-dummy-switcher.include-label))))
        (let ((junction-points (get-property ledge layered-options.junction-points)))
          (if junction-points
              (progn
                (offset junction-points edge-offset)
                (set-property elkedge layered-options.junction-points junction-points))
              (set-property elkedge layered-options.junction-points nil)))
        (if (eq routing edge-routing.splines)
            (set-property elkedge layered-options.edge-routing edge-routing.splines)
            (set-property elkedge layered-options.edge-routing nil)))))
  nil)

(defjmethod calculate-hierarchical-offset ((this elk-graph-layout-transferrer) ledge)
  (let ((target-coordinate-system (get-property ledge layered-internal-properties.coordinate-system-origin)))
    (if target-coordinate-system
        (let ((result (new-k-vector))
              (current-graph (get-graph (get-node (get-source ledge)))))
          (loop until (eq current-graph target-coordinate-system)
                do (let ((representing-node (get-parent-node current-graph)))
                     (setf current-graph (get-graph representing-node))
                     (add result (get-position representing-node))
                     (add result (get-offset current-graph))
                     (add result (.left (get-padding current-graph)) (.top (get-padding current-graph)))))
          result)
        elk-graph-layout-transferrer.zero-offset)))

(defjmethod apply-parent-node-layout ((this elk-graph-layout-transferrer) lgraph)
  (elk-graph-layout-transferrer.apply-parent-node-layout
   lgraph (get-property lgraph layered-internal-properties.origin))
  nil)

;;; ------------------------------------------------------------ statics

(defjstatic elk-graph-layout-transferrer.apply-parent-node-layout (lgraph elknode)
  (let ((size-constraints-included-port-labels
          (contains (get-property elknode layered-options.node-size-constraints) size-constraint.port-labels)))
    (when (null (get-parent-node lgraph))
      (let ((graph-props (get-property lgraph layered-internal-properties.graph-properties))
            (actual-graph-size (get-actual-size lgraph)))
        (if (contains graph-props layered-graph-properties.external-ports)
            (progn
              (set-property elknode layered-options.port-constraints port-constraints.fixed-pos)
              (elk-util.resize-node elknode (.x actual-graph-size) (.y actual-graph-size) nil t))
            (unless (get-property elknode layered-options.node-size-fixed-graph-size)
              (elk-util.resize-node elknode (.x actual-graph-size) (.y actual-graph-size) t t)))))
    (if size-constraints-included-port-labels
        (set-property elknode layered-options.node-size-constraints (enum-set.of size-constraint.port-labels))
        (set-property elknode layered-options.node-size-constraints (size-constraint.fixed))))
  nil)

(defjstatic elk-graph-layout-transferrer.represents-node (lnode)
  (typep (get-property lnode layered-internal-properties.origin) 'elk-node))

(defjstatic elk-graph-layout-transferrer.represents-external-port (lnode)
  (typep (get-property lnode layered-internal-properties.origin) 'elk-port))

(defjstatic elk-graph-layout-transferrer.apply-layout-non-mutating (lgraph)
  (let ((parent-elk-node (elk-graph-util.create-graph)))
    (elk-graph-layout-transferrer.apply-layout-non-mutating lgraph parent-elk-node)))

(defjstatic elk-graph-layout-transferrer.apply-layout-non-mutating (lgraph parent-elk-node)
  (let* ((parent-lnode (get-parent-node lgraph))
         (offset (new-k-vector (clone (get-offset lgraph))))
         (l-padding (clone (get-padding lgraph))))
    (incf (.x offset) (.left l-padding))
    (incf (.y offset) (.top l-padding))
    (let ((size-options (get-property parent-elk-node layered-options.node-size-options)))
      (when (contains size-options size-options.compute-padding)
        (let ((padding (get-property parent-elk-node layered-options.padding)))
          (set-bottom padding (.bottom l-padding))
          (set-top padding (.top l-padding))
          (set-left padding (.left l-padding))
          (set-right padding (.right l-padding)))))
    (let ((edge-list (new-jlist)))
      (jdo (lnode (elk-graph-layout-transferrer.collect-nodes lgraph))
        (let ((elk-node nil))
          (when (elk-graph-layout-transferrer.represents-node lnode)
            (setf elk-node (elk-graph-util.create-node parent-elk-node))
            (elk-graph-layout-transferrer.apply-node-layout lnode elk-node offset))
          (jdo (port (get-ports lnode))
            (jdo (edge (get-outgoing-edges port))
              (unless (l-graph-util.is-descendant (get-node (get-target edge)) lnode)
                (jl-add edge-list edge))))
          (let ((nested-graph (get-nested-graph lnode)))
            (when nested-graph
              (elk-graph-layout-transferrer.apply-layout-non-mutating nested-graph elk-node)
              (jl-add (get-children parent-elk-node) elk-node)))))
      (when parent-lnode
        (jdo (port (get-ports parent-lnode))
          (jdo (edge (get-outgoing-edges port))
            (when (l-graph-util.is-descendant (get-node (get-target edge)) parent-lnode)
              (jl-add edge-list edge)))))
      (let ((routing (get-property parent-elk-node layered-options.edge-routing)))
        (jdo (ledge edge-list)
          (let ((elkedge (elk-graph-util.create-edge parent-elk-node)))
            (elk-graph-layout-transferrer.apply-edge-layout ledge elkedge routing offset l-padding))))
      (elk-graph-layout-transferrer.apply-parent-node-layout lgraph parent-elk-node)
      parent-elk-node)))

(defjstatic elk-graph-layout-transferrer.collect-nodes (lgraph)
  (let ((nodes (new-jlist)))
    (jdo (layer (get-layers lgraph))
      (jdo (lnode (get-nodes layer))
        (when (elk-graph-layout-transferrer.represents-node lnode)
          (jl-add nodes lnode))))
    (jdo (lnode (get-layerless-nodes lgraph))
      (when (elk-graph-layout-transferrer.represents-node lnode)
        (jl-add nodes lnode)))
    nodes))

(defjstatic elk-graph-layout-transferrer.apply-node-layout (lnode elknode offset)
  (let ((node-id (get-property lnode layered-options.crossing-minimization-position-id))
        (layer-id (get-property lnode layered-options.layering-layer-id)))
    (set-property elknode layered-options.crossing-minimization-position-id node-id)
    (set-property elknode layered-options.layering-layer-id layer-id)
    (set-x elknode (+ (.x (get-position lnode)) (.x offset)))
    (set-y elknode (+ (.y (get-position lnode)) (.y offset)))
    (when (or (not (is-empty (get-property elknode layered-options.node-size-constraints)))
              (get-nested-graph lnode)
              (and (eq (get-property (get-graph lnode) layered-options.node-placement-strategy)
                       node-placement-strategy.network-simplex)
                   (is-flexible-size-where-space-permits
                    (node-flexibility.get-node-flexibility lnode))))
      (set-width elknode (.x (get-size lnode)))
      (set-height elknode (.y (get-size lnode))))
    (jdo (lport (get-ports lnode))
      (let ((elkport (elk-graph-util.create-port elknode)))
        (set-location elkport (.x (get-position lport)) (.y (get-position lport)))
        (set-property elkport layered-options.port-side (get-side lport))
        (unless (port-label-placement.is-fixed (get-property lnode layered-options.port-labels-placement))
          (jdo (llabel (get-labels lport))
            (let ((elklabel (elk-graph-util.create-label elkport)))
              (set-width elklabel (.x (get-size llabel)))
              (set-height elklabel (.y (get-size llabel)))
              (set-location elklabel (.x (get-position llabel)) (.y (get-position llabel))))))))
    (let ((node-has-label-placement (not (is-empty (get-property lnode layered-options.node-labels-placement)))))
      (jdo (llabel (get-labels lnode))
        (when (or node-has-label-placement
                  (not (is-empty (get-property llabel layered-options.node-labels-placement))))
          (let ((elklabel (elk-graph-util.create-label elknode)))
            (set-dimensions elklabel (.x (get-size llabel)) (.y (get-size llabel)))
            (set-location elklabel (.x (get-position llabel)) (.y (get-position llabel))))))))
  nil)

(defjstatic elk-graph-layout-transferrer.apply-edge-layout (ledge elkedge routing offset additional-padding)
  (declare (ignorable additional-padding))
  (when elkedge
    (let* ((bend-points (clone (get-bend-points ledge)))
           (edge-offset (new-k-vector offset))
           (source-point nil))
      (setf edge-offset (k-vector.sum (list edge-offset
                                            (elk-graph-layout-transferrer.calculate-hierarchical-offset-non-mutating ledge))))
      (if (l-graph-util.is-descendant (get-node (get-target ledge)) (get-node (get-source ledge)))
          (let ((source-port (get-source ledge)))
            (setf source-point (k-vector.sum (list (get-position source-port) (get-anchor source-port))))
            (k-vector.diff source-point offset))
          (setf source-point (clone (get-absolute-anchor (get-source ledge)))))
      (add-first bend-points source-point)
      (let ((target-point (clone (get-absolute-anchor (get-target ledge)))))
        (when (get-property ledge layered-internal-properties.target-offset)
          (add target-point (get-property ledge layered-internal-properties.target-offset)))
        (add-last bend-points target-point))
      (setf bend-points (offset-non-mutating bend-points edge-offset))
      (let ((elkedge-section (elk-graph-util.first-edge-section elkedge t t)))
        (elk-util.apply-vector-chain bend-points elkedge-section))
      (jdo (llabel (get-labels ledge))
        (let ((elklabel (elk-graph-util.create-label elkedge)))
          (set-width elklabel (.x (get-size llabel)))
          (set-height elklabel (.y (get-size llabel)))
          (set-location elklabel
                        (+ (.x (get-position llabel)) (.x edge-offset))
                        (+ (.y (get-position llabel)) (.y edge-offset)))
          (set-property elklabel label-dummy-switcher.include-label
                        (get-property llabel label-dummy-switcher.include-label))))
      (let ((junction-points (clone (get-property ledge layered-options.junction-points))))
        (when junction-points
          (setf junction-points (offset-non-mutating junction-points edge-offset)))
        (if junction-points
            (set-property elkedge layered-options.junction-points junction-points)
            (set-property elkedge layered-options.junction-points nil)))
      (if (eq routing edge-routing.splines)
          (set-property elkedge layered-options.edge-routing edge-routing.splines)
          (set-property elkedge layered-options.edge-routing nil))))
  nil)

(defjstatic elk-graph-layout-transferrer.calculate-hierarchical-offset-non-mutating (ledge)
  (let ((target-coordinate-system (get-property ledge layered-internal-properties.coordinate-system-origin)))
    (if target-coordinate-system
        (let ((result (new-k-vector))
              (current-graph (get-graph (get-node (get-source ledge)))))
          (loop until (eq current-graph target-coordinate-system)
                do (let ((representing-node (get-parent-node current-graph)))
                     (setf current-graph (get-graph representing-node))
                     (setf result (k-vector.sum (list result
                                                      (get-position representing-node)
                                                      (get-offset current-graph)
                                                      (new-k-vector (.left (get-padding current-graph))
                                                                    (.top (get-padding current-graph))))))))
          result)
        elk-graph-layout-transferrer.zero-offset)))

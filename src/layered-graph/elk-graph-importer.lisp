;;;; elk-graph-importer.lisp -- org.eclipse.elk.alg.layered.graph.transform.ElkGraphImporter
;;;;
;;;; Java's class is package-private; its instance holds the ElkGraphElement ->
;;;; LGraphElement map (identity keys, so an EQ table).

(in-package #:elk)

(defjmethod import-graph ((this layered-elk-graph-importer) elkgraph)
  (let ((top-level-graph (create-l-graph this elkgraph)))
    (jdo (elkport (get-ports elkgraph))
      (ensure-defined-port-side this top-level-graph elkport))
    (let ((graph-properties (get-property top-level-graph layered-internal-properties.graph-properties)))
      (check-external-ports this elkgraph graph-properties)
      (when (contains graph-properties layered-graph-properties.external-ports)
        (jdo (elkport (get-ports elkgraph))
          (transform-external-port this elkgraph top-level-graph elkport)))
      (when (should-calculate-minimum-graph-size this elkgraph)
        (calculate-minimum-graph-size this elkgraph top-level-graph))
      (when (get-property top-level-graph layered-options.partitioning-activate)
        (add graph-properties layered-graph-properties.partitions))
      (when (has-property top-level-graph layered-options.spacing-base-value)
        (j-apply (layered-spacings.with-base-value
                  (get-property top-level-graph layered-options.spacing-base-value))
                 top-level-graph))
      (if (eq (get-property elkgraph layered-options.hierarchy-handling)
              hierarchy-handling.include-children)
          (import-hierarchical-graph this elkgraph top-level-graph)
          (import-flat-graph this elkgraph top-level-graph)))
    top-level-graph))

(defjmethod ensure-defined-port-side ((this layered-elk-graph-importer) lgraph elkport)
  (let* ((layout-direction (get-property lgraph layered-options.direction))
         (port-side (get-property elkport layered-options.port-side))
         (port-constraints (get-property lgraph layered-options.port-constraints)))
    (if (not (is-side-fixed port-constraints))
        (let ((net-flow (calculate-net-flow this elkport)))
          (if (> net-flow 0)
              (setf port-side (port-side.from-direction layout-direction))
              (setf port-side (opposed (port-side.from-direction layout-direction)))))
        (when (eq port-side port-side.undefined)
          (setf port-side (elk-util.calc-port-side elkport layout-direction))
          (when (eq port-side port-side.undefined)
            (setf port-side (port-side.from-direction layout-direction)))))
    (set-property elkport layered-options.port-side port-side)))

(defjmethod should-calculate-minimum-graph-size ((this layered-elk-graph-importer) elkgraph)
  (not (is-empty (get-property elkgraph layered-options.node-size-constraints))))

(defjmethod calculate-minimum-graph-size ((this layered-elk-graph-importer) elkgraph lgraph)
  (when (get-parent elkgraph)
    (let ((size-constraints (get-property lgraph layered-options.node-size-constraints)))
      (when (eq (get-property elkgraph layered-options.port-constraints) port-constraints.undefined)
        (set-property elkgraph layered-options.port-constraints port-constraints.free))
      (let* ((graph-adapter (elk-graph-adapters.adapt (get-parent elkgraph)))
             (node-adapter (elk-graph-adapters.adapt-single-node elkgraph))
             (min-size (node-label-and-size-calculator.process graph-adapter node-adapter nil t)))
        (add size-constraints size-constraint.minimum-size)
        (let ((configured-min-size (get-property lgraph layered-options.node-size-minimum)))
          (setf (.x configured-min-size) (math.max (.x min-size) (.x configured-min-size)))
          (setf (.y configured-min-size) (math.max (.y min-size) (.y configured-min-size))))))))

(defjmethod import-flat-graph ((this layered-elk-graph-importer) elkgraph lgraph)
  (let ((index 0)
        (cb-group-model-orders (new-jset)))
    (jdo (child (get-children elkgraph))
      (unless (get-property child layered-options.no-layout)
        (when (needs-model-order this child)
          (set-property child layered-internal-properties.model-order index)
          (incf index)
          (when (has-property child layered-options.consider-model-order-group-model-order-cycle-breaking-id)
            (js-add cb-group-model-orders
                    (get-property child layered-options.consider-model-order-group-model-order-cycle-breaking-id))))
        (transform-node this child lgraph)))
    (set-property lgraph layered-internal-properties.max-model-order-nodes index)
    (set-property lgraph layered-internal-properties.cb-num-model-order-groups (size cb-group-model-orders))
    (setf index 0)
    (jdo (elkedge (get-contained-edges elkgraph))
      (when (needs-model-order-based-on-parent this elkgraph)
        (set-property elkedge layered-internal-properties.model-order index)
        (incf index))
      (let* ((source (elk-graph-util.get-source-node elkedge))
             (target (elk-graph-util.get-target-node elkedge))
             (enable-inside-self-loops (get-property source layered-options.inside-self-loops-activate))
             (is-to-be-laid-out (not (get-property elkedge layered-options.no-layout)))
             (is-inside-self-loop (and enable-inside-self-loops
                                       (is-selfloop elkedge)
                                       (get-property elkedge layered-options.inside-self-loops-yo)))
             (connects-siblings (and (eq (get-parent source) elkgraph)
                                     (eq (get-parent source) (get-parent target))))
             (connects-to-graph (let ((x (and (eq (get-parent source) elkgraph) (eq target elkgraph)))
                                      (y (and (eq (get-parent target) elkgraph) (eq source elkgraph))))
                                  (if x (not y) y))))
        (when (and is-to-be-laid-out (not is-inside-self-loop)
                   (or connects-to-graph connects-siblings))
          (transform-edge this elkedge elkgraph lgraph))))
    (when (get-parent elkgraph)
      (jdo (elkedge (get-contained-edges (get-parent elkgraph)))
        (let ((source (elk-graph-util.get-source-node elkedge)))
          (when (and (eq source elkgraph) (is-selfloop elkedge))
            (let ((is-inside-self-loop (and (get-property source layered-options.inside-self-loops-activate)
                                            (get-property elkedge layered-options.inside-self-loops-yo))))
              (when is-inside-self-loop
                (transform-edge this elkedge elkgraph lgraph)))))))))

(defjmethod import-hierarchical-graph ((this layered-elk-graph-importer) elkgraph lgraph)
  (let ((elk-graph-queue (new-jlist))
        (parent-graph-direction (get-property lgraph layered-options.direction))
        (index 0)
        (cb-group-model-orders (new-jset)))
    (jl-add-all elk-graph-queue (get-children elkgraph))
    (loop until (is-empty elk-graph-queue)
          do (let ((elknode (jl-poll-first elk-graph-queue)))
               (when (needs-model-order this elknode)
                 (set-property elknode layered-internal-properties.model-order index)
                 (incf index)
                 (when (has-property elknode layered-options.consider-model-order-group-model-order-cycle-breaking-id)
                   (js-add cb-group-model-orders
                           (get-property elknode layered-options.consider-model-order-group-model-order-cycle-breaking-id))))
               (when (not (get-property elknode layered-options.no-layout))
                 (let* ((has-children (not (is-empty (get-children elknode))))
                        (has-inside-self-loops (has-inside-self-loops this elknode))
                        (has-hierarchy-handling-enabled
                          (eq (get-property elknode layered-options.hierarchy-handling)
                              hierarchy-handling.include-children))
                        (uses-elk-layered
                          (or (not (has-property elknode core-options.algorithm))
                              (%lg-ends-with layered-options.algorithm-id
                                             (get-property elknode core-options.algorithm))))
                        (nested-graph nil))
                   (when (and uses-elk-layered has-hierarchy-handling-enabled
                              (or has-children has-inside-self-loops))
                     (setf nested-graph (create-l-graph this elknode))
                     (set-property nested-graph layered-options.direction parent-graph-direction)
                     (when (has-property nested-graph layered-options.spacing-base-value)
                       (j-apply (layered-spacings.with-base-value
                                 (get-property nested-graph layered-options.spacing-base-value))
                                nested-graph))
                     (when (should-calculate-minimum-graph-size this elknode)
                       (let ((final-nested-graph nested-graph))
                         (jdo (elkport (get-ports elknode))
                           (ensure-defined-port-side this final-nested-graph elkport)))
                       (calculate-minimum-graph-size this elknode nested-graph)))
                   (let* ((parent-lgraph lgraph)
                          (parent-lnode (jm-get (.node-and-port-map this) (get-parent elknode))))
                     (when parent-lnode
                       (setf parent-lgraph (get-nested-graph parent-lnode)))
                     (let ((lnode (transform-node this elknode parent-lgraph)))
                       (when nested-graph
                         (set-nested-graph lnode nested-graph)
                         (set-parent-node nested-graph lnode)
                         (jl-add-all elk-graph-queue (get-children elknode)))))))))
    (set-property lgraph layered-internal-properties.max-model-order-nodes index)
    (set-property lgraph layered-internal-properties.cb-num-model-order-groups (size cb-group-model-orders))
    (setf index 0)
    (jl-add elk-graph-queue elkgraph)
    (loop until (is-empty elk-graph-queue)
          do (let ((elk-graph-node (jl-poll-first elk-graph-queue)))
               (jdo (elkedge (get-contained-edges elk-graph-node))
                 (block edge-body
                   (check-edge-validity this elkedge)
                   (when (needs-model-order-based-on-parent this elkgraph)
                     (set-property elkedge layered-internal-properties.model-order index)
                     (incf index))
                   (let* ((source-node (elk-graph-util.connectable-shape-to-node (jl-get (get-sources elkedge) 0)))
                          (target-node (elk-graph-util.connectable-shape-to-node (jl-get (get-targets elkedge) 0))))
                     (when (or (get-property elkedge layered-options.no-layout)
                               (get-property source-node layered-options.no-layout)
                               (get-property target-node layered-options.no-layout))
                       (return-from edge-body))
                     (let* ((is-inside-self-loop
                              (and (is-selfloop elkedge)
                                   (get-property source-node layered-options.inside-self-loops-activate)
                                   (get-property elkedge layered-options.inside-self-loops-yo)))
                            (parent-elk-graph elk-graph-node))
                       (cond ((or is-inside-self-loop (elk-graph-util.is-descendant target-node source-node))
                              (setf parent-elk-graph source-node))
                             ((elk-graph-util.is-descendant source-node target-node)
                              (setf parent-elk-graph target-node)))
                       (let* ((parent-lgraph lgraph)
                              (parent-lnode (jm-get (.node-and-port-map this) parent-elk-graph)))
                         (when parent-lnode
                           (setf parent-lgraph (get-nested-graph parent-lnode)))
                         (let ((ledge (transform-edge this elkedge parent-elk-graph parent-lgraph)))
                           (set-property ledge layered-internal-properties.coordinate-system-origin
                                         (find-coordinate-system-origin this elkedge elkgraph lgraph))))))))
               (when (eq (get-property elk-graph-node layered-options.hierarchy-handling)
                         hierarchy-handling.include-children)
                 (jdo (elk-child-graph-node (get-children elk-graph-node))
                   (let ((uses-elk-layered
                           (or (not (has-property elk-child-graph-node core-options.algorithm))
                               (%lg-ends-with layered-options.algorithm-id
                                              (get-property elk-child-graph-node core-options.algorithm))))
                         (part-of-same-layout-run
                           (eq (get-property elk-child-graph-node layered-options.hierarchy-handling)
                               hierarchy-handling.include-children)))
                     (when (and uses-elk-layered part-of-same-layout-run)
                       (jl-add elk-graph-queue elk-child-graph-node)))))))))

(defjmethod needs-model-order ((this layered-elk-graph-importer) child)
  (let ((elkgraph (get-parent child)))
    (and (needs-model-order-based-on-parent this elkgraph)
         (not (get-property child layered-options.consider-model-order-no-model-order)))))

(defjmethod needs-model-order-based-on-parent ((this layered-elk-graph-importer) elkgraph)
  (let* ((cycle-breaking (get-property elkgraph layered-options.cycle-breaking-strategy))
         (layering (get-property elkgraph layered-options.layering-strategy))
         (promotion (get-property elkgraph layered-options.layering-node-promotion-strategy))
         (model-order-cycle-breaking
           (or (eq cycle-breaking cycle-breaking-strategy.model-order)
               (eq cycle-breaking cycle-breaking-strategy.bfs-node-order)
               (eq cycle-breaking cycle-breaking-strategy.dfs-node-order)
               (eq cycle-breaking cycle-breaking-strategy.greedy-model-order)
               (eq cycle-breaking cycle-breaking-strategy.scc-connectivity)
               (eq cycle-breaking cycle-breaking-strategy.scc-node-type)))
         (model-order-layering
           (or (eq layering layering-strategy.bf-model-order)
               (eq layering layering-strategy.df-model-order)
               (eq promotion node-promotion-strategy.model-order-left-to-right)
               (eq promotion node-promotion-strategy.model-order-right-to-left)))
         (model-order-crossing-minimization
           (or (not (eq (get-property elkgraph layered-options.consider-model-order-strategy)
                        ordering-strategy.none))
               (get-property elkgraph layered-options.crossing-minimization-force-node-model-order)
               (not (eq (get-property elkgraph layered-options.consider-model-order-components)
                        component-ordering-strategy.none))
               (/= (get-property elkgraph layered-options.consider-model-order-crossing-counter-node-influence) 0)
               (/= (get-property elkgraph layered-options.consider-model-order-crossing-counter-port-influence) 0))))
    (and (or model-order-cycle-breaking model-order-layering model-order-crossing-minimization) t)))

(defjmethod has-inside-self-loops ((this layered-elk-graph-importer) elknode)
  (and (get-property elknode layered-options.inside-self-loops-activate)
       (%lg-any-p (elk-graph-util.all-outgoing-edges elknode)
                  (lambda (edge)
                    (and (is-selfloop edge)
                         (get-property edge layered-options.inside-self-loops-yo))))
       t))

(defjmethod find-coordinate-system-origin ((this layered-elk-graph-importer) elkedge top-level-elk-graph top-level-lgraph)
  (let ((source (elk-graph-util.connectable-shape-to-node (jl-get (get-sources elkedge) 0)))
        (target (elk-graph-util.connectable-shape-to-node (jl-get (get-targets elkedge) 0))))
    (cond ((eq (get-parent source) (get-parent target)) nil)
          ((elk-graph-util.is-descendant target source) nil)
          (t
           (let ((origin (get-containing-node elkedge)))
             (cond ((eq origin top-level-elk-graph) top-level-lgraph)
                   (t
                    (let ((lnode (jm-get (.node-and-port-map this) origin)))
                      (when lnode
                        (let ((lgraph (get-nested-graph lnode)))
                          (when lgraph lgraph)))))))))))

(defjmethod create-l-graph ((this layered-elk-graph-importer) elkgraph)
  (let ((lgraph (new-l-graph)))
    (copy-properties lgraph elkgraph)
    (when (eq (get-property lgraph layered-options.direction) core-direction.undefined)
      (set-property lgraph layered-options.direction (l-graph-util.get-direction lgraph)))
    (when (null (get-property lgraph label-management-options.label-manager))
      (let ((root (%lg-root-container elkgraph)))
        (set-property lgraph label-management-options.label-manager
                      (get-property root label-management-options.label-manager))))
    (set-property lgraph layered-internal-properties.origin elkgraph)
    (set-property lgraph layered-internal-properties.graph-properties (enum-set.none-of 'layered-graph-properties))
    (let* ((node-label-padding
             (node-label-and-size-calculator.compute-inside-node-label-padding
              (if (null (get-parent elkgraph)) nil (elk-graph-adapters.adapt (get-parent elkgraph)))
              (elk-graph-adapters.adapt-single-node elkgraph)
              core-direction.right))
           (node-padding (get-property lgraph layered-options.padding))
           (l-padding (get-padding lgraph)))
      (add l-padding node-padding)
      (add l-padding node-label-padding))
    lgraph))

(defjmethod check-external-ports ((this layered-elk-graph-importer) elkgraph graph-properties)
  (let ((enable-self-loops (get-property elkgraph layered-options.inside-self-loops-activate))
        (port-label-placement (get-property elkgraph layered-options.port-labels-placement))
        (has-external-ports nil)
        (has-hyperedges nil)
        (ports (get-ports elkgraph))
        (i 0))
    (loop while (and (< i (size ports)) (or (not has-external-ports) (not has-hyperedges)))
          do (let ((elkport (j-get ports i))
                   (external-port-edges 0))
               (incf i)
               (block edges
                 (jdo (elkedge (elk-graph-util.all-incident-edges elkport))
                   (let* ((is-inside-self-loop (and enable-self-loops
                                                    (is-selfloop elkedge)
                                                    (get-property elkedge layered-options.inside-self-loops-yo)))
                          (connects-to-child
                            (if (contains (get-sources elkedge) elkport)
                                (eq elkgraph (get-parent (elk-graph-util.connectable-shape-to-node
                                                          (jl-get (get-targets elkedge) 0))))
                                (eq elkgraph (get-parent (elk-graph-util.connectable-shape-to-node
                                                          (jl-get (get-sources elkedge) 0)))))))
                     (when (or is-inside-self-loop connects-to-child)
                       (incf external-port-edges)
                       (when (> external-port-edges 1)
                         (return-from edges))))))
               (cond ((> external-port-edges 0) (setf has-external-ports t))
                     ((and (contains port-label-placement port-label-placement.inside)
                           (> (size (get-labels elkport)) 0))
                      (setf has-external-ports t)))
               (when (> external-port-edges 1)
                 (setf has-hyperedges t))))
    (when has-external-ports
      (add graph-properties layered-graph-properties.external-ports))
    (when has-hyperedges
      (add graph-properties layered-graph-properties.hyperedges))
    nil))

(defjmethod transform-external-port ((this layered-elk-graph-importer) elkgraph lgraph elkport)
  (let* ((elkport-position (new-k-vector (+ (get-x elkport) (/ (get-width elkport) 2.0d0))
                                         (+ (get-y elkport) (/ (get-height elkport) 2.0d0))))
         (net-flow (calculate-net-flow this elkport))
         (port-constraints (get-property elkgraph layered-options.port-constraints))
         (port-side (get-property elkport layered-options.port-side)))
    (unless (jm-contains-key (get-all-properties elkport) layered-options.port-border-offset)
      (let ((port-offset (if (and (= (get-x elkport) 0.0d0) (= (get-y elkport) 0.0d0))
                             0.0d0
                             (elk-util.calc-port-offset elkport port-side))))
        (set-property elkport layered-options.port-border-offset port-offset)))
    (let* ((graph-size (new-k-vector (get-width elkgraph) (get-height elkgraph)))
           (dummy (l-graph-util.create-external-port-dummy
                   elkport port-constraints port-side net-flow graph-size
                   elkport-position (new-k-vector (get-width elkport) (get-height elkport))
                   (get-property lgraph layered-options.direction) lgraph))
           (dummy-port (jl-get (get-ports dummy) 0))
           (inside-port-labels (contains (get-property elkgraph layered-options.port-labels-placement)
                                         port-label-placement.inside)))
      (set-property dummy layered-internal-properties.origin elkport)
      (set-connected-to-external-nodes dummy-port (is-connected-to-external-nodes this elkport))
      (set-property dummy layered-options.port-labels-placement (port-label-placement.outside))
      (jdo (elklabel (get-labels elkport))
        (when (and (not (get-property elklabel layered-options.no-layout))
                   (not (%lg-null-or-empty-p (get-text elklabel))))
          (let ((llabel (transform-label this elklabel)))
            (jl-add (get-labels dummy-port) llabel)
            (unless inside-port-labels
              (let ((inside-part 0.0d0))
                (when (port-label-placement.is-fixed (get-property elkgraph layered-options.port-labels-placement))
                  (setf inside-part
                        (elk-util.compute-inside-part
                         (new-k-vector (get-x elklabel) (get-y elklabel))
                         (new-k-vector (get-width elklabel) (get-height elklabel))
                         (new-k-vector (get-width elkport) (get-height elkport))
                         0.0d0 port-side)))
                (enum-case port-side
                  ((port-side.east port-side.west) (setf (.x (get-size llabel)) inside-part))
                  ((port-side.north port-side.south) (setf (.y (get-size llabel)) inside-part))))))))
      (set-property dummy layered-options.spacing-label-port-horizontal
                    (get-property (get-parent elkgraph) layered-options.spacing-label-port-horizontal))
      (set-property dummy layered-options.spacing-label-port-vertical
                    (get-property (get-parent elkgraph) layered-options.spacing-label-port-vertical))
      (set-property dummy layered-options.spacing-label-label
                    (get-property (get-parent elkgraph) layered-options.spacing-label-label))
      (jl-add (get-layerless-nodes lgraph) dummy)
      (jm-put (.node-and-port-map this) elkport dummy)
      nil)))

(defjmethod calculate-net-flow ((this layered-elk-graph-importer) elkport)
  (let* ((elkgraph (get-parent elkport))
         (inside-self-loops-enabled (get-property elkgraph layered-options.inside-self-loops-activate))
         (output-port-vote 0)
         (input-port-vote 0))
    (jdo (outgoing-edge (get-outgoing-edges elkport))
      (let* ((is-self-loop (is-selfloop outgoing-edge))
             (is-inside-self-loop (and is-self-loop inside-self-loops-enabled
                                       (get-property outgoing-edge layered-options.inside-self-loops-yo)))
             (target-node (elk-graph-util.connectable-shape-to-node (jl-get (get-targets outgoing-edge) 0))))
        (cond ((and is-self-loop is-inside-self-loop) (incf input-port-vote))
              ((and is-self-loop (not is-inside-self-loop)) (incf output-port-vote))
              ((or (eq (get-parent target-node) elkgraph) (eq target-node elkgraph)) (incf input-port-vote))
              (t (incf output-port-vote)))))
    (jdo (incoming-edge (get-incoming-edges elkport))
      (let* ((is-self-loop (is-selfloop incoming-edge))
             (is-inside-self-loop (and is-self-loop inside-self-loops-enabled
                                       (get-property incoming-edge layered-options.inside-self-loops-yo)))
             (source-node (elk-graph-util.connectable-shape-to-node (jl-get (get-sources incoming-edge) 0))))
        (cond ((and is-self-loop is-inside-self-loop) (incf output-port-vote))
              ((and is-self-loop (not is-inside-self-loop)) (incf input-port-vote))
              ((or (eq (get-parent source-node) elkgraph) (eq source-node elkgraph)) (incf output-port-vote))
              (t (incf input-port-vote)))))
    (- output-port-vote input-port-vote)))

(defjmethod is-connected-to-external-nodes ((this layered-elk-graph-importer) elkport)
  (let ((parent (get-parent elkport)))
    (or (%lg-any-p (get-outgoing-edges elkport)
                   (lambda (edge)
                     (not (elk-graph-util.is-descendant
                           (elk-graph-util.connectable-shape-to-node (jl-get (get-targets edge) 0)) parent))))
        (%lg-any-p (get-incoming-edges elkport)
                   (lambda (edge)
                     (not (elk-graph-util.is-descendant
                           (elk-graph-util.connectable-shape-to-node (jl-get (get-sources edge) 0)) parent)))))))

(defjmethod transform-node ((this layered-elk-graph-importer) elknode lgraph)
  (let ((lnode (new-l-node lgraph)))
    (copy-properties lnode elknode)
    (set-property lnode layered-internal-properties.origin elknode)
    (setf (.x (get-size lnode)) (get-width elknode))
    (setf (.y (get-size lnode)) (get-height elknode))
    (setf (.x (get-position lnode)) (get-x elknode))
    (setf (.y (get-position lnode)) (get-y elknode))
    (jl-add (get-layerless-nodes lgraph) lnode)
    (jm-put (.node-and-port-map this) elknode lnode)
    (when (or (not (is-empty (get-children elknode)))
              (get-property elknode layered-options.inside-self-loops-activate))
      (set-property lnode layered-internal-properties.compound-node t))
    (let ((graph-properties (get-property lgraph layered-internal-properties.graph-properties))
          (port-constraints (get-property lnode layered-options.port-constraints))
          (port-model-order 0)
          (direction (get-property lgraph layered-options.direction)))
      (cond ((eq port-constraints port-constraints.undefined)
             (set-property lnode layered-options.port-constraints port-constraints.free))
            ((not (eq port-constraints port-constraints.free))
             (add graph-properties layered-graph-properties.non-free-ports)))
      (jdo (elkport (get-ports elknode))
        (when (needs-model-order this elknode)
          (set-property elkport layered-internal-properties.model-order port-model-order)
          (incf port-model-order))
        (unless (get-property elkport layered-options.no-layout)
          (transform-port this elkport lnode graph-properties direction port-constraints)))
      (jdo (elklabel (get-labels elknode))
        (when (and (not (get-property elklabel layered-options.no-layout))
                   (not (%lg-null-or-empty-p (get-text elklabel))))
          (jl-add (get-labels lnode) (transform-label this elklabel))))
      (when (get-property lnode layered-options.comment-box)
        (add graph-properties layered-graph-properties.comments))
      (when (get-property lnode layered-options.hypernode)
        (add graph-properties layered-graph-properties.hypernodes)
        (add graph-properties layered-graph-properties.hyperedges)
        (set-property lnode layered-options.port-constraints port-constraints.free)))
    lnode))

(defjmethod transform-port ((this layered-elk-graph-importer) elkport parent-lnode graph-properties
                            layout-direction port-constraints)
  (let ((lport (new-l-port)))
    (copy-properties lport elkport)
    (set-side lport (get-property elkport layered-options.port-side))
    (set-property lport layered-internal-properties.origin elkport)
    (set-node lport parent-lnode)
    (let ((port-size (get-size lport)))
      (setf (.x port-size) (get-width elkport))
      (setf (.y port-size) (get-height elkport)))
    (let ((port-pos (get-position lport)))
      (setf (.x port-pos) (get-x elkport))
      (setf (.y port-pos) (get-y elkport)))
    (jm-put (.node-and-port-map this) elkport lport)
    (let ((connections-to-descendants
            (%lg-any-p (get-outgoing-edges elkport)
                       (lambda (edge)
                         (%lg-any-p (get-targets edge)
                                    (lambda (shape)
                                      (elk-graph-util.is-descendant
                                       (elk-graph-util.connectable-shape-to-node shape)
                                       (get-parent elkport))))))))
      (unless connections-to-descendants
        (setf connections-to-descendants
              (%lg-any-p (get-incoming-edges elkport)
                         (lambda (edge)
                           (%lg-any-p (get-sources edge)
                                      (lambda (shape)
                                        (elk-graph-util.is-descendant
                                         (elk-graph-util.connectable-shape-to-node shape)
                                         (get-parent elkport))))))))
      (unless connections-to-descendants
        (setf connections-to-descendants
              (%lg-any-p (get-outgoing-edges elkport)
                         (lambda (edge)
                           (and (is-selfloop edge)
                                (get-property edge layered-options.inside-self-loops-yo))))))
      (set-property lport layered-internal-properties.inside-connections connections-to-descendants))
    (l-graph-util.initialize-port lport port-constraints layout-direction
                                  (get-property elkport layered-options.port-anchor))
    (jdo (elklabel (get-labels elkport))
      (when (and (not (get-property elklabel layered-options.no-layout))
                 (not (%lg-null-or-empty-p (get-text elklabel))))
        (jl-add (get-labels lport) (transform-label this elklabel))))
    (enum-case layout-direction
      ((core-direction.left core-direction.right)
       (when (or (eq (get-side lport) port-side.north) (eq (get-side lport) port-side.south))
         (add graph-properties layered-graph-properties.north-south-ports)))
      ((core-direction.up core-direction.down)
       (when (or (eq (get-side lport) port-side.east) (eq (get-side lport) port-side.west))
         (add graph-properties layered-graph-properties.north-south-ports))))
    lport))

(defjmethod transform-edge ((this layered-elk-graph-importer) elkedge elkparent lgraph)
  (check-edge-validity this elkedge)
  (let* ((elk-source-shape (jl-get (get-sources elkedge) 0))
         (elk-target-shape (jl-get (get-targets elkedge) 0))
         (elk-source-node (elk-graph-util.connectable-shape-to-node elk-source-shape))
         (elk-target-node (elk-graph-util.connectable-shape-to-node elk-target-shape))
         (edge-section (if (is-empty (get-sections elkedge)) nil (jl-get (get-sections elkedge) 0)))
         (source-lnode (jm-get (.node-and-port-map this) elk-source-node))
         (target-lnode (jm-get (.node-and-port-map this) elk-target-node))
         (source-lport nil)
         (target-lport nil))
    (when (typep elk-source-shape 'elk-port)
      (let ((source-elem (jm-get (.node-and-port-map this) elk-source-shape)))
        (cond ((typep source-elem 'l-port) (setf source-lport source-elem))
              ((typep source-elem 'l-node)
               (setf source-lnode source-elem)
               (setf source-lport (jl-get (get-ports source-lnode) 0))))))
    (when (typep elk-target-shape 'elk-port)
      (let ((target-elem (jm-get (.node-and-port-map this) elk-target-shape)))
        (cond ((typep target-elem 'l-port) (setf target-lport target-elem))
              ((typep target-elem 'l-node)
               (setf target-lnode target-elem)
               (setf target-lport (jl-get (get-ports target-lnode) 0))))))
    (when (or (null source-lnode) (null target-lnode))
      (jthrow 'unsupported-graph-exception
              "The source or the target of edge ~A could not be found. This usually happens when an edge connects a node laid out by ELK Layered to a node in another level of hierarchy laid out by either another instance of ELK Layered or another layout algorithm alltogether. The former can be solved by setting the hierarchyHandling option to INCLUDE_CHILDREN."
              elkedge))
    (let ((ledge (new-l-edge)))
      (copy-properties ledge elkedge)
      (set-property ledge layered-internal-properties.origin elkedge)
      (set-property ledge layered-options.junction-points nil)
      (let ((graph-properties (get-property lgraph layered-internal-properties.graph-properties)))
        (when (eq source-lnode target-lnode)
          (add graph-properties layered-graph-properties.self-loops))
        (when (null source-lport)
          (let ((port-type port-type.output)
                (source-point nil))
            (when (and edge-section
                       (is-side-fixed (get-property source-lnode layered-options.port-constraints)))
              (setf source-point (new-k-vector (get-start-x edge-section) (get-start-y edge-section)))
              (elk-util.to-absolute source-point (get-containing-node elkedge))
              (elk-util.to-relative source-point elkparent)
              (when (elk-graph-util.is-descendant elk-target-node elk-source-node)
                (setf port-type port-type.input)
                (add source-point (get-position source-lnode))))
            (setf source-lport (l-graph-util.create-port source-lnode source-point port-type lgraph))))
        (when (null target-lport)
          (let ((port-type port-type.input)
                (target-point nil))
            (when (and edge-section
                       (is-side-fixed (get-property target-lnode layered-options.port-constraints)))
              (setf target-point (new-k-vector (get-end-x edge-section) (get-end-y edge-section)))
              (elk-util.to-absolute target-point (get-containing-node elkedge))
              (elk-util.to-relative target-point elkparent))
            (setf target-lport (l-graph-util.create-port target-lnode target-point port-type
                                                         (get-graph target-lnode)))))
        (set-source ledge source-lport)
        (set-target ledge target-lport)
        (when (or (> (size (get-incoming-edges source-lport)) 1)
                  (> (size (get-outgoing-edges source-lport)) 1)
                  (> (size (get-incoming-edges target-lport)) 1)
                  (> (size (get-outgoing-edges target-lport)) 1))
          (add graph-properties layered-graph-properties.hyperedges))
        (jdo (elklabel (get-labels elkedge))
          (when (and (not (get-property elklabel layered-options.no-layout))
                     (not (%lg-null-or-empty-p (get-text elklabel))))
            (let ((llabel (transform-label this elklabel)))
              (jl-add (get-labels ledge) llabel)
              (enum-case (get-property llabel layered-options.edge-labels-placement)
                ((edge-label-placement.head edge-label-placement.tail)
                 (add graph-properties layered-graph-properties.end-labels))
                (edge-label-placement.center
                 (add graph-properties layered-graph-properties.center-labels)
                 (set-property llabel layered-options.edge-labels-placement edge-label-placement.center))))))
        (let ((cross-min-strat (get-property lgraph layered-options.crossing-minimization-strategy))
              (node-place-strat (get-property lgraph layered-options.node-placement-strategy)))
          (let ((bend-points-required
                  (or (eq cross-min-strat crossing-minimization-strategy.interactive)
                      (eq node-place-strat node-placement-strategy.interactive))))
            (when (and edge-section
                       (not (is-empty (get-bend-points edge-section)))
                       bend-points-required)
              (let ((original-bendpoints (elk-util.create-vector-chain edge-section))
                    (imported-bendpoints (new-k-vector-chain)))
                (jdo (point original-bendpoints)
                  (add imported-bendpoints (new-k-vector point)))
                (set-property ledge layered-internal-properties.original-bendpoints imported-bendpoints))))))
      ledge)))

(defjmethod check-edge-validity ((this layered-elk-graph-importer) edge)
  (cond ((is-empty (get-sources edge))
         (jthrow 'unsupported-graph-exception "Edges must have a source."))
        ((is-empty (get-targets edge))
         (jthrow 'unsupported-graph-exception "Edges must have a target."))
        ((is-hyperedge edge)
         (jthrow 'unsupported-graph-exception "Hyperedges are not supported.")))
  nil)

(defjmethod transform-label ((this layered-elk-graph-importer) elklabel)
  (let ((new-label (new-l-label (get-text elklabel))))
    (copy-properties new-label elklabel)
    (set-property new-label layered-internal-properties.origin elklabel)
    (setf (.x (get-size new-label)) (get-width elklabel))
    (setf (.y (get-size new-label)) (get-height elklabel))
    (setf (.x (get-position new-label)) (get-x elklabel))
    (setf (.y (get-position new-label)) (get-y elklabel))
    new-label))

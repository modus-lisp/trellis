;;;; common/utils.lisp -- org.eclipse.elk.alg.common.utils (see tools/classnames.tsv)

(in-package #:elk)

;;; ------------------------------------------------------------ SVGImage (no-op)

(defjctor svg-image (file)
  (setf (.file-name this) file))

;; One no-op method per arity, generated by a local macro (no global macro is defined).
(macrolet ((svg-noop-methods (name min max)
  "One no-op method per arity MIN..MAX (arguments excluding the receiver).
Variadic Java methods (addGroups, addPoly) need one method per count."
  `(progn
     ,@(loop for n from min to max
             collect `(defjmethod ,name ((this svg-image)
                                         ,@(loop for i below n
                                                 collect (intern (format nil "A~D" i) :elk)))
                        this)))))
(svg-noop-methods g 1 1)
(svg-noop-methods add-groups 0 8)
(svg-noop-methods clear-group 1 1)
(svg-noop-methods remove-group 1 1)
(svg-noop-methods set-view-box 4 4)
(svg-noop-methods clear 0 0)
(svg-noop-methods add-element-str 1 1)
(svg-noop-methods add-circle 2 2)
(svg-noop-methods add-circle 4 4)
(svg-noop-methods add-line 4 4)
(svg-noop-methods add-line 5 5)
(svg-noop-methods add-rect 5 5)
(svg-noop-methods add-rect 2 2)
(svg-noop-methods add-poly 1 9)
(svg-noop-methods add-text 4 4)
(svg-noop-methods isave 0 0))

;;; ------------------------------------------------------------ UniqueTriple

(defjctor unique-triple (f s th)
  (setf (.first-v this) f (.second-v this) s (.third-v this) th))

(defjmethod get-first ((this unique-triple)) (.first-v this))
(defjmethod get-second ((this unique-triple)) (.second-v this))
(defjmethod get-third ((this unique-triple)) (.third-v this))

(defjmethod to-string ((this unique-triple))
  (jstr "(" (.first-v this) ", " (.second-v this) ", " (.third-v this) ")"))

;;; ------------------------------------------------------------ Utils

(defjstatic utils.overlap (r1 r2)
  (let ((horizontal-overlap (math.min (math.abs (- (.x r1) (+ (.x r2) (.width r2))))
                                      (math.abs (- (+ (.x r1) (.width r1)) (.x r2)))))
        (vertical-overlap (math.min (math.abs (- (.y r1) (+ (.y r2) (.height r2))))
                                    (math.abs (- (+ (.y r1) (.height r1)) (.y r2)))))
        (horizontal-center-distance (math.abs (- (+ (.x r1) (/ (.width r1) 2.0d0))
                                                 (+ (.x r2) (/ (.width r2) 2.0d0))))))
    (block overlap
      (when (> horizontal-center-distance (+ (/ (.width r1) 2.0d0) (/ (.width r2) 2.0d0)))
        (return-from overlap 1.0d0))
      (let ((vertical-center-distance (math.abs (- (+ (.y r1) (/ (.height r1) 2.0d0))
                                                   (+ (.y r2) (/ (.height r2) 2.0d0))))))
        (when (> vertical-center-distance (+ (/ (.height r1) 2.0d0) (/ (.height r2) 2.0d0)))
          (return-from overlap 1.0d0))
        (when (and (= horizontal-center-distance 0d0) (= vertical-center-distance 0d0))
          (return-from overlap 0d0))
        (when (= horizontal-center-distance 0d0)
          (return-from overlap (+ (/ vertical-overlap vertical-center-distance) 1)))
        (when (= vertical-center-distance 0d0)
          (return-from overlap (+ (/ horizontal-overlap horizontal-center-distance) 1)))
        (+ (math.min (/ horizontal-overlap horizontal-center-distance)
                     (/ vertical-overlap vertical-center-distance))
           1)))))

(defjstatic utils.get-rect-edges (r)
  (jlist (new-t-edge/2 (get-top-left r) (get-top-right r))
         (new-t-edge/2 (get-top-left r) (get-bottom-left r))
         (new-t-edge/2 (get-bottom-right r) (get-top-right r))
         (new-t-edge/2 (get-bottom-right r) (get-bottom-left r))))

;;;; networksimplex.lisp -- org.eclipse.elk.alg.common.networksimplex methods
;;;; NGraph, NNode (+ NNodeBuilder), NEdge (+ NEdgeBuilder), NetworkSimplex.

(in-package #:elk)

;;; ------------------------------------------------------------ NGraph

(defjmethod write-debug-graph ((this n-graph) file-path)
  (declare (ignore file-path))
  nil)

(defjmethod make-connected ((this n-graph))
  (let ((id 0))
    (jdo (n (.nodes this))
      (setf (.internal-id n) id)
      (incf id)))
  (let ((cc-rep (%ns-find-con-comp-representatives this))
        (root nil))
    (when (> (length cc-rep) 1)
      (setf root (%ns-create-artificial-root-and-connect this cc-rep)))
    root))

(defun %ns-create-artificial-root-and-connect (graph nodes-to-connect)
  (let ((root (create (n-node.of) graph)))
    (jdo (src nodes-to-connect)
      (create (target (source (weight (delta (n-edge.of) 0) 0d0) root) src)))
    root))

(defun %ns-find-con-comp-representatives (graph)
  (let ((cc-rep (new-jlist))
        (mark (make-array (length (.nodes graph)) :initial-element nil)))
    (jdo (node (.nodes graph))
      (unless (aref mark (.internal-id node))
        (jl-add cc-rep node)
        (%ns-dfs node mark)))
    cc-rep))

(defun %ns-dfs (node mark)
  (unless (aref mark (.internal-id node))
    (setf (aref mark (.internal-id node)) t)
    (jdo (edge (get-connected-edges node))
      (%ns-dfs (get-other edge node) mark))))

(defjmethod is-acyclic ((this n-graph))
  (let ((nodes (.nodes this)) (id 0))
    (jdo (n nodes) (setf (.internal-id n) id) (incf id))
    (let ((incident (make-array (length nodes) :initial-element 0))
          (layer (make-array (length nodes) :initial-element 0))
          (roots (new-jlist)))
      (jdo (node nodes)
        (incf (aref incident (.internal-id node)) (length (.incoming-edges node))))
      (jdo (node nodes)
        (when (jl-is-empty (.incoming-edges node)) (jl-add roots node)))
      (when (and (jl-is-empty roots) (not (jl-is-empty nodes)))
        (return-from is-acyclic/0 nil))
      (loop until (jl-is-empty roots)
            do (let ((node (jl-poll-first roots)))
                 (jdo (edge (.outgoing-edges node))
                   (let ((target (.target edge)))
                     (setf (aref layer (.internal-id target))
                           (max (aref layer (.internal-id target))
                                (1+ (aref layer (.internal-id node)))))
                     (decf (aref incident (.internal-id target)))
                     (when (zerop (aref incident (.internal-id target)))
                       (jl-add roots target))))))
      (jdo (node nodes)
        (jdo (edge (.outgoing-edges node))
          (when (<= (aref layer (.internal-id (.target edge)))
                    (aref layer (.internal-id (.source edge))))
            (return-from is-acyclic/0 nil))))
      t)))

;;; ------------------------------------------------------------ NNode

(defjstatic n-node.of () (new-n-node-builder))

(defjmethod get-outgoing-edges ((this n-node)) (.outgoing-edges this))
(defjmethod get-incoming-edges ((this n-node)) (.incoming-edges this))

(defjmethod get-connected-edges ((this n-node))
  (let ((all (new-jlist (+ (length (.incoming-edges this)) (length (.outgoing-edges this))))))
    (jl-add-all all (.incoming-edges this))
    (jl-add-all all (.outgoing-edges this))
    all))

(defjmethod to-string ((this n-node)) (format nil "~A" (.origin this)))


(defjmethod id ((this n-node-builder) id) (setf (.id (.node this)) id) this)
(defjmethod origin ((this n-node-builder) origin) (setf (.origin (.node this)) origin) this)
(defjmethod j-type ((this n-node-builder) type) (setf (.type (.node this)) type) this)
(defjmethod create ((this n-node-builder) graph)
  (jl-add (.nodes graph) (.node this))
  (.node this))

;;; ------------------------------------------------------------ NEdge

(defjstatic n-edge.of () (new-n-edge-builder))
(defjstatic n-edge.of (origin) (declare (ignore origin)) (new-n-edge-builder))

(defjmethod get-source ((this n-edge)) (.source this))
(defjmethod get-target ((this n-edge)) (.target this))

(defjmethod get-other ((this n-edge) some)
  (cond ((eq some (.source this)) (.target this))
        ((eq some (.target this)) (.source this))
        (t (jthrow 'illegal-argument-exception "Node ~A not part of edge ~A" some this))))

(defjmethod j-reverse ((this n-edge))
  (rotatef (.source this) (.target this))
  (jl-remove (.outgoing-edges (.target this)) this)
  (jl-add (.incoming-edges (.target this)) this)
  (jl-remove (.incoming-edges (.source this)) this)
  (jl-add (.outgoing-edges (.source this)) this)
  this)

(defjmethod to-string ((this n-edge))
  (jstr "NEdge[id=" (.id this) " w=" (.weight this) " d=" (.delta this) "]"))

(defmethod print-object ((e n-edge) s)
  (print-unreadable-object (e s) (format s "NEdge id=~A w=~A d=~A" (.id e) (.weight e) (.delta e))))
(defmethod print-object ((n n-node) s)
  (print-unreadable-object (n s) (format s "NNode id=~A layer=~A" (.id n) (.layer n))))


(defjmethod id ((this n-edge-builder) id) (setf (.id (.edge this)) id) this)
(defjmethod origin ((this n-edge-builder) origin) (setf (.origin (.edge this)) origin) this)
(defjmethod weight ((this n-edge-builder) weight) (setf (.weight (.edge this)) (jd weight)) this)
(defjmethod delta ((this n-edge-builder) delta) (setf (.delta (.edge this)) delta) this)
(defjmethod source ((this n-edge-builder) source) (setf (.source (.edge this)) source) this)
(defjmethod target ((this n-edge-builder) target) (setf (.target (.edge this)) target) this)
(defjmethod create ((this n-edge-builder))
  (let ((edge (.edge this)))
    (when (or (null (.source edge)) (null (.target edge)))
      (jthrow 'illegal-state-exception "NEdge must have a source and target NNode specified."))
    (when (eq (.source edge) (.target edge))
      (jthrow 'illegal-state-exception "Network simplex does not support self-loops: ~A ~A ~A"
              edge (.source edge) (.target edge)))
    (jl-add (.outgoing-edges (.source edge)) edge)
    (jl-add (.incoming-edges (.target edge)) edge)
    edge))

;;; ------------------------------------------------------------ NetworkSimplex

(defjstatic network-simplex.for-graph (graph)
  (let ((ns (make-instance 'network-simplex)))
    (setf (.graph ns) graph)
    ns))

(defjmethod with-balancing ((this network-simplex) do-balance)
  (setf (.balance this) do-balance) this)
(defjmethod with-previous-layering ((this network-simplex) consider)
  (setf (.previous-layering-node-counts this) consider) this)
(defjmethod with-iteration-limit ((this network-simplex) limit)
  (setf (.iteration-limit this) limit) this)

(defun %ns-initialize (ns)
  (let* ((graph (.graph ns))
         (num-nodes (length (.nodes graph))))
    (jdo (n (.nodes graph)) (setf (.tree-node n) nil))
    (setf (.po-id ns) (make-array num-nodes :initial-element 0)
          (.lowest-po-id ns) (make-array num-nodes :initial-element 0)
          (.sources ns) (new-jlist))
    (let ((index 0) (the-edges (new-jlist)))
      (jdo (node (.nodes graph))
        (setf (.internal-id node) index) (incf index)
        (when (zerop (length (.incoming-edges node)))
          (jl-add (.sources ns) node))
        (jl-add-all the-edges (.outgoing-edges node)))
      (let ((counter 0))
        (jdo (edge the-edges)
          (setf (.internal-id edge) counter (.tree-edge edge) nil)
          (incf counter)))
      (let ((num-edges (length the-edges)))
        (if (or (null (.cutvalue ns)) (< (length (.cutvalue ns)) num-edges))
            (setf (.cutvalue ns) (make-array num-edges :initial-element 0d0)
                  (.edge-visited ns) (make-array num-edges :initial-element nil))
            (fill (.edge-visited ns) nil)))
      (setf (.edges ns) the-edges
            (.tree-edges ns) (new-jlist)
            (.post-order ns) 1))))

(defun %ns-dispose (ns)
  (setf (.cutvalue ns) nil (.edges ns) nil (.tree-edges ns) nil (.edge-visited ns) nil
        (.lowest-po-id ns) nil (.po-id ns) nil (.sources ns) nil (.subtree-nodes-stack ns) nil))

(defjmethod execute ((this network-simplex))
  (execute this (new-basic-progress-monitor)))

(defjmethod execute ((this network-simplex) monitor)
  (begin monitor "Network simplex" 1)
  (let ((graph (.graph this)))
    (when (< (length (.nodes graph)) 1)
      (done monitor)
      (return-from execute/1 nil))
    (jdo (node (.nodes graph)) (setf (.layer node) 0))
    (let ((remove-subtrees (>= (length (.nodes graph)) network-simplex.remove-subtrees-thresh)))
      (when remove-subtrees (%ns-remove-subtrees this))
      (%ns-initialize this)
      (%ns-feasible-tree this)
      (let ((e (%ns-leave-edge this)) (iter 0))
        (loop while (and e (< iter (.iteration-limit this)))
              do (%ns-exchange this e (%ns-enter-edge this e))
                 (setf e (%ns-leave-edge this))
                 (incf iter)))
      (when remove-subtrees (%ns-reattach-subtrees this))
      (if (.balance this)
          (%ns-balance this (%ns-normalize this))
          (%ns-normalize this))
      (%ns-dispose this)
      (done monitor)
      nil)))

(defun %ns-remove-subtrees (ns)
  (let ((graph (.graph ns))
        (stack (new-jlist))
        (leafs (new-jlist)))
    (setf (.subtree-nodes-stack ns) stack)
    (jdo (node (.nodes graph))
      (when (= (length (get-connected-edges node)) 1) (jl-add leafs node)))
    (loop until (jl-is-empty leafs)
          do (let ((node (jl-poll-first leafs)))
               (unless (zerop (length (get-connected-edges node)))
                 (let* ((edge (aref (get-connected-edges node) 0))
                        (is-out-edge (> (length (.outgoing-edges node)) 0))
                        (other (get-other edge node)))
                   (if is-out-edge
                       (jl-remove (.incoming-edges other) edge)
                       (jl-remove (.outgoing-edges other) edge))
                   (when (= (length (get-connected-edges other)) 1)
                     (jl-add leafs other))
                   ;; ArrayDeque.push = addFirst
                   (jl-add-first stack (cons node edge))
                   (jl-remove (.nodes graph) node)))))))

(defun %ns-reattach-subtrees (ns)
  (let ((stack (.subtree-nodes-stack ns))
        (graph (.graph ns)))
    (loop until (jl-is-empty stack)
          do (destructuring-bind (node . edge) (jl-remove-first stack)
               (let ((placed (get-other edge node)))
                 (if (eq (.target edge) node)
                     (progn (jl-add (.outgoing-edges placed) edge)
                            (setf (.layer node) (+ (.layer placed) (.delta edge))))
                     (progn (jl-add (.incoming-edges placed) edge)
                            (setf (.layer node) (- (.layer placed) (.delta edge)))))
                 (jl-add (.nodes graph) node))))))

(defun %ns-feasible-tree (ns)
  (let ((graph (.graph ns)))
    (%ns-layering-topological-numbering ns (.sources ns))
    (when (> (length (.edges ns)) 0)
      (fill (.edge-visited ns) nil)
      (loop while (< (%ns-tight-tree-dfs ns (aref (.nodes graph) 0)) (length (.nodes graph)))
            do (let* ((e (%ns-minimal-slack ns))
                      (slack (- (.layer (.target e)) (.layer (.source e)) (.delta e))))
                 (when (.tree-node (.target e)) (setf slack (- slack)))
                 (jdo (node (.nodes graph))
                   (when (.tree-node node) (incf (.layer node) slack)))
                 (fill (.edge-visited ns) nil)))
      (fill (.edge-visited ns) nil)
      (%ns-postorder-traversal ns (aref (.nodes graph) 0))
      (%ns-cutvalues ns))))

(defun %ns-layering-topological-numbering (ns initial-root-nodes)
  (let* ((graph (.graph ns))
         (incident (make-array (length (.nodes graph)) :initial-element 0))
         (roots (let ((l (new-jlist))) (jl-add-all l initial-root-nodes) l)))
    (jdo (node (.nodes graph))
      (incf (aref incident (.internal-id node)) (length (.incoming-edges node))))
    (loop until (jl-is-empty roots)
          do (let ((node (jl-poll-first roots)))
               (jdo (edge (.outgoing-edges node))
                 (let ((target (.target edge)))
                   (setf (.layer target) (max (.layer target) (+ (.layer node) (.delta edge))))
                   (decf (aref incident (.internal-id target)))
                   (when (zerop (aref incident (.internal-id target)))
                     (jl-add roots target))))))))

(defun %ns-minimal-span (node)
  "Returns (values min-span-in min-span-out)."
  (let ((min-span-out integer.max-value)
        (min-span-in integer.max-value))
    (jdo (edge (get-connected-edges node))
      (let ((current-span (- (.layer (.target edge)) (.layer (.source edge)))))
        (cond ((and (eq (.target edge) node) (< current-span min-span-in))
               (setf min-span-in current-span))
              ((< current-span min-span-out)
               (setf min-span-out current-span)))))
    (when (= min-span-in integer.max-value) (setf min-span-in -1))
    (when (= min-span-out integer.max-value) (setf min-span-out -1))
    (values min-span-in min-span-out)))

(defun %ns-tight-tree-dfs (ns node)
  (let ((node-count 1)
        (visited (.edge-visited ns)))
    (setf (.tree-node node) t)
    (jdo (edge (get-connected-edges node))
      (unless (aref visited (.internal-id edge))
        (setf (aref visited (.internal-id edge)) t)
        (let ((opposite (get-other edge node)))
          (cond ((.tree-edge edge)
                 (incf node-count (%ns-tight-tree-dfs ns opposite)))
                ((and (not (.tree-node opposite))
                      (= (.delta edge) (- (.layer (.target edge)) (.layer (.source edge)))))
                 (setf (.tree-edge edge) t)
                 (%ns-tree-edges-add ns edge)
                 (incf node-count (%ns-tight-tree-dfs ns opposite)))))))
    node-count))

(defun %ns-tree-edges-add (ns edge)
  (let ((te (.tree-edges ns)))
    ;; never already present: callers only add edges whose tree-edge flag was off
    (jl-add te edge)))

(defun %ns-tree-edges-remove (ns edge)
  (let* ((te (.tree-edges ns)) (i (position edge te :test #'eq)))
    (when i (jl-remove-at te i))))

(defun %ns-minimal-slack (ns)
  (let ((min-slack integer.max-value) (min-slack-edge nil))
    (jdo (edge (.edges ns))
      (unless (eq (not (.tree-node (.source edge))) (not (.tree-node (.target edge))))
        (let ((cur-slack (- (.layer (.target edge)) (.layer (.source edge)) (.delta edge))))
          (when (< cur-slack min-slack)
            (setf min-slack cur-slack min-slack-edge edge)))))
    min-slack-edge))

(defun %ns-postorder-traversal (ns node)
  (let ((lowest integer.max-value)
        (visited (.edge-visited ns)))
    (jdo (edge (get-connected-edges node))
      (when (and (.tree-edge edge) (not (aref visited (.internal-id edge))))
        (setf (aref visited (.internal-id edge)) t)
        (setf lowest (min lowest (%ns-postorder-traversal ns (get-other edge node))))))
    (setf (aref (.po-id ns) (.internal-id node)) (.post-order ns))
    (setf (aref (.lowest-po-id ns) (.internal-id node)) (min lowest (.post-order ns)))
    (incf (.post-order ns))
    (aref (.lowest-po-id ns) (.internal-id node))))

(defun %ns-is-in-head (ns node edge)
  (let* ((po (.po-id ns)) (low (.lowest-po-id ns))
         (s (.internal-id (.source edge))) (tg (.internal-id (.target edge)))
         (n (.internal-id node)))
    (if (and (<= (aref low s) (aref po n)) (<= (aref po n) (aref po s))
             (<= (aref low tg) (aref po n)) (<= (aref po n) (aref po tg)))
        (not (< (aref po s) (aref po tg)))
        (< (aref po s) (aref po tg)))))

(defun %ns-cutvalues (ns)
  (let ((leafs (new-jlist))
        (cutvalue (.cutvalue ns)))
    (jdo (node (.nodes (.graph ns)))
      (let ((tree-edge-count 0))
        (jl-clear (.unknown-cutvalues node))
        (jdo (edge (get-connected-edges node))
          (when (.tree-edge edge)
            (jl-add (.unknown-cutvalues node) edge)
            (incf tree-edge-count)))
        (when (= tree-edge-count 1) (jl-add leafs node))))
    (jdo (node leafs)
      (loop while (= (length (.unknown-cutvalues node)) 1)
            do (let* ((to-determine (aref (.unknown-cutvalues node) 0))
                      (ti (.internal-id to-determine))
                      (source (.source to-determine))
                      (target (.target to-determine)))
                 (setf (aref cutvalue ti) (.weight to-determine))
                 (jdo (edge (get-connected-edges node))
                   (unless (eq edge to-determine)
                     (if (.tree-edge edge)
                         (if (or (eq source (.source edge)) (eq target (.target edge)))
                             (decf (aref cutvalue ti) (- (aref cutvalue (.internal-id edge)) (.weight edge)))
                             (incf (aref cutvalue ti) (- (aref cutvalue (.internal-id edge)) (.weight edge))))
                         (if (eq node source)
                             (if (eq (.source edge) node)
                                 (incf (aref cutvalue ti) (.weight edge))
                                 (decf (aref cutvalue ti) (.weight edge)))
                             (if (eq (.source edge) node)
                                 (decf (aref cutvalue ti) (.weight edge))
                                 (incf (aref cutvalue ti) (.weight edge)))))))
                 (jl-remove (.unknown-cutvalues source) to-determine)
                 (jl-remove (.unknown-cutvalues target) to-determine)
                 (setf node (if (eq source node) (.target to-determine) (.source to-determine))))))))

(defun %ns-leave-edge (ns)
  (jdo (edge (.tree-edges ns))
    (when (and (.tree-edge edge)
               (< (aref (.cutvalue ns) (.internal-id edge)) network-simplex.fuzzy-st-zero))
      (return-from %ns-leave-edge edge)))
  nil)

(defun %ns-enter-edge (ns leave)
  (unless (.tree-edge leave)
    (jthrow 'illegal-argument-exception "The input edge is not a tree edge."))
  (let ((replace nil) (rep-slack integer.max-value))
    (jdo (edge (.edges ns))
      (let ((source (.source edge)) (target (.target edge)))
        (when (and (%ns-is-in-head ns source leave) (not (%ns-is-in-head ns target leave)))
          (let ((slack (- (.layer target) (.layer source) (.delta edge))))
            (when (< slack rep-slack)
              (setf rep-slack slack replace edge))))))
    replace))

(defun %ns-exchange (ns leave enter)
  (unless (.tree-edge leave)
    (jthrow 'illegal-argument-exception "Given leave edge is no tree edge."))
  (when (.tree-edge enter)
    (jthrow 'illegal-argument-exception "Given enter edge is a tree edge already."))
  (setf (.tree-edge leave) nil)
  (%ns-tree-edges-remove ns leave)
  (setf (.tree-edge enter) t)
  (%ns-tree-edges-add ns enter)
  (let ((delta (- (.layer (.target enter)) (.layer (.source enter)) (.delta enter))))
    (unless (%ns-is-in-head ns (.target enter) leave) (setf delta (- delta)))
    (jdo (node (.nodes (.graph ns)))
      (unless (%ns-is-in-head ns node leave)
        (incf (.layer node) delta))))
  (setf (.post-order ns) 1)
  (fill (.edge-visited ns) nil)
  (%ns-postorder-traversal ns (aref (.nodes (.graph ns)) 0))
  (%ns-cutvalues ns))

(defun %ns-normalize (ns)
  (let ((highest integer.min-value) (lowest integer.max-value)
        (nodes (.nodes (.graph ns))))
    (jdo (node nodes)
      (setf lowest (min lowest (.layer node))
            highest (max highest (.layer node))))
    (let ((filling (make-array (+ (- highest lowest) 1) :initial-element 0)))
      (jdo (node nodes)
        (decf (.layer node) lowest)
        (incf (aref filling (.layer node))))
      (let ((layer-id 0) (prev (.previous-layering-node-counts ns)))
        (when prev
          (loop for cnt across prev
                do (incf (aref filling layer-id) cnt)
                   (incf layer-id)
                   (when (= (length filling) layer-id) (return)))))
      filling)))

(defun %ns-balance (ns filling)
  (jdo (node (.nodes (.graph ns)))
    (when (= (length (.incoming-edges node)) (length (.outgoing-edges node)))
      (let ((new-layer (.layer node)))
        (multiple-value-bind (span-in span-out) (%ns-minimal-span node)
          (loop for i from (+ (- (.layer node) span-in) 1) below (+ (.layer node) span-out)
                do (when (< (aref filling i) (aref filling new-layer))
                     (setf new-layer i))))
        (when (< (aref filling new-layer) (aref filling (.layer node)))
          (decf (aref filling (.layer node)))
          (incf (aref filling new-layer))
          (setf (.layer node) new-layer))))))

;;;; common/polyomino-successors.lisp -- the BiFunction successors of PolyominoCompactor.
;;;; Each maps (x, y) coordinates (a Pair) to the next candidate offset.
;;;; Java's apply is J-APPLY here (CL symbol clash); Pair is core-util's pair.

(in-package #:elk)

(defjmethod j-apply ((this successor-combination) coords poly)
  (if (> (size (get-polyomino-extensions poly)) 0)
      (j-apply (.external-fun this) coords poly)
      (j-apply (.normal-fun this) coords poly)))

(defjctor successor-combination (normal-fun external-fun)
  (setf (.normal-fun this) normal-fun
        (.external-fun this) external-fun))

(defjmethod j-apply ((this successor-line-by-line) coords poly)
  (let ((x (get-first coords))
        (y (get-second coords)))
    (when (>= x 0)
      (when (= x y)
        (return-from j-apply (new-pair (- (- x) 1) (- (- x) 1))))
      (when (= x (- y))
        (return-from j-apply (new-pair (- x) (+ y 1)))))
    (when (> (math.abs x) (math.abs y))
      (if (< x 0)
          (return-from j-apply (new-pair (- x) y))
          (return-from j-apply (new-pair (- x) (+ y 1)))))
    (new-pair (+ x 1) y)))

(defjmethod j-apply ((this successor-manhattan) coords poly)
  (let* ((x (get-first coords))
         (y (get-second coords))
         (new-x x)
         (new-y y))
    (cond ((and (= x 0) (= y 0))
           (decf new-y 1))
          ((and (= x -1) (<= y 0))
           (setf new-x 0)
           (decf new-y 2))
          ((and (<= x 0) (> y 0))
           (decf new-x 1)
           (decf new-y 1))
          ((and (>= x 0) (< y 0))
           (incf new-x 1)
           (incf new-y 1))
          ((and (> x 0) (>= y 0))
           (decf new-x 1)
           (incf new-y 1))
          (t
           (incf new-x 1)
           (decf new-y 1)))
    (new-pair new-x new-y)))

(defjmethod j-apply ((this successor-jitter) coords poly)
  (let* ((x (get-first coords))
         (y (get-second coords))
         (new-x x)
         (new-y y)
         (cost (math.max (math.abs x) (math.abs y))))
    (cond ((and (<= x 0) (= x y))
           (setf new-x 0
                 new-y (- y 1)))
          ((and (= x (- cost)) (/= y cost))
           (setf new-x y
                 new-y x)
           (when (>= y 0)
             (incf new-x)))
          (t
           (setf new-x (- y)
                 new-y x)))
    (new-pair new-x new-y)))

(defjmethod j-apply ((this successor-max-norm-winding-in-math-pos-sense) coords poly)
  (let* ((x (get-first coords))
         (y (get-second coords))
         (cost (math.max (math.abs x) (math.abs y))))
    (cond ((and (< x cost) (= y (- cost)))
           (new-pair (+ x 1) y))
          ((and (= x cost) (< y cost))
           (new-pair x (+ y 1)))
          ((and (>= x (- cost)) (= y cost))
           (new-pair (- x 1) y))
          (t
           (new-pair x (- y 1))))))

(defjctor successor-quadrants-generic (cost-fun)
  (setf (.cost-fun this) cost-fun))

(defjmethod j-apply ((this successor-quadrants-generic) coords poly)
  (unless (eq poly (.last-poly this))
    (setf (.last-poly this) poly)
    (let ((dir-set (new-jset))
          (contains-pos nil)
          (contains-neg nil))
      (jdo (ext (get-polyomino-extensions poly))
        (js-add dir-set (get-first ext)))
      (setf (.pos-x this) t
            (.pos-y this) t
            (.neg-x this) t
            (.neg-y this) t)
      (setf contains-pos (js-contains dir-set common-direction.north)
            contains-neg (js-contains dir-set common-direction.south))
      (when (and contains-pos (not contains-neg))
        (setf (.pos-y this) nil))
      (when (and (not contains-pos) contains-neg)
        (setf (.neg-y this) nil))
      (setf contains-pos (js-contains dir-set common-direction.east)
            contains-neg (js-contains dir-set common-direction.west))
      (when (and contains-pos (not contains-neg))
        (setf (.neg-x this) nil))
      (when (and (not contains-pos) contains-neg)
        (setf (.pos-x this) nil))))
  (let* ((next-coords (j-apply (.cost-fun this) coords poly))
         (new-x (get-first next-coords))
         (new-y (get-second next-coords))
         (invalid nil))
    (if (< new-x 0)
        (unless (.neg-x this) (setf invalid t))
        (unless (.pos-x this) (setf invalid t)))
    (if (< new-y 0)
        (unless (.neg-y this) (setf invalid t))
        (unless (.pos-y this) (setf invalid t)))
    (if invalid
        (j-apply this next-coords poly)
        next-coords)))

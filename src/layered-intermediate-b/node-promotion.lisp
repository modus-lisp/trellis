;;;; node-promotion.lisp -- NodePromotion.

(in-package #:elk)

(defjconst node-promotion.model-order-node-comparator-desc
  (lambda (o1 o2)
    (if (and (has-property o1 layered-internal-properties.model-order)
             (has-property o2 layered-internal-properties.model-order))
        (- (get-property o2 layered-internal-properties.model-order)
           (get-property o1 layered-internal-properties.model-order))
        0)))

(defjconst node-promotion.model-order-node-comparator-asc
  (lambda (o1 o2)
    (if (and (has-property o1 layered-internal-properties.model-order)
             (has-property o2 layered-internal-properties.model-order))
        (- (get-property o1 layered-internal-properties.model-order)
           (get-property o2 layered-internal-properties.model-order))
        0)))

(defun %lib-nulls-list (n)
  "Lists.newArrayList(new T[n])"
  (make-array n :adjustable t :fill-pointer n :initial-element nil))

(defjmethod process ((this node-promotion) layered-graph progress-monitor)
  (begin progress-monitor "Node promotion heuristic" 1)
  (setf (.master-graph this) layered-graph
        (.promotion-strategy this) (get-property layered-graph layered-options.layering-node-promotion-strategy))
  (if (and (not (eq (.promotion-strategy this) node-promotion-strategy.model-order-left-to-right))
           (not (eq (.promotion-strategy this) node-promotion-strategy.model-order-right-to-left)))
      (precalculate-and-set-information this)
      (precalculate-and-set-information-model-order this))
  (let ((promote-until (to-int (get-property (.master-graph this) layered-options.layering-node-promotion-max-iterations)))
        (fun-function (lambda (reduced iterations) (declare (ignore reduced iterations)) t)))
    (enum-case (.promotion-strategy this)
      (node-promotion-strategy.nikolov (promotion-magic this fun-function))
      (node-promotion-strategy.nikolov-pixel (promotion-magic this fun-function))
      (node-promotion-strategy.nikolov-improved
       (setf (.promotion-strategy this) node-promotion-strategy.no-boundary)
       (promotion-magic this fun-function)
       (let ((new-max-width 0))
         (jdo (martha (.current-width this))
           (setf new-max-width (max new-max-width martha)))
         (when (> new-max-width (.max-width this))
           (setf (.promotion-strategy this) node-promotion-strategy.nikolov)
           (promotion-magic this fun-function))))
      (node-promotion-strategy.nikolov-improved-pixel
       (setf (.promotion-strategy this) node-promotion-strategy.no-boundary)
       (promotion-magic this fun-function)
       (let ((new-max-width-pixel 0.0))
         (jdo (donna (.current-width-pixel this))
           (setf new-max-width-pixel (math.max new-max-width-pixel donna)))
         (when (> new-max-width-pixel (.max-width-pixel this))
           (setf (.promotion-strategy this) node-promotion-strategy.nikolov-pixel)
           (promotion-magic this fun-function))))
      (node-promotion-strategy.nodecount-percentage
       (let ((promote-until-n (to-int (math.ceil (/ (* (length (.layers this)) promote-until) 100.0)))))
         (promotion-magic this (lambda (reduced iterations) (declare (ignore reduced))
                                 (< iterations promote-until-n)))))
      (node-promotion-strategy.dummynode-percentage
       (let ((promote-until-d (to-int (math.ceil (/ (* (.dummy-node-count this) promote-until) 100.0)))))
         (promotion-magic this (lambda (reduced iterations) (declare (ignore iterations))
                                 (< reduced promote-until-d)))))
      (node-promotion-strategy.model-order-left-to-right (model-order-node-promotion this t))
      (node-promotion-strategy.model-order-right-to-left (model-order-node-promotion this nil))
      (t (promotion-magic this fun-function))))
  (if (and (not (eq (.promotion-strategy this) node-promotion-strategy.model-order-left-to-right))
           (not (eq (.promotion-strategy this) node-promotion-strategy.model-order-right-to-left)))
      (set-new-layering this layered-graph)
      (set-new-layering-model-order this layered-graph))
  (done progress-monitor))

(defjmethod precalculate-and-set-information ((this node-promotion))
  (let* ((master (.master-graph this)))
    (setf (.node-size-affix this) (get-property master layered-options.spacing-node-node)
          (.dummy-size this) (get-property master layered-options.spacing-edge-node-between-layers)
          (.max-height this) (length (get-layers master)))
    (let ((layer-id (1- (.max-height this)))
          (node-id 0))
      (setf (.max-width this) 0
            (.max-width-pixel this) 0.0
            (.current-width this) (%lib-nulls-list (.max-height this))
            (.current-width-pixel this) (%lib-nulls-list (.max-height this)))
      ;; Layer IDs are reversed for easier handling in the heuristic.
      (jdo (layer (get-layers master))
        (setf (.id layer) layer-id)
        (jdo (node (get-nodes layer))
          (setf (.id node) node-id)
          (incf node-id))
        (decf layer-id))
      (setf (.layers this) (make-array node-id :initial-element 0)
            (.degree-diff this) (make-array (list node-id 3) :initial-element 0)
            (.nodes this) (new-jlist)
            (.nodes-with-incoming-edges this) (new-jlist))
      (let ((dummy-baggage 0)
            (layers (.layers this))
            (degree-diff (.degree-diff this)))
        (setf (.dummy-node-count this) 0)
        (jdo (layer (get-layers master))
          (setf layer-id (.id layer))
          (let ((incoming 0) (outcoming 0)
                (layer-size (length (get-nodes layer)))
                (layer-size-pixel 0.0))
            (jdo (node (get-nodes layer))
              (setf node-id (.id node))
              (setf (aref layers node-id) (.id (get-layer node)))
              (incf layer-size-pixel (+ (.y (get-size node)) (.node-size-affix this)))
              (let ((in-degree (length (to-jvector (get-incoming-edges node))))
                    (out-degree (length (to-jvector (get-outgoing-edges node)))))
                (setf (aref degree-diff node-id 0) (- out-degree in-degree)
                      (aref degree-diff node-id 1) in-degree
                      (aref degree-diff node-id 2) out-degree)
                (incf incoming in-degree)
                (incf outcoming out-degree)
                (when (> in-degree 0)
                  (jl-add (.nodes-with-incoming-edges this) node))
                (jl-add (.nodes this) node)))
            (decf dummy-baggage incoming)
            (let ((nodes-n-dummies (+ layer-size dummy-baggage)))
              (incf layer-size-pixel (* dummy-baggage (.dummy-size this)))
              (setf (aref (.current-width this) layer-id) nodes-n-dummies
                    (aref (.current-width-pixel this) layer-id) layer-size-pixel)
              (setf (.max-width this) (max (.max-width this) nodes-n-dummies)
                    (.max-width-pixel this) (math.max (.max-width-pixel this) layer-size-pixel))
              (incf (.dummy-node-count this) dummy-baggage)
              (incf dummy-baggage outcoming))))))))

(defjmethod precalculate-and-set-information-model-order ((this node-promotion))
  (setf (.bi-layer-map this) (new-bi-linked-hash-multi-map))
  (let ((node-id 0) (layer-id 0) (master (.master-graph this)))
    (jdo (layer (get-layers master))
      (setf (.id layer) layer-id)
      (jdo (node (get-nodes layer))
        (setf (.id node) node-id)
        (incf node-id))
      (incf layer-id))
    (let* ((left-to-right (eq (.promotion-strategy this) node-promotion-strategy.model-order-left-to-right))
           (cmp (if left-to-right
                    node-promotion.model-order-node-comparator-desc
                    node-promotion.model-order-node-comparator-asc)))
      (jdo (layer (get-layers master))
        (jl-sort (get-nodes layer) cmp)
        (put-all (.bi-layer-map this) (.id layer) (get-nodes layer))))))

(defun %lib-oset-add (oset x)
  "LinkedHashSet.add on a jlist used as an insertion-ordered set."
  (unless (find x oset :test #'eq) (jl-add oset x)))

(defjmethod model-order-node-promotion ((this node-promotion) left-to-right)
  (let ((bi (.bi-layer-map this))
        (something-changed nil)
        (mo layered-internal-properties.model-order))
    (loop
      (setf something-changed nil)
      (let ((current-layer-id (if left-to-right (- (size (key-set bi)) 2) 1)))
        (loop while (if left-to-right (>= current-layer-id 0) (< current-layer-id (size (key-set bi))))
              do (let ((current-layer (get-values bi current-layer-id))
                       (node-index 0))
                   (loop while (< node-index (length current-layer))
                         do (block next-node
                              (let ((node (jl-get current-layer node-index)))
                                (unless (has-property node mo) (return-from next-node))
                                ;; The last/first node shall not be promoted if no other node is there to compare it to.
                                (when (or (and (is-maximal-key bi current-layer-id)
                                               (eq (.promotion-strategy this) node-promotion-strategy.model-order-left-to-right))
                                          (and (is-minimal-key bi current-layer-id)
                                               (eq (.promotion-strategy this) node-promotion-strategy.model-order-right-to-left)))
                                  (return-from next-node))
                                ;; Check whether this layer has a model order that prevents node promotion.
                                (let ((shall-be-promoted t))
                                  (jdo (other-node current-layer)
                                    (when (has-property other-node mo)
                                      (when (or (and left-to-right
                                                     (< (get-property node mo) (get-property other-node mo)))
                                                (and (not left-to-right)
                                                     (> (get-property node mo) (get-property other-node mo))))
                                        (setf shall-be-promoted nil))))
                                  (unless shall-be-promoted (return-from next-node)))
                                (let* ((next-layer-id (if left-to-right (1+ current-layer-id) (1- current-layer-id)))
                                       (next-layer (get-values bi next-layer-id))
                                       (model-order-allows-promotion nil)
                                       (promote-through-dummy-layer t)
                                       (contains-labels nil))
                                  (jdo (next-layer-node next-layer)
                                    (cond
                                      ((has-property next-layer-node mo)
                                       (unless (eql (.id next-layer-node) (.id node))
                                         (when (if left-to-right
                                                   (< (get-property next-layer-node mo) (get-property node mo))
                                                   (> (get-property next-layer-node mo) (get-property node mo)))
                                           (setf model-order-allows-promotion t))
                                         (setf promote-through-dummy-layer nil)))
                                      ((and (not model-order-allows-promotion) promote-through-dummy-layer)
                                       (when (eq (get-type next-layer-node) node-type.label)
                                         (setf contains-labels t)
                                         (let ((node-connected-to-next-layer
                                                 (if left-to-right
                                                     (get-node (get-source (%lib-first (get-incoming-edges next-layer-node))))
                                                     (get-node (get-target (%lib-first (get-outgoing-edges next-layer-node)))))))
                                           (when (jequals node-connected-to-next-layer node)
                                             (let ((connected-node
                                                     (if left-to-right
                                                         (get-node (get-target (%lib-first (get-outgoing-edges next-layer-node))))
                                                         (get-node (get-source (%lib-first (get-incoming-edges next-layer-node)))))))
                                               (when (<= (if left-to-right
                                                             (- (get-key bi connected-node) (get-key bi node-connected-to-next-layer))
                                                             (- (get-key bi node-connected-to-next-layer) (get-key bi connected-node)))
                                                         2)
                                                 (setf promote-through-dummy-layer nil)))))))))
                                  (when (and contains-labels promote-through-dummy-layer)
                                    (let ((connected-node
                                            (if left-to-right
                                                (get-node (get-target (%lib-first (get-outgoing-edges node))))
                                                (get-node (get-source (%lib-first (get-incoming-edges node)))))))
                                      (when (and (<= (if left-to-right
                                                         (- (get-key bi connected-node) (get-key bi node))
                                                         (- (get-key bi node) (get-key bi connected-node)))
                                                     2)
                                                 (eq (get-type connected-node) node-type.normal))
                                        (setf promote-through-dummy-layer nil))))
                                  (when (or model-order-allows-promotion promote-through-dummy-layer)
                                    (let ((nodes-to-promote (promote-node-by-model-order this node left-to-right)))
                                      (loop until (jl-is-empty nodes-to-promote)
                                            do (let ((node-to-promote (jl-remove-at nodes-to-promote 0)))
                                                 (jdo (n (promote-node-by-model-order this node-to-promote left-to-right))
                                                   (%lib-oset-add nodes-to-promote n)))))
                                    ;; Select next node.
                                    (decf node-index)
                                    (setf something-changed t)))))
                            (incf node-index)))
                 (incf current-layer-id (if left-to-right -1 1))))
      (unless something-changed (return)))))

(defjmethod promote-node-by-model-order ((this node-promotion) node left-to-right)
  "Returns an insertion-ordered jlist standing for the LinkedHashSet."
  (let* ((bi (.bi-layer-map this))
         (old-layer-id (get-key bi node)))
    (if left-to-right
        (put bi (1+ old-layer-id) node)
        (put bi (1- old-layer-id) node))
    (let ((nodes-to-promote (new-jlist)))
      (jdo (edge (jlist-from (if left-to-right (get-outgoing-edges node) (get-incoming-edges node))))
        (let ((next-node (if left-to-right (get-node (get-target edge)) (get-node (get-source edge)))))
          (when (eql (get-key bi next-node) (get-key bi node))
            (%lib-oset-add nodes-to-promote next-node))))
      nodes-to-promote)))

(defjmethod promotion-magic ((this node-promotion) funky)
  (let* ((promotions 0)
         (promotion-flag nil)
         (iteration-counter 0)
         (reduced-dummies 0)
         (layering-backup (copy-seq (.layers this)))
         (dummy-backup (.dummy-node-count this))
         (height-backup (.max-height this))
         (current-width-backup (.current-width this))
         (current-width-pixel-backup (.current-width-pixel this)))
    (loop
      (setf promotions 0)
      (jdo (node (.nodes-with-incoming-edges this))
        (multiple-value-bind (diff not-exceeded) (promote-node this node)
          (let ((apply t))
            (when (or (eq (.promotion-strategy this) node-promotion-strategy.nikolov)
                      (eq (.promotion-strategy this) node-promotion-strategy.nikolov-pixel))
              (setf apply not-exceeded))
            (if (and (< diff 0) apply)
                (progn
                  (incf promotions)
                  (setf layering-backup (copy-seq (.layers this)))
                  (setf (.dummy-node-count this) (+ (.dummy-node-count this) diff))
                  (incf reduced-dummies (- dummy-backup (.dummy-node-count this)))
                  (setf dummy-backup (+ (.dummy-node-count this) diff)
                        height-backup (.max-height this)
                        current-width-backup (jlist-from (.current-width this))
                        current-width-pixel-backup (jlist-from (.current-width-pixel this))))
                (progn
                  (setf (.layers this) (copy-seq layering-backup)
                        (.dummy-node-count this) dummy-backup
                        (.current-width this) (jlist-from current-width-backup)
                        (.current-width-pixel this) (jlist-from current-width-pixel-backup)
                        (.max-height this) height-backup))))))
      (incf iteration-counter)
      (setf promotion-flag (and (/= promotions 0)
                                (funcall funky reduced-dummies iteration-counter)))
      (unless promotion-flag (return)))))

(defjmethod promote-node ((this node-promotion) node)
  "Returns (values dummydiff max-width-not-exceeded) for Java's Pair<Integer, Boolean>."
  (let* ((max-width-not-exceeded t)
         (dummydiff 0)
         (layers (.layers this))
         (degree-diff (.degree-diff this))
         (cw (.current-width this))
         (cwp (.current-width-pixel this))
         (node-layer-pos (aref layers (.id node)))
         (node-size (+ (.y (get-size node)) (.node-size-affix this)))
         (dummies-built (aref degree-diff (.id node) 2)))
    (setf (aref cw node-layer-pos) (+ (- (aref cw node-layer-pos) 1) dummies-built))
    (setf (aref cwp node-layer-pos) (+ (- (aref cwp node-layer-pos) node-size) (* dummies-built (.dummy-size this))))
    (incf node-layer-pos)
    (if (>= node-layer-pos (.max-height this))
        (progn
          (incf (.max-height this))
          (jl-add cw 1)
          (jl-add cwp node-size))
        (let ((dummies-reduced (aref degree-diff (.id node) 1)))
          (setf (aref cw node-layer-pos) (- (+ (aref cw node-layer-pos) 1) dummies-reduced))
          (setf (aref cwp node-layer-pos) (- (+ (aref cwp node-layer-pos) node-size)
                                             (* dummies-reduced (.dummy-size this))))))
    (when (or (and (eq (.promotion-strategy this) node-promotion-strategy.nikolov)
                   (or (> (aref cw node-layer-pos) (.max-width this))
                       (> (aref cw (1- node-layer-pos)) (.max-width this))))
              (and (eq (.promotion-strategy this) node-promotion-strategy.nikolov-pixel)
                   (or (> (aref cwp node-layer-pos) (.max-width-pixel this))
                       (> (aref cwp (1- node-layer-pos)) (.max-width-pixel this)))))
      (setf max-width-not-exceeded nil))
    (jdo (edge (get-incoming-edges node))
      (let ((master-node (get-node (get-source edge))))
        (when (= (aref (.layers this) (.id master-node)) node-layer-pos)
          (multiple-value-bind (d ok) (promote-node this master-node)
            (setf dummydiff (+ dummydiff d)
                  max-width-not-exceeded (and max-width-not-exceeded ok))))))
    (setf (aref (.layers this) (.id node)) node-layer-pos)
    (setf dummydiff (+ dummydiff (aref degree-diff (.id node) 0)))
    (values dummydiff max-width-not-exceeded)))

(defjmethod set-new-layering ((this node-promotion) layered-graph)
  (let ((lay-list (new-jlist))
        (max-height (.max-height this)))
    (loop for i from 0 to max-height
          do (let ((la-la-layer (new-layer layered-graph)))
               (setf (.id la-la-layer) (- max-height i))
               (jl-add lay-list la-la-layer)))
    (jdo (node (.nodes this))
      (set-layer node (jl-get lay-list (- max-height (aref (.layers this) (.id node))))))
    (jl-remove-if lay-list (lambda (layer) (jl-is-empty (get-nodes layer))))
    (jl-clear (get-layers layered-graph))
    (jl-add-all (get-layers layered-graph) lay-list)))

(defjmethod set-new-layering-model-order ((this node-promotion) layered-graph)
  (let ((layer-list (new-jlist))
        (bi (.bi-layer-map this)))
    (jl-clear (get-layers layered-graph))
    (jdo (layer-index (jl-sort (jlist-from (key-set bi)) #'integer.compare))
      (let ((layer-nodes (get-values bi layer-index)))
        (unless (is-empty layer-nodes)
          (let ((new-layer (new-layer layered-graph)))
            (jl-add layer-list new-layer)
            (setf (.id new-layer) layer-index)
            (jdo (node (jlist-from layer-nodes))
              (set-layer node new-layer))))))
    (jl-add-all (get-layers layered-graph) layer-list)))

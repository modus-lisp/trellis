;;;; north-south.lisp -- NorthSouthPortPreprocessor and NorthSouthPortPostprocessor
;;;; of org.eclipse.elk.alg.layered.intermediate.

(in-package #:elk)

;;; ------------------------------------------------ NorthSouthPortPreprocessor

(defjconst north-south-port-preprocessor.use-new-approach t)

(defjmethod process ((this north-south-port-preprocessor) layered-graph monitor)
  (begin monitor "Odd port side processing" 1)
  (let ((pointer -1)
        (north-dummy-nodes (new-jlist))
        (south-dummy-nodes (new-jlist)))
    (jdo (layer (get-layers layered-graph))
      (setf pointer -1)
      (let ((node-array (l-graph-util.to-node-array (get-nodes layer))))
        (jdo (node node-array)
          (incf pointer)
          (when (and (eq (get-type node) node-type.normal)
                     (is-side-fixed (get-property node layered-options.port-constraints)))
            (when (and (not (is-order-fixed (get-property node layered-options.port-constraints)))
                       (eq (get-property (get-graph node) layered-options.consider-model-order-strategy)
                           ordering-strategy.none))
              (sort-port-list this node))
            (set-property node layered-internal-properties.in-layer-layout-unit node)
            (jl-clear north-dummy-nodes)
            (jl-clear south-dummy-nodes)
            (let ((barycenter-associates (new-jlist))
                  (port-list (new-jlist)))
              (jdo (port (get-ports node port-side.north))
                (jl-add port-list port))
              (unless (eq (get-property (get-graph node) layered-options.consider-model-order-strategy)
                          ordering-strategy.none)
                (setf port-list (model-order-north-south-input-reversing this port-list node)))
              (create-dummy-nodes this layered-graph port-list north-dummy-nodes south-dummy-nodes
                                  barycenter-associates)
              ;; northern dummies are inserted before the node; each one at the same index
              (let ((insert-point pointer)
                    (successor node))
                (jdo (dummy north-dummy-nodes)
                  (set-layer dummy insert-point layer)
                  (incf pointer)
                  (set-property dummy layered-internal-properties.in-layer-layout-unit node)
                  (let* ((dummy-port (jl-get (get-ports dummy) 0))
                         (origin-port (get-property dummy-port layered-internal-properties.origin)))
                    (unless (get-property origin-port layered-options.allow-non-flow-ports-to-switch-sides)
                      (add (get-property dummy layered-internal-properties.in-layer-successor-constraints)
                           successor))
                    (unless north-south-port-preprocessor.use-new-approach
                      (setf successor dummy)))))
              ;; southern side: the port list is built right to left
              (jl-clear port-list)
              (jdo (port (get-ports node port-side.south))
                (jl-add-first port-list port))
              (unless (eq (get-property (get-graph node) layered-options.consider-model-order-strategy)
                          ordering-strategy.none)
                (setf port-list (model-order-north-south-input-reversing this port-list node)))
              (create-dummy-nodes this layered-graph port-list south-dummy-nodes nil
                                  barycenter-associates)
              (let ((predecessor node))
                (jdo (dummy south-dummy-nodes)
                  (set-layer dummy (incf pointer) layer)
                  (set-property dummy layered-internal-properties.in-layer-layout-unit node)
                  (let* ((dummy-port (jl-get (get-ports dummy) 0))
                         (origin-port (get-property dummy-port layered-internal-properties.origin)))
                    (unless (get-property origin-port layered-options.allow-non-flow-ports-to-switch-sides)
                      (add (get-property predecessor layered-internal-properties.in-layer-successor-constraints)
                           dummy))
                    (unless north-south-port-preprocessor.use-new-approach
                      (setf predecessor dummy)))))
              (unless (jl-is-empty barycenter-associates)
                (set-property node layered-internal-properties.barycenter-associates barycenter-associates)))))))
    (done monitor)))

(defjmethod sort-port-list ((this north-south-port-preprocessor) node)
  (let* ((ports (get-ports node))
         (n (size ports))
         (in-ports 0)
         (in-out-ports n)
         (out-ports (* 2 n)))
    (jdo (port (get-ports node))
      (let ((side (get-side port)))
        (cond ((or (eq side port-side.east) (eq side port-side.west))
               (setf (.id port) -1))
              ((or (eq side port-side.north) (eq side port-side.south))
               (let ((incoming (size (get-incoming-edges port)))
                     (outgoing (size (get-outgoing-edges port))))
                 (cond ((and (> incoming 0) (> outgoing 0))
                        (setf (.id port) in-out-ports)
                        (incf in-out-ports))
                       ((> incoming 0)
                        (setf (.id port) in-ports)
                        (incf in-ports))
                       ((> outgoing 0)
                        (setf (.id port) out-ports)
                        (incf out-ports))
                       (t
                        (setf (.id port) in-ports)
                        (incf in-ports))))))))
    (jl-sort (get-ports node)
             (lambda (port1 port2)
               (let ((side1 (get-side port1))
                     (side2 (get-side port2)))
                 (cond ((not (eq side1 side2))
                        (- (ordinal side1) (ordinal side2)))
                       ((= (.id port1) (.id port2)) 0)
                       ((eq side1 port-side.north)
                        (- (.id port1) (.id port2)))
                       (t
                        (- (.id port2) (.id port1)))))))))

(defjmethod model-order-north-south-input-reversing ((this north-south-port-preprocessor) port-list node)
  (let ((incoming (new-jlist))
        (outgoing (new-jlist)))
    (jdo (port port-list)
      (if (not (is-empty (get-incoming-edges port)))
          (jl-add incoming port)
          (jl-add outgoing port)))
    ;; Java: Lists.reverse(incoming).addAll(outgoing) -- the reversed view appends at the
    ;; FRONT of the underlying list, so the result is reverse(outgoing) followed by incoming
    ;; in its original order.
    (let ((result (new-jlist)))
      (jdo (port outgoing)
        (jl-add-first result port))
      (jdo (port incoming)
        (jl-add result port))
      result)))

(defjmethod create-dummy-nodes ((this north-south-port-preprocessor) layered-graph ports
                                dummy-nodes opposing-side-dummy-nodes barycenter-associates)
  (let ((in-ports (new-jlist))
        (out-ports (new-jlist))
        (in-out-ports (new-jlist))
        (same-side-self-loop-edges (new-jlist))
        (north-south-self-loop-edges (new-jlist)))
    (jdo (port ports)
      (jdo (edge (get-outgoing-edges port))
        (when (eq (get-node (get-source edge)) (get-node (get-target edge)))
          (cond ((eq (get-side port) (get-side (get-target edge)))
                 (jl-add same-side-self-loop-edges edge))
                ((and (eq (get-side port) port-side.north)
                      (eq (get-side (get-target edge)) port-side.south))
                 (jl-add north-south-self-loop-edges edge))))))
    (jdo (edge north-south-self-loop-edges)
      (create-north-south-self-loop-dummy-nodes this layered-graph edge dummy-nodes
                                                opposing-side-dummy-nodes port-side.east))
    (jdo (edge same-side-self-loop-edges)
      (create-same-side-self-loop-dummy-node this layered-graph edge dummy-nodes))
    (jdo (port ports)
      (let ((has-in (> (size (get-incoming-edges port)) 0))
            (has-out (> (size (get-outgoing-edges port)) 0)))
        (cond ((and has-in has-out) (jl-add in-out-ports port))
              (has-in (jl-add in-ports port))
              (has-out (jl-add out-ports port)))))
    (if north-south-port-preprocessor.use-new-approach
        (progn
          (jdo (in-port in-ports)
            (jl-add barycenter-associates
                    (create-dummy-node this layered-graph in-port nil dummy-nodes)))
          (jdo (out-port out-ports)
            (jl-add barycenter-associates
                    (create-dummy-node this layered-graph nil out-port dummy-nodes))))
        (let ((in-ports-index 0)
              (out-ports-index (- (size out-ports) 1)))
          (loop while (and (< in-ports-index (size in-ports)) (>= out-ports-index 0))
                do (let ((in-port (jl-get in-ports in-ports-index))
                         (out-port (jl-get out-ports out-ports-index)))
                     (when (< (jl-index-of ports out-port) (jl-index-of ports in-port))
                       (return))
                     (jl-add barycenter-associates
                             (create-dummy-node this layered-graph in-port out-port dummy-nodes))
                     (incf in-ports-index)
                     (decf out-ports-index)))
          (loop while (< in-ports-index (size in-ports))
                do (jl-add barycenter-associates
                           (create-dummy-node this layered-graph (jl-get in-ports in-ports-index)
                                              nil dummy-nodes))
                   (incf in-ports-index))
          (loop while (>= out-ports-index 0)
                do (jl-add barycenter-associates
                           (create-dummy-node this layered-graph nil (jl-get out-ports out-ports-index)
                                              dummy-nodes))
                   (decf out-ports-index))))
    (jdo (in-out-port in-out-ports)
      (jl-add barycenter-associates
              (create-dummy-node this layered-graph in-out-port in-out-port dummy-nodes)))))

(defjmethod create-dummy-node ((this north-south-port-preprocessor) layered-graph in-port out-port dummy-nodes)
  (let ((dummy (new-l-node layered-graph))
        (crossing-hint 0))
    (set-type dummy node-type.north-south-port)
    (set-property dummy layered-options.port-constraints port-constraints.fixed-pos)
    (when in-port
      (let ((dummy-input-port (new-l-port)))
        (set-property dummy-input-port layered-internal-properties.origin in-port)
        (set-property dummy layered-internal-properties.origin (get-node in-port))
        (set-side dummy-input-port port-side.west)
        (set-node dummy-input-port dummy)
        (jdo (edge (l-graph-util.to-edge-array (get-incoming-edges in-port)))
          (set-target edge dummy-input-port))
        (set-property in-port layered-internal-properties.port-dummy dummy)
        (incf crossing-hint)))
    (when out-port
      (let ((dummy-output-port (new-l-port)))
        (set-property dummy layered-internal-properties.origin (get-node out-port))
        (set-property dummy-output-port layered-internal-properties.origin out-port)
        (set-side dummy-output-port port-side.east)
        (set-node dummy-output-port dummy)
        (jdo (edge (l-graph-util.to-edge-array (get-outgoing-edges out-port)))
          (set-source edge dummy-output-port))
        (set-property out-port layered-internal-properties.port-dummy dummy)
        (incf crossing-hint)))
    (set-property dummy layered-internal-properties.crossing-hint crossing-hint)
    (jl-add dummy-nodes dummy)
    dummy))

(defjmethod create-same-side-self-loop-dummy-node ((this north-south-port-preprocessor) layered-graph self-loop
                                                   dummy-nodes)
  (let ((dummy (new-l-node layered-graph))
        (dummy-input-port (new-l-port))
        (dummy-output-port (new-l-port)))
    (set-type dummy node-type.north-south-port)
    (set-property dummy layered-options.port-constraints port-constraints.fixed-pos)
    (set-property dummy layered-internal-properties.origin self-loop)
    (set-property dummy-input-port layered-internal-properties.origin (get-target self-loop))
    (set-side dummy-input-port port-side.west)
    (set-node dummy-input-port dummy)
    (set-property dummy-output-port layered-internal-properties.origin (get-source self-loop))
    (set-side dummy-output-port port-side.east)
    (set-node dummy-output-port dummy)
    (set-property (get-source self-loop) layered-internal-properties.port-dummy dummy)
    (set-property (get-target self-loop) layered-internal-properties.port-dummy dummy)
    (set-source self-loop nil)
    (set-target self-loop nil)
    (jl-add dummy-nodes dummy)
    (set-property dummy layered-internal-properties.crossing-hint 2)))

(defjmethod create-north-south-self-loop-dummy-nodes ((this north-south-port-preprocessor) layered-graph
                                                      self-loop north-dummy-nodes south-dummy-nodes port-side)
  (let ((north-dummy (new-l-node layered-graph)))
    (set-type north-dummy node-type.north-south-port)
    (set-property north-dummy layered-options.port-constraints port-constraints.fixed-pos)
    (set-property north-dummy layered-internal-properties.origin (get-node (get-source self-loop)))
    (let ((north-dummy-output-port (new-l-port)))
      (set-property north-dummy-output-port layered-internal-properties.origin (get-source self-loop))
      (set-side north-dummy-output-port port-side)
      (set-node north-dummy-output-port north-dummy)
      (set-property (get-source self-loop) layered-internal-properties.port-dummy north-dummy)
      (let ((south-dummy (new-l-node layered-graph)))
        (set-type south-dummy node-type.north-south-port)
        (set-property south-dummy layered-options.port-constraints port-constraints.fixed-pos)
        (set-property south-dummy layered-internal-properties.origin (get-node (get-target self-loop)))
        (let ((south-dummy-input-port (new-l-port)))
          (set-property south-dummy-input-port layered-internal-properties.origin (get-target self-loop))
          (set-side south-dummy-input-port port-side)
          (set-node south-dummy-input-port south-dummy)
          (set-property (get-target self-loop) layered-internal-properties.port-dummy south-dummy)
          (set-source self-loop north-dummy-output-port)
          (set-target self-loop south-dummy-input-port)
          (jl-add-first north-dummy-nodes north-dummy)
          (jl-add south-dummy-nodes south-dummy)
          (set-property north-dummy layered-internal-properties.crossing-hint 1)
          (set-property south-dummy layered-internal-properties.crossing-hint 1))))))

;;; ------------------------------------------------ NorthSouthPortPostprocessor

(defjmethod process ((this north-south-port-postprocessor) layered-graph monitor)
  (begin monitor "Odd port side processing" 1)
  ;; Spline edge routing manages bend points in the edge router. Differentiate behaviour
  ;; depending on edge router.
  (let ((routing (get-property layered-graph layered-options.edge-routing)))
    (jdo (layer (get-layers layered-graph))
      (let ((node-array (l-graph-util.to-node-array (get-nodes layer))))
        (jdo (node node-array)
          ;; We only care for North/South Port dummy nodes
          (when (eq (get-type node) node-type.north-south-port)
            (cond ((eq routing edge-routing.splines)
                   (jdo (port (get-ports node))
                     (unless (is-empty (get-incoming-edges port))
                       (process-spline-input-port this port))
                     (unless (is-empty (get-outgoing-edges port))
                       (process-spline-output-port this port))))
                  ((typep (get-property node layered-internal-properties.origin) 'l-edge)
                   ;; It's a self-loop
                   (process-self-loop this node))
                  (t
                   ;; Check if all ports were created for the same origin port
                   (let ((same-origin-port
                           (if (>= (size (get-ports node)) 2)
                               (let ((same t))
                                 (loop for i from 1 below (size (get-ports node))
                                       do (unless (jequals (get-property (jl-get (get-ports node) (1- i))
                                                                         layered-internal-properties.origin)
                                                           (get-property (jl-get (get-ports node) i)
                                                                         layered-internal-properties.origin))
                                            (setf same nil)
                                            (return)))
                                 same)
                               nil)))
                     (jdo (port (get-ports node))
                       (unless (is-empty (get-incoming-edges port))
                         (process-input-port this port same-origin-port))
                       (unless (is-empty (get-outgoing-edges port))
                         (process-output-port this port same-origin-port))))))
            ;; Remove the node
            (set-layer node nil)))))
    (done monitor)))

(defjmethod process-input-port ((this north-south-port-postprocessor) input-port add-junction-points)
  ;; Retrieve the port the dummy node was created from
  (let* ((origin-port (get-property input-port layered-internal-properties.origin))
         ;; Calculate the bend point
         (x (.x (get-absolute-anchor origin-port)))
         (y (.y (get-position (get-node input-port)))))
    ;; Reroute the edges, inserting a new bend point at the position of the dummy node
    (jdo (in-edge (l-graph-util.to-edge-array (get-incoming-edges input-port)))
      (set-target in-edge origin-port)
      (add-last (get-bend-points in-edge) x y)
      ;; Check if a junction point should be added
      (when add-junction-points
        (let ((junction-points (get-property in-edge layered-options.junction-points)))
          (when (null junction-points)
            (setf junction-points (new-k-vector-chain))
            (set-property in-edge layered-options.junction-points junction-points))
          (add junction-points (new-k-vector x y)))))))

(defjmethod process-output-port ((this north-south-port-postprocessor) output-port add-junction-points)
  (let* ((origin-port (get-property output-port layered-internal-properties.origin))
         (x (.x (get-absolute-anchor origin-port)))
         (y (.y (get-position (get-node output-port)))))
    (jdo (out-edge (l-graph-util.to-edge-array (get-outgoing-edges output-port)))
      (set-source out-edge origin-port)
      (add-first (get-bend-points out-edge) x y)
      (when add-junction-points
        (let ((junction-points (get-property out-edge layered-options.junction-points)))
          (when (null junction-points)
            (setf junction-points (new-k-vector-chain))
            (set-property out-edge layered-options.junction-points junction-points))
          (add junction-points (new-k-vector x y)))))))

(defjmethod process-self-loop ((this north-south-port-postprocessor) dummy)
  ;; Get the edge and the ports it was originally connected to
  (let* ((self-loop (get-property dummy layered-internal-properties.origin))
         (input-port (jl-first (get-ports dummy port-side.west)))
         (output-port (jl-first (get-ports dummy port-side.east)))
         (origin-input-port (get-property input-port layered-internal-properties.origin))
         (origin-output-port (get-property output-port layered-internal-properties.origin)))
    ;; Reconnect the edge
    (set-source self-loop origin-output-port)
    (set-target self-loop origin-input-port)
    ;; Add two bend points
    (let ((bend-point (new-k-vector (get-position (get-node output-port)))))
      (setf (.x bend-point) (.x (get-absolute-anchor origin-output-port)))
      (add (get-bend-points self-loop) bend-point))
    (let ((bend-point (new-k-vector (get-position (get-node input-port)))))
      (setf (.x bend-point) (.x (get-absolute-anchor origin-input-port)))
      (add (get-bend-points self-loop) bend-point))))

(defjmethod process-spline-input-port ((this north-south-port-postprocessor) input-port)
  (let ((origin-port (get-property input-port layered-internal-properties.origin)))
    (set-property origin-port layered-internal-properties.spline-ns-port-y-coord
                  (.y (get-position (get-node input-port))))
    (jdo (in-edge (l-graph-util.to-edge-array (get-incoming-edges input-port)))
      (set-target in-edge origin-port))))

(defjmethod process-spline-output-port ((this north-south-port-postprocessor) output-port)
  (let ((origin-port (get-property output-port layered-internal-properties.origin)))
    (set-property origin-port layered-internal-properties.spline-ns-port-y-coord
                  (.y (get-position (get-node output-port))))
    (jdo (out-edge (l-graph-util.to-edge-array (get-outgoing-edges output-port)))
      (set-source out-edge origin-port))))

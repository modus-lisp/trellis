;;;; elk-util.lisp -- org.eclipse.elk.core.util.ElkUtil

(in-package #:elk)

(defjconst elk-util.default-min-width (%cu-float 20.0))
(defjconst elk-util.default-min-height (%cu-float 20.0))

;;; ------------------------------------------------------------ graph traversal helpers

(defun %cu-element-children-lists (element)
  "The containment lists of ELEMENT whose members are graph elements, in EMF
feature order (labels, then ports, children, contained edges for a node)."
  (typecase element
    (elk-node (list (get-labels element) (get-ports element) (get-children element)
                    (get-contained-edges element)))
    (t (list (get-labels element)))))

(defun %cu-walk-graph (fn root include-root)
  "Pre-order over ROOT's containment tree, as EMF's eAllContents (and
ElkGraphUtil.propertiesSkippingIteratorFor) do it: an element is handed to FN
before its contents are enumerated, and the contents lists are read live, so
elements FN adds to them are visited as well."
  (labels ((walk (el)
             (funcall fn el)
             (descend el))
           (descend (el)
             (dolist (lst (%cu-element-children-lists el))
               (when lst
                 (let ((i 0))
                   (loop while (< i (jsize lst))
                         do (walk (j-get lst i))
                            (incf i)))))))
    (if include-root (walk root) (descend root))))

(defun %cu-elk-class-name (element)
  "element.eClass().getName()"
  (typecase element
    (elk-node "ElkNode")
    (elk-port "ElkPort")
    (elk-edge "ElkEdge")
    (elk-label "ElkLabel")
    (elk-edge-section "ElkEdgeSection")
    (elk-bend-point "ElkBendPoint")
    (t (let ((n (string-downcase (symbol-name (type-of element)))))
         (with-output-to-string (s)
           (loop with up = t for c across n
                 do (cond ((char= c #\-) (setf up t))
                          (up (write-char (char-upcase c) s) (setf up nil))
                          (t (write-char c s)))))))))

(defun %cu-container (element)
  "element.eContainer() for graph elements."
  (typecase element
    (elk-edge (get-containing-node element))
    (t (get-parent element))))

(defun new-string-builder (&optional (init ""))
  "java.lang.StringBuilder: a string with a fill pointer."
  (let ((s (make-array (length init) :element-type 'character :adjustable t :fill-pointer 0)))
    (loop for c across init do (vector-push-extend c s))
    s))

(defun %cu-append (builder &rest parts)
  (let ((str (apply #'jstr (mapcar (lambda (p) (if (typep p 'jenum) (name p) p)) parts))))
    (loop for c across str do (vector-push-extend c builder))
    builder))

(defun %cu-null-or-empty (s) (or (null s) (and (stringp s) (zerop (length s)))))

;;; ------------------------------------------------------------ layout-related methods

(defjstatic elk-util.calc-port-side (port direction)
  (when (null (get-parent port))
    (jthrow 'illegal-state-exception "port must have a parent node to calculate the port side"))
  (let* ((node (get-parent port))
         (node-width (get-width node))
         (node-height (get-height node)))
    (when (and (<= node-width 0) (<= node-height 0))
      (return-from elk-util.calc-port-side/2 port-side.undefined))
    (let ((xpos (get-x port)) (ypos (get-y port)))
      (enum-case direction
        ((core-direction.left core-direction.right)
         (cond ((< xpos 0) (return-from elk-util.calc-port-side/2 port-side.west))
               ((> (+ xpos (get-width port)) node-width)
                (return-from elk-util.calc-port-side/2 port-side.east))))
        ((core-direction.up core-direction.down)
         (cond ((< ypos 0) (return-from elk-util.calc-port-side/2 port-side.north))
               ((> (+ ypos (get-height port)) node-height)
                (return-from elk-util.calc-port-side/2 port-side.south)))))
      (with-java-floats
        (let ((width-percent (/ (+ xpos (/ (get-width port) 2)) node-width))
              (height-percent (/ (+ ypos (/ (get-height port) 2)) node-height)))
          (cond ((and (<= (+ width-percent height-percent) 1) (<= (- width-percent height-percent) 0))
                 port-side.west)
                ((and (>= (+ width-percent height-percent) 1) (>= (- width-percent height-percent) 0))
                 port-side.east)
                ((< height-percent 0.5) port-side.north)
                (t port-side.south)))))))

(defjstatic elk-util.calc-port-offset (port side)
  (when (null (get-parent port))
    (jthrow 'illegal-state-exception "port must have a parent node to calculate the port side"))
  (let ((node (get-parent port)))
    (enum-case side
      (port-side.north (- (+ (get-y port) (get-height port))))
      (port-side.east (- (get-x port) (get-width node)))
      (port-side.south (- (get-y port) (get-height node)))
      (port-side.west (- (+ (get-x port) (get-width port))))
      (t 0.0))))

(defun %cu-direction-of (node)
  (if (null (get-parent node))
      (get-property node core-options.direction)
      (get-property (get-parent node) core-options.direction)))

(defjstatic elk-util.resize-node (node)
  (let ((size-constraint (get-property node core-options.node-size-constraints)))
    (when (is-empty size-constraint)
      (return-from elk-util.resize-node/1 nil))
    (let ((new-width 0.0) (new-height 0.0))
      (when (contains size-constraint size-constraint.ports)
        (let ((port-constraints (get-property node core-options.port-constraints))
              (min-north 2.0) (min-east 2.0) (min-south 2.0) (min-west 2.0)
              (direction (%cu-direction-of node)))
          (jdo (port (get-ports node))
            (let ((port-side (get-property port core-options.port-side)))
              (when (eq port-side port-side.undefined)
                (setf port-side (elk-util.calc-port-side port direction))
                (set-property port core-options.port-side port-side))
              (if (eq port-constraints port-constraints.fixed-pos)
                  (enum-case port-side
                    (port-side.north (setf min-north (math.max min-north (+ (get-x port) (get-width port)))))
                    (port-side.east (setf min-east (math.max min-east (+ (get-y port) (get-height port)))))
                    (port-side.south (setf min-south (math.max min-south (+ (get-x port) (get-width port)))))
                    (port-side.west (setf min-west (math.max min-west (+ (get-y port) (get-height port))))))
                  (enum-case port-side
                    (port-side.north (incf min-north (+ (get-width port) 2)))
                    (port-side.east (incf min-east (+ (get-height port) 2)))
                    (port-side.south (incf min-south (+ (get-width port) 2)))
                    (port-side.west (incf min-west (+ (get-height port) 2)))))))
          (setf new-width (math.max min-north min-south)
                new-height (math.max min-east min-west))))
      (elk-util.resize-node node new-width new-height t t))))

(defjstatic elk-util.resize-node (node new-width new-height move-ports move-labels)
  (with-java-floats
    (let* ((old-size (new-k-vector (get-width node) (get-height node)))
           (new-size (elk-util.effective-min-size-constraint-for node)))
      (setf (.x new-size) (math.max (.x new-size) new-width)
            (.y new-size) (math.max (.y new-size) new-height))
      (let ((width-ratio (/ (.x new-size) (.x old-size)))
            (height-ratio (/ (.y new-size) (.y old-size)))
            (width-diff (- (.x new-size) (.x old-size)))
            (height-diff (- (.y new-size) (.y old-size))))
        (when move-ports
          (let ((direction (%cu-direction-of node))
                (fixed-ports (eq (get-property node core-options.port-constraints)
                                 port-constraints.fixed-pos)))
            (jdo (port (get-ports node))
              (let ((port-side (get-property port core-options.port-side)))
                (when (eq port-side port-side.undefined)
                  (setf port-side (elk-util.calc-port-side port direction))
                  (set-property port core-options.port-side port-side))
                (enum-case port-side
                  (port-side.north
                   (unless fixed-ports (set-x port (* (get-x port) width-ratio))))
                  (port-side.east
                   (set-x port (+ (get-x port) width-diff))
                   (unless fixed-ports (set-y port (* (get-y port) height-ratio))))
                  (port-side.south
                   (unless fixed-ports (set-x port (* (get-x port) width-ratio)))
                   (set-y port (+ (get-y port) height-diff)))
                  (port-side.west
                   (unless fixed-ports (set-y port (* (get-y port) height-ratio)))))))))
        ;; resize the node AFTER ports have been placed, since calcPortSide needs the old size
        (set-dimensions node (.x new-size) (.y new-size))
        (when move-labels
          (jdo (label (get-labels node))
            (let* ((midx (+ (get-x label) (/ (get-width label) 2)))
                   (midy (+ (get-y label) (/ (get-height label) 2)))
                   (width-percent (/ midx (.x old-size)))
                   (height-percent (/ midy (.y old-size))))
              (when (>= (+ width-percent height-percent) 1)
                (cond ((and (> (- width-percent height-percent) 0) (>= midy 0))
                       (set-x label (+ (get-x label) width-diff))
                       (set-y label (+ (get-y label) (* height-diff height-percent))))
                      ((and (< (- width-percent height-percent) 0) (>= midx 0))
                       (set-x label (+ (get-x label) (* width-diff width-percent)))
                       (set-y label (+ (get-y label) height-diff))))))))
        (set-property node core-options.node-size-constraints (size-constraint.fixed))
        (new-k-vector width-ratio height-ratio)))))

(defjstatic elk-util.effective-min-size-constraint-for (node)
  (let ((size-constraint (get-property node core-options.node-size-constraints)))
    (if (contains size-constraint size-constraint.minimum-size)
        (let ((size-options (get-property node core-options.node-size-options))
              (min-size (new-k-vector (get-property node core-options.node-size-minimum))))
          (when (contains size-options size-options.default-minimum-size)
            (when (<= (.x min-size) 0) (setf (.x min-size) elk-util.default-min-width))
            (when (<= (.y min-size) 0) (setf (.y min-size) elk-util.default-min-height)))
          min-size)
        (new-k-vector))))

(defjstatic elk-util.apply-configured-node-scaling (node)
  (let ((scaling-factor (get-property node core-options.scale-factor)))
    (when (= scaling-factor 1)
      (return-from elk-util.apply-configured-node-scaling/1 nil))
    (set-dimensions node (* scaling-factor (get-width node)) (* scaling-factor (get-height node)))
    (let ((shapes (new-jlist)))
      (jl-add-all shapes (get-labels node))
      (jl-add-all shapes (get-ports node))
      (jdo (p (get-ports node)) (jl-add-all shapes (get-labels p)))
      (jdo (shape shapes)
        (set-location shape (* scaling-factor (get-x shape)) (* scaling-factor (get-y shape)))
        (set-dimensions shape (* scaling-factor (get-width shape)) (* scaling-factor (get-height shape)))
        (let ((anchor (get-property shape core-options.port-anchor)))
          (when anchor
            (setf (.x anchor) (* (.x anchor) scaling-factor)
                  (.y anchor) (* (.y anchor) scaling-factor))))))
    nil))

(defjstatic elk-util.compute-child-area-dimensions (node)
  (let ((min-x double.positive-infinity) (min-y double.positive-infinity)
        (max-x 0.0) (max-y 0.0)
        (shapes (new-jlist)))
    (jl-add-all shapes (get-labels node))
    (jl-add-all shapes (get-children node))
    (jdo (edge (get-contained-edges node)) (jl-add-all shapes (get-labels edge)))
    (jdo (shape shapes)
      (let ((margins (get-property shape core-options.margins)))
        (when (> min-x (- (get-x shape) (.left margins)))
          (setf min-x (- (get-x shape) (.left margins))))
        (when (> min-y (- (get-y shape) (.top margins)))
          (setf min-y (- (get-y shape) (.top margins))))
        (when (< max-x (+ (get-x shape) (get-width shape) (.right margins)))
          (setf max-x (+ (get-x shape) (get-width shape) (.right margins))))
        (when (< max-y (+ (get-y shape) (get-height shape) (.bottom margins)))
          (setf max-y (+ (get-y shape) (get-height shape) (.bottom margins))))))
    (jdo (edge (get-contained-edges node))
      (jdo (section (get-sections edge))
        (let ((sx (get-start-x section)) (ex (get-end-x section))
              (sy (get-start-y section)) (ey (get-end-y section)))
          (setf min-x (math.min min-x sx) min-x (math.min min-x ex)
                max-x (math.max max-x sx) max-x (math.max max-x ex)
                min-y (math.min min-y sy) min-y (math.min min-y ey)
                max-y (math.max max-y sy) max-y (math.max max-y ey))
          (jdo (bendpoint (get-bend-points section))
            (setf min-x (math.min min-x (get-x bendpoint))
                  max-x (math.max max-x (get-x bendpoint))
                  min-y (math.min min-y (get-y bendpoint))
                  max-y (math.max max-y (get-y bendpoint)))))))
    (with-java-floats
      (set-property node core-options.child-area-width (- max-x min-x))
      (set-property node core-options.child-area-height (- max-y min-y)))
    nil))

(defjstatic elk-util.determine-junction-points (edge)
  (unless (= (jsize (get-sections edge)) 1)
    (jthrow 'illegal-argument-exception
            "The edge needs to have exactly one edge section. Found: ~A" (jsize (get-sections edge))))
  (let ((junction-points (new-k-vector-chain))
        (sp (elk-graph-util.connectable-shape-to-port (j-get (get-sources edge) 0)))
        (tp (elk-graph-util.connectable-shape-to-port (j-get (get-targets edge) 0))))
    (when sp
      (add-all junction-points (%cu-determine-junction-points edge sp nil)))
    (when tp
      (add-all junction-points (%cu-determine-junction-points edge tp t)))
    junction-points))

(defun %cu-determine-junction-points (edge port reverse)
  (let* ((section (j-get (get-sections edge) 0))
         (junction-points (new-k-vector-chain))
         (points-map (make-hash-table :test 'eq))
         (section-points (%cu-get-points section))
         (offset-map (make-hash-table :test 'eq))
         (all-connected-sections (new-jlist)))
    (setf (gethash section points-map) section-points)
    (jdo (other-edge (elk-graph-util.all-incident-edges port))
      (unless (= (jsize (get-sections edge)) 1)
        (jthrow 'illegal-argument-exception
                "The edge needs to have exactly one edge section. Found: ~A" (jsize (get-sections edge))))
      (unless (eq other-edge edge)
        (let* ((other-section (j-get (get-sections other-edge) 0))
               (other-points (gethash other-section points-map)))
          (jl-add all-connected-sections other-section)
          (unless other-points
            (setf other-points (%cu-get-points other-section))
            (setf (gethash other-section points-map) other-points))
          (setf (gethash other-section offset-map)
                (if reverse
                    (sub (new-k-vector (jl-last section-points)) (jl-last other-points))
                    (sub (new-k-vector (jl-get section-points 0)) (jl-get other-points 0)))))))
    (unless (jl-is-empty all-connected-sections)
      (let* ((n (length section-points))
             (p1 (jl-get section-points (if reverse (1- n) 0))))
        (loop for i from 1 below n
              do (let ((p2 (jl-get section-points (if reverse (- n 1 i) i)))
                       (j 0))
                   (loop while (< j (length all-connected-sections))
                         do (let* ((other-section (jl-get all-connected-sections j))
                                   (other-points (gethash other-section points-map))
                                   (removed nil))
                              (if (<= (length other-points) i)
                                  (progn (jl-remove-at all-connected-sections j) (setf removed t))
                                  (let ((p3 (add (new-k-vector
                                                  (jl-get other-points
                                                          (if reverse (- (length other-points) 1 i) i)))
                                                 (gethash other-section offset-map))))
                                    (when (or (/= (.x p2) (.x p3)) (/= (.y p2) (.y p3)))
                                      (let ((dx2 (- (.x p2) (.x p1))) (dy2 (- (.y p2) (.y p1)))
                                            (dx3 (- (.x p3) (.x p1))) (dy3 (- (.y p3) (.y p1))))
                                        (cond ((and (= (* dx3 dy2) (* dy3 dx2))
                                                    (= (math.signum dx2) (math.signum dx3))
                                                    (= (math.signum dy2) (math.signum dy3)))
                                               (when (or (< (abs dx2) (abs dx3)) (< (abs dy2) (abs dy3)))
                                                 (add junction-points p2)))
                                              ((> i 1) (add junction-points p1))))
                                      (jl-remove-at all-connected-sections j)
                                      (setf removed t))))
                              (unless removed (incf j))))
                   (setf p1 p2)))))
    junction-points))

(defjstatic elk-util.get-labels-bounds (port)
  (let ((bounds nil))
    (jdo (label (get-labels port))
      (let ((current (new-elk-rectangle (.x (get-position label)) (.y (get-position label))
                                        (.x (get-size label)) (.y (get-size label)))))
        (if (null bounds) (setf bounds current) (j-union bounds current))))
    (or bounds (new-elk-rectangle))))

(defjstatic elk-util.compute-inside-part (port port-border-offset)
  (let ((label-bounds (elk-util.get-labels-bounds port)))
    (elk-util.compute-inside-part (new-k-vector (.x label-bounds) (.y label-bounds))
                                  (new-k-vector (.width label-bounds) (.height label-bounds))
                                  (get-size port) port-border-offset (get-side port))))

(defjstatic elk-util.compute-inside-part (label-position label-size port-size port-border-offset port-side)
  (enum-case port-side
    (port-side.north (math.max 0.0 (- (+ (.y label-size) (.y label-position))
                                      (+ (.y port-size) port-border-offset))))
    (port-side.south (math.max 0.0 (- (- (.y label-position)) port-border-offset)))
    (port-side.east (math.max 0.0 (- (- (.x label-position)) port-border-offset)))
    (port-side.west (math.max 0.0 (- (+ (.x label-size) (.x label-position))
                                     (+ (.x port-size) port-border-offset))))
    (t 0.0)))

;;; ------------------------------------------------------------ coordinate translation

(defgeneric %cu-translate (thing xoffset yoffset))

(defmethod %cu-translate ((parent elk-node) xoffset yoffset)
  (jdo (child (get-children parent))
    (set-location child (+ (get-x child) xoffset) (+ (get-y child) yoffset)))
  (jdo (edge (jl-copy (jlist-from (get-contained-edges parent))))
    (%cu-translate edge xoffset yoffset)))

(defmethod %cu-translate ((edge elk-edge) xoffset yoffset)
  (jdo (s (get-sections edge)) (%cu-translate s xoffset yoffset))
  (jdo (label (get-labels edge))
    (set-location label (+ (get-x label) xoffset) (+ (get-y label) yoffset)))
  (let ((junction-points (get-property edge core-options.junction-points)))
    (when junction-points (offset junction-points xoffset yoffset))))

(defmethod %cu-translate ((section elk-edge-section) xoffset yoffset)
  (set-start-location section (+ (get-start-x section) xoffset) (+ (get-start-y section) yoffset))
  (jdo (bend-point (get-bend-points section))
    (j-set bend-point (+ (get-x bend-point) xoffset) (+ (get-y bend-point) yoffset)))
  (set-end-location section (+ (get-end-x section) xoffset) (+ (get-end-y section) yoffset)))

(defjstatic elk-util.translate (thing xoffset-or-new-size yoffset-or-old-size)
  (if (typep xoffset-or-new-size 'k-vector)
      (%cu-translate-aligned thing xoffset-or-new-size yoffset-or-old-size)
      (%cu-translate thing xoffset-or-new-size yoffset-or-old-size))
  nil)

(defun %cu-translate-aligned (parent new-size old-size)
  (let ((content-alignment (get-property parent core-options.content-alignment))
        (x-translate 0.0) (y-translate 0.0))
    (when (> (.x new-size) (.x old-size))
      (cond ((contains content-alignment content-alignment.h-center)
             (setf x-translate (/ (- (.x new-size) (.x old-size)) 2.0)))
            ((contains content-alignment content-alignment.h-right)
             (setf x-translate (- (.x new-size) (.x old-size))))))
    (when (> (.y new-size) (.y old-size))
      (cond ((contains content-alignment content-alignment.v-center)
             (setf y-translate (/ (- (.y new-size) (.y old-size)) 2.0)))
            ((contains content-alignment content-alignment.v-bottom)
             (setf y-translate (- (.y new-size) (.y old-size))))))
    (%cu-translate parent x-translate y-translate)))

;;; ------------------------------------------------------------ coordinate-system and type "conversion"

(defjstatic elk-util.absolute-position (element)
  (typecase element
    (elk-node (elk-util.to-absolute (new-k-vector (get-x element) (get-y element)) (get-parent element)))
    (elk-port (elk-util.to-absolute (new-k-vector (get-x element) (get-y element)) (get-parent element)))
    (elk-edge (elk-util.absolute-position (get-containing-node element)))
    (elk-label (let ((p (elk-util.absolute-position (get-parent element))))
                 (new-k-vector (+ (.x p) (get-x element)) (+ (.y p) (get-y element)))))
    (t nil)))

(defjstatic elk-util.to-absolute (point parent)
  (loop for node = parent then (get-parent node)
        while node do (add point (get-x node) (get-y node)))
  point)

(defjstatic elk-util.to-relative (point parent)
  (loop for node = parent then (get-parent node)
        while node do (add point (- (get-x node)) (- (get-y node))))
  point)

(defun %cu-get-points (section)
  (let ((points (new-jlist)))
    (jl-add points (new-k-vector (get-start-x section) (get-start-y section)))
    (jdo (bp (get-bend-points section)) (jl-add points (new-k-vector (get-x bp) (get-y bp))))
    (jl-add points (new-k-vector (get-end-x section) (get-end-y section)))
    (let ((i 1))
      (loop while (< i (1- (length points)))
            do (let ((p1 (aref points (1- i))) (p2 (aref points i)) (p3 (aref points (1+ i))))
                 (if (or (and (= (.x p1) (.x p2)) (= (.x p2) (.x p3)))
                         (and (= (.y p1) (.y p2)) (= (.y p2) (.y p3))))
                     (jl-remove-at points i)
                     (incf i)))))
    points))

(defjstatic elk-util.get-points (section) (%cu-get-points section))

(defjstatic elk-util.create-vector-chain (edge-section)
  (let ((chain (new-k-vector-chain)))
    (add chain (new-k-vector (get-start-x edge-section) (get-start-y edge-section)))
    (jdo (bp (get-bend-points edge-section)) (add chain (new-k-vector (get-x bp) (get-y bp))))
    (add chain (new-k-vector (get-end-x edge-section) (get-end-y edge-section)))
    chain))

(defjstatic elk-util.apply-vector-chain (vector-chain section)
  (when (< (size vector-chain) 2)
    (jthrow 'illegal-argument-exception "The vector chain must contain at least a source and a target point."))
  (let ((first-point (get-first vector-chain))
        (points (to-jvector vector-chain))
        (bend-points (get-bend-points section))
        (old-index 0))
    (set-start-location section (.x first-point) (.y first-point))
    ;; reuse as many existing bend points as possible
    (loop for k from 1 below (1- (length points))
          do (let ((next-point (aref points k))
                   (bendpoint nil))
               (if (< old-index (jsize bend-points))
                   (setf bendpoint (j-get bend-points old-index))
                   (setf bendpoint (elk-graph-util.create-bend-point section)))
               (incf old-index)
               (j-set bendpoint (.x next-point) (.y next-point))))
    ;; remove existing bend points that we did not use
    (loop while (> (jsize bend-points) old-index)
          do (jl-remove-at bend-points old-index))
    (let ((last-point (get-last vector-chain)))
      (set-end-location section (.x last-point) (.y last-point)))
    nil))

;;; ------------------------------------------------------------ default layout settings

(defjstatic elk-util.configure-defaults-recursively (graph)
  (%cu-walk-graph (lambda (kge)
                    (when (typep kge '(or elk-node elk-port elk-edge))
                      (elk-util.configure-with-default-values kge)))
                  graph nil)
  nil)

(defjstatic elk-util.configure-with-default-values (element)
  (etypecase element
    (elk-node
     (let ((sc (get-property element core-options.node-size-constraints)))
       (when (and (jequals sc (size-constraint.fixed))
                  (= (get-width element) 0) (= (get-height element) 0))
         (set-width element (* elk-util.default-min-width 2 2))
         (set-height element (* elk-util.default-min-height 2 2))))
     (elk-util.ensure-label element)
     (let ((nlp (get-property element core-options.node-labels-placement)))
       (when (jequals nlp (node-label-placement.fixed))
         (set-property element core-options.node-labels-placement (node-label-placement.inside-center)))))
    (elk-port
     (when (and (= (get-width element) 0) (= (get-height element) 0))
       (set-width element (/ elk-util.default-min-width 2 2))
       (set-height element (/ elk-util.default-min-height 2 2)))
     (elk-util.ensure-label element))
    (elk-edge
     (unless (has-property element core-options.edge-labels-placement)
       (set-property element core-options.edge-labels-placement edge-label-placement.center))))
  nil)

(defjstatic elk-util.ensure-label (klge)
  (when (is-empty (get-labels klge))
    (unless (%cu-null-or-empty (get-identifier klge))
      (let ((label (elk-graph-util.create-label klge)))
        (set-text label (get-identifier klge))))))

;;; ------------------------------------------------------------ visitors

(defjgeneric visit 1)
(defmethod visit/1 ((f function) element) (funcall f element))

(defjstatic elk-util.apply-visitors (graph visitors)
  "VISITORS is the varargs array: a list or vector of visitors."
  (let ((vs (%cu-visitor-list visitors)))
    (%cu-walk-graph (lambda (element)
                      (loop for v across vs do (visit v element)))
                    graph t))
  nil)

(defjgeneric get-issues 0)

(defjstatic elk-util.apply-visitors-with-validation (graph visitors)
  (elk-util.apply-visitors graph visitors)
  (let ((all-issues nil))
    (jdo (v (%cu-visitor-list visitors))
      (when (typep v 'i-validating-graph-element-visitor)
        (let ((issues (get-issues v)))
          (unless (zerop (jsize issues))
            (if (null all-issues)
                (setf all-issues (jlist-from issues))
                (jl-add-all all-issues issues))))))
    (when (and all-issues
               (some (lambda (issue) (eq (get-severity issue) severity.error)) all-issues))
      (let ((message (new-string-builder)))
        (jdo (issue all-issues)
          (when (> (length message) 0) (%cu-append message (string #\Newline)))
          (%cu-append message (get-severity issue) ": " (get-message issue)
                      (string #\Newline) (string #\Tab) "at ")
          (elk-util.print-element-path (get-element issue) message))
        (error 'graph-validation-exception :message (coerce message 'simple-string)
                                           :issues all-issues))))
  nil)

(defun %cu-visitor-list (visitors)
  "Varargs IGraphElementVisitor...: a list/vector of visitors, or a single one."
  (if (or (functionp visitors) (typep visitors 'i-graph-element-visitor))
      (vector visitors)
      (to-jvector visitors)))

;;; ------------------------------------------------------------ debugging

(defjstatic elk-util.print-element-path (element builder)
  "BUILDER is a StringBuilder: a string with a fill pointer (see NEW-STRING-BUILDER)."
  (let ((container (%cu-container element)))
    (if (typep container 'elk-graph-element)
        (progn (elk-util.print-element-path container builder)
               (%cu-append builder " > "))
        (%cu-append builder "Root ")))
  (let ((class-name (%cu-elk-class-name element)))
    (%cu-append builder (if (and (>= (length class-name) 3) (string= "Elk" class-name :end2 3))
                            (subseq class-name 3)
                            class-name)))
  (let ((identifier (get-identifier element)))
    (unless (%cu-null-or-empty identifier)
      (%cu-append builder " " identifier)
      (return-from elk-util.print-element-path/2 nil)))
  (when (typep element 'elk-label)
    (let ((text (get-text element)))
      (unless (%cu-null-or-empty text)
        (%cu-append builder " " text)
        (return-from elk-util.print-element-path/2 nil))))
  (jdo (label (get-labels element))
    (let ((text (get-text label)))
      (unless (%cu-null-or-empty text)
        (%cu-append builder " " text)
        (return-from elk-util.print-element-path/2 nil))))
  (when (and (typep element 'elk-edge) (is-connected element))
    (%cu-append builder " (")
    (let ((i 0))
      (jdo (s (get-sources element))
        (when (> i 0) (%cu-append builder ", "))
        (elk-util.print-element-path s builder)
        (incf i)))
    (%cu-append builder " -> ")
    (let ((i 0))
      (jdo (s (get-targets element))
        (when (> i 0) (%cu-append builder ", "))
        (elk-util.print-element-path s builder)
        (incf i)))
    (%cu-append builder ")"))
  nil)

(defjstatic elk-util.debug-folder-path (subfolders)
  (let ((home (namestring (user-homedir-pathname))))
    (with-output-to-string (s)
      (write-string home s)
      (unless (and (> (length home) 0) (char= (char home (1- (length home))) #\/))
        (write-char #\/ s))
      (write-string "elk/" s)
      (jdo (f subfolders) (write-string f s) (write-char #\/ s)))))

(defjstatic elk-util.to-safe-path-name (name)
  (map 'string (lambda (c)
                 (cond ((member c '(#\Space #\Tab #\Newline #\Return #\Page #.(code-char 11))) #\_)
                       ((or (char<= #\a c #\z) (char<= #\A c #\Z) (char<= #\0 c #\9) (char= c #\_)) c)
                       (t #\-)))
       name))

;;; ------------------------------------------------------------ miscellaneous

(defvar *cu-identifier-counter* 0)

(defjstatic elk-util.create-identifier (element)
  ;; Java uses the identity hash code; any unique integer will do.
  (set-identifier element (princ-to-string (incf *cu-identifier-counter*))))

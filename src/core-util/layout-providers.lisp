;;;; layout-providers.lisp -- org.eclipse.elk.core.util.FixedLayoutProvider and
;;;; org.eclipse.elk.core.util.RandomLayoutProvider.  BoxLayoutProvider is in
;;;; box-layout-provider.lisp.

(in-package #:elk)

;;; ------------------------------------------------------------ helpers shared by the providers

(defun %cu-e-list-remove-at (elist index)
  "List.remove(int) on an EMF-style EList (the graph module's E-LIST has no index removal)."
  (j-remove/1 elist (j-get/1 elist index)))

;;; ------------------------------------------------------------ FixedLayoutProvider

(defjmethod layout ((this fixed-layout-provider) layout-node progress-monitor)
  (begin progress-monitor "Fixed Layout" 1)
  (let ((edge-routing (get-property layout-node core-options.edge-routing))
        (maxx 0.0d0)
        (maxy 0.0d0))
    (jdo (nd (get-children layout-node))
      (let ((pos (get-property nd fixed-layouter-options.position)))
        (when pos
          (set-location nd (.x pos) (.y pos))
          (when (contains (get-property nd fixed-layouter-options.node-size-constraints)
                          size-constraint.minimum-size)
            (let ((min-size (get-property nd fixed-layouter-options.node-size-minimum)))
              (when (and (> (.x min-size) 0) (> (.y min-size) 0))
                (elk-util.resize-node nd (.x min-size) (.y min-size) t t))))))
      (setf maxx (math.max maxx (+ (get-x nd) (get-width nd)))
            maxy (math.max maxy (+ (get-y nd) (get-height nd))))
      (jdo (label (get-labels nd))
        (let ((pos (get-property label fixed-layouter-options.position)))
          (when pos
            (set-location label (.x pos) (.y pos))))
        (setf maxx (math.max maxx (+ (get-x nd) (get-x label) (get-width label)))
              maxy (math.max maxy (+ (get-y nd) (get-y label) (get-height label)))))
      (jdo (port (get-ports nd))
        (let ((pos (get-property port fixed-layouter-options.position)))
          (when pos
            (set-location port (.x pos) (.y pos))))
        (let ((portx (+ (get-x nd) (get-x port)))
              (porty (+ (get-y nd) (get-y port))))
          (setf maxx (math.max maxx (+ portx (get-width port)))
                maxy (math.max maxy (+ porty (get-height port))))
          (jdo (label (get-labels port))
            (let ((pos (get-property label fixed-layouter-options.position)))
              (when pos
                (set-location label (.x pos) (.y pos))))
            (setf maxx (math.max maxx (+ portx (get-x label) (get-width label)))
                  maxy (math.max maxy (+ porty (get-y label) (get-height label)))))))
      (jdo (edge (elk-graph-util.all-outgoing-edges nd))
        (let ((maxv (process-edge this edge edge-routing)))
          (setf maxx (math.max maxx (.x maxv))
                maxy (math.max maxy (.y maxv)))))
      (jdo (edge (elk-graph-util.all-incoming-edges nd))
        (when (not (eq (get-parent (elk-graph-util.get-source-node edge)) layout-node))
          (let ((maxv (process-edge this edge edge-routing)))
            (setf maxx (math.max maxx (.x maxv))
                  maxy (math.max maxy (.y maxv)))))))
    (when (eq edge-routing edge-routing.orthogonal)
      (jdo (nd (get-children layout-node))
        (jdo (edge (elk-graph-util.all-outgoing-edges nd))
          (generate-junction-points this edge))))
    (unless (get-property layout-node fixed-layouter-options.node-size-fixed-graph-size)
      (let* ((padding (get-property layout-node fixed-layouter-options.padding))
             (new-width (+ maxx (get-left padding) (get-right padding)))
             (new-height (+ maxy (get-top padding) (get-bottom padding))))
        (elk-util.resize-node layout-node new-width new-height t t)))
    (done progress-monitor)
    nil))

(defjmethod process-edge ((this fixed-layout-provider) edge edge-routing)
  (declare (ignorable edge-routing))
  (let* ((source-parent (get-parent (elk-graph-util.connectable-shape-to-node (j-get (get-sources edge) 0))))
         (target-parent (get-parent (elk-graph-util.connectable-shape-to-node (j-get (get-targets edge) 0))))
         (same-hierarchy (eq source-parent target-parent))
         (maxv (new-k-vector))
         (bend-points (get-property edge fixed-layouter-options.bend-points)))
    (when (and bend-points (>= (jsize bend-points) 2))
      (cond ((is-empty (get-sections edge))
             (elk-graph-util.create-edge-section edge))
            ((> (jsize (get-sections edge)) 1)
             (loop while (> (jsize (get-sections edge)) 0)
                   do (%cu-e-list-remove-at (get-sections edge) 0))))
      (elk-util.apply-vector-chain bend-points (j-get (get-sections edge) 0)))
    (when same-hierarchy
      (jdo (edge-section (get-sections edge))
        (jdo (point (get-bend-points edge-section))
          (setf (.x maxv) (math.max (.x maxv) (get-x point))
                (.y maxv) (math.max (.y maxv) (get-y point))))))
    (jdo (label (get-labels edge))
      (let ((pos (get-property label fixed-layouter-options.position)))
        (when pos
          (set-location label (.x pos) (.y pos))))
      (when same-hierarchy
        (setf (.x maxv) (math.max (.x maxv) (+ (get-x label) (get-width label)))
              (.y maxv) (math.max (.y maxv) (+ (get-y label) (get-height label))))))
    maxv))

(defjmethod generate-junction-points ((this fixed-layout-provider) edge)
  (let ((junction-points (elk-util.determine-junction-points edge)))
    (if (is-empty junction-points)
        (set-property edge core-options.junction-points nil)
        (set-property edge core-options.junction-points junction-points))
    nil))

;;; ------------------------------------------------------------ RandomLayoutProvider

(defconstant %rlp-max-bends 5)
(defparameter %rlp-rand-fact 0.2d0)

(defjmethod layout ((this random-layout-provider) parent-node progress-monitor)
  (begin progress-monitor "Random Layout" 1)
  (when (is-empty (get-children parent-node))
    (done progress-monitor)
    (return-from layout nil))
  (let* ((random-seed (get-property parent-node random-layouter-options.random-seed))
         (random (if (and random-seed (/= random-seed 0))
                     (new-random random-seed)
                     (new-random)))
         (aspect-ratio (%cu-float (get-property parent-node random-layouter-options.aspect-ratio)))
         (spacing (%cu-float (get-property parent-node random-layouter-options.spacing-node-node)))
         (padding (get-property parent-node random-layouter-options.padding)))
    (randomize this parent-node random aspect-ratio spacing padding)
    (done progress-monitor)
    nil))

(defjmethod randomize ((this random-layout-provider) parent random aspect-ratio spacing padding)
  (let ((nodes-area 0.0d0) (max-width 0.0d0) (max-height 0.0d0) (m 1))
    (jdo (nd (get-children parent))
      (incf m (jsize (elk-graph-util.all-outgoing-edges nd)))
      (let ((width (get-width nd)))
        (setf max-width (math.max max-width width)))
      (let ((height (get-height nd)))
        (setf max-height (math.max max-height height)))
      (incf nodes-area (* (get-width nd) (get-height nd))))
    (let* ((n (jsize (get-children parent)))
           (draw-area (+ nodes-area (* 2 spacing spacing m n)))
           (area-sqrt (math.sqrt draw-area))
           (draw-width (math.max (* area-sqrt aspect-ratio) max-width))
           (draw-height (math.max (/ area-sqrt aspect-ratio) max-height)))
      (jdo (nd (get-children parent))
        (let ((x (+ (get-left padding) (* (random-next-double random) (- draw-width (get-width nd)))))
              (y (+ (get-left padding) (* (random-next-double random) (- draw-height (get-height nd))))))
          (set-location nd x y)))
      (let ((total-width (+ draw-width (get-horizontal padding)))
            (total-height (+ draw-height (get-vertical padding))))
        (jdo (source (get-children parent))
          (jdo (edge (elk-graph-util.all-outgoing-edges source))
            (unless (is-hierarchical edge)
              (randomize this edge random total-width total-height))))
        (incf total-width (+ (get-left padding) (get-right padding)))
        (incf total-height (+ (get-top padding) (get-bottom padding)))
        (elk-util.resize-node parent total-width total-height nil t))))
  nil)

(defjmethod randomize ((this random-layout-provider) edge random draw-width draw-height)
  (let* ((source-shape (j-get (get-sources edge) 0))
         (source-x (get-x source-shape))
         (source-y (get-y source-shape))
         (source-width (/ (get-width source-shape) 2))
         (source-height (/ (get-height source-shape) 2)))
    (when (typep source-shape 'elk-port)
      (incf source-x (get-x (get-parent source-shape)))
      (incf source-x (get-x (get-parent source-shape))))
    (incf source-x source-width)
    (incf source-y source-height)
    ;; The Java source reads getSources() for the target as well; kept as is.
    (let* ((target-shape (j-get (get-sources edge) 0))
           (target-x (get-x target-shape))
           (target-y (get-y target-shape))
           (target-width (/ (get-width target-shape) 2))
           (target-height (/ (get-height target-shape) 2)))
      (when (typep target-shape 'elk-port)
        (incf target-x (get-x (get-parent target-shape)))
        (incf target-x (get-x (get-parent target-shape))))
      (incf target-x target-width)
      (incf target-y target-height)
      (if (is-empty (get-sections edge))
          (elk-graph-util.create-edge-section edge)
          (when (> (jsize (get-sections edge)) 1)
            (loop while (> (jsize (get-sections edge)) 0)
                  do (%cu-e-list-remove-at (get-sections edge) 0))))
      (let* ((edge-section (j-get (get-sections edge) 0))
             (source-px target-x)
             (source-py target-y)
             (target-px source-x)
             (target-py source-y))
        (cond ((> target-x (+ source-x source-width)) (setf source-px (+ source-x source-width)))
              ((< target-x (- source-x source-width)) (setf source-px (- source-x source-width))))
        (cond ((> target-y (+ source-y source-height)) (setf source-py (+ source-y source-height)))
              ((< target-y (- source-y source-height)) (setf source-py (- source-y source-height))))
        (when (and (> source-px (- source-x source-width)) (< source-px (+ source-x source-width))
                   (> source-py (- source-y source-height)) (< source-py (+ source-y source-height)))
          (setf source-px (+ source-x source-width)))
        (set-start-location edge-section source-px source-py)
        (cond ((> source-x (+ target-x target-width)) (setf target-px (+ target-x target-width)))
              ((< source-x (- target-x target-width)) (setf target-px (- target-x target-width))))
        (cond ((> source-y (+ target-y target-height)) (setf target-py (+ target-y target-height)))
              ((< source-y (- target-y target-height)) (setf target-py (- target-y target-height))))
        (when (and (> target-px (- target-x target-width)) (< target-px (+ target-x target-width))
                   (> target-py (- target-y target-height)) (< target-py (+ target-y target-height)))
          (setf target-py (+ target-y target-height)))
        (set-end-location edge-section target-px target-py)
        (j-clear-bend-points edge-section)
        (let* ((bends-num (random-next-int random %rlp-max-bends))
               (xdiff 0.0d0) (ydiff 0.0d0))
          (when (eq source-shape target-shape)
            (incf bends-num))
          (setf xdiff (- target-px source-px)
                ydiff (- target-py source-py))
          (let* ((total-dist (math.sqrt (+ (* xdiff xdiff) (* ydiff ydiff))))
                 (max-rand (* total-dist %rlp-rand-fact))
                 (xincr (/ xdiff (1+ bends-num)))
                 (yincr (/ ydiff (1+ bends-num)))
                 (x source-px)
                 (y source-py))
            (dotimes (i bends-num)
              (declare (ignorable i))
              (incf x xincr)
              (incf y yincr)
              (let ((randx (- (+ x (* (random-next-float random) max-rand)) (/ max-rand 2))))
                (cond ((< randx 0) (setf randx 1d0))
                      ((> randx draw-width) (setf randx (- draw-width 1))))
                (let ((randy (- (+ y (* (random-next-float random) max-rand)) (/ max-rand 2))))
                  (cond ((< randy 0) (setf randy 1d0))
                        ((> randy draw-height) (setf randy (- draw-height 1))))
                  (let ((bend-point (elk-graph-factory-create-bend-point)))
                    (j-set bend-point randx randy)
                    (jl-add (get-bend-points edge-section) bend-point))))))))))
  nil)

(defun j-clear-bend-points (edge-section)
  "edgeSection.getBendPoints().clear()"
  (clear/0 (get-bend-points edge-section)))

(defun elk-graph-factory-create-bend-point ()
  "ElkGraphFactory.eINSTANCE.createElkBendPoint(): a bend point not yet in any section."
  (create-elk-bend-point/0 elk-graph-factory.e-instance))

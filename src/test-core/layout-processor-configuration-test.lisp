;;;; layout-processor-configuration-test.lisp -- port of
;;;; org.eclipse.elk.core.alg.LayoutProcessorConfigurationTest.

(in-package #:elk)

(defcore-class layout-processor-configuration-test
  ((:ignore "testClear")
   (let ((config (layout-processor-configuration.create)))
     (add (before config test-phases.phase-1) test-processors.processor-1)
     (assert-equals 0 (size (processors-before config test-phases.phase-1)))
     (assert-equals 0 (size (processors-after config test-phases.phase-1)))
     (assert-equals 0 (size (processors-before config test-phases.phase-2)))
     (assert-equals 0 (size (processors-after config test-phases.phase-2)))))
  ("testBefore"
   (let ((config (layout-processor-configuration.create)))
     (add (add (before (add (before config test-phases.phase-1) test-processors.processor-1)
                       test-phases.phase-2)
               test-processors.processor-2)
          test-processors.processor-3)
     (assert-equals 1 (size (processors-before config test-phases.phase-1)))
     (assert-equals 2 (size (processors-after config test-phases.phase-1)))
     (assert-equals 2 (size (processors-before config test-phases.phase-2)))
     (assert-equals 0 (size (processors-after config test-phases.phase-2)))))
  ("testAfter"
   (let ((config (layout-processor-configuration.create)))
     (add (add (after (add (after config test-phases.phase-1) test-processors.processor-1)
                      test-phases.phase-2)
               test-processors.processor-2)
          test-processors.processor-3)
     (assert-equals 0 (size (processors-before config test-phases.phase-1)))
     (assert-equals 1 (size (processors-after config test-phases.phase-1)))
     (assert-equals 1 (size (processors-before config test-phases.phase-2)))
     (assert-equals 2 (size (processors-after config test-phases.phase-2)))))
  ("testAddBefore1"
   (let ((config (layout-processor-configuration.create)))
     (before config test-phases.phase-1)
     (add-before config test-phases.phase-2 test-processors.processor-1)
     (assert-equals 0 (size (processors-before config test-phases.phase-1)))
     (assert-equals 1 (size (processors-after config test-phases.phase-1)))
     (assert-equals 1 (size (processors-before config test-phases.phase-2)))
     (assert-equals 0 (size (processors-after config test-phases.phase-2)))))
  ("testAddBefore2"
   (let ((config (layout-processor-configuration.create)))
     (before config test-phases.phase-1)
     (add-before config test-phases.phase-2 test-processors.processor-1)
     (assert-throws error (add config test-processors.processor-2))))
  ("testAddAfter1"
   (let ((config (layout-processor-configuration.create)))
     (before config test-phases.phase-1)
     (add-after config test-phases.phase-1 test-processors.processor-1)
     (assert-equals 0 (size (processors-before config test-phases.phase-1)))
     (assert-equals 1 (size (processors-after config test-phases.phase-1)))
     (assert-equals 1 (size (processors-before config test-phases.phase-2)))
     (assert-equals 0 (size (processors-after config test-phases.phase-2)))))
  ("testAddAfter2"
   (let ((config (layout-processor-configuration.create)))
     (before config test-phases.phase-1)
     (add-after config test-phases.phase-1 test-processors.processor-1)
     (assert-throws error (add config test-processors.processor-2))))
  ("testAddAll"
   (let ((config (layout-processor-configuration.create)))
     (add (add (after (add (after config test-phases.phase-1) test-processors.processor-1)
                      test-phases.phase-2)
               test-processors.processor-2)
          test-processors.processor-3)
     (let ((config2 (layout-processor-configuration.create)))
       (add-all config2 config)
       (assert-equals 0 (size (processors-before config2 test-phases.phase-1)))
       (assert-equals 1 (size (processors-after config2 test-phases.phase-1)))
       (assert-equals 1 (size (processors-before config2 test-phases.phase-2)))
       (assert-equals 2 (size (processors-after config2 test-phases.phase-2)))))))

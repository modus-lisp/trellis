;;;; radial/optimization.lisp -- org.eclipse.elk.alg.radial.intermediate.optimization

(in-package #:elk)

;;; ---------------------------------------------------------------- CrossingMinimizationPosition

(defjmethod evaluate ((this crossing-minimization-position) root-node)
  (setf (.root this) root-node)
  (let ((crossings 0)
        (nodes (radial-util.get-successors root-node))
        (k 0))
    (jdo (node1 nodes)
      (incf k)
      (loop for i from k below (size nodes)
            do (when (%crossing-minimization-crossing-p this node1 (j-get nodes i))
                 (incf crossings 1))))
    crossings))

(defun %crossing-minimization-crossing-p (this node1 node2)
  (let* ((root (.root this))
         ;; the Java source reads getX() for the y coordinate here; ported as written
         (root-x (+ (get-x root) (/ (get-width root) 2)))
         (root-y (+ (get-x root) (/ (get-width root) 2)))
         ;; node1
         (x-pos1 (+ (get-x node1) (/ (get-width node1) 2)))
         (y-pos1 (+ (get-y node1) (/ (get-height node1) 2)))
         (node1-vector (new-k-vector x-pos1 y-pos1))
         (position1 (get-property node1 core-options.position))
         (m1 0d0)
         (b1 0d0))
    (setf (.x position1) (+ (.x position1) root-x)
          (.y position1) (+ (.y position1) root-y))
    (setf m1 (/ (- (.y node1-vector) (.y position1)) (- (.x node1-vector) (.x position1))))
    (setf b1 (- (.y node1-vector) (* m1 (.x node1-vector))))
    ;; node2
    (let* ((x-pos2 (+ (get-x node2) (/ (get-width node2) 2)))
           (y-pos2 (+ (get-y node2) (/ (get-height node2) 2)))
           (node2-vector (new-k-vector x-pos2 y-pos2))
           (position2 (get-property node2 core-options.position)))
      (setf (.x position2) (+ (.x position2) root-x)
            (.y position2) (+ (.y position2) root-y))
      (let* ((m2 (/ (- (.y node2-vector) (.y position2)) (- (.x node2-vector) (.x position2))))
             (b2 (- (.y node2-vector) (* m2 (.x node2-vector))))
             (x-cut (/ (- b1 b2) (- m2 m1))))
        ;; check whether the cut occurs on the relevant line segment
        (cond ((or (and (< (.x position1) x-cut) (< (.x node1-vector) x-cut))
                   (and (< x-cut (.x position1)) (< x-cut (.x node1-vector))))
               nil)
              ((or (and (< (.x position2) x-cut) (< (.x node2-vector) x-cut))
                   (and (< x-cut (.x position2)) (< x-cut (.x node2-vector))))
               nil)
              (t t))))))

;;; ---------------------------------------------------------------- EdgeLengthOptimization

(defjmethod evaluate ((this edge-length-optimization) root)
  (let ((edge-length 0d0))
    (jdo (edge (elk-graph-util.all-outgoing-edges root))
      (let* ((target (elk-graph-util.connectable-shape-to-node (j-get (get-targets edge) 0)))
             (target-x (+ (get-x target) (/ (get-width target) 2)))
             (target-y (+ (get-y target) (/ (get-height target) 2)))
             (root-x (+ (get-x root) (/ (get-width root) 2)))
             (root-y (+ (get-y root) (/ (get-height root) 2)))
             ;; Clipping
             (vector (new-k-vector)))
        (setf (.x vector) (- target-x root-x)
              (.y vector) (- target-y root-y))
        (let ((source-clip (new-k-vector (.x vector) (.y vector))))
          (elk-math.clip-vector source-clip (get-width root) (get-height root))
          (decf (.x vector) (.x source-clip))
          (decf (.y vector) (.y source-clip)))
        (setf root-x (- target-x (.x vector))
              root-y (- target-y (.y vector)))
        (let ((target-clip (new-k-vector (.x vector) (.y vector))))
          (elk-math.clip-vector target-clip (get-width target) (get-height target))
          (decf (.x vector) (.x target-clip))
          (decf (.y vector) (.y target-clip)))
        (setf target-x (+ root-x (.x vector))
              target-y (+ root-y (.y vector)))
        (let* ((vector-x (- target-x root-x))
               (vector-y (- target-y root-y)))
          (incf edge-length (math.sqrt (+ (* vector-x vector-x) (* vector-y vector-y)))))))
    edge-length))

;;; ---------------------------------------------------------------- EdgeLengthPositionOptimization

(defjmethod evaluate ((this edge-length-position-optimization) root)
  (let ((edge-length 0d0))
    (jdo (edge (elk-graph-util.all-outgoing-edges root))
      (let* ((target (elk-graph-util.connectable-shape-to-node (j-get (get-targets edge) 0)))
             (target-x (+ (get-x target) (/ (get-width target) 2)))
             (target-y (+ (get-y target) (/ (get-height target) 2)))
             (position (get-property target core-options.position))
             (root-x (+ (get-x root) (.x position) (/ (get-width root) 2)))
             (root-y (+ (get-y root) (.y position) (get-height root)))
             (vector-x (- target-x root-x))
             (vector-y (- target-y root-y)))
        (incf edge-length (math.sqrt (+ (* vector-x vector-x) (* vector-y vector-y))))))
    edge-length))

;;;; radial/placement.lisp -- org.eclipse.elk.alg.radial.p1position.EadesRadial and
;;;; org.eclipse.elk.alg.radial.p2routing (IRadialEdgeRouter, StraightLineEdgeRouter)

(in-package #:elk)

(defjconst eades-radial.circle-degrees 360)
(defjconst eades-radial.degree-to-rad (/ pi 180))

;;; ---------------------------------------------------------------- EadesRadial

(defjmethod process ((this eades-radial) graph progress-monitor)
  (begin progress-monitor "Eades radial" 1)
  (log-graph progress-monitor graph "After")
  (setf (.root this) (get-property graph radial-internal-properties.root-node))
  (setf (.radius this) (get-property graph radial-options.radius))
  (setf (.sorter this) (create (get-property graph radial-options.sorter)))
  (setf (.annulus-wedge-criteria this) (create (get-property graph radial-options.wedge-criteria)))
  (setf (.optimizer this) (create (get-property graph radial-options.optimization-criteria)))
  (%eades-translate this graph)
  (log-graph progress-monitor graph "After"))

(defun %eades-translate (this graph)
  (declare (ignore graph))
  (let ((optimal-offset 0d0)
        (optimal-value most-positive-double-float))
    (when (.optimizer this)
      (dotimes (i eades-radial.circle-degrees)
        (let* ((offset (* i eades-radial.degree-to-rad)))
          (%eades-position-nodes this (.root this) 0d0 0d0 (* 2 pi) offset)
          (let ((translated-value (evaluate (.optimizer this) (.root this))))
            ;; Take the first occurence of the minimum
            (when (< translated-value optimal-value)
              (setf optimal-offset offset
                    optimal-value translated-value))))))
    (%eades-position-nodes this (.root this) 0d0 0d0 (* 2 pi) optimal-offset)))

(defun %eades-position-nodes (this node current-radius min-alpha max-alpha optimal-offset)
  (let* ((rad-offset optimal-offset)
         (alpha-point (+ (/ (+ min-alpha max-alpha) 2) rad-offset))
         ;; x=r*sin(theta), y=r*cos(theta)
         (x-pos (* current-radius (math.cos alpha-point)))
         (y-pos (* current-radius (math.sin alpha-point))))
    ;; shift the nodes, such that the center of each node is on the circle
    (radial-util.center-nodes-on-radi node x-pos y-pos)
    (let* ((number-of-leafs (calculate-wedge-space (.annulus-wedge-criteria this) node))
           (tau (* 2 (math.acos (+ (/ current-radius current-radius) (.radius this)))))
           (s 0d0)
           (alpha 0d0))
      (if (< tau (- max-alpha min-alpha))
          (setf s (/ tau number-of-leafs)
                alpha (/ (- (+ min-alpha max-alpha) tau) 2))
          (setf s (/ (- max-alpha min-alpha) number-of-leafs)
                alpha min-alpha))
      (let ((successors (radial-util.get-successors node)))
        (when (.sorter this)
          (initialize (.sorter this) (.root this))
          (j-sort (.sorter this) successors))
        (jdo (child successors)
          (let ((number-of-child-leafs (calculate-wedge-space (.annulus-wedge-criteria this) child)))
            (%eades-position-nodes this child (+ current-radius (.radius this)) alpha
                                   (+ alpha (* s number-of-child-leafs)) optimal-offset)
            (incf alpha (* s number-of-child-leafs))))))))

(defjmethod get-layout-processor-configuration ((this eades-radial) graph)
  nil)

;;; ---------------------------------------------------------------- StraightLineEdgeRouter

(defjmethod process ((this straight-line-edge-router) graph progress-monitor)
  (begin progress-monitor "Straight Line Edge Routing" 1)
  (log-graph progress-monitor graph "Before")
  (let ((root (get-property graph radial-internal-properties.root-node)))
    (route-edges this root))
  (log-graph progress-monitor graph "After"))

(defjmethod route-edges ((this straight-line-edge-router) node)
  (jdo (edge (elk-graph-util.all-outgoing-edges node))
    (unless (typep (j-get (get-sources edge) 0) 'elk-port)
      (let ((target (elk-graph-util.connectable-shape-to-node (j-get (get-targets edge) 0))))
        (unless (is-hierarchical edge)
          (let* ((source-x (+ (get-x node) (/ (get-width node) 2)))
                 (source-y (+ (get-y node) (/ (get-height node) 2)))
                 (target-x (+ (get-x target) (/ (get-width target) 2)))
                 (target-y (+ (get-y target) (/ (get-height target) 2))))
            ;; Clipping
            (let ((vector (new-k-vector)))
              (setf (.x vector) (- target-x source-x)
                    (.y vector) (- target-y source-y))
              (let ((source-clip (new-k-vector (.x vector) (.y vector))))
                (elk-math.clip-vector source-clip (get-width node) (get-height node))
                (decf (.x vector) (.x source-clip))
                (decf (.y vector) (.y source-clip)))
              (setf source-x (- target-x (.x vector))
                    source-y (- target-y (.y vector)))
              (let ((target-clip (new-k-vector (.x vector) (.y vector))))
                (elk-math.clip-vector target-clip (get-width target) (get-height target))
                (decf (.x vector) (.x target-clip))
                (decf (.y vector) (.y target-clip)))
              (setf target-x (+ source-x (.x vector))
                    target-y (+ source-y (.y vector))))
            (let ((section (elk-graph-util.first-edge-section edge t t)))
              (set-start-location section source-x source-y)
              (set-end-location section target-x target-y))
            (route-edges this target)))))))

(defjmethod get-layout-processor-configuration ((this straight-line-edge-router) graph)
  nil)

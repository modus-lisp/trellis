;;;; port-label-placement-variants-test.lisp -- port of
;;;; org.eclipse.elk.alg.common.nodespacing.PortLabelPlacementVariantsTest.

(in-package #:elk)

(defun %plpv-configurator-for (ps)
  (let ((config (new-layout-configurator)))
    (set-property (configure config 'elk-port) layered-options.port-side ps)
    config))

(defun %plpv-assert-below-or-right (port)
  (let* ((label (%plpv-label port))
         (port-position
           (cond ((contains port-side.sides-east-west (get-property port core-options.port-side))
                  (get-y label))
                 ((contains port-side.sides-north-south (get-property port core-options.port-side))
                  (get-x label))
                 (t (assert-true nil) 0d0))))
    (assert-true (> port-position 0d0))))

(defun %plpv-assert-above-or-left (port)
  (let* ((label (%plpv-label port))
         (port-position
           (cond ((contains port-side.sides-east-west (get-property port core-options.port-side))
                  (get-y label))
                 ((contains port-side.sides-north-south (get-property port core-options.port-side))
                  (get-x label))
                 (t (assert-true nil) 0d0))))
    (assert-true (< port-position 0d0))))

(defun %plpv-assert-centered (port)
  (let ((label (%plpv-label port)))
    (cond ((contains port-side.sides-east-west (get-property port core-options.port-side))
           (let ((port-center (/ (get-height port) 2d0))
                 (label-center (+ (get-y label) (/ (get-height label) 2d0))))
             (assert-true (= label-center port-center))))
          ((contains port-side.sides-north-south (get-property port core-options.port-side))
           (let ((port-center (/ (get-width port) 2d0))
                 (label-center (+ (get-x label) (/ (get-width label) 2d0))))
             (assert-true (= label-center port-center))))
          (t (assert-true nil)))))

(defun %plpv-label (port)
  (j-get (get-labels port) 0))

(defun %plpv-ports-of-node (parent node-id)
  (let ((node (find-if (lambda (n) (jequals (get-identifier n) node-id))
                       (jlist-from (get-children parent)))))
    (if (null node)
        (new-jlist)
        (jl-sort (jlist-from (get-ports node))
                 (lambda (p1 p2)
                   (if (contains port-side.sides-south-west (get-property p1 core-options.port-side))
                       (- (get-property p1 layered-options.port-index)
                          (get-property p2 layered-options.port-index))
                       (- (get-property p2 layered-options.port-index)
                          (get-property p1 layered-options.port-index))))))))

(deflayouttest port-label-placement-variants-test
  (:algorithm "org.eclipse.elk.layered")
  (:default-configuration :nodes t :ports t)
  (:graph-resources (list (model-resource-path "tests/core/label_placement/port_labels/variants.elkt")))
  (:configurator-provider west-side-ports ()
    (%plpv-configurator-for port-side.west))
  (:configurator-provider east-side-ports ()
    (%plpv-configurator-for port-side.east))
  (:test test-outside-two-default () (graph)
    (let ((ports (%plpv-ports-of-node graph "outside_two_default")))
      (assert-equals "Unexpected test graph" 2 (size ports))
      (%plpv-assert-below-or-right (jl-get ports 0))
      (%plpv-assert-above-or-left (jl-get ports 1))))
  (:test test-outside-two-same-side () (graph)
    (let ((ports (%plpv-ports-of-node graph "outside_two_same_side")))
      (assert-equals "Unexpected test graph" 2 (size ports))
      (%plpv-assert-below-or-right (jl-get ports 0))
      (%plpv-assert-below-or-right (jl-get ports 1))))
  (:test test-outside-two-next-to-port () (graph)
    (let ((ports (%plpv-ports-of-node graph "outside_two_next_to_port")))
      (assert-equals "Unexpected test graph" 2 (size ports))
      (%plpv-assert-centered (jl-get ports 0))
      (%plpv-assert-centered (jl-get ports 1))))
  (:test test-outside-three-default () (graph)
    (let ((ports (%plpv-ports-of-node graph "outside_three_default")))
      (assert-equals "Unexpected test graph" 3 (size ports))
      (%plpv-assert-below-or-right (jl-get ports 0))
      (%plpv-assert-below-or-right (jl-get ports 1))
      (%plpv-assert-below-or-right (jl-get ports 2))))
  (:test test-outside-three-space-efficient () (graph)
    (let ((ports (%plpv-ports-of-node graph "outside_three_space_efficient")))
      (assert-equals "Unexpected test graph" 3 (size ports))
      (%plpv-assert-below-or-right (jl-get ports 0))
      (%plpv-assert-below-or-right (jl-get ports 1))
      (%plpv-assert-above-or-left (jl-get ports 2))))
  (:test test-inside-two-default () (graph)
    (let ((ports (%plpv-ports-of-node graph "inside_two_default")))
      (assert-equals "Unexpected test graph" 2 (size ports))
      (%plpv-assert-centered (jl-get ports 0))
      (%plpv-assert-centered (jl-get ports 1))))
  (:test test-inside-two-default-hierarchical () (graph)
    (let ((ports (%plpv-ports-of-node graph "inside_two_default_hierarchical")))
      (assert-equals "Unexpected test graph" 2 (size ports))
      (%plpv-assert-below-or-right (jl-get ports 0))
      (%plpv-assert-below-or-right (jl-get ports 1))))
  (:test test-inside-two-next-to-port-hierarchical () (graph)
    (let ((ports (%plpv-ports-of-node graph "inside_two_next_to_port_hierarchical")))
      (assert-equals "Unexpected test graph" 2 (size ports))
      (%plpv-assert-centered (jl-get ports 0))
      (%plpv-assert-centered (jl-get ports 1))))
  (:test test-inside-two-with-one-edge () (graph)
    (let ((ports (%plpv-ports-of-node graph "inside_two_with_one_edge")))
      (assert-equals "Unexpected test graph" 2 (size ports))
      (%plpv-assert-below-or-right (jl-get ports 0))
      (%plpv-assert-below-or-right (jl-get ports 1))))
  (:test test-inside-two-with-one-edge-next-to-port () (graph)
    (let* ((ports (%plpv-ports-of-node graph "inside_two_with_one_edge_next_to_port"))
           (port-with-edge (if (is-empty (get-outgoing-edges (jl-get ports 0)))
                               (jl-get ports 1) (jl-get ports 0)))
           (the-other (if (is-empty (get-outgoing-edges (jl-get ports 0)))
                          (jl-get ports 0) (jl-get ports 1))))
      (assert-equals "Unexpected test graph" 2 (size ports))
      (%plpv-assert-below-or-right port-with-edge)
      (%plpv-assert-centered the-other)))
  (:test test-inside-three-with-one-edge () (graph)
    (let ((ports (%plpv-ports-of-node graph "inside_three_with_one_edge")))
      (assert-equals "Unexpected test graph" 3 (size ports))
      (%plpv-assert-below-or-right (jl-get ports 0))
      (%plpv-assert-below-or-right (jl-get ports 1))
      (%plpv-assert-below-or-right (jl-get ports 2))))
  (:test test-inside-three-with-one-edge-next-to-port () (graph)
    (let ((ports (%plpv-ports-of-node graph "inside_three_with_one_edge_next_to_port")))
      (assert-equals "Unexpected test graph" 3 (size ports))
      (%plpv-assert-centered (jl-get ports 0))
      (%plpv-assert-below-or-right (jl-get ports 1))
      (%plpv-assert-centered (jl-get ports 2)))))

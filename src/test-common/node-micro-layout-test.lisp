;;;; node-micro-layout-test.lisp -- port of
;;;; org.eclipse.elk.alg.common.nodespacing.NodeMicroLayoutTest.

(in-package #:elk)

(defun %omit-micro-layout-p (graph)
  (and (has-property graph core-options.omit-node-micro-layout)
       (get-property graph core-options.omit-node-micro-layout)))

(defun %nml-get-label (node text)
  (find-if (lambda (label) (jequals (get-text label) text))
           (jlist-from (get-labels node))))

(defun %nml-verify-labels-positioned (node)
  (let ((before-center-threshold 40d0)
        (after-center-threshold 60d0))
    (let ((a (%nml-get-label node "A")))
      (assert-true (> (get-y a) 0d0)))
    (let ((b (%nml-get-label node "B")))
      (assert-true (> (get-x b) after-center-threshold))
      (assert-true (< (get-x b) (get-width node)))
      (assert-true (> (get-y b) after-center-threshold))
      (assert-true (< (get-y b) (get-height node))))
    (let ((c (%nml-get-label node "C")))
      (assert-true (> (get-x c) before-center-threshold))
      (assert-true (< (get-x c) after-center-threshold))
      (assert-true (> (get-y c) (get-height node))))
    (let ((d (%nml-get-label node "D")))
      (assert-true (< (get-x d) 0d0))
      (assert-true (> (get-y d) before-center-threshold))
      (assert-true (< (get-y d) after-center-threshold)))))

(defun %nml-verify-labels-not-positioned (node)
  (jdo (label (get-labels node))
    (assert-true (%close-to-p (get-x label) 0d0 0.01d0))))

(deflayouttest node-micro-layout-test
  (:algorithm "org.eclipse.elk.force")
  (:algorithm "org.eclipse.elk.layered")
  (:algorithm "org.eclipse.elk.mrtree")
  (:algorithm "org.eclipse.elk.radial")
  (:algorithm "org.eclipse.elk.rectpacking")
  (:algorithm "org.eclipse.elk.stress")
  (:default-configuration :nodes t :ports t)
  (:graph-resources (list (model-resource-path "tests/core/label_placement/node_labels/variants.elkt")))
  (:configurator omit-node-micro-layout (graph)
    (unless (jequals (get-property graph core-options.algorithm) layered-options.algorithm-id)
      (set-property graph core-options.omit-node-micro-layout t)))
  (:configurator apply-node-micro-layout (graph)
    (set-property graph core-options.omit-node-micro-layout nil))
  (:test test-minimum-size () (graph)
    (let ((node (j-get (get-children graph) 0)))
      (if (not (%omit-micro-layout-p graph))
          (progn
            (assert-true (%close-to-p (get-width node) 101d0 0.01d0))
            (assert-true (%close-to-p (get-height node) 102d0 0.01d0)))
          (progn
            (assert-true (%close-to-p (get-width node) 100d0 0.01d0))
            (assert-true (%close-to-p (get-height node) 100d0 0.01d0))))))
  (:test test-node-label-positions () (graph)
    (let ((node (j-get (get-children graph) 0)))
      (if (not (%omit-micro-layout-p graph))
          (%nml-verify-labels-positioned node)
          (%nml-verify-labels-not-positioned node)))))

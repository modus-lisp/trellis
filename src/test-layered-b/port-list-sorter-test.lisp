;;;; port-list-sorter-test.lisp -- port of
;;;; org.eclipse.elk.alg.layered.intermediate.PortListSorterTest.

(in-package #:elk)

(deflayouttest port-list-sorter-test
  (:algorithm "org.eclipse.elk.layered")
  (:default-configuration)
  (:graph-resources (list (%b-with-ext (model-resource-path "realworld/ptolemy/**/") "elkg")))
  (:configurator configure-ports (graph)
    (let ((node-queue (new-jlist)))
      (jdo (child (get-children graph)) (jl-add node-queue child))
      (loop until (is-empty node-queue)
            do (let ((node (jl-poll-first node-queue)))
                 (jdo (child (get-children node)) (jl-add node-queue child))
                 (unless (eq (get-property node layered-options.port-constraints)
                             port-constraints.fixed-order)
                   (set-property node layered-options.port-constraints port-constraints.fixed-order)
                   (let ((index 0))
                     (jdo (port (get-ports node))
                       (set-property port layered-options.port-index index)
                       (incf index))))))))
  ;; LongEdgeJoiner
  (:after-processor test-proper-port-side-order
    (:processors (port-list-sorter)) (graph)
    (jdo (layer graph)
      (jdo (node layer)
        (let ((last-side nil))
          (jdo (port (get-ports node))
            (when (not (eq last-side (get-side port)))
              (cond ((null last-side)
                     (assert-true (or (eq (get-side port) port-side.north)
                                      (eq (get-side port) port-side.east)
                                      (eq (get-side port) port-side.south)
                                      (eq (get-side port) port-side.west))))
                    ((eq last-side port-side.north)
                     (assert-true (or (eq (get-side port) port-side.east)
                                      (eq (get-side port) port-side.south)
                                      (eq (get-side port) port-side.west))))
                    ((eq last-side port-side.east)
                     (assert-true (or (eq (get-side port) port-side.south)
                                      (eq (get-side port) port-side.west))))
                    ((eq last-side port-side.south)
                     (assert-true (eq (get-side port) port-side.west)))
                    ((eq last-side port-side.west)
                     (fail nil)))
              (setf last-side (get-side port))))))))
  (:after-processor test-monotonical-coordinates
    (:processors (long-edge-joiner)) (graph)
    (jdo (layer graph)
      (jdo (node layer)
        (let ((last-pos nil) (last-side nil))
          (jdo (port (get-ports node))
            (if (or (null last-side) (not (eq last-side (get-side port))))
                (progn
                  ;; upon side change reset the reference position
                  (cond ((or (eq (get-side port) port-side.north) (eq (get-side port) port-side.south))
                         (setf last-pos (.x (get-position port))))
                        ((or (eq (get-side port) port-side.east) (eq (get-side port) port-side.west))
                         (setf last-pos (.y (get-position port)))))
                  (setf last-side (get-side port)))
                ;; check the positions
                (let ((pos (get-position port)) (side (get-side port)))
                  (cond ((eq side port-side.north) (assert-true (<= last-pos (.x pos))))
                        ((eq side port-side.east) (assert-true (<= last-pos (.y pos))))
                        ((eq side port-side.south) (assert-true (>= last-pos (.x pos))))
                        ((eq side port-side.west) (assert-true (>= last-pos (.y pos)))))))))))))

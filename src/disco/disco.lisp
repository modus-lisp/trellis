;;;; disco/disco.lisp -- org.eclipse.elk.alg.disco (+ graph, structures, transform, options)

(in-package #:elk)

;;; ---------------------------------------------------------------- graph.DCDirection

(defjmethod is-horizontal ((this dc-direction))
  (enum-case this
    ((dc-direction.east dc-direction.west) t)
    (t nil)))

;;; ---------------------------------------------------------------- graph.DCComponent

(defjctor dc-component ()
  (setf (.offset this) (new-k-vector 0.0 0.0)
        (.shapes this) (new-jset)))

(defjmethod set-offset ((this dc-component) offset)
  (setf (.changed this) t
        (.offset this) offset))
(defjmethod get-offset ((this dc-component)) (.offset this))
(defjmethod get-elements ((this dc-component)) (.shapes this))

(defjmethod get-dimensions-of-bounding-rectangle ((this dc-component))
  (when (.changed this) (%dc-component-update this))
  (.bounds this))

(defjmethod get-min-corner ((this dc-component))
  (when (.changed this) (%dc-component-update this))
  (.min-corner-of-bounding-rectangle this))

(defjmethod intersects ((this dc-component) rect)
  (jdo (elem (.shapes this))
    (when (intersects elem rect) (return-from intersects/1 t)))
  nil)

(defjmethod add-element ((this dc-component) element)
  (setf (.changed this) t)
  (js-add (.shapes this) element)
  (set-component element this))

(defjmethod add-elements ((this dc-component) elements)
  (jdo (elem elements) (add-element this elem)))

(defun %dc-component-update (this)
  (setf (.changed this) nil)
  (let ((min-x double.positive-infinity) (max-x double.negative-infinity)
        (min-y double.positive-infinity) (max-y double.negative-infinity))
    (jdo (elem (.shapes this))
      (let ((b (get-bounds elem)))
        (setf min-x (math.min min-x (.x b))
              max-x (math.max max-x (+ (.x b) (.width b)))
              min-y (math.min min-y (.y b))
              max-y (math.max max-y (+ (.y b) (.height b))))
        (jdo (ext (get-extensions elem))
          (if (is-horizontal (get-direction ext))
              (let* ((min-pos (+ (.y b) (.y (get-offset ext))))
                     (max-pos (+ min-pos (get-width ext))))
                (setf min-y (math.min min-y min-pos)
                      max-y (math.max max-y max-pos)))
              (let* ((min-pos (+ (.x b) (.x (get-offset ext))))
                     (max-pos (+ min-pos (get-width ext))))
                (setf min-x (math.min min-x min-pos)
                      max-x (math.max max-x max-pos)))))))
    (setf (.bounds this) (new-k-vector (- max-x min-x) (- max-y min-y))
          (.min-corner-of-bounding-rectangle this)
          (new-k-vector (+ min-x (.x (.offset this))) (+ min-y (.y (.offset this)))))))

(defjmethod get-id ((this dc-component)) (.id this))
(defjmethod set-id ((this dc-component) id) (setf (.id this) id))

;;; ---------------------------------------------------------------- graph.DCExtension

(defjctor dc-extension (parent direction middle-pos width)
  (setf (.parent this) parent
        (.direction this) direction
        (.width this) width)
  (let ((bounds (get-bounds parent)))
    (setf (.offset this) (new-k-vector (- (.x bounds)) (- (.y bounds))))
    (add (.offset this) middle-pos)
    (let ((half-width (/ width 2)))
      (if (is-horizontal direction)
          (sub (.offset this) 0.0 half-width)
          (sub (.offset this) half-width 0.0))))
  (add-extension parent this))

(defjmethod get-parent ((this dc-extension)) (.parent this))
(defjmethod get-direction ((this dc-extension)) (.direction this))
(defjmethod get-offset ((this dc-extension)) (.offset this))
(defjmethod get-width ((this dc-extension)) (.width this))

;;; ---------------------------------------------------------------- graph.DCGraph

(defjctor dc-graph (components)
  (jdo (elements components)
    (let ((component (new-dc-component)))
      (add-elements component elements)
      (js-add (.components this) component))))

(defjctor dc-graph (components inset)
  (this-ctor dc-graph this components)
  (setf (.inset this) inset))

(defjmethod get-components ((this dc-graph)) (.components this))
(defjmethod get-dimensions ((this dc-graph)) (.dimensions this))
(defjmethod set-dimensions ((this dc-graph) dimensions) (setf (.dimensions this) dimensions))
(defjmethod get-inset ((this dc-graph)) (.inset this))

;;; ---------------------------------------------------------------- graph.DCElement

(defjctor dc-element (poly-path)
  (setf (.shape this) poly-path)
  (let ((min-x double.positive-infinity) (min-y double.positive-infinity)
        (max-x double.negative-infinity) (max-y double.negative-infinity))
    (jdo (v poly-path)
      (setf min-x (math.min min-x (.x v))
            min-y (math.min min-y (.y v))
            max-x (math.max max-x (.x v))
            max-y (math.max max-y (.y v))))
    (setf (.bounds this) (new-elk-rectangle min-x min-y (- max-x min-x) (- max-y min-y)))))

(defjmethod get-offset ((this dc-element)) (get-offset (.cp this)))

(defjmethod get-coords ((this dc-element))
  (or (.coords this)
      (let ((coords (make-array (* (size (.shape this)) 2) :initial-element 0.0))
            (i 0))
        (jdo (c (.shape this))
          (setf (aref coords i) (.x c)
                (aref coords (+ i 1)) (.y c))
          (incf i 2))
        (setf (.coords this) coords))))

(defjmethod add-extension ((this dc-element) extension) (jl-add (.extensions this) extension))
(defjmethod get-extensions ((this dc-element)) (.extensions this))
(defjmethod get-bounds ((this dc-element)) (.bounds this))
(defjmethod set-parent-coords ((this dc-element) p) (setf (.parent-coords this) p))
(defjmethod get-parentcoords ((this dc-element)) (.parent-coords this))
(defjmethod set-component ((this dc-element) comp) (setf (.cp this) comp))
(defjmethod intersects ((this dc-element) rect)
  (or (elk-math.intersects rect (.shape this)) (elk-math.contains rect (.shape this))))

;;; ---------------------------------------------------------------- structures.DCPolyomino

(defjctor dc-polyomino (comp cs-x cs-y)
  (super-ctor polyomino this)
  (setf (.cell-size-x this) cs-x
        (.cell-size-y this) cs-y
        (.representee this) comp)
  (let ((dims (get-dimensions-of-bounding-rectangle comp)))
    (setf (.p-width this) (%dc-low-res-dimension (.x dims) cs-x)
          (.p-height this) (%dc-low-res-dimension (.y dims) cs-y)))
  (reinitialize this (.p-width this) (.p-height this))
  (%dc-fill-cells this)
  (jdo (elem (get-elements (.representee this)))
    (when (> (length (get-extensions elem)) 0)
      (%dc-add-extensions-to-poly this elem))))

(defjmethod get-offset ((this dc-polyomino))
  (scale (sub (jclone (get-dimensions-of-bounding-rectangle (.representee this)))
              (* (.p-width this) (.cell-size-x this))
              (* (.p-height this) (.cell-size-y this)))
         -0.5))

(defjmethod get-min-corner-on-canvas ((this dc-polyomino))
  (sub (jclone (get-min-corner (.representee this))) (get-offset this)))
(defjmethod get-cell-size-x ((this dc-polyomino)) (.cell-size-x this))
(defjmethod get-cell-size-y ((this dc-polyomino)) (.cell-size-y this))
(defjmethod get-id ((this dc-polyomino)) (get-id (.representee this)))
(defjmethod set-id ((this dc-polyomino) id) (set-id (.representee this) id))
(defjmethod get-representee ((this dc-polyomino)) (.representee this))

(defun %dc-low-res-dimension (dim cell-size)
  (let* ((cell-fit (/ dim cell-size))
         (fit (to-int cell-fit)))
    (when (> cell-fit fit) (incf fit))
    fit))

(defun %dc-fill-cells (this)
  (let* ((rep (.representee this))
         (corner (get-min-corner rep))
         (off (get-offset this))
         (base-x (- (.x corner) (.x off)))
         (cur-y (- (.y corner) (.y off))))
    (dotimes (y (.p-height this))
      (let ((cur-x base-x))
        (dotimes (x (.p-width this))
          (when (intersects rep (new-elk-rectangle cur-x cur-y (.cell-size-x this) (.cell-size-y this)))
            (set-blocked this x y))
          (incf cur-x (.cell-size-x this))))
      (incf cur-y (.cell-size-y this)))))

(defun %dc-add-extensions-to-poly (this elem)
  (let* ((extensions (get-extensions elem))
         (corner (get-min-corner (.representee this)))
         (off (get-offset this))
         (base-x (- (.x corner) (.x off)))
         (base-y (- (.y corner) (.y off)))
         (elem-pos (get-bounds elem))
         (csx (.cell-size-x this))
         (csy (.cell-size-y this)))
    (setf base-x (- (.x elem-pos) base-x)
          base-y (- (.y elem-pos) base-y))
    (jdo (extension extensions)
      (let* ((pos (get-offset extension))
             (xe (+ base-x (.x pos)))
             (ye (+ base-y (.y pos)))
             (xp (to-int (/ xe csx)))
             (yp (to-int (/ ye csy)))
             (dir (get-direction extension))
             (poly-dir (enum-case dir
                         (dc-direction.north common-direction.north)
                         (dc-direction.east common-direction.east)
                         (dc-direction.south common-direction.south)
                         (t common-direction.west))))
        (if (is-horizontal dir)
            (let ((yp+w (to-int (/ (+ ye (get-width extension)) csy))))
              (add-extension this poly-dir yp yp+w)
              (if (eq dir dc-direction.west)
                  (weakly-block-area this 0 yp xp yp+w)
                  (weakly-block-area this xp yp (- (.p-width this) 1) yp+w)))
            (let ((xp+w (to-int (/ (+ xe (get-width extension)) csx))))
              (add-extension this poly-dir xp xp+w)
              (if (eq dir dc-direction.north)
                  (weakly-block-area this xp 0 xp+w yp)
                  (weakly-block-area this xp yp xp+w (- (.p-height this) 1)))))))))

;;; ---------------------------------------------------------------- DisCoPolyominoCompactor

(defjmethod compact ((this dis-co-polyomino-compactor) graph)
  (setf (.cmp-graph this) graph
        (.polys this) (new-jlist))
  (let ((rec (%dc-compute-cell-size this graph)))
    (setf (.grid-cell-size-x this) rec
          (.grid-cell-size-y this) rec))
  (setf (.fill this) (get-property graph polyomino-options.polyomino-fill)
        (.aspect-ratio this) (get-property graph core-options.aspect-ratio))
  (when (null (.aspect-ratio this))
    (setf (.aspect-ratio this) 1.0))
  (if (> (.aspect-ratio this) 1.0)
      (setf (.grid-cell-size-x this) (* (.grid-cell-size-x this) (.aspect-ratio this)))
      (setf (.grid-cell-size-y this) (/ (.grid-cell-size-y this) (.aspect-ratio this))))
  ;; createPolyominoes
  (jdo (comp (get-components graph))
    (jl-add (.polys this) (new-dc-polyomino comp (.grid-cell-size-x this) (.grid-cell-size-y this))))
  ;; packPolyominoes
  (let ((id 0))
    (jdo (poly (.polys this)) (set-id poly id) (incf id)))
  (let ((holder (new-polyominoes (.polys this) (.aspect-ratio this) (.fill this))))
    (pack-polyominoes (new-polyomino-compactor) holder)
    (setf (.polys this) (get-polyominoes holder)
          (.grid this) (get-grid holder)))
  ;; applyToDCGraph
  (let* ((crop (get-filled-bounds (.grid this)))
         (padding (get-property graph dis-co-options.padding))
         (parent-width (+ (* (get-third crop) (.grid-cell-size-x this)) (get-horizontal padding)))
         (parent-height (+ (* (get-fourth crop) (.grid-cell-size-y this)) (get-vertical padding))))
    (set-dimensions graph (new-k-vector parent-width parent-height))
    (jdo (poly (.polys this))
      (let* ((ax (- (get-x poly) (get-first crop)))
             (ay (- (get-y poly) (get-second crop)))
             (abs-pos (add (scale (new-k-vector (jd ax) (jd ay)) (get-cell-size-x poly) (get-cell-size-y poly))
                           (get-offset poly)))
             (original (get-min-corner (get-representee poly))))
        (set-offset (get-representee poly) (sub abs-pos original)))))
  (set-property graph dis-co-options.debug-disco-polys (.polys this)))

(defun %dc-compute-cell-size (this graph)
  (let* ((sum-term 0.0) (prod-term 0.0)
         (comps (get-components graph))
         (num (size comps))
         (ub (.upper-bound this)))
    (jdo (comp comps)
      (let* ((b (get-dimensions-of-bounding-rectangle comp))
             (w (.x b)) (h (.y b)))
        (incf sum-term (+ w h))
        (incf prod-term (* w h))))
    (let ((numerator (+ (math.sqrt (+ (- (* 4.0 ub num prod-term) (* 4.0 prod-term)) (* sum-term sum-term)))
                        sum-term))
          (denominator (* 2 (- (* ub num) 1.0))))
      (if (= denominator 0.0) numerator (/ numerator denominator)))))

;;; ---------------------------------------------------------------- DisCoLayoutProvider

(defjmethod layout ((this dis-co-layout-provider) layout-graph progress-monitor)
  (begin progress-monitor "Connected Components Compaction" 1)
  (setf (.component-spacing this) (get-property layout-graph dis-co-options.spacing-component-component))
  (when (has-property layout-graph dis-co-options.component-compaction-component-layout-algorithm)
    (let* ((requested (get-property layout-graph dis-co-options.component-compaction-component-layout-algorithm))
           (lad (get-algorithm-data-by-suffix (layout-meta-data-service.get-instance) requested)))
      (when lad
        (layout (fetch (get-instance-pool lad)) layout-graph (sub-task progress-monitor 1)))))
  (let ((transformer (new-disco-elk-graph-transformer (.component-spacing this))))
    (setf (.result this) (import-graph transformer layout-graph))
    (enum-case (get-property layout-graph dis-co-meta-data-provider.component-compaction-strategy)
      (disco-compaction-strategy.polyomino
       (compact (new-dis-co-polyomino-compactor) (.result this))
       (set-property layout-graph dis-co-options.debug-disco-polys
                     (get-property (.result this) dis-co-options.debug-disco-polys)))
      (t nil))
    (apply-layout transformer)
    (set-property layout-graph dis-co-options.debug-disco-graph (.result this)))
  (done progress-monitor))

;;; ---------------------------------------------------------------- transform.ElkGraphComponentsProcessor

(defvar *elk-graph-components-processor-visited* (new-jlist))
(defvar *elk-graph-components-processor-incidence-map* (new-jmap))
(defvar *elk-graph-components-processor-components* (new-jlist))

(defjstatic elk-graph-components-processor.split (graph)
  (setf *elk-graph-components-processor-visited* (new-jlist)
        *elk-graph-components-processor-incidence-map* (new-jmap)
        *elk-graph-components-processor-components* (new-jlist))
  (let ((children (get-children graph)))
    (%dc-compute-incidences children)
    (jdo (node children)
      (unless (jl-contains *elk-graph-components-processor-visited* node)
        (let ((component (new-jlist)))
          (jl-add *elk-graph-components-processor-components* component)
          (%dc-dfs node component))))
    *elk-graph-components-processor-components*))

(defun %dc-same-level-p (edge)
  (eq (get-parent (elk-graph-util.get-source-node edge))
      (get-parent (elk-graph-util.get-target-node edge))))

(defun %dc-compute-incidences (nodes)
  (let ((adjacent-and-inside-parent (new-jmap)))
    (flet ((nodes-at-port (port)
             (or (gethash port adjacent-and-inside-parent)
                 (setf (gethash port adjacent-and-inside-parent) (%dc-inner-neighbors-of-port port)))))
      (jdo (node nodes)
        (let ((adjacent (new-jset)))
          (jm-put *elk-graph-components-processor-incidence-map* node adjacent)
          (let ((same '()) (other '()))
            (jdo (e (elk-graph-util.all-incoming-edges node))
              (if (%dc-same-level-p e) (push e same) (push e other)))
            (dolist (e (nreverse same)) (js-add adjacent (elk-graph-util.get-source-node e)))
            (dolist (e (nreverse other))
              (when (eq (elk-graph-util.get-source-node e) (get-parent (elk-graph-util.get-target-node e)))
                (let ((port (elk-graph-util.get-source-port e)))
                  (when port (js-add-all adjacent (nodes-at-port port)))))))
          (let ((same '()) (other '()))
            (jdo (e (elk-graph-util.all-outgoing-edges node))
              (if (%dc-same-level-p e) (push e same) (push e other)))
            (dolist (e (nreverse same)) (js-add adjacent (elk-graph-util.get-target-node e)))
            (dolist (e (nreverse other))
              (when (eq (elk-graph-util.get-target-node e) (get-parent (elk-graph-util.get-source-node e)))
                (let ((port (elk-graph-util.get-target-port e)))
                  (when port (js-add-all adjacent (nodes-at-port port))))))))))))

(defun %dc-inner-neighbors-of-port (port)
  (let ((port-parent (get-parent port))
        (all-edges (new-jlist))
        (result (new-jset)))
    (jl-add-all all-edges (get-incoming-edges port))
    (jl-add-all all-edges (get-outgoing-edges port))
    (jdo (edge all-edges)
      (when (or (eq port-parent (get-parent (elk-graph-util.get-source-node edge)))
                (eq port-parent (get-parent (elk-graph-util.get-target-node edge))))
        (js-add result (if (eq port-parent (elk-graph-util.get-source-node edge))
                           (elk-graph-util.get-target-node edge)
                           (elk-graph-util.get-source-node edge)))))
    result))

(defun %dc-dfs (start component)
  (jl-add *elk-graph-components-processor-visited* start)
  (jl-add component start)
  (let ((adjacent (jm-get *elk-graph-components-processor-incidence-map* start)))
    (when adjacent
      (jdo (node adjacent)
        (unless (jl-contains *elk-graph-components-processor-visited* node)
          (%dc-dfs node component))))))

;;; ---------------------------------------------------------------- transform.ElkGraphTransformer

(defjconst disco-elk-graph-transformer.half-pi (/ pi 2))

(defjctor disco-elk-graph-transformer (component-spacing)
  (setf (.component-spacing this) component-spacing))

(defjmethod import-graph ((this disco-elk-graph-transformer) graph)
  (setf (.parent this) graph)
  (let ((components (elk-graph-components-processor.split graph))
        (result (new-jlist)))
    (jdo (component components)
      (let ((sub-result (new-jlist))
            (edge-set (new-jset)))
        (jl-add result sub-result)
        (jdo (node component)
          (let* ((component-node (%dc-import-elk-shape this node t 0.0 0.0))
                 (node-x (get-x node))
                 (node-y (get-y node)))
            (jl-add sub-result component-node)
            (set-parent-coords component-node (new-k-vector node-x node-y))
            (jdo (label (get-labels node))
              (jl-add sub-result (%dc-import-elk-shape this label nil node-x node-y)))
            (jdo (port (get-ports node))
              (jl-add sub-result (%dc-import-elk-shape this port nil node-x node-y))
              (let ((port-x (+ (get-x port) node-x))
                    (port-y (+ (get-y port) node-y)))
                (jdo (label (get-labels port))
                  (jl-add sub-result (%dc-import-elk-shape this label nil port-x port-y)))))
            (js-add-all edge-set (elk-graph-util.all-incident-edges node))))
        (%dc-import-elk-edges this edge-set sub-result)))
    (setf (.transformed-graph this) (new-dc-graph result (/ (.component-spacing this) 2)))
    (copy-properties (.transformed-graph this) graph)
    (.transformed-graph this)))

(defjmethod apply-layout ((this disco-elk-graph-transformer))
  (let* ((parent (.parent this))
         (dims (get-dimensions (.transformed-graph this)))
         (new-width (.x dims)) (new-height (.y dims))
         (old-width (get-width parent)) (old-height (get-height parent)))
    (set-dimensions parent (.x dims) (.y dims))
    (let ((x-factor (/ new-width old-width))
          (y-factor (/ new-height old-height)))
      (jdo (label (get-labels parent))
        (set-x label (* (get-x label) x-factor))
        (set-y label (* (get-y label) y-factor)))
      (jdo (port (get-ports parent))
        (let ((px (get-x port)) (py (get-y port)))
          (when (> px 0) (set-x port (* px x-factor)))
          (when (> py 0) (set-y port (* py y-factor)))))))
  (let ((applier (make-instance 'offset-applier :outer this)))
    (jdo-map (k v (.element-mapping this)) (accept applier k v)))
  (let ((adjusted-ports (new-jlist)))
    (jdo-map (edge ext (.incoming-extensions-mapping this))
      (let* ((dir (get-direction ext))
             (section (elk-graph-util.first-edge-section edge nil nil))
             (new-points (%dc-adjust-first-segment (elk-graph-util.get-source-node edge)
                                                   (elk-util.create-vector-chain section) dir)))
        (elk-util.apply-vector-chain new-points section)
        (let ((port (elk-graph-util.get-source-port edge)))
          (when (and port (not (jl-contains adjusted-ports port)))
            (jl-add adjusted-ports port)
            (%dc-adjust-related-port port (get-first new-points) dir)))))
    (jdo-map (edge ext (.outgoing-extensions-mapping this))
      (let* ((dir (get-direction ext))
             (section (elk-graph-util.first-edge-section edge nil nil))
             (new-points (%dc-adjust-first-segment
                          (elk-graph-util.get-target-node edge)
                          (k-vector-chain.reverse (elk-util.create-vector-chain section)) dir)))
        (setf new-points (k-vector-chain.reverse new-points))
        (elk-util.apply-vector-chain new-points section)
        (let ((port (elk-graph-util.get-target-port edge)))
          (when (and port (not (jl-contains adjusted-ports port)))
            (jl-add adjusted-ports port)
            (%dc-adjust-related-port port (get-last new-points) dir)))))))

(defun %dc-adjust-related-port (port edge-point dir)
  (if (is-horizontal dir)
      (set-y port (- (.y edge-point) (/ (get-height port) 2)))
      (set-x port (- (.x edge-point) (/ (get-width port) 2)))))

(defun %dc-import-elk-shape (this element consider offset-x offset-y)
  (unless (or (typep element 'elk-node) (typep element 'elk-label) (typep element 'elk-port))
    (jthrow 'illegal-argument-exception "Method only works for ElkNode-, ElkLabel and ElkPort-objects."))
  (let* ((cs (.component-spacing this))
         (half (/ cs 2))
         (x0 (- (+ (get-x element) offset-x) half))
         (y0 (- (+ (get-y element) offset-y) half))
         (x1 (+ x0 (get-width element) cs))
         (y1 (+ y0 (get-height element) cs))
         (coords (new-k-vector-chain)))
    (add coords (new-k-vector x0 y0))
    (add coords (new-k-vector x0 y1))
    (add coords (new-k-vector x1 y1))
    (add coords (new-k-vector x1 y0))
    (let ((shape (new-dc-element coords)))
      (copy-properties shape element)
      (when consider (jm-put (.element-mapping this) element shape))
      shape)))

(defun %dc-import-edge-labels (this edge new-component)
  (jdo (label (get-labels edge))
    (add new-component (%dc-import-elk-shape this label t 0.0 0.0))))

(defun %dc-import-elk-edge (this edge new-component)
  (let* ((section (elk-graph-util.first-edge-section edge nil nil))
         (points (elk-util.create-vector-chain section))
         (thickness (get-property edge dis-co-options.edge-thickness))
         (contour (%dc-get-contour points (+ thickness (.component-spacing this))))
         (shape (new-dc-element contour)))
    (copy-properties shape edge)
    (jm-put (.element-mapping this) edge shape)
    (add new-component shape)
    (%dc-import-edge-labels this edge new-component)
    shape))

(defun %dc-import-extension (this edge new-component outgoing)
  (let* ((section (elk-graph-util.first-edge-section edge nil nil))
         (points (elk-util.create-vector-chain section)))
    (when outgoing (setf points (k-vector-chain.reverse points)))
    (let* ((thickness (get-property edge dis-co-options.edge-thickness))
           (outer-point (get-first points))
           (inner-point (j-get points 1))
           (shape nil))
      (if (> (size points) 2)
          (let ((fixed (new-jlist)))
            (jl-add-all fixed (sub-list points 1 (size points)))
            (setf shape (new-dc-element (%dc-get-contour fixed (+ thickness (.component-spacing this)))))
            (copy-properties shape edge)
            (add new-component shape))
          (setf shape (jm-get (.element-mapping this)
                              (if outgoing
                                  (elk-graph-util.get-source-node edge)
                                  (elk-graph-util.get-target-node edge)))))
      (let* ((ext-parent (if outgoing
                             (elk-graph-util.get-target-node edge)
                             (elk-graph-util.get-source-node edge)))
             (dir (%dc-nearest-side outer-point ext-parent))
             (ext-width (+ thickness (.component-spacing this)))
             (middle-pos nil))
        (if (is-horizontal dir)
            (progn (incf ext-width (math.abs (- (.y outer-point) (.y inner-point))))
                   (setf middle-pos (new-k-vector (.x inner-point) (/ (+ (.y inner-point) (.y outer-point)) 2))))
            (progn (incf ext-width (math.abs (- (.x outer-point) (.x inner-point))))
                   (setf middle-pos (new-k-vector (/ (+ (.x inner-point) (.x outer-point)) 2) (.y inner-point)))))
        (jm-put (if outgoing (.outgoing-extensions-mapping this) (.incoming-extensions-mapping this))
                edge (new-dc-extension shape dir middle-pos ext-width))
        (jm-put (.element-mapping this) edge shape)
        (%dc-import-edge-labels this edge new-component)))))

(defun %dc-nearest-side (point node)
  (let ((shortest (math.abs (.y point)))
        (result dc-direction.north)
        (d 0.0))
    (setf d (math.abs (- (get-height node) (.y point))))
    (when (< d shortest) (setf shortest d result dc-direction.south))
    (setf d (math.abs (.x point)))
    (when (< d shortest) (setf shortest d result dc-direction.west))
    (setf d (math.abs (- (get-width node) (.x point))))
    (when (< d shortest) (setf shortest d result dc-direction.east))
    result))

(defun %dc-import-elk-edges (this edges new-component)
  (jdo (edge edges)
    (unless (jm-get (.element-mapping this) edge)
      (let ((src (elk-graph-util.get-source-node edge))
            (tgt (elk-graph-util.get-target-node edge)))
        (cond ((eq (get-parent src) (get-parent tgt))
               (%dc-import-elk-edge this edge new-component))
              ((eq src (get-parent tgt))
               (when (and (null (jm-get (.incoming-extensions-mapping this) edge))
                          (jm-get (.element-mapping this) tgt))
                 (%dc-import-extension this edge new-component nil)))
              (t
               (when (and (null (jm-get (.outgoing-extensions-mapping this) edge))
                          (jm-get (.element-mapping this) src))
                 (%dc-import-extension this edge new-component t))))))))

(defun %dc-get-contour (edge-points thickness)
  (let* ((ccw (new-jlist)) (cw (new-jlist))
         (radius (/ thickness 2))
         (n (size edge-points))
         (predecessor nil)
         (current (j-get edge-points 0))
         (successor (j-get edge-points 1))
         (orth (%dc-orthogonal-points (.x current) (.y current) (.x successor) (.y successor) radius)))
    (jl-add ccw (jl-get orth 0))
    (jl-add cw (jl-get orth 1))
    (loop for i from 2 below n
          do (setf predecessor current
                   current successor
                   successor (j-get edge-points i))
             (setf orth (%dc-orthogonal-points (.x current) (.y current) (.x predecessor) (.y predecessor) radius))
             (jl-add ccw (jl-get orth 1))
             (jl-add cw (jl-get orth 0))
             (setf orth (%dc-orthogonal-points (.x current) (.y current) (.x successor) (.y successor) radius))
             (jl-add ccw (jl-get orth 0))
             (jl-add cw (jl-get orth 1)))
    (setf orth (%dc-orthogonal-points (.x successor) (.y successor) (.x current) (.y current) radius))
    (jl-add ccw (jl-get orth 1))
    (jl-add cw (jl-get orth 0))
    (let ((ccw-merged (new-k-vector-chain))
          (cw-merged (new-jlist)))
      (flet ((merge-into (pts out)
               (add out (jl-get pts 0))
               (loop for i from 1 below (- (length pts) 2) by 2
                     do (let* ((cp (jl-get pts i))
                               (ip (%dc-compute-intersection (jl-get pts (- i 1)) cp
                                                             (jl-get pts (+ i 1)) (jl-get pts (+ i 2)))))
                          (if (or (nan-p (.x ip)) (infinite-p (.x ip)) (nan-p (.y ip)) (infinite-p (.y ip)))
                              (add out cp)
                              (add out ip))))
               (add out (jl-get pts (- (length pts) 1)))))
        (merge-into ccw ccw-merged)
        (merge-into cw cw-merged))
      (loop for i from (- (length cw-merged) 1) downto 0
            do (add ccw-merged (jl-get cw-merged i)))
      ccw-merged)))

(defun %dc-orthogonal-points (cur-x cur-y nxt-x nxt-y radius)
  (let* ((angle (math.atan2 (- nxt-x cur-x) (- nxt-y cur-y)))
         (ccw (+ angle disco-elk-graph-transformer.half-pi))
         (cw (- angle disco-elk-graph-transformer.half-pi)))
    (jlist (new-k-vector (+ (* radius (math.sin ccw)) cur-x) (+ (* radius (math.cos ccw)) cur-y))
           (new-k-vector (+ (* radius (math.sin cw)) cur-x) (+ (* radius (math.cos cw)) cur-y)))))

(defun %dc-compute-intersection (p1 p2 p3 p4)
  (with-java-floats
    (let* ((x1 (.x p1)) (y1 (.y p1)) (x2 (.x p2)) (y2 (.y p2))
           (x3 (.x p3)) (y3 (.y p3)) (x4 (.x p4)) (y4 (.y p4))
           (f1 (- (* x1 y2) (* y1 x2)))
           (f2 (- (* x3 y4) (* y3 x4)))
           (den (- (* (- x1 x2) (- y3 y4)) (* (- y1 y2) (- x3 x4)))))
      (new-k-vector (/ (- (* f1 (- x3 x4)) (* f2 (- x1 x2))) den)
                    (/ (- (* f1 (- y3 y4)) (* f2 (- y1 y2))) den)))))

(defun %dc-adjust-first-segment (source chain dir)
  (let ((first-point (j-remove chain)))
    (enum-case dir
      (dc-direction.north (setf (.y first-point) 0.0))
      (dc-direction.south (setf (.y first-point) (get-height source)))
      (dc-direction.west (setf (.x first-point) 0.0))
      (t (setf (.x first-point) (get-width source))))
    (add chain 0 first-point)
    chain))

;;; OffsetApplier (BiConsumer) and OffSetToChainApplier (Consumer)

(defjmethod accept ((this offset-applier) elem poly)
  (setf (.offset this) (get-offset poly))
  (if (typep elem 'elk-edge)
      (let* ((section (elk-graph-util.first-edge-section elem nil nil))
             (points (elk-util.create-vector-chain section))
             (applier (make-instance 'off-set-to-chain-applier :outer this)))
        (jdo (p points) (accept applier p))
        (elk-util.apply-vector-chain points section)
        (let ((jps (get-property elem core-options.junction-points)))
          (when jps (jdo (p jps) (accept applier p)))))
      (progn
        (set-x elem (+ (get-x elem) (.x (.offset this))))
        (set-y elem (+ (get-y elem) (.y (.offset this)))))))

(defjmethod accept ((this off-set-to-chain-applier) point)
  (let ((offset (.offset (.outer this))))
    (add point (.x offset) (.y offset))))

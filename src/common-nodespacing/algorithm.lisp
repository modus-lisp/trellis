;;;; algorithm.lisp -- org.eclipse.elk.alg.common.nodespacing.internal.algorithm
;;;; (PortContextCreator, NodeLabelCellCreator, InsidePortLabelCellCreator,
;;;; NodeLabelAndSizeUtilities, CellSystemConfigurator, NodeSizeCalculator, LabelPlacer)

(in-package #:elk)

;;; ------------------------------------------------------------ PortContextCreator

(defjstatic port-context-creator.create-port-contexts (nc ignore-inside-port-labels)
  (let ((im-port-labels (or (not ignore-inside-port-labels)
                            (not (contains (.port-labels-placement nc) port-label-placement.inside))))
        (volatile-id 0))
    (jdo (port (get-ports (.node nc)))
      (when (eq (get-side port) port-side.undefined)
        (jthrow 'illegal-argument-exception
                "Label and node size calculator can only be used with ports that have port sides assigned."))
      (set-volatile-id port volatile-id)
      (incf volatile-id)
      (%ns-create-port-context nc port im-port-labels))))

(defun %ns-create-port-context (nc port im-port-labels)
  (let ((pc (new-port-context nc port)))
    (ns-port-contexts-put nc (get-side port) pc)
    (when (and im-port-labels (not (port-label-placement.is-fixed (.port-labels-placement nc))))
      (setf (.port-label-cell pc) (new-label-cell (.label-label-spacing nc)))
      (jdo (label (get-labels port))
        (add-label (.port-label-cell pc) label)))))

;;; ------------------------------------------------------------ NodeLabelCellCreator

(defjstatic node-label-cell-creator.create-node-label-cells (nc only-inside horizontal-layout-mode)
  (%ns-create-node-label-cell-containers nc only-inside)
  (jdo (label (get-labels (.node nc)))
    (%ns-handle-node-label nc label only-inside horizontal-layout-mode)))

(defun %ns-handle-node-label (nc label only-inside horizontal-layout-mode)
  (let* ((placement (if (has-property label core-options.node-labels-placement)
                        (get-property label core-options.node-labels-placement)
                        (.node-label-placement nc)))
         (location (node-label-location.from-node-label-placement placement)))
    (when (eq location node-label-location.undefined)
      (return-from %ns-handle-node-label))
    (when (and only-inside (not (is-inside-location location)))
      (return-from %ns-handle-node-label))
    (add-label (%ns-retrieve-node-label-cell nc location horizontal-layout-mode) label)))

(defun %ns-create-node-label-cell-containers (nc only-inside)
  (let ((symmetry (not (contains (.size-options nc) size-options.asymmetrical)))
        (tabular (contains (.size-options nc) size-options.force-tabular-node-labels))
        (spacing (.label-cell-spacing nc)))
    (setf (.inside-node-label-container nc) (new-grid-container-cell tabular symmetry spacing))
    (when (.node-labels-padding nc)
      (copy (get-padding (.inside-node-label-container nc)) (.node-labels-padding nc)))
    (set-cell (.node-container-middle-row nc) container-area.center (.inside-node-label-container nc))
    (unless only-inside
      (let ((m (.outside-node-label-containers nc)))
        (let ((c (new-strip-container-cell strip.horizontal symmetry spacing)))
          (setf (.bottom (get-padding c)) (.node-label-spacing nc))
          (setf (gethash port-side.north m) c))
        (let ((c (new-strip-container-cell strip.horizontal symmetry spacing)))
          (setf (.top (get-padding c)) (.node-label-spacing nc))
          (setf (gethash port-side.south m) c))
        (let ((c (new-strip-container-cell strip.vertical symmetry spacing)))
          (setf (.right (get-padding c)) (.node-label-spacing nc))
          (setf (gethash port-side.west m) c))
        (let ((c (new-strip-container-cell strip.vertical symmetry spacing)))
          (setf (.left (get-padding c)) (.node-label-spacing nc))
          (setf (gethash port-side.east m) c))))))

(defun %ns-retrieve-node-label-cell (nc location horizontal-layout-mode)
  (let ((cell (gethash location (.node-label-cells nc))))
    (unless cell
      (setf cell (new-label-cell (.label-label-spacing nc) location horizontal-layout-mode))
      (setf (gethash location (.node-label-cells nc)) cell)
      (if (is-inside-location location)
          (set-cell (.inside-node-label-container nc)
                    (get-container-row location) (get-container-column location) cell)
          (let* ((outside-side (get-outside-side location))
                 (container (gethash outside-side (.outside-node-label-containers nc))))
            (enum-case outside-side
              ((port-side.north port-side.south)
               (set-contributes-to-minimum-height cell t)
               (set-cell container (get-container-column location) cell))
              ((port-side.west port-side.east)
               (set-contributes-to-minimum-width cell t)
               (set-cell container (get-container-row location) cell))))))
    cell))

;;; ------------------------------------------------------------ InsidePortLabelCellCreator

(defjstatic inside-port-label-cell-creator.create-inside-port-label-cells (nc)
  (%ns-create-inside-port-label-cell nc (.node-container nc) container-area.begin port-side.north)
  (%ns-create-inside-port-label-cell nc (.node-container nc) container-area.end port-side.south)
  (%ns-create-inside-port-label-cell nc (.node-container-middle-row nc) container-area.begin port-side.west)
  (%ns-create-inside-port-label-cell nc (.node-container-middle-row nc) container-area.end port-side.east)
  (%ns-setup-north-or-south-port-label-cell nc port-side.north)
  (%ns-setup-north-or-south-port-label-cell nc port-side.south)
  (%ns-setup-east-or-west-port-label-cell nc port-side.east)
  (%ns-setup-east-or-west-port-label-cell nc port-side.west))

(defun %ns-create-inside-port-label-cell (nc container area side)
  (let ((cell (new-atomic-cell)))
    (set-cell container area cell)
    (setf (gethash side (.inside-port-label-cells nc)) cell)))

(defun %ns-setup-north-or-south-port-label-cell (nc side)
  (let ((padding (get-padding (%ns-ipl-cell nc side))))
    (enum-case side
      (port-side.north
       (when (>= (.port-label-spacing-vertical nc) 0)
         (setf (.top padding) (.port-label-spacing-vertical nc))))
      (port-side.south
       (when (>= (.port-label-spacing-vertical nc) 0)
         (setf (.bottom padding) (.port-label-spacing-vertical nc)))))
    (when (.surrounding-port-margins nc)
      (setf (.left padding) (.left (.surrounding-port-margins nc))
            (.right padding) (.right (.surrounding-port-margins nc))))))

(defun %ns-setup-east-or-west-port-label-cell (nc side)
  (when (contains (.port-labels-placement nc) port-label-placement.inside)
    (%ns-calculate-width-due-to-labels nc side))
  (when (.surrounding-port-margins nc)
    (let ((padding (get-padding (%ns-ipl-cell nc side))))
      (setf (.top padding) (.top (.surrounding-port-margins nc))
            (.bottom padding) (.bottom (.surrounding-port-margins nc))))))

(defun %ns-calculate-width-due-to-labels (nc side)
  (let* ((cell (%ns-ipl-cell nc side))
         (min-cell-size (get-minimum-content-area-size cell)))
    (jdo (pc (ns-port-contexts-get nc side))
      (when (.port-label-cell pc)
        (setf (.x min-cell-size) (math.max (.x min-cell-size) (get-minimum-width (.port-label-cell pc))))))
    (when (> (.x min-cell-size) 0)
      (enum-case side
        (port-side.east (setf (.right (get-padding cell)) (.port-label-spacing-horizontal nc)))
        (port-side.west (setf (.left (get-padding cell)) (.port-label-spacing-horizontal nc)))))))

;;; ------------------------------------------------------------ NodeLabelAndSizeUtilities

(defjstatic node-label-and-size-utilities.setup-minimum-client-area-size (nc)
  (let ((min-size (node-label-and-size-utilities.get-minimum-client-area-size nc)))
    (when min-size
      (set-center-cell-minimum-size (.inside-node-label-container nc) min-size))))

(defjstatic node-label-and-size-utilities.setup-node-padding-for-ports-with-offset (nc)
  (let ((p (get-padding (.node-container nc))))
    (jdo (pc (ns-port-contexts-values nc))
      (let ((port (.port pc))
            (port-border-offset 0.0))
        (when (has-property port core-options.port-border-offset)
          (setf port-border-offset (get-property port core-options.port-border-offset))
          (when (< port-border-offset 0)
            (enum-case (get-side port)
              (port-side.north (setf (.top p) (math.max (.top p) (- port-border-offset))))
              (port-side.south (setf (.bottom p) (math.max (.bottom p) (- port-border-offset))))
              (port-side.east (setf (.right p) (math.max (.right p) (- port-border-offset))))
              (port-side.west (setf (.left p) (math.max (.left p) (- port-border-offset)))))))
        (when (port-label-placement.is-fixed (.port-labels-placement nc))
          (let ((inside-part (elk-util.compute-inside-part port port-border-offset))
                (symmetry (not (contains (get-property (.node nc) core-options.node-size-options)
                                         size-options.asymmetrical)))
                (bigger nil))
            (enum-case (get-side port)
              (port-side.north
               (setf bigger (> inside-part (.top p)))
               (setf (.top p) (math.max (.top p) inside-part))
               (when (and symmetry bigger)
                 (setf (.top p) (math.max (.top p) (.bottom p)))
                 (setf (.bottom p) (+ (.top p) port-border-offset))))
              (port-side.south
               (setf bigger (> inside-part (.bottom p)))
               (setf (.bottom p) (math.max (.bottom p) inside-part))
               (when (and symmetry bigger)
                 (setf (.bottom p) (math.max (.bottom p) (.top p)))
                 (setf (.top p) (+ (.bottom p) port-border-offset))))
              (port-side.east
               (setf bigger (> inside-part (.right p)))
               (setf (.right p) (math.max (.right p) inside-part))
               (when (and symmetry bigger)
                 (setf (.right p) (math.max (.left p) (.right p)))
                 (setf (.left p) (+ (.right p) port-border-offset))))
              (port-side.west
               (setf bigger (> inside-part (.left p)))
               (setf (.left p) (math.max (.left p) inside-part))
               (when (and symmetry bigger)
                 (setf (.left p) (math.max (.left p) (.right p)))
                 (setf (.right p) (+ (.left p) port-border-offset)))))))))))

(defjstatic node-label-and-size-utilities.offset-southern-ports-by-node-size (nc)
  (let ((node-height (.y (.node-size nc))))
    (jdo (pc (ns-port-contexts-get nc port-side.south))
      (incf (.y (.port-position pc)) node-height))))

(defjstatic node-label-and-size-utilities.set-node-padding (nc)
  (unless (contains (.size-options nc) size-options.compute-padding)
    (return-from node-label-and-size-utilities.set-node-padding/1))
  (let ((node-rect (get-cell-rectangle (.node-container nc)))
        (client-area (get-center-cell-rectangle (.inside-node-label-container nc)))
        (node-padding (new-elk-padding)))
    (setf (.left node-padding) (- (.x client-area) (.x node-rect)))
    (setf (.top node-padding) (- (.y client-area) (.y node-rect)))
    (setf (.right node-padding) (- (+ (.x node-rect) (.width node-rect))
                                   (+ (.x client-area) (.width client-area))))
    (setf (.bottom node-padding) (- (+ (.y node-rect) (.height node-rect))
                                    (+ (.y client-area) (.height client-area))))
    (set-padding (.node nc) node-padding)))

(defjstatic node-label-and-size-utilities.apply-stuff (nc)
  (apply-node-size nc)
  (jdo (pc (ns-port-contexts-values nc))
    (apply-port-position pc)))

(defjstatic node-label-and-size-utilities.get-minimum-client-area-size (nc)
  (if (and (contains (.size-constraints nc) size-constraint.minimum-size)
           (contains (.size-options nc) size-options.minimum-size-accounts-for-padding))
      (node-label-and-size-utilities.get-minimum-node-or-client-area-size nc)
      nil))

(defjstatic node-label-and-size-utilities.get-minimum-node-size (nc)
  (if (and (contains (.size-constraints nc) size-constraint.minimum-size)
           (not (contains (.size-options nc) size-options.minimum-size-accounts-for-padding)))
      (node-label-and-size-utilities.get-minimum-node-or-client-area-size nc)
      nil))

(defjstatic node-label-and-size-utilities.get-minimum-node-or-client-area-size (nc)
  (let ((min-size (new-k-vector (get-property (.node nc) core-options.node-size-minimum))))
    (when (contains (.size-options nc) size-options.default-minimum-size)
      (when (<= (.x min-size) 0)
        (setf (.x min-size) elk-util.default-min-width))
      (when (<= (.y min-size) 0)
        (setf (.y min-size) elk-util.default-min-height)))
    min-size))

(defjstatic node-label-and-size-utilities.are-size-constraints-fixed (nc)
  ;; EFFECTIVELY_FIXED_SIZE_CONSTRAINTS = EnumSet.of(SizeConstraint.PORT_LABELS)
  (let ((sc (.size-constraints nc)))
    (or (is-empty sc)
        (and (= (size sc) 1) (contains sc size-constraint.port-labels)))))

(defjstatic node-label-and-size-utilities.is-first-outside-port-label-placed-differently (nc side)
  (let ((pcs (ns-port-contexts-get nc side)))
    (if (>= (length pcs) 2)
        (let ((first-port (jl-first pcs))
              (always-same-side (contains (.port-labels-placement nc) port-label-placement.always-same-side))
              (space-efficient (contains (.port-labels-placement nc) port-label-placement.space-efficient)))
          (and (not (.labels-next-to-port first-port))
               (not always-same-side)
               (or (= (length pcs) 2) space-efficient)))
        nil)))

;;; ------------------------------------------------------------ CellSystemConfigurator

(defjstatic cell-system-configurator.configure-cell-system-size-contributions (nc)
  (let ((sc (.size-constraints nc)))
    (when (is-empty sc)
      (return-from cell-system-configurator.configure-cell-system-size-contributions/1))
    (when (contains sc size-constraint.ports)
      (set-contributes-to-minimum-width (%ns-ipl-cell nc port-side.north) t)
      (set-contributes-to-minimum-width (%ns-ipl-cell nc port-side.south) t)
      (let ((free (and (not (eq (.port-constraints nc) port-constraints.fixed-ratio))
                       (not (eq (.port-constraints nc) port-constraints.fixed-pos)))))
        (set-contributes-to-minimum-height (%ns-ipl-cell nc port-side.east) free)
        (set-contributes-to-minimum-height (%ns-ipl-cell nc port-side.west) free)
        (set-contributes-to-minimum-height (.node-container-middle-row nc) free))
      (when (contains sc size-constraint.port-labels)
        (set-contributes-to-minimum-height (%ns-ipl-cell nc port-side.north) t)
        (set-contributes-to-minimum-height (%ns-ipl-cell nc port-side.south) t)
        (set-contributes-to-minimum-width (%ns-ipl-cell nc port-side.east) t)
        (set-contributes-to-minimum-width (%ns-ipl-cell nc port-side.west) t)
        (set-contributes-to-minimum-width (.node-container-middle-row nc) t)))
    (when (contains sc size-constraint.node-labels)
      (set-contributes-to-minimum-height (.inside-node-label-container nc) t)
      (set-contributes-to-minimum-width (.inside-node-label-container nc) t)
      (set-contributes-to-minimum-height (.node-container-middle-row nc) t)
      (set-contributes-to-minimum-width (.node-container-middle-row nc) t)
      (let ((overhang (contains (.size-options nc) size-options.outside-node-labels-overhang)))
        (jdo (location (node-label-location.values))
          (let ((cell (gethash location (.node-label-cells nc))))
            (when cell
              (if (is-inside-location location)
                  (progn (set-contributes-to-minimum-height cell t)
                         (set-contributes-to-minimum-width cell t))
                  (progn (set-contributes-to-minimum-height cell (not overhang))
                         (set-contributes-to-minimum-width cell (not overhang)))))))))
    (when (and (contains sc size-constraint.minimum-size)
               (contains (.size-options nc) size-options.minimum-size-accounts-for-padding))
      ;; (sic: ELK sets the height contribution twice)
      (set-contributes-to-minimum-height (.node-container-middle-row nc) t)
      (set-contributes-to-minimum-height (.node-container-middle-row nc) t)
      (unless (is-contributing-to-minimum-height (.inside-node-label-container nc))
        (set-contributes-to-minimum-height (.inside-node-label-container nc) t)
        (set-contributes-to-minimum-width (.inside-node-label-container nc) t)
        (set-only-center-cell-contributes-to-minimum-size (.inside-node-label-container nc) t)))))

(defjstatic cell-system-configurator.update-vertical-inside-port-label-cell-padding (nc)
  (when (or (eq (.port-constraints nc) port-constraints.fixed-ratio)
            (eq (.port-constraints nc) port-constraints.fixed-pos))
    (return-from cell-system-configurator.update-vertical-inside-port-label-cell-padding/1))
  (let* ((top-border-offset (+ (.top (get-padding (.node-container nc)))
                               (get-minimum-height (%ns-ipl-cell nc port-side.north))
                               (.label-cell-spacing nc)))
         (bottom-border-offset (+ (.bottom (get-padding (.node-container nc)))
                                  (get-minimum-height (%ns-ipl-cell nc port-side.south))
                                  (.label-cell-spacing nc)))
         (east (%ns-ipl-cell nc port-side.east))
         (west (%ns-ipl-cell nc port-side.west))
         (top-padding (math.max 0.0 (- (.top (get-padding east)) top-border-offset)))
         (bottom-padding 0.0))
    (setf top-padding (math.max top-padding (- (.top (get-padding west)) top-border-offset)))
    (setf bottom-padding (math.max 0.0 (- (.bottom (get-padding east)) bottom-border-offset)))
    (setf bottom-padding (math.max bottom-padding (- (.bottom (get-padding west)) bottom-border-offset)))
    (setf (.top (get-padding east)) top-padding
          (.top (get-padding west)) top-padding
          (.bottom (get-padding east)) bottom-padding
          (.bottom (get-padding west)) bottom-padding)))

;;; ------------------------------------------------------------ NodeSizeCalculator

(defjstatic node-size-calculator.set-node-width (nc)
  (let ((node-size (.node-size nc))
        (width 0.0))
    (if (node-label-and-size-utilities.are-size-constraints-fixed nc)
        (setf width (.x node-size))
        (progn
          (setf width (if (.topdown-layout nc)
                          (math.max (.x node-size) (get-minimum-width (.node-container nc)))
                          (get-minimum-width (.node-container nc))))
          (when (and (contains (.size-constraints nc) size-constraint.node-labels)
                     (not (contains (.size-options nc) size-options.outside-node-labels-overhang)))
            (setf width (math.max width (get-minimum-width
                                         (gethash port-side.north (.outside-node-label-containers nc)))))
            (setf width (math.max width (get-minimum-width
                                         (gethash port-side.south (.outside-node-label-containers nc))))))
          (let ((min-node-size (node-label-and-size-utilities.get-minimum-node-size nc)))
            (when min-node-size
              (setf width (math.max width (.x min-node-size)))))))
    (if (get-property (get-graph (.node nc)) core-options.node-size-fixed-graph-size)
        (setf (.x node-size) (math.max (.x node-size) width))
        (setf (.x node-size) width))
    (let ((r (get-cell-rectangle (.node-container nc))))
      (setf (.x r) 0.0 (.width r) width))
    (layout-children-horizontally (.node-container nc))))

(defjstatic node-size-calculator.set-node-height (nc)
  (let ((node-size (.node-size nc))
        (height 0.0))
    (if (node-label-and-size-utilities.are-size-constraints-fixed nc)
        (setf height (.y node-size))
        (progn
          (setf height (if (.topdown-layout nc)
                           (math.max (.y node-size) (get-minimum-height (.node-container nc)))
                           (get-minimum-height (.node-container nc))))
          (when (and (contains (.size-constraints nc) size-constraint.node-labels)
                     (not (contains (.size-options nc) size-options.outside-node-labels-overhang)))
            (setf height (math.max height (get-minimum-height
                                           (gethash port-side.east (.outside-node-label-containers nc)))))
            (setf height (math.max height (get-minimum-height
                                           (gethash port-side.west (.outside-node-label-containers nc))))))
          (let ((min-node-size (node-label-and-size-utilities.get-minimum-node-size nc)))
            (when min-node-size
              (setf height (math.max height (.y min-node-size)))))
          (when (and (contains (.size-constraints nc) size-constraint.ports)
                     (or (eq (.port-constraints nc) port-constraints.fixed-ratio)
                         (eq (.port-constraints nc) port-constraints.fixed-pos)))
            (setf height (math.max height (get-minimum-height (%ns-ipl-cell nc port-side.east))))
            (setf height (math.max height (get-minimum-height (%ns-ipl-cell nc port-side.west)))))))
    (if (get-property (get-graph (.node nc)) core-options.node-size-fixed-graph-size)
        (setf (.y node-size) (math.max (.y node-size) height))
        (setf (.y node-size) height))
    (let ((r (get-cell-rectangle (.node-container nc))))
      (setf (.y r) 0.0 (.height r) height))
    (layout-children-vertically (.node-container nc))))

;;; ------------------------------------------------------------ LabelPlacer (common-label-placer)

(defjstatic common-label-placer.place-labels (nc)
  (%ns-place-outer-node-label-containers nc)
  (jdo (cell (ns-enum-map-values (.node-label-cells nc) 'node-label-location))
    (apply-label-layout cell))
  (jdo (pc (ns-port-contexts-values nc))
    (when (.port-label-cell pc)
      (apply-label-layout (.port-label-cell pc)))))

(defun %ns-place-outer-node-label-containers (nc)
  (let ((overhang (contains (.size-options nc) size-options.outside-node-labels-overhang)))
    (%ns-place-horizontal-outer-node-label-container nc overhang port-side.north)
    (%ns-place-horizontal-outer-node-label-container nc overhang port-side.south)
    (%ns-place-vertical-outer-node-label-container nc overhang port-side.east)
    (%ns-place-vertical-outer-node-label-container nc overhang port-side.west)))

(defun %ns-place-horizontal-outer-node-label-container (nc overhang side)
  (let* ((node-size (.node-size nc))
         (container (gethash side (.outside-node-label-containers nc)))
         (r (get-cell-rectangle container)))
    (setf (.width r) (get-minimum-width container)
          (.height r) (get-minimum-height container))
    (setf (.width r) (math.max (.width r) (.x node-size)))
    (when (and (> (.width r) (.x node-size)) (not overhang))
      (setf (.width r) (.x node-size)))
    (setf (.x r) (/ (- (- (.width r) (.x node-size))) 2))
    (enum-case side
      (port-side.north (setf (.y r) (- (.height r))))
      (port-side.south (setf (.y r) (.y node-size))))
    (layout-children-horizontally container)
    (layout-children-vertically container)))

(defun %ns-place-vertical-outer-node-label-container (nc overhang side)
  (let* ((node-size (.node-size nc))
         (container (gethash side (.outside-node-label-containers nc)))
         (r (get-cell-rectangle container)))
    (setf (.width r) (get-minimum-width container)
          (.height r) (get-minimum-height container))
    (setf (.height r) (math.max (.height r) (.y node-size)))
    (when (and (> (.height r) (.y node-size)) (not overhang))
      (setf (.height r) (.y node-size)))
    (setf (.y r) (/ (- (- (.height r) (.y node-size))) 2))
    (enum-case side
      (port-side.west (setf (.x r) (- (.width r))))
      (port-side.east (setf (.x r) (.x node-size))))
    (layout-children-horizontally container)
    (layout-children-vertically container)))

;;;; cellsystem.lisp -- org.eclipse.elk.alg.common.nodespacing.cellsystem

(in-package #:elk)

;;; ------------------------------------------------------------ Cell

(defjmethod get-padding ((this cell)) (.padding this))
(defjmethod get-cell-rectangle ((this cell)) (.cell-rectangle this))
(defjmethod is-contributing-to-minimum-width ((this cell)) (.contributes-to-minimum-width this))
(defjmethod set-contributes-to-minimum-width ((this cell) v)
  (setf (.contributes-to-minimum-width this) v))
(defjmethod is-contributing-to-minimum-height ((this cell)) (.contributes-to-minimum-height this))
(defjmethod set-contributes-to-minimum-height ((this cell) v)
  (setf (.contributes-to-minimum-height this) v))
(defjgeneric get-minimum-width 0)
(defjgeneric get-minimum-height 0)

;;; ------------------------------------------------------------ AtomicCell

(defjmethod get-minimum-content-area-size ((this atomic-cell)) (.minimum-content-area-size this))

(defjmethod set-minimum-content-area-size ((this atomic-cell) new-size includes-padding)
  (if includes-padding
      (let ((padding (get-padding this))
            (m (.minimum-content-area-size this)))
        (setf (.x m) (- (.x new-size) (.left padding) (.right padding)))
        (setf (.y m) (- (.y new-size) (.top padding) (.bottom padding))))
      (j-set (.minimum-content-area-size this) new-size)))

(defjmethod get-minimum-width ((this atomic-cell))
  (let ((padding (get-padding this)))
    (+ (.x (.minimum-content-area-size this)) (.left padding) (.right padding))))

(defjmethod get-minimum-height ((this atomic-cell))
  (let ((padding (get-padding this)))
    (+ (.y (.minimum-content-area-size this)) (.top padding) (.bottom padding))))

;;; ------------------------------------------------------------ ContainerCell

(defjgeneric layout-children-horizontally 0)
(defjgeneric layout-children-vertically 0)

(defjstatic container-cell.min-width-of-cell (cell respect-contribution-flag)
  (cond ((null cell) 0.0)
        ((and respect-contribution-flag (not (is-contributing-to-minimum-width cell))) 0.0)
        ((and (typep cell 'atomic-cell) (= (.x (get-minimum-content-area-size cell)) 0)) 0.0)
        (t (get-minimum-width cell))))

(defjstatic container-cell.min-height-of-cell (cell respect-contribution-flag)
  (cond ((null cell) 0.0)
        ((and respect-contribution-flag (not (is-contributing-to-minimum-height cell))) 0.0)
        ((and (typep cell 'atomic-cell) (= (.y (get-minimum-content-area-size cell)) 0)) 0.0)
        (t (get-minimum-height cell))))

(defjmethod apply-horizontal-layout ((this container-cell) cell x width)
  (when cell
    (let ((r (get-cell-rectangle cell)))
      (setf (.x r) x (.width r) width))))

(defjmethod apply-vertical-layout ((this container-cell) cell y height)
  (when cell
    (let ((r (get-cell-rectangle cell)))
      (setf (.y r) y (.height r) height))))

;;; ------------------------------------------------------------ LabelCell

(defjctor label-cell (gap)
  (setf (.gap this) gap (.horizontal-layout-mode this) t))

(defun %ns-label-cell-init (this gap second)
  (if (typep second 'node-label-location)
      (progn (setf (.gap this) gap (.horizontal-layout-mode this) t)
             (setf (.horizontal-alignment this) (get-horizontal-alignment second)
                   (.vertical-alignment this) (get-vertical-alignment second)))
      (setf (.gap this) gap (.horizontal-layout-mode this) second)))

(defjctor label-cell (gap second)
  ;; LabelCell(double, boolean) and LabelCell(double, NodeLabelLocation)
  (%ns-label-cell-init this gap second))

(defjctor label-cell (gap node-label-location horizontal-layout-mode)
  (setf (.gap this) gap
        (.horizontal-layout-mode this) horizontal-layout-mode
        (.horizontal-alignment this) (get-horizontal-alignment node-label-location)
        (.vertical-alignment this) (get-vertical-alignment node-label-location)))

(defjmethod get-horizontal-alignment ((this label-cell)) (.horizontal-alignment this))
(defjmethod set-horizontal-alignment ((this label-cell) a)
  (unless a (jthrow 'null-pointer-exception "Horizontal alignment cannot be null"))
  (setf (.horizontal-alignment this) a)
  this)
(defjmethod get-vertical-alignment ((this label-cell)) (.vertical-alignment this))
(defjmethod set-vertical-alignment ((this label-cell) a)
  (unless a (jthrow 'null-pointer-exception "Vertical alignment cannot be null"))
  (setf (.vertical-alignment this) a)
  this)
(defjmethod get-labels ((this label-cell)) (.labels this))

(defjmethod get-minimum-width ((this label-cell))
  (let ((padding (get-padding this)))
    (+ (.x (.minimum-content-area-size this)) (.left padding) (.right padding))))

(defjmethod get-minimum-height ((this label-cell))
  (let ((padding (get-padding this)))
    (+ (.y (.minimum-content-area-size this)) (.top padding) (.bottom padding))))

(defjmethod add-label ((this label-cell) label)
  (jl-add (.labels this) label)
  (let ((label-size (get-size label))
        (m (.minimum-content-area-size this)))
    (if (.horizontal-layout-mode this)
        (progn
          (setf (.x m) (math.max (.x m) (.x label-size)))
          (incf (.y m) (.y label-size))
          (when (> (length (.labels this)) 1)
            (incf (.y m) (.gap this))))
        (progn
          (incf (.x m) (.x label-size))
          (setf (.y m) (math.max (.y m) (.y label-size)))
          (when (> (length (.labels this)) 1)
            (incf (.x m) (.gap this)))))))

(defjmethod has-labels ((this label-cell)) (> (length (.labels this)) 0))

(defjmethod apply-label-layout ((this label-cell))
  (if (.horizontal-layout-mode this)
      (%ns-apply-horizontal-mode-label-layout this)
      (%ns-apply-vertical-mode-label-layout this)))

(defun %ns-apply-horizontal-mode-label-layout (this)
  (let* ((cell-rect (get-cell-rectangle this))
         (cell-padding (get-padding this))
         (m (.minimum-content-area-size this))
         (y-pos (.y cell-rect)))
    (cond ((eq (.vertical-alignment this) vertical-label-alignment.center)
           (incf y-pos (/ (- (.height cell-rect) (.y m)) 2)))
          ((eq (.vertical-alignment this) vertical-label-alignment.bottom)
           (incf y-pos (- (.height cell-rect) (.y m)))))
    (jdo (label (.labels this))
      (let ((label-size (get-size label))
            (label-pos (new-k-vector)))
        (setf (.y label-pos) y-pos)
        (incf y-pos (+ (.y label-size) (.gap this)))
        (enum-case (.horizontal-alignment this)
          (horizontal-label-alignment.left
           (setf (.x label-pos) (+ (.x cell-rect) (.left cell-padding))))
          (horizontal-label-alignment.center
           (setf (.x label-pos) (+ (.x cell-rect) (.left cell-padding)
                                   (/ (- (.width cell-rect) (.x label-size)) 2))))
          (horizontal-label-alignment.right
           (setf (.x label-pos) (- (+ (.x cell-rect) (.width cell-rect)) (.right cell-padding)
                                   (.x label-size)))))
        (set-position label label-pos)))))

(defun %ns-apply-vertical-mode-label-layout (this)
  (let* ((cell-rect (get-cell-rectangle this))
         (cell-padding (get-padding this))
         (m (.minimum-content-area-size this))
         (x-pos (.x cell-rect)))
    (cond ((eq (.horizontal-alignment this) horizontal-label-alignment.center)
           (incf x-pos (/ (- (.width cell-rect) (.x m)) 2)))
          ((eq (.horizontal-alignment this) horizontal-label-alignment.right)
           (incf x-pos (- (.width cell-rect) (.x m)))))
    (jdo (label (.labels this))
      (let ((label-size (get-size label))
            (label-pos (new-k-vector)))
        (setf (.x label-pos) x-pos)
        (incf x-pos (+ (.x label-size) (.gap this)))
        (enum-case (.vertical-alignment this)
          (vertical-label-alignment.top
           (setf (.y label-pos) (+ (.y cell-rect) (.top cell-padding))))
          (vertical-label-alignment.center
           (setf (.y label-pos) (+ (.y cell-rect) (.top cell-padding)
                                   (/ (- (.height cell-rect) (.y label-size)) 2))))
          (vertical-label-alignment.bottom
           (setf (.y label-pos) (- (+ (.y cell-rect) (.height cell-rect)) (.bottom cell-padding)
                                   (.y label-size)))))
        (set-position label label-pos)))))

;;; ------------------------------------------------------------ StripContainerCell

(defjctor strip-container-cell (mode symmetrical gap)
  (setf (.container-mode this) mode (.symmetrical this) symmetrical (.gap this) gap))

(defjmethod get-container-mode ((this strip-container-cell)) (.container-mode this))
(defjmethod get-gap ((this strip-container-cell)) (.gap this))
(defjmethod get-cell ((this strip-container-cell) area)
  (aref (.cells this) (ordinal area)))
(defjmethod set-cell ((this strip-container-cell) area cell)
  (setf (aref (.cells this) (ordinal area)) cell))

(defun %ns-sum-active (values gap)
  "Sum of the positive values plus a gap between each two of them."
  (let ((sum 0.0) (active 0))
    (loop for v across values
          when (> v 0) do (incf sum v) (incf active))
    (when (> active 1)
      (incf sum (* gap (- active 1))))
    sum))

(defjmethod get-minimum-width ((this strip-container-cell))
  (let ((width 0.0))
    (if (eq (.container-mode this) strip.vertical)
        (let ((m nil))
          (loop for c across (.cells this)
                when (and c (is-contributing-to-minimum-width c))
                  do (let ((w (get-minimum-width c)))
                       (setf m (if m (math.max m w) w))))
          (setf width (or m 0.0)))
        (setf width (%ns-sum-active (%ns-strip-min-cell-widths this t) (.gap this))))
    (if (> width 0)
        (+ width (.left (get-padding this)) (.right (get-padding this)))
        0.0)))

(defjmethod get-minimum-height ((this strip-container-cell))
  (let ((height 0.0))
    (if (eq (.container-mode this) strip.vertical)
        (setf height (%ns-sum-active (%ns-strip-min-cell-heights this t) (.gap this)))
        (let ((m nil))
          (loop for c across (.cells this)
                when (and c (is-contributing-to-minimum-height c))
                  do (let ((h (get-minimum-height c)))
                       (setf m (if m (math.max m h) h))))
          (setf height (or m 0.0))))
    (if (> height 0)
        (+ height (.top (get-padding this)) (.bottom (get-padding this)))
        0.0)))

(defjmethod layout-children-horizontally ((this strip-container-cell))
  (let ((cell-rectangle (get-cell-rectangle this))
        (cell-padding (get-padding this))
        (cells (.cells this))
        (gap (.gap this)))
    (if (eq (.container-mode this) strip.vertical)
        (let ((x-pos (+ (.x cell-rectangle) (.left cell-padding)))
              (width (- (.width cell-rectangle) (.left cell-padding) (.right cell-padding))))
          (loop for child across cells do (apply-horizontal-layout this child x-pos width)))
        (let ((cell-widths (%ns-strip-min-cell-widths this nil)))
          (apply-horizontal-layout this (aref cells 0)
                                   (+ (.x cell-rectangle) (.left cell-padding))
                                   (aref cell-widths 0))
          (apply-horizontal-layout this (aref cells 2)
                                   (- (+ (.x cell-rectangle) (.width cell-rectangle))
                                      (.right cell-padding) (aref cell-widths 2))
                                   (aref cell-widths 2))
          (let ((free (- (.width cell-rectangle) (.left cell-padding) (.right cell-padding))))
            (when (> (aref cell-widths 0) 0)
              (decf free (+ (aref cell-widths 0) gap))
              (incf (aref cell-widths 0) gap))
            (when (> (aref cell-widths 2) 0)
              (decf free (+ (aref cell-widths 2) gap)))
            (setf (aref cell-widths 1) (math.max (aref cell-widths 1) free))
            (apply-horizontal-layout this (aref cells 1)
                                     (- (+ (.x cell-rectangle) (.left cell-padding) (aref cell-widths 0))
                                        (/ (- (aref cell-widths 1) free) 2))
                                     (aref cell-widths 1)))))
    (loop for child across cells
          when (typep child 'container-cell) do (layout-children-horizontally child))))

(defjmethod layout-children-vertically ((this strip-container-cell))
  (let ((cell-rectangle (get-cell-rectangle this))
        (cell-padding (get-padding this))
        (cells (.cells this))
        (gap (.gap this)))
    (if (eq (.container-mode this) strip.vertical)
        (let ((cell-heights (%ns-strip-min-cell-heights this nil)))
          (apply-vertical-layout this (aref cells 0)
                                 (+ (.y cell-rectangle) (.top cell-padding))
                                 (aref cell-heights 0))
          (apply-vertical-layout this (aref cells 2)
                                 (- (+ (.y cell-rectangle) (.height cell-rectangle))
                                    (.bottom cell-padding) (aref cell-heights 2))
                                 (aref cell-heights 2))
          (let* ((content-area-height (- (.height cell-rectangle) (.top cell-padding) (.bottom cell-padding)))
                 (free content-area-height))
            (when (> (aref cell-heights 0) 0)
              (incf (aref cell-heights 0) gap)
              (decf free (aref cell-heights 0)))
            (when (> (aref cell-heights 2) 0)
              (decf free (+ (aref cell-heights 2) gap)))
            (setf (aref cell-heights 1) (math.max (aref cell-heights 1) free))
            (apply-vertical-layout this (aref cells 1)
                                   (- (+ (.y cell-rectangle) (.top cell-padding) (aref cell-heights 0))
                                      (/ (- (aref cell-heights 1) free) 2))
                                   (aref cell-heights 1))))
        (let ((y-pos (+ (.y cell-rectangle) (.top cell-padding)))
              (height (- (.height cell-rectangle) (.top cell-padding) (.bottom cell-padding))))
          (loop for child across cells do (apply-vertical-layout this child y-pos height))))
    (loop for child across cells
          when (typep child 'container-cell) do (layout-children-vertically child))))

(defun %ns-strip-min-cell-widths (this respect)
  (let* ((cells (.cells this))
         (w (vector (container-cell.min-width-of-cell (aref cells 0) respect)
                    (container-cell.min-width-of-cell (aref cells 1) respect)
                    (container-cell.min-width-of-cell (aref cells 2) respect))))
    (when (.symmetrical this)
      (setf (aref w 0) (math.max (aref w 0) (aref w 2)))
      (setf (aref w 2) (aref w 0)))
    w))

(defun %ns-strip-min-cell-heights (this respect)
  (let* ((cells (.cells this))
         (h (vector (container-cell.min-height-of-cell (aref cells 0) respect)
                    (container-cell.min-height-of-cell (aref cells 1) respect)
                    (container-cell.min-height-of-cell (aref cells 2) respect))))
    (when (.symmetrical this)
      (setf (aref h 0) (math.max (aref h 0) (aref h 2)))
      (setf (aref h 2) (aref h 0)))
    h))

;;; ------------------------------------------------------------ GridContainerCell

(defjctor grid-container-cell (tabular symmetrical gap)
  (setf (.tabular this) tabular (.symmetrical this) symmetrical (.gap this) gap))

(defjmethod get-gap ((this grid-container-cell)) (.gap this))
(defjmethod get-cell ((this grid-container-cell) row col)
  (aref (.cells this) (ordinal row) (ordinal col)))
(defjmethod set-cell ((this grid-container-cell) row col cell)
  (setf (aref (.cells this) (ordinal row) (ordinal col)) cell))
(defjmethod set-center-cell-minimum-size ((this grid-container-cell) minimum-size)
  (setf (.center-cell-minimum-size this) (new-k-vector minimum-size)))
(defjmethod set-only-center-cell-contributes-to-minimum-size ((this grid-container-cell) c)
  (setf (.only-center-cell-contributes-to-minimum-size this) c))
(defjmethod get-center-cell-rectangle ((this grid-container-cell))
  (new-elk-rectangle (.center-cell-rect this)))

(defjmethod get-minimum-width ((this grid-container-cell))
  (let ((width 0.0)
        (cells (.cells this)))
    (cond ((.only-center-cell-contributes-to-minimum-size this)
           (cond ((.center-cell-minimum-size this)
                  (setf width (.x (.center-cell-minimum-size this))))
                 ((aref cells 1 1)
                  (setf width (get-minimum-width (aref cells 1 1))))))
          ((.tabular this)
           (setf width (%ns-sum-active (%ns-grid-min-column-widths this nil t) (.gap this))))
          (t
           (jdo (area (container-area.values))
             (setf width (math.max width (%ns-sum-active (%ns-grid-min-column-widths this area t)
                                                         (.gap this)))))))
    (if (> width 0)
        (+ width (.left (get-padding this)) (.right (get-padding this)))
        0.0)))

(defjmethod get-minimum-height ((this grid-container-cell))
  (let ((height 0.0)
        (cells (.cells this)))
    (if (.only-center-cell-contributes-to-minimum-size this)
        (cond ((.center-cell-minimum-size this)
               (setf height (.y (.center-cell-minimum-size this))))
              ((aref cells 1 1)
               (setf height (get-minimum-height (aref cells 1 1)))))
        (setf height (%ns-sum-active (%ns-grid-min-row-heights this t) (.gap this))))
    (if (> height 0)
        (+ height (.top (get-padding this)) (.bottom (get-padding this)))
        0.0)))

(defjmethod layout-children-horizontally ((this grid-container-cell))
  (if (.tabular this)
      (let ((col-widths (%ns-grid-min-column-widths this nil nil)))
        (jdo (row (container-area.values))
          (%ns-grid-apply-widths-to-row this row col-widths)))
      (jdo (row (container-area.values))
        (%ns-grid-apply-widths-to-row this row (%ns-grid-min-column-widths this row nil)))))

(defjmethod layout-children-vertically ((this grid-container-cell))
  (let* ((cell-rectangle (get-cell-rectangle this))
         (cell-padding (get-padding this))
         (gap (.gap this))
         (row-heights (%ns-grid-min-row-heights this nil))
         (ccr (.center-cell-rect this)))
    (%ns-grid-apply-height-to-row this container-area.begin
                                  (+ (.y cell-rectangle) (.top cell-padding)) row-heights)
    (%ns-grid-apply-height-to-row this container-area.end
                                  (- (+ (.y cell-rectangle) (.height cell-rectangle))
                                     (.bottom cell-padding) (aref row-heights 2))
                                  row-heights)
    (let ((free (- (.height cell-rectangle) (.top cell-padding) (.bottom cell-padding))))
      (when (> (aref row-heights 0) 0)
        (incf (aref row-heights 0) gap)
        (decf free (aref row-heights 0)))
      (when (> (aref row-heights 2) 0)
        (incf (aref row-heights 2) gap)
        (decf free (aref row-heights 2)))
      (setf (.height ccr) (math.max 0.0 free))
      (setf (.y ccr) (+ (.y cell-rectangle) (.top cell-padding) (/ (- (.height ccr) free) 2)))
      (setf (aref row-heights 1) (math.max (aref row-heights 1) free))
      (%ns-grid-apply-height-to-row this container-area.center
                                    (- (+ (.y cell-rectangle) (.top cell-padding) (aref row-heights 0))
                                       (/ (- (aref row-heights 1) free) 2))
                                    row-heights))))

(defun %ns-grid-min-column-widths (this row respect)
  (let ((w (vector (%ns-grid-min-width-of-column this container-area.begin row respect)
                   (%ns-grid-min-width-of-column this container-area.center row respect)
                   (%ns-grid-min-width-of-column this container-area.end row respect))))
    (when (.symmetrical this)
      (setf (aref w 0) (math.max (aref w 0) (aref w 2)))
      (setf (aref w 2) (aref w 0)))
    w))

(defun %ns-grid-min-width-of-column (this column row respect)
  (let ((max-min-width 0.0)
        (cells (.cells this))
        (c (ordinal column)))
    (if (null row)
        (dotimes (r 3)
          (setf max-min-width (math.max max-min-width
                                        (container-cell.min-width-of-cell (aref cells r c) respect))))
        (setf max-min-width (container-cell.min-width-of-cell (aref cells (ordinal row) c) respect)))
    (when (and (eq column container-area.center) (.center-cell-minimum-size this))
      (setf max-min-width (math.max max-min-width (.x (.center-cell-minimum-size this)))))
    max-min-width))

(defun %ns-grid-min-row-heights (this respect)
  (let ((h (vector (%ns-grid-min-height-of-row this container-area.begin respect)
                   (%ns-grid-min-height-of-row this container-area.center respect)
                   (%ns-grid-min-height-of-row this container-area.end respect))))
    (when (.symmetrical this)
      (setf (aref h 0) (math.max (aref h 0) (aref h 2)))
      (setf (aref h 2) (aref h 0)))
    h))

(defun %ns-grid-min-height-of-row (this row respect)
  (let ((max-min-height 0.0)
        (cells (.cells this))
        (r (ordinal row)))
    (dotimes (c 3)
      (setf max-min-height (math.max max-min-height
                                     (container-cell.min-height-of-cell (aref cells r c) respect))))
    (when (and (eq row container-area.center) (.center-cell-minimum-size this))
      (setf max-min-height (math.max max-min-height (.y (.center-cell-minimum-size this)))))
    max-min-height))

(defun %ns-grid-apply-widths-to-row (this row col-widths)
  (let* ((cell-rectangle (get-cell-rectangle this))
         (cell-padding (get-padding this))
         (gap (.gap this)))
    (%ns-grid-apply-width-to-column this container-area.begin
                                    (+ (.x cell-rectangle) (.left cell-padding)) col-widths)
    (%ns-grid-apply-width-to-column this container-area.end
                                    (- (+ (.x cell-rectangle) (.width cell-rectangle))
                                       (.right cell-padding) (aref col-widths 2))
                                    col-widths)
    (let ((free (- (.width cell-rectangle) (.left cell-padding) (.right cell-padding))))
      (when (> (aref col-widths 0) 0)
        (incf (aref col-widths 0) gap)
        (decf free (aref col-widths 0)))
      (when (> (aref col-widths 2) 0)
        (incf (aref col-widths 2) gap)
        (decf free (aref col-widths 2)))
      (let ((center-width (math.max 0.0 free)))
        (setf (aref col-widths 1) (math.max (aref col-widths 1) free))
        (%ns-grid-apply-width-to-column this container-area.center
                                        (- (+ (.x cell-rectangle) (.left cell-padding) (aref col-widths 0))
                                           (/ (- (aref col-widths 1) free) 2))
                                        col-widths)
        (when (eq row container-area.center)
          (let ((ccr (.center-cell-rect this)))
            (setf (.width ccr) center-width)
            (setf (.x ccr) (+ (.x cell-rectangle) (.left cell-padding) (/ (- center-width free) 2)))))))))

(defun %ns-grid-apply-width-to-column (this column x col-widths)
  ;; NB: as in ELK, this applies to the column in ALL rows
  (let ((c (ordinal column)))
    (dotimes (r 3)
      (apply-horizontal-layout this (aref (.cells this) r c) x (aref col-widths c)))))

(defun %ns-grid-apply-height-to-row (this row y row-heights)
  (let ((r (ordinal row)))
    (dotimes (c 3)
      (apply-vertical-layout this (aref (.cells this) r c) y (aref row-heights r)))))

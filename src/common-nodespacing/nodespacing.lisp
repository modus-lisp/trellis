;;;; nodespacing.lisp -- org.eclipse.elk.alg.common.nodespacing
;;;; (NodeLabelAndSizeCalculator, NodeDimensionCalculation, NodeMarginCalculator)

(in-package #:elk)

;;; ------------------------------------------------------------ NodeLabelAndSizeCalculator

(defjstatic node-label-and-size-calculator.process (graph)
  (jdo (node (get-nodes graph))
    (node-label-and-size-calculator.process graph node t nil)))

(defjstatic node-label-and-size-calculator.process (graph node apply-stuff ignore-inside-port-labels)
  (let ((nc (new-node-context graph node))
        (horizontal-layout-mode t))
    (port-context-creator.create-port-contexts nc ignore-inside-port-labels)
    (when (and graph (has-property graph core-options.direction))
      (let ((dir (get-property graph core-options.direction)))
        (setf horizontal-layout-mode (or (eq dir core-direction.undefined) (is-horizontal dir)))))
    (node-label-cell-creator.create-node-label-cells nc nil horizontal-layout-mode)
    (inside-port-label-cell-creator.create-inside-port-label-cells nc)
    (node-label-and-size-utilities.setup-minimum-client-area-size nc)
    (node-label-and-size-utilities.setup-node-padding-for-ports-with-offset nc)
    (horizontal-port-placement-size-calculator.calculate-horizontal-port-placement-size nc)
    (vertical-port-placement-size-calculator.calculate-vertical-port-placement-size nc)
    (cell-system-configurator.configure-cell-system-size-contributions nc)
    (node-size-calculator.set-node-width nc)
    (port-placement-calculator.place-horizontal-ports nc)
    (port-label-placement-calculator.place-horizontal-port-labels nc)
    (cell-system-configurator.update-vertical-inside-port-label-cell-padding nc)
    (node-size-calculator.set-node-height nc)
    (unless apply-stuff
      (return-from node-label-and-size-calculator.process/4 (.node-size nc)))
    (node-label-and-size-utilities.offset-southern-ports-by-node-size nc)
    (port-placement-calculator.place-vertical-ports nc)
    (port-label-placement-calculator.place-vertical-port-labels nc)
    (common-label-placer.place-labels nc)
    (node-label-and-size-utilities.set-node-padding nc)
    (node-label-and-size-utilities.apply-stuff nc)
    (.node-size nc)))

(defjstatic node-label-and-size-calculator.compute-inside-node-label-padding (graph node layout-direction)
  graph
  (let* ((nc (new-node-context nil node)))
    (node-label-cell-creator.create-node-label-cells nc t (not (is-vertical layout-direction)))
    (let ((container (.inside-node-label-container nc))
          (padding (new-elk-padding)))
      (jdo (col (container-area.values))
        (let ((c (get-cell container container-area.begin col)))
          (when c (setf (.top padding) (math.max (.top padding) (get-minimum-height c))))))
      (jdo (col (container-area.values))
        (let ((c (get-cell container container-area.end col)))
          (when c (setf (.bottom padding) (math.max (.bottom padding) (get-minimum-height c))))))
      (jdo (row (container-area.values))
        (let ((c (get-cell container row container-area.begin)))
          (when c (setf (.left padding) (math.max (.left padding) (get-minimum-width c))))))
      (jdo (row (container-area.values))
        (let ((c (get-cell container row container-area.end)))
          (when c (setf (.right padding) (math.max (.right padding) (get-minimum-width c))))))
      (when (> (.top padding) 0)
        (incf (.top padding) (.top (get-padding container)))
        (incf (.top padding) (get-gap container)))
      (when (> (.bottom padding) 0)
        (incf (.bottom padding) (.bottom (get-padding container)))
        (incf (.bottom padding) (get-gap container)))
      (when (> (.left padding) 0)
        (incf (.left padding) (.left (get-padding container)))
        (incf (.left padding) (get-gap container)))
      (when (> (.right padding) 0)
        (incf (.right padding) (.right (get-padding container)))
        (incf (.right padding) (get-gap container)))
      padding)))

;;; ------------------------------------------------------------ NodeDimensionCalculation

(defjstatic node-dimension-calculation.calculate-label-and-node-sizes (adapter)
  (node-label-and-size-calculator.process adapter))

(defjstatic node-dimension-calculation.calculate-node-margins (adapter)
  (process (new-node-margin-calculator adapter)))

(defjstatic node-dimension-calculation.get-node-margin-calculator (adapter)
  (new-node-margin-calculator adapter))

(defjstatic node-dimension-calculation.sort-port-lists (adapter)
  (jdo (node (get-nodes adapter))
    (sort-port-list node)))

;;; ------------------------------------------------------------ NodeMarginCalculator

(defjctor node-margin-calculator (adapter)
  (setf (.adapter this) adapter))

(defjmethod exclude-labels ((this node-margin-calculator))
  (setf (.include-labels this) nil) this)
(defjmethod exclude-ports ((this node-margin-calculator))
  (setf (.include-ports this) nil) this)
(defjmethod exclude-port-labels ((this node-margin-calculator))
  (setf (.include-port-labels this) nil) this)
(defjmethod exclude-edge-head-tail-labels ((this node-margin-calculator))
  (setf (.include-edge-head-tail-labels this) nil) this)

(defjmethod process ((this node-margin-calculator))
  (let ((spacing (get-property (.adapter this) core-options.spacing-label-node)))
    (jdo (node (get-nodes (.adapter this)))
      (process-node this node spacing))))

(defjmethod process-node ((this node-margin-calculator) node)
  (process-node this node (get-property (.adapter this) core-options.spacing-label-node)))

(defun %ns-set-box (box x y w h)
  (setf (.x box) x (.y box) y (.width box) w (.height box) h))

(defjmethod process-node ((this node-margin-calculator) node label-spacing)
  (let* ((npos (get-position node))
         (nsize (get-size node))
         (bounding-box (new-elk-rectangle (.x npos) (.y npos) (.x nsize) (.y nsize)))
         (element-box (new-elk-rectangle)))
    (when (.include-labels this)
      (jdo (label (get-labels node))
        (%ns-set-box element-box (+ (.x (get-position label)) (.x npos)) (+ (.y (get-position label)) (.y npos))
                     (.x (get-size label)) (.y (get-size label)))
        (j-union bounding-box element-box)))
    (jdo (port (get-ports node))
      (let ((port-x (+ (.x (get-position port)) (.x npos)))
            (port-y (+ (.y (get-position port)) (.y npos))))
        (when (.include-ports this)
          (%ns-set-box element-box port-x port-y (.x (get-size port)) (.y (get-size port)))
          (j-union bounding-box element-box))
        (when (.include-port-labels this)
          (jdo (label (get-labels port))
            (%ns-set-box element-box (+ (.x (get-position label)) port-x) (+ (.y (get-position label)) port-y)
                         (.x (get-size label)) (.y (get-size label)))
            (j-union bounding-box element-box)))
        (when (.include-edge-head-tail-labels this)
          (let ((space (new-k-vector (- label-spacing) (- label-spacing))))
            (when (contains (get-property node core-options.port-labels-placement) port-label-placement.outside)
              (jdo (label (get-labels port))
                (incf (.x space) (+ (.x (get-size label)) label-spacing))
                (incf (.y space) (+ (.y (get-size label)) label-spacing))))
            (setf (.x space) (math.max (.x space) 0.0)
                  (.y space) (math.max (.y space) 0.0))
            (%ns-process-edge-head-tail-labels bounding-box (get-outgoing-edges port) (get-incoming-edges port)
                                               node port space label-spacing)))))
    (when (.include-edge-head-tail-labels this)
      (%ns-process-edge-head-tail-labels bounding-box (get-outgoing-edges node) (get-incoming-edges node)
                                         node nil nil label-spacing))
    (let ((margin (new-elk-margin (get-margin node))))
      (setf (.top margin) (math.max 0.0 (- (.y npos) (.y bounding-box))))
      (setf (.bottom margin) (math.max 0.0 (- (+ (.y bounding-box) (.height bounding-box))
                                              (+ (.y npos) (.y nsize)))))
      (setf (.left margin) (math.max 0.0 (- (.x npos) (.x bounding-box))))
      (setf (.right margin) (math.max 0.0 (- (+ (.x bounding-box) (.width bounding-box))
                                             (+ (.x npos) (.x nsize)))))
      (set-margin node margin))))

(defun %ns-process-edge-head-tail-labels (bounding-box outgoing incoming node port space label-spacing)
  (let ((label-box (new-elk-rectangle)))
    (jdo (edge outgoing)
      (jdo (label (get-labels edge))
        (when (eq (get-property label core-options.edge-labels-placement) edge-label-placement.tail)
          (%ns-compute-label-box label-box label nil node port space label-spacing)
          (j-union bounding-box label-box))))
    (jdo (edge incoming)
      (jdo (label (get-labels edge))
        (when (eq (get-property label core-options.edge-labels-placement) edge-label-placement.head)
          (%ns-compute-label-box label-box label t node port space label-spacing)
          (j-union bounding-box label-box))))))

(defun %ns-compute-label-box (label-box label incoming node port space label-spacing)
  (setf (.x label-box) (.x (get-position node))
        (.y label-box) (.y (get-position node)))
  (when port
    (incf (.x label-box) (.x (get-position port)))
    (incf (.y label-box) (.y (get-position port))))
  (setf (.width label-box) (.x (get-size label))
        (.height label-box) (.y (get-size label)))
  (if (null port)
      (if incoming
          (decf (.x label-box) (+ label-spacing (.x (get-size label))))
          (incf (.x label-box) (+ (.x (get-size node)) label-spacing)))
      (enum-case (get-side port)
        ((port-side.undefined port-side.east)
         (incf (.x label-box) (+ (.x (get-size port)) label-spacing (.x space) label-spacing)))
        (port-side.west
         (decf (.x label-box) (+ label-spacing (.x space) label-spacing (.x (get-size label)))))
        (port-side.north
         (incf (.x label-box) (+ (.x (get-size port)) label-spacing))
         (decf (.y label-box) (+ label-spacing (.y space) label-spacing (.y (get-size label)))))
        (port-side.south
         (incf (.x label-box) (+ (.x (get-size port)) label-spacing))
         (incf (.y label-box) (+ (.y (get-size port)) label-spacing (.y space) label-spacing))))))

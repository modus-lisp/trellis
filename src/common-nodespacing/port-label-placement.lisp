;;;; port-label-placement.lisp -- PortLabelPlacementCalculator

(in-package #:elk)

(defjstatic port-label-placement-calculator.place-horizontal-port-labels (nc)
  (%ns-place-port-labels nc port-side.north)
  (%ns-place-port-labels nc port-side.south))

(defjstatic port-label-placement-calculator.place-vertical-port-labels (nc)
  (%ns-place-port-labels nc port-side.east)
  (%ns-place-port-labels nc port-side.west))

(defun %ns-place-port-labels (nc side)
  (let ((constrained (or (not (contains (.size-constraints nc) size-constraint.port-labels))
                         (eq (.port-constraints nc) port-constraints.fixed-pos))))
    (cond ((contains (.port-labels-placement nc) port-label-placement.inside)
           (if constrained
               (%ns-constrained-inside-port-label-placement nc side)
               (%ns-simple-inside-port-label-placement nc side)))
          ((contains (.port-labels-placement nc) port-label-placement.outside)
           (if constrained
               (%ns-constrained-outside-port-label-placement nc side)
               (%ns-simple-outside-port-label-placement nc side))))))

(defun %ns-has-port-labels (pc)
  (and (.port-label-cell pc) (has-labels (.port-label-cell pc))))

(defun %ns-next-to-port-label-height (nc cell rect)
  (if (.port-labels-treat-as-group nc)
      (.height rect)
      (.y (get-size (jl-get (get-labels cell) 0)))))

(defun %ns-simple-inside-port-label-placement (nc side)
  (let ((area-height 0.0)
        (label-border-offset (%ns-port-label-border-offset-for-port-side nc side))
        (sp-h (.port-label-spacing-horizontal nc))
        (sp-v (.port-label-spacing-vertical nc)))
    (jdo (pc (ns-port-contexts-get nc side))
      (when (%ns-has-port-labels pc)
        (let* ((port-size (get-size (.port pc)))
               (port-border-offset (if (has-property (.port pc) core-options.port-border-offset)
                                       (get-property (.port pc) core-options.port-border-offset)
                                       0.0))
               (cell (.port-label-cell pc))
               (rect (get-cell-rectangle cell)))
          (setf (.width rect) (get-minimum-width cell)
                (.height rect) (get-minimum-height cell))
          (enum-case side
            (port-side.north
             (setf (.x rect) (if (.labels-next-to-port pc)
                                 (/ (- (.x port-size) (.width rect)) 2)
                                 (+ (.x port-size) sp-h)))
             (setf (.y rect) (+ (.y port-size) port-border-offset label-border-offset))
             (set-horizontal-alignment cell horizontal-label-alignment.center)
             (set-vertical-alignment cell vertical-label-alignment.top))
            (port-side.south
             (setf (.x rect) (if (.labels-next-to-port pc)
                                 (/ (- (.x port-size) (.width rect)) 2)
                                 (+ (.x port-size) sp-h)))
             (setf (.y rect) (- (- port-border-offset) label-border-offset (.height rect)))
             (set-horizontal-alignment cell horizontal-label-alignment.center)
             (set-vertical-alignment cell vertical-label-alignment.bottom))
            (port-side.east
             (setf (.x rect) (- (- port-border-offset) label-border-offset (.width rect)))
             (setf (.y rect) (if (.labels-next-to-port pc)
                                 (/ (- (.y port-size) (%ns-next-to-port-label-height nc cell rect)) 2)
                                 (+ (.y port-size) sp-v)))
             (set-horizontal-alignment cell horizontal-label-alignment.right)
             (set-vertical-alignment cell vertical-label-alignment.center))
            (port-side.west
             (setf (.x rect) (+ (.x port-size) port-border-offset label-border-offset))
             (setf (.y rect) (if (.labels-next-to-port pc)
                                 (/ (- (.y port-size) (%ns-next-to-port-label-height nc cell rect)) 2)
                                 (+ (.y port-size) sp-v)))
             (set-horizontal-alignment cell horizontal-label-alignment.left)
             (set-vertical-alignment cell vertical-label-alignment.center)))
          (when (or (eq side port-side.north) (eq side port-side.south))
            (setf area-height (math.max area-height (.height rect)))))))
    (when (> area-height 0)
      (setf (.y (get-minimum-content-area-size (%ns-ipl-cell nc side))) area-height))))

(defun %ns-port-label-border-offset-for-port-side (nc side)
  (let ((p (get-padding (.node-container nc))))
    (enum-case side
      (port-side.north (+ (.top p) (.port-label-spacing-vertical nc)))
      (port-side.south (+ (.bottom p) (.port-label-spacing-vertical nc)))
      (port-side.east (+ (.right p) (.port-label-spacing-horizontal nc)))
      (port-side.west (+ (.left p) (.port-label-spacing-horizontal nc)))
      (t 0.0))))

(defun %ns-constrained-inside-port-label-placement (nc side)
  (let ((pcs (ns-port-contexts-get nc side)))
    (when (or (eq side port-side.east) (eq side port-side.west))
      (%ns-simple-inside-port-label-placement nc side)
      (return-from %ns-constrained-inside-port-label-placement))
    (let* ((north (eq side port-side.north))
           (direction (if north overlap-removal-direction.down overlap-removal-direction.up))
           (valign (if north vertical-label-alignment.top vertical-label-alignment.bottom))
           (container (%ns-ipl-cell nc side))
           (crect (get-cell-rectangle container))
           (left-border (+ (.x crect) (elk-math.maxd (list (.left (get-padding container))
                                                            (.left (.surrounding-port-margins nc))
                                                            (.node-label-spacing nc)))))
           (right-border (- (+ (.x crect) (.width crect))
                            (elk-math.maxd (list (.right (get-padding container))
                                                 (.right (.surrounding-port-margins nc))
                                                 (.node-label-spacing nc)))))
           (remover (with-gap (rectangle-strip-overlap-remover.create-for-direction direction)
                      (.port-label-spacing-horizontal nc) (.port-label-spacing-vertical nc)))
           (start (if north double.negative-infinity double.positive-infinity)))
      (jdo (pc pcs)
        (when (%ns-has-port-labels pc)
          (let* ((port-size (get-size (.port pc)))
                 (port-position (.port-position pc))
                 (cell (.port-label-cell pc))
                 (rect (get-cell-rectangle cell)))
            (setf (.width rect) (get-minimum-width cell)
                  (.height rect) (get-minimum-height cell))
            (set-vertical-alignment cell valign)
            (set-horizontal-alignment cell horizontal-label-alignment.right)
            (%ns-center-port-label rect port-position port-size left-border right-border)
            (add-rectangle remover rect)
            (setf start (if north
                            (math.max start (+ (.y port-position) (.y (get-size (.port pc)))))
                            (math.min start (.y port-position)))))))
      (incf start (if north (.port-label-spacing-vertical nc) (- (.port-label-spacing-vertical nc))))
      (let ((strip-height (remove-overlaps (with-start-coordinate remover start))))
        (when (> strip-height 0)
          (setf (.y (get-minimum-content-area-size (%ns-ipl-cell nc side))) strip-height)))
      (%ns-relativize-port-label-cells pcs))))

(defun %ns-relativize-port-label-cells (pcs)
  (jdo (pc pcs)
    (when (%ns-has-port-labels pc)
      (let ((rect (get-cell-rectangle (.port-label-cell pc))))
        (decf (.x rect) (.x (.port-position pc)))
        (decf (.y rect) (.y (.port-position pc)))))))

(defun %ns-center-port-label (rect port-position port-size min-x max-x)
  (setf (.x rect) (- (.x port-position) (/ (- (.width rect) (.x port-size)) 2)))
  (let ((actual-min-x (math.min min-x (.x port-position)))
        (actual-max-x (math.max max-x (+ (.x port-position) (.x port-size)))))
    (cond ((< (.x rect) actual-min-x)
           (setf (.x rect) actual-min-x))
          ((> (+ (.x rect) (.width rect)) actual-max-x)
           (setf (.x rect) (- actual-max-x (.width rect)))))))

(defun %ns-simple-outside-port-label-placement (nc side)
  (let ((pcs (ns-port-contexts-get nc side))
        (first-differently (node-label-and-size-utilities.is-first-outside-port-label-placed-differently nc side))
        (always-above (contains (.port-labels-placement nc) port-label-placement.always-other-same-side))
        (sp-h (.port-label-spacing-horizontal nc))
        (sp-v (.port-label-spacing-vertical nc)))
    (jdo (pc pcs)
      (when (%ns-has-port-labels pc)
        (let* ((port-size (get-size (.port pc)))
               (cell (.port-label-cell pc))
               (rect (get-cell-rectangle cell)))
          (setf (.width rect) (get-minimum-width cell)
                (.height rect) (get-minimum-height cell))
          (flet ((horizontal-x ()
                   (cond ((.labels-next-to-port pc)
                          (setf (.x rect) (/ (- (.x port-size) (.width rect)) 2))
                          (set-horizontal-alignment cell horizontal-label-alignment.center))
                         ((or first-differently always-above)
                          (setf (.x rect) (- (- (.width rect)) sp-h))
                          (set-horizontal-alignment cell horizontal-label-alignment.right))
                         (t
                          (setf (.x rect) (+ (.x port-size) sp-h))
                          (set-horizontal-alignment cell horizontal-label-alignment.left))))
                 (vertical-y ()
                   (cond ((.labels-next-to-port pc)
                          (setf (.y rect) (/ (- (.y port-size) (%ns-next-to-port-label-height nc cell rect)) 2))
                          (set-vertical-alignment cell vertical-label-alignment.center))
                         ((or first-differently always-above)
                          (setf (.y rect) (- (- (.height rect)) sp-v))
                          (set-vertical-alignment cell vertical-label-alignment.bottom))
                         (t
                          (setf (.y rect) (+ (.y port-size) sp-v))
                          (set-vertical-alignment cell vertical-label-alignment.top)))))
            (enum-case side
              (port-side.north
               (horizontal-x)
               (setf (.y rect) (- (- (.height rect)) sp-v))
               (set-vertical-alignment cell vertical-label-alignment.bottom))
              (port-side.south
               (horizontal-x)
               (setf (.y rect) (+ (.y port-size) sp-v))
               (set-vertical-alignment cell vertical-label-alignment.top))
              (port-side.east
               (vertical-y)
               (setf (.x rect) (+ (.x port-size) sp-h))
               (set-horizontal-alignment cell horizontal-label-alignment.left))
              (port-side.west
               (vertical-y)
               (setf (.x rect) (- (- (.width rect)) sp-h))
               (set-horizontal-alignment cell horizontal-label-alignment.right))))
          (setf first-differently nil))))))

(defun %ns-constrained-outside-port-label-placement (nc side)
  (let ((pcs (ns-port-contexts-get nc side)))
    (when (or (<= (length pcs) 2) (eq side port-side.east) (eq side port-side.west))
      (%ns-simple-outside-port-label-placement nc side)
      (return-from %ns-constrained-outside-port-label-placement))
    (let* ((special-needs (contains (.port-labels-placement nc) port-label-placement.space-efficient))
           (north (eq side port-side.north))
           (direction (if north overlap-removal-direction.up overlap-removal-direction.down))
           (valign (if north vertical-label-alignment.bottom vertical-label-alignment.top))
           (remover (with-gap (rectangle-strip-overlap-remover.create-for-direction direction)
                      (.port-label-spacing-vertical nc) (.port-label-spacing-horizontal nc)))
           (start (if north double.positive-infinity double.negative-infinity)))
      (jdo (pc pcs)
        (when (%ns-has-port-labels pc)
          (let* ((port-size (get-size (.port pc)))
                 (port-position (.port-position pc))
                 (cell (.port-label-cell pc))
                 (rect (get-cell-rectangle cell)))
            (setf (.width rect) (get-minimum-width cell)
                  (.height rect) (get-minimum-height cell))
            (if special-needs
                (progn
                  (setf (.x rect) (- (.x port-position) (get-minimum-width cell)
                                     (.port-label-spacing-horizontal nc)))
                  (setf special-needs nil))
                (setf (.x rect) (+ (.x port-position) (.x port-size) (.port-label-spacing-horizontal nc))))
            (set-vertical-alignment cell valign)
            (set-horizontal-alignment cell horizontal-label-alignment.right)
            (add-rectangle remover rect)
            (setf start (if north
                            (math.min start (.y port-position))
                            (math.max start (+ (.y port-position) (.y (get-size (.port pc))))))))))
      (incf start (if north (- (.port-label-spacing-vertical nc)) (.port-label-spacing-vertical nc)))
      (remove-overlaps (with-start-coordinate remover start))
      (%ns-relativize-port-label-cells pcs))))
